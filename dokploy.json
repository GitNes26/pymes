{
  "$schema": "https://dokploy.com/docs/configuration/dokploy-json",
  "name": "catamanager",
  "description": "CataManager — catálogo digital + pedidos por WhatsApp (Express + MySQL)",
  "compose": {
    "services": {
      "app": {
        "build": {
          "context": ".",
          "dockerfile": "Dockerfile"
        },
        "ports": ["3000:3000"],
        "volumes": [
          "${UPLOADS_HOST_PATH:-/var/www/imagenes_cadi}:/app/public/uploads",
          "backups:/app/backups"
        ],
        "environment": {
          "NODE_ENV": "production",
          "PORT": "3000",
          "DB_HOST": "${DB_HOST}",
          "DB_PORT": "${DB_PORT:-3306}",
          "DB_USER": "${DB_USER}",
          "DB_PASS": "${DB_PASS}",
          "DB_NAME": "${DB_NAME:-catamanager}",
          "MASTER_KEY": "${MASTER_KEY}",
          "BASE_URL": "${BASE_URL:-https://cadi.nessik.net}",
          "UPLOADS_ROOT": "/app/public/uploads",
          "UPLOADS_PROJECT_NAME": "${UPLOADS_PROJECT_NAME:-catamanager}"
        },
        "labels": [
          "traefik.enable=true",
          "traefik.http.services.cadi.loadbalancer.server.port=3000",
          "traefik.http.routers.cadi.rule=Host(`cadi.nessik.net`)",
          "traefik.http.routers.cadi.entrypoints=web",
          "traefik.http.routers.cadi.service=cadi",
          "traefik.http.routers.cadi.middlewares=cadi-https-redirect",
          "traefik.http.middlewares.cadi-https-redirect.redirectscheme.scheme=https",
          "traefik.http.routers.cadi-secure.rule=Host(`cadi.nessik.net`)",
          "traefik.http.routers.cadi-secure.entrypoints=websecure",
          "traefik.http.routers.cadi-secure.tls=true",
          "traefik.http.routers.cadi-secure.tls.certresolver=letsencrypt",
          "traefik.http.routers.cadi-secure.service=cadi"
        ]
      }
    },
    "volumes": {
      "backups": { "driver": "local" }
    }
  }
}
