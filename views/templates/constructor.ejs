        <div class="xs-ship-col">
          <h3><i class="bi bi-truck" aria-hidden="true"></i> Envíos</h3>
          <ul class="xs-list"><% _envLines.forEach(function(l){ %><li><i class="bi bi-check2-circle" aria-hidden="true"></i><span><%= l %></span></li><% }) %></ul>
        </div>
        <% } %>
        <% if (_hasPay) { %>
        <div class="xs-ship-col">
