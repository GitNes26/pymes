  <link rel="stylesheet" href="/css/catalog-hero.css?v=20260919c">
  <script src="/js/catalog-motion.js?v=20260920a" defer></script>
  <script src="/js/catalog-gallery.js?v=20260919a" defer></script>
  <script src="/js/btn-fit.js?v=20260918a" defer></script>
