    <div class="wrap">
      <div class="sec-title" style="font-size:19px;"><i class="bi bi-geo-alt"></i> ¿Dónde estamos?</div>
      <div style="background:var(--bg-card,#fff);border:1px solid var(--border,rgba(26,60,94,.08));border-radius:16px;overflow:hidden;box-shadow:var(--shadow,0 8px 32px rgba(0,0,0,.06));margin-bottom:14px;">
        <iframe title="Ubicación de <%= biz.name %>" src="https://maps.google.com/maps?q=<%= _addressEnc %>&z=16&output=embed" style="width:100%;height:360px;border:0;display:block;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <div style="padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
          <span style="font-size:13px;color:var(--text,#1e1b1a);font-weight:600;"><i class="bi bi-pin-map" style="color:var(--accent,#1a3c5e);margin-right:6px;"></i><%= _address %></span>
          <a href="https://www.google.com/maps/search/?api=1&query=<%= _addressEnc %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;background:var(--accent,#1a3c5e);color:#fff;padding:8px 16px;border-radius:99px;font-weight:700;font-size:12px;text-decoration:none;">Cómo llegar <i class="bi bi-box-arrow-up-right" style="font-size:11px;"></i></a>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ===== FORMULARIO DE CONTACTO ===== -->
  <div class="contact-section">
    <div class="wrap">
      <div class="contact-form-wrap">
        <h2><i class="bi bi-chat-dots" style="color:var(--accent);"></i> ¿Tienes alguna pregunta?</h2>
        <p class="contact-sub">Escríbenos y te respondemos lo antes posible</p>
        <form class="contact-form" onsubmit="event.preventDefault();sendContactForm();">
          <input type="text" id="cfName" placeholder="Tu nombre" required class="cf-input" style="margin-bottom:10px;">
          <select id="cfTopic" class="cf-input" style="margin-bottom:10px;">
            <option value="">Asunto...</option>
            <option value="producto">Consulta de producto</option>
            <option value="envio">Envío y entrega</option>
            <option value="pedido">Estado de pedido</option>
            <option value="otro">Otro</option>
          </select>
          <textarea id="cfMsg" placeholder="Escribe tu mensaje..." rows="4" required class="cf-input cf-textarea"></textarea>
          <button type="submit" class="cf-submit"><i class="bi bi-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
      </div>
    </div>
  </div>

  <!-- ===== TAMBIÉN TE PUEDE INTERESAR (slider) ===== -->
  <% if (typeof adsEnabled !== 'undefined' && adsEnabled && typeof sponsoredAds !== 'undefined' && sponsoredAds.length) { %>
  <section class="sponsored-section">
    <div class="wrap">
      <div class="ofertas-header">
        <div class="sponsored-label">También te puede interesar</div>
        <div class="ofertas-arrows">
          <button class="ofertas-arrow" onclick="document.getElementById('sponsored-track').scrollBy({left:-220,behavior:'smooth'})"><i class="bi bi-chevron-left"></i></button>
          <button class="ofertas-arrow" onclick="document.getElementById('sponsored-track').scrollBy({left:220,behavior:'smooth'})"><i class="bi bi-chevron-right"></i></button>
          <button type="button" class="sponsored-ver-todos" id="sponsored-ver-todos" onclick="toggleSponsoredGrid()">Ver todos</button>
        </div>
      </div>
    </div>
    <div class="ofertas-track-wrap">
      <div class="ofertas-track" id="sponsored-track">
        <script>
          function toggleSponsoredGrid() {
            const tr = document.getElementById('sponsored-track');
            const btn = document.getElementById('sponsored-ver-todos');
            if (!tr || !btn) return;
            const grid = tr.classList.toggle('sponsored-grid');
            btn.textContent = grid ? 'Ver menos' : 'Ver todos';
          }
        </script>
        <% sponsoredAds.forEach(function(ad) { %>
        <a href="/<%= ad.store.slug %><%= ad.id ? '/p/' + ad.id : '' %>" class="oferta-card" style="text-decoration:none;color:inherit;">
          <div class="oferta-img-wrap">
            <% if (ad.image) { %><img src="<%= ad.image %>" alt="<%= ad.name %>" loading="lazy" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'"><% } %>
            <span class="oferta-badge-tag"><%= ad.store.name %></span>
          </div>
          <div class="oferta-body">
            <div class="oferta-name"><%= ad.name %></div>
            <div class="oferta-prices">
              <% if (ad.price) { %><span class="oferta-new"><%= _money(ad.price) %></span><% } %>
            </div>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (_showFooter) { %>
  <footer class="ftr">
    <div class="ftr-inner">
      <div class="ftr-top">
        <div>
          <h3><%= biz.name %></h3>
          <p><%= biz.description || 'Tu negocio en línea.' %></p>
          <% if (_socials.length) { %>
          <div class="ftr-redes">
            <% _socials.forEach(function(s){ %><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.label %> de <%= biz.name %>" title="<%= s.label %>"><i class="bi <%= s.icon %>" aria-hidden="true"></i></a><% }) %>
          </div>
          <% } %>
        </div>
        <div>
          <h3>Contacto</h3>
          <ul>
            <% if (_whatsapp) { %><li><i class="bi bi-whatsapp" style="margin-right:6px;"></i><%= biz.whatsapp %></li><% } %>
            <% if (biz.phone) { %><li><i class="bi bi-telephone" style="margin-right:6px;"></i><%= biz.phone %></li><% } %>
            <% if (biz.address) { %><li><i class="bi bi-geo-alt" style="margin-right:6px;"></i><%= biz.address %></li><% } %>
          </ul>
        </div>
        <div>
          <h3>Horario</h3>
          <% if (_horarioHtml) { %><div style="font-size:13px;"><%- _horarioHtml %></div><% } else { %><p style="font-size:13px;">Consultar horarios</p><% } %>
        </div>
      </div>
      <div class="ftr-copy">© 2026 <%= biz.name %>. Hecho por nessik.net</div>
    </div>
  </footer>
  <% } %>

  <!-- Lightbox -->
  <div class="lb" id="galLB">
    <button class="lb-close" onclick="closeLB()">&times;</button>
    <button class="lb-nav" style="left:12px;" onclick="navLB(-1)">&#8249;</button>
    <button class="lb-nav" style="right:12px;" onclick="navLB(1)">&#8250;</button>
    <img id="galLBImg" src="">
    <div class="lb-counter" id="galLBCtr"></div>
  </div>



  <script>
    var _galUrls=[], _galIdx=0;
    function openLB(src) {
      var imgs = document.querySelectorAll('#galGrid img');
      _galUrls = Array.prototype.map.call(imgs, function(i){ return i.src; });
      _galIdx = _galUrls.indexOf(src);
      if(_galIdx < 0) _galIdx = 0;
      document.getElementById('galLBImg').src = _galUrls[_galIdx];
      document.getElementById('galLBCtr').textContent = (_galIdx+1)+' / '+_galUrls.length;
      document.getElementById('galLB').style.display='flex';
      document.body.style.overflow='hidden';
    }
    function closeLB() { document.getElementById('galLB').style.display='none'; document.body.style.overflow=''; }
    function navLB(d) { _galIdx=(_galIdx+d+_galUrls.length)%_galUrls.length; document.getElementById('galLBImg').src=_galUrls[_galIdx]; document.getElementById('galLBCtr').textContent=(_galIdx+1)+' / '+_galUrls.length; }
    document.addEventListener('keydown',function(e){ if(!document.getElementById('galLB')||document.getElementById('galLB').style.display!=='flex')return; if(e.key==='Escape')closeLB(); if(e.key==='ArrowLeft')navLB(-1); if(e.key==='ArrowRight')navLB(1); });
    if(document.getElementById('galLB')) document.getElementById('galLB').addEventListener('click',function(e){ if(e.target===this)closeLB(); });

    // ===== FILTROS =====
    // Paginación: 20 productos por página con botón "Ver más"
    var PAGE_SIZE = 20;
    var _shownCount = PAGE_SIZE;
    function _matchesFilters(c) {
      var q = (document.getElementById('filterSearch')||{}).value||'';
      var pMin = parseFloat((document.getElementById('filterPriceMin')||{}).value)||0;
      var pMax = parseFloat((document.getElementById('filterPriceMax')||{}).value)||Infinity;
      var name = (c.getAttribute('data-name')||'').toLowerCase();
      var price = parseFloat(c.getAttribute('data-price'))||0;
      var cat = c.getAttribute('data-cat');
      var activeCat = document.querySelector('.filter-cat.on');
      var catOk = !activeCat || activeCat.getAttribute('data-cat')==='all' || activeCat.getAttribute('data-cat')===cat;
      var nameOk = !q || name.indexOf(q.toLowerCase())>-1;
      var priceOk = price>=pMin && price<=pMax;
      return catOk && nameOk && priceOk;
    }
    // Anima el contador con una transición numérica discreta (opacidad),
    // no un simple salto de texto.
    function _setCount(el, n, reducedMotion) {
      if (!el) return;
      if (reducedMotion) { el.textContent = n; return; }
      el.classList.add('counting');
      setTimeout(function () { el.textContent = n; el.classList.remove('counting'); }, 90);
    }
    // Aplica un stagger corto (≤240ms en total) a las tarjetas que van entrando.
    function _staggerCards(list, cap) {
      var n = list.length; if (!n) return;
      var step = n > 1 ? Math.min(cap / (n - 1), 45) : 0;
      list.forEach(function (card, i) {
        card.classList.remove('card-enter');
        card.style.setProperty('--card-delay', Math.min(i * step, cap) + 'ms');
        requestAnimationFrame(function () { requestAnimationFrame(function () { card.classList.add('card-enter'); }); });
      });
    }
    function _renderProducts() {
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var cards = Array.prototype.slice.call(document.querySelectorAll('#prodGrid .prod-card'));
      var oldRect = {};
      if (!reducedMotion) {
        cards.forEach(function (c, i) { if (c.style.display !== 'none') oldRect[i] = c.getBoundingClientRect(); });
      }
      var total = 0, shown = 0, newlyShown = [];
      cards.forEach(function (c) { if (_matchesFilters(c)) total++; });
      cards.forEach(function (c) {
        var willShow = _matchesFilters(c) && shown < _shownCount;
        if (willShow) {
          if (c.style.display === 'none' && !reducedMotion) newlyShown.push(c);
          c.style.display = '';
          shown++;
        } else if (c.style.display !== 'none') {
          if (reducedMotion) { c.style.display = 'none'; }
          else {
            // Salida corta (120–160ms) antes de sacarla del flujo del grid.
            c.classList.add('card-exit');
            c.style.transition = 'opacity .14s ' + (getComputedStyle(document.documentElement).getPropertyValue('--ease-premium') || 'cubic-bezier(.16,1,.3,1)');
            c.style.opacity = '0';
            c.style.transform = 'scale(.96)';
            setTimeout(function () { c.style.display = 'none'; c.classList.remove('card-exit'); c.style.opacity = ''; c.style.transform = ''; c.style.transition = ''; }, 150);
          }
        }
      });
      if (!reducedMotion) {
        // FLIP: las tarjetas que siguen visibles pero cambiaron de lugar en el
        // grid se deslizan a su nueva posición en vez de "saltar".
        requestAnimationFrame(function () {
          cards.forEach(function (c, i) {
            if (oldRect[i] === undefined || c.style.display === 'none') return;
            var r = c.getBoundingClientRect();
            var dx = oldRect[i].left - r.left, dy = oldRect[i].top - r.top;
            if (Math.abs(dx) > 1 || Math.abs(dy) > 1) {
              c.style.transition = 'none';
              c.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
              requestAnimationFrame(function () {
                c.classList.add('flip-move');
                c.style.transform = '';
                setTimeout(function () { c.classList.remove('flip-move'); c.style.transition = ''; }, 300);
              });
            }
          });
          _staggerCards(newlyShown, 240);
        });
      }
      _setCount(document.getElementById('prodCount'), total, reducedMotion);
      var nr = document.getElementById('noResults');
      if (nr) nr.style.display = total === 0 ? 'block' : 'none';
      var wrap = document.getElementById('loadMoreWrap');
      if (wrap) {
        wrap.style.display = total > shown ? 'block' : 'none';
        var info = document.getElementById('loadMoreInfo');
        if (info) info.textContent = 'Mostrando ' + shown + ' de ' + total + ' productos';
      }
    }
    function loadMoreProducts() {
      _shownCount += PAGE_SIZE;
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var cards = Array.prototype.slice.call(document.querySelectorAll('#prodGrid .prod-card'));
      var total = 0, newlyShown = [];
      cards.forEach(function (c) {
        if (!_matchesFilters(c)) { c.style.display = 'none'; return; }
        total++;
        if (total <= _shownCount) {
          if (c.style.display === 'none') { c.style.display = ''; newlyShown.push(c); }
        } else { c.style.display = 'none'; }
      });
      if (!reducedMotion) _staggerCards(newlyShown, 240);
      _setCount(document.getElementById('prodCount'), total, reducedMotion);
      var wrap = document.getElementById('loadMoreWrap');
      if (wrap) {
        wrap.style.display = total > _shownCount ? 'block' : 'none';
        var info = document.getElementById('loadMoreInfo');
        if (info) info.textContent = 'Mostrando ' + Math.min(total, _shownCount) + ' de ' + total + ' productos';
      }
    }
    function applyFilters() {
      _shownCount = PAGE_SIZE; // cada cambio de filtro reinicia la paginación
      _renderProducts();
    }
    function setPriceRange(min, max) {
      var minEl = document.getElementById('filterPriceMin');
      var maxEl = document.getElementById('filterPriceMax');
      if (minEl) minEl.value = min||'';
      if (maxEl) maxEl.value = max===99999 ? '' : max;
      document.querySelectorAll('.filter-range').forEach(function(b){b.classList.remove('active');});
      event.target.classList.add('active');
      applyFilters();
    }
    function clearFilters() {
      var s = document.getElementById('filterSearch');
      var p1 = document.getElementById('filterPriceMin');
      var p2 = document.getElementById('filterPriceMax');
      if (s) s.value = '';
      if (p1) p1.value = '';
      if (p2) p2.value = '';
      document.querySelectorAll('.filter-range').forEach(function(b){b.classList.remove('active');});
      document.querySelectorAll('.filter-cat').forEach(function(b){b.classList.remove('on');});
      var allBtn = document.querySelector('.filter-cat[data-cat="all"]');
      if (allBtn) allBtn.classList.add('on');
      _shownCount = PAGE_SIZE;
      _renderProducts();
    }
    function catalogFilterCat(cat, el) {
      document.querySelectorAll('.filter-cat').forEach(function(b){b.classList.remove('on');});
      if (!el) { var btn = document.querySelector('.filter-cat[data-cat="'+cat+'"]'); if (btn) btn.classList.add('on'); }
      else { el.classList.add('on'); }
      applyFilters();
    }

    // Estado inicial: solo la primera página visible
    _renderProducts();

    // ===== FORMULARIO DE CONTACTO =====
    function sendContactForm() {
      var name = (document.getElementById('cfName')||{}).value||'';
      var topic = (document.getElementById('cfTopic')||{}).value||'';
      var msg = (document.getElementById('cfMsg')||{}).value||'';
      if (!name||!msg) { toast('Escribe tu nombre y mensaje'); return; }
      var topicMap = {producto:'Consulta de producto',envio:'Envío y entrega',pedido:'Estado de pedido',otro:'Otro'};
      var text = 'Hola, soy ' + name + '.\nAsunto: ' + (topicMap[topic]||'Consulta') + '\n\n' + msg;
      window.open('https://wa.me/<%= _whatsapp %>?text=' + encodeURIComponent(text), '_blank', 'noopener');
      var form = document.querySelector('.contact-form');
      if (form) form.reset();
    }

    /* ===== MOVIMIENTO: apertura, header sticky, scroll reveal acotado ===== */
    (function() {
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Solo las secciones que ganan significado con un reveal al hacer scroll
      // (ofertas, colección filtrada ya la maneja stagger propio, galería,
      // contacto) — el footer y cada bloque genérico ya NO se animan aquí.
      var revealObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) { e.target.classList.add('visible'); revealObserver.unobserve(e.target); }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.sec-title').forEach(function(el) { revealObserver.observe(el); });
      var cf = document.querySelector('.contact-form-wrap');
      if (cf) revealObserver.observe(cf);
      document.querySelectorAll('.gallery .sec-title, .gal-grid').forEach(function(el) { revealObserver.observe(el); });

      // Stagger de la colección al mostrarse por primera vez (≤240ms en total),
      // no en cada scroll — una vez pintada la página, las tarjetas ya están
      // en su estado final y no vuelven a animarse solas.
      function staggerIn(list, cap) {
        var n = list.length; if (!n) return;
        var step = n > 1 ? Math.min(cap / (n - 1), 45) : 0;
        list.forEach(function(card, i) {
          card.style.setProperty('--card-delay', Math.min(i * step, cap) + 'ms');
          card.classList.add('card-enter');
        });
      }
      if (!reducedMotion) {
        staggerIn(Array.prototype.slice.call(document.querySelectorAll('#prodGrid .prod-card')), 240);
        staggerIn(Array.prototype.slice.call(document.querySelectorAll('#ofertas-track .oferta-card')), 240);
      }

      // Header sticky: continuidad entre el logo grande del hero y el logo
      // compacto del header — se activa apenas el hero sale de vista.
      var hero = document.querySelector('.hero');
      var hdr = document.querySelector('.hdr');
      if (hero && hdr) {
        var hdrObs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) { hdr.classList.toggle('hdr-compact', !e.isIntersecting); });
        }, { threshold: 0, rootMargin: '-64px 0px 0px 0px' });
        hdrObs.observe(hero);
      }

      // Parallax sutil del hero, sin bloquear el hilo principal
      var heroBg = document.querySelector('.hero img.bg');
      if (heroBg && !reducedMotion) {
        var ticking = false;
        window.addEventListener('scroll', function() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function() {
            var y = window.scrollY;
            if (y < 500) heroBg.style.transform = 'translateY(' + (y * 0.12) + 'px)';
            ticking = false;
          });
        }, { passive: true });
      }
    })();

    /* ===== IMAGEN EXPANDIDA (click para ver grande) ===== */
    function expandImage(src, caption) {
      var overlay = document.getElementById('imgExpandOverlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'imgExpandOverlay';
        overlay.className = 'img-expand-overlay';
        overlay.innerHTML = '<button class="expand-close" onclick="closeExpandImage()"><i class="bi bi-x-lg"></i></button>'
          + '<img id="expandImg" src="" alt="">'
          + '<div class="expand-caption" id="expandCaption"></div>';
        overlay.addEventListener('click', function(e) { if (e.target === overlay) closeExpandImage(); });
        document.body.appendChild(overlay);
      }
      document.getElementById('expandImg').src = src;
      document.getElementById('expandCaption').textContent = caption || '';
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeExpandImage() {
      var overlay = document.getElementById('imgExpandOverlay');
      if (overlay) { overlay.classList.remove('show'); document.body.style.overflow = ''; }
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeExpandImage(); });

    /* Hacer clickeables las imágenes de producto y galería */
    document.addEventListener('DOMContentLoaded', function() {
      /* Imágenes de productos */
      document.querySelectorAll('.prod-img-wrap img').forEach(function(img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function(e) {
          e.stopPropagation();
          var card = img.closest('.prod-card');
          var name = card ? (card.querySelector('.prod-name') || {}).textContent : '';
          expandImage(img.src, name || '');
        });
      });
      /* Imágenes de galería */
      document.querySelectorAll('.gal-grid img').forEach(function(img) {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', function(e) {
          e.stopPropagation();
          expandImage(img.src, '');
        });
      });
    });

    /* Accesibilidad: las tarjetas abren el detalle con clic — también deben
       poder abrirse con teclado (Enter/Espacio), ya que son <div onclick>. */
    (function () {
      document.querySelectorAll('.prod-card, .oferta-card').forEach(function (card) {
        if (!card.hasAttribute('tabindex')) card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.addEventListener('keydown', function (e) {
          if ((e.key === 'Enter' || e.key === ' ') && e.target === card) {
            e.preventDefault();
            card.click();
          }
        });
      });
    })();

    /* Imágenes: fade-in suave cuando terminan de cargar (evita flash de fondo) */
    (function () {
      function markLoaded(img) { img.classList.add('img-loaded'); }
      document.querySelectorAll('.prod-img-wrap img, .oferta-img-wrap img').forEach(function (img) {
        if (img.complete && img.naturalWidth) markLoaded(img);
        else img.addEventListener('load', function () { markLoaded(img); }, { once: true });
        img.addEventListener('error', function () { markLoaded(img); }, { once: true });
      });
    })();

    /* Confirmación táctil breve al tocar una tarjeta en móvil (sin depender de hover) */
    (function () {
      if (!('ontouchstart' in window)) return;
      document.addEventListener('touchstart', function (e) {
        var card = e.target.closest && e.target.closest('.prod-card, .oferta-card');
        if (!card) return;
        card.classList.add('tap-press');
      }, { passive: true });
      document.addEventListener('touchend', function () {
        document.querySelectorAll('.tap-press').forEach(function (c) { c.classList.remove('tap-press'); });
      }, { passive: true });
    })();

    /* ===== AGREGAR AL CARRITO: conecta visualmente la tarjeta con el contador
       del carrito flotante — el "segundo momento importante" de la experiencia.
       addToCart() (en cart-js.ejs) llama a esto solo cuando de verdad agregó
       algo (no cuando solo abrió el selector de variantes o no hay stock). ===== */
    function flyToCart(originEl, imgSrc) {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var fab = document.getElementById('chat-fab');
        if (!fab || !originEl) return;
        var from = originEl.getBoundingClientRect();
        var to = fab.getBoundingClientRect();
        if (!from.width || !to.width) return;
        var fly = document.createElement('img');
        fly.src = imgSrc || '/img/sin-imagen.svg';
        fly.className = 'cart-fly';
        fly.style.left = from.left + 'px';
        fly.style.top = from.top + 'px';
        fly.style.width = from.width + 'px';
        fly.style.height = from.height + 'px';
        fly.style.opacity = '1';
        document.body.appendChild(fly);
        var toX = to.left + to.width / 2 - (from.left + from.width / 2);
        var toY = to.top + to.height / 2 - (from.top + from.height / 2);
        var anim = fly.animate([
          { transform: 'translate(0,0) scale(1)', opacity: 1, offset: 0 },
          { transform: 'translate(' + (toX * 0.5) + 'px,' + (toY * 0.5 - 40) + 'px) scale(.7)', opacity: 1, offset: 0.6 },
          { transform: 'translate(' + toX + 'px,' + toY + 'px) scale(.12)', opacity: 0, offset: 1 }
        ], { duration: 420, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
        anim.onfinish = function () {
          fly.remove();
          fab.classList.remove('tapped');
          void fab.offsetWidth;
          fab.classList.add('tapped');
          var badge = document.getElementById('chat-fab-badge');
          if (badge) { badge.classList.remove('cart-count-bump'); void badge.offsetWidth; badge.classList.add('cart-count-bump'); }
        };
      } catch (e) {}
    }
  </script>

  <%- include("../partials/cart-js", { biz, products, currencySymbol: typeof currencySymbol !== "undefined" ? currencySymbol : "$" }) %>
  <script src="/js/searchable-select.js"></script>
</body>
</html>
