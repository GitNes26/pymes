  <!-- ===== ENVÍOS Y FORMAS DE PAGO ===== -->
  <% if (_exShip) { var _envLines = String(_ex.envios || '').split(/\n+/).map(function(l){ return l.trim(); }).filter(Boolean); var _hasPay = !!(_exPagos.length || _ex.pagos_nota); %>
