</head>
<body>

  <% if (biz.banner) { %>
  <div class="hero<%= biz.banner ? ' has-banner' : '' %>">
    <img src="<%= biz.banner %>" class="bg" alt="banner" data-hide-on-error>
    <div class="hero-overlay">
      <% if (biz.logo) { %><img src="<%= biz.logo %>" class="hero-logo" alt="logo" data-hide-on-error><% } %>
      <div class="hero-name"><%= biz.name %></div>
      <% if (biz.description) { %><div class="hero-desc"><%= biz.description %></div><% } %>
      <% if (_horarioHtml) { %>
      <div class="hero-status <%= (function(){
        if(!_horario) return 'closed';
        var now=new Date(), dow=now.getDay(), hm=now.getHours()*60+now.getMinutes();
        if(Array.isArray(_horario)){
          for(var i=0;i<_horario.length;i++){
            var h=_horario[i];
            if(h && h.d===dow && h.o && h.c){
              var op=parseInt(h.o.split(':')[0])*60+parseInt(h.o.split(':')[1]);
              var cl=parseInt(h.c.split(':')[0])*60+parseInt(h.c.split(':')[1]);
              return hm>=op&&hm<=cl?'open':'closed';
            }
          }
        }
        return 'closed';
      })() %>">
        <span><%= (function(){
          if(!_horario) return '🔴 Cerrado';
          var now=new Date(), dow=now.getDay(), hm=now.getHours()*60+now.getMinutes();
          if(Array.isArray(_horario)){
            for(var i=0;i<_horario.length;i++){
              var h=_horario[i];
              if(h && h.d===dow && h.o && h.c){
                var op=parseInt(h.o.split(':')[0])*60+parseInt(h.o.split(':')[1]);
                var cl=parseInt(h.c.split(':')[0])*60+parseInt(h.c.split(':')[1]);
                return hm>=op&&hm<=cl?'🟢 Abierto ahora':'🔴 Cerrado';
              }
            }
          }
          return '🔴 Cerrado';
        })() %></span>
      </div>
      <% } %>
    </div>
  </div>
  <% } else if (biz.logo) { %>
  <!-- Sin banner: el logo se presenta grande en una portada sencilla -->
  <div class="brand-hero">
    <img src="<%= biz.logo %>" class="brand-hero-logo" alt="<%= biz.name %>" data-hide-on-error>
    <div class="hero-name"><%= biz.name %></div>
    <% if (biz.description) { %><div class="hero-desc"><%= biz.description %></div><% } %>
  </div>
  <% } %>

  <% if (_showHeader) { %>
  <!-- ===== BANNER DE CAMPAÑA (editable en Configuración) ===== -->
  <% var _camp = (_sec.campaign && _sec.campaign.text) ? _sec.campaign : null; %>
  <% if (_camp) { %>
  <div id="campaign-bar" style="position:relative;z-index:49;background:linear-gradient(90deg,var(--accent),var(--accent-light));color:#fff;text-align:center;padding:9px 44px 9px 16px;font-size:.88rem;font-weight:600;letter-spacing:.01em;">
    <span style="margin-right:6px;">🔥</span><%= _camp.text %><% if (_camp.ends) { %> <span id="campaign-count" style="font-weight:800;margin-left:8px;"></span><% } %>
    <button type="button" onclick="document.getElementById('campaign-bar').remove()" aria-label="Cerrar" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.18);border:none;color:#fff;width:24px;height:24px;border-radius:50%;cursor:pointer;font-size:13px;line-height:1;">✕</button>
  </div>
  <% if (_camp.ends) { %>
  <script>
    (function () {
      var el = document.getElementById('campaign-count');
      if (!el) return;
      function tick() {
        var end = new Date('<%= _camp.ends %>T23:59:59');
        var ms = end - new Date();
        if (ms <= 0) { el.textContent = '· ¡Último día!'; return; }
        var d = Math.floor(ms / 86400000), h = Math.floor(ms % 86400000 / 3600000), m = Math.floor(ms % 3600000 / 60000);
        el.textContent = '· ' + (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm';
      }
      tick(); setInterval(tick, 60000);
    })();
  </script>
  <% } %>
  <% } %>

  <header class="hdr">
    <div class="hdr-inner">
      <div class="hdr-left">
        <% if (biz.logo) { %><img src="<%= biz.logo %>" class="hdr-logo" alt="logo" data-hide-on-error><% } %>
        <span class="hdr-title"><%= biz.name %></span>
      </div>
      <div class="hdr-right">
        <button type="button" id="pwa-install-btn-public" class="install-pill" onclick="window.installPWA && window.installPWA()"><i class="bi bi-download"></i> Instalar app</button>
        <% if (adminLink) { %><a href="<%= adminLink %>" class="admin-pill"><i class="bi bi-speedometer2"></i> Panel</a><% } %>
        <% if (_whatsapp) { %><a href="https://wa.me/<%= _whatsapp %>" target="_blank" rel="noopener" class="wa-pill"><i class="bi bi-whatsapp"></i> Pedir</a><% } %>
      </div>
    </div>
  </header>
  <script>
    (function () {
      var btn = document.getElementById('pwa-install-btn-public');
      if (!btn) return;
      function apply(can) { btn.style.display = can ? 'inline-flex' : 'none'; }
      document.addEventListener('pwa-installable-change', function (e) { apply(e.detail.installable); });
      if (document.documentElement.classList.contains('pwa-installable')) apply(true);
    })();
  </script>
  <% } %>

  <!-- ===== OFERTAS (full width) ===== -->
  <% if (_ofertas.length) { %>
  <div class="ofertas-section">
    <div class="wrap">
      <div class="ofertas-header">
        <div class="ofertas-title"><i class="bi bi-lightning-charge-fill"></i> Ofertas</div>
        <div class="ofertas-arrows">
          <button class="ofertas-arrow" onclick="document.getElementById('ofertas-track').scrollBy({left:-220,behavior:'smooth'})"><i class="bi bi-chevron-left"></i></button>
          <button class="ofertas-arrow" onclick="document.getElementById('ofertas-track').scrollBy({left:220,behavior:'smooth'})"><i class="bi bi-chevron-right"></i></button>
        </div>
      </div>
    </div>
    <div class="ofertas-track-wrap">
      <div class="ofertas-track" id="ofertas-track">
        <% _ofertas.forEach(function(p){ var _pct=Math.round((1-p.price/p.old_price)*100); %>
        <div class="oferta-card" onclick="location.href='/<%= biz.slug %>/p/<%= p.id %>'" style="cursor:pointer;">
          <div class="oferta-img-wrap"<%- _ph(p.image) %>>
            <img src="<%= p.image||'/img/sin-imagen.svg' %>"<%- _imgAttrs(p.image, '(max-width:640px) 62vw, 280px') %> loading="lazy" decoding="async" alt="<%= p.name %>">
            <div class="prod-badge-wrap"><span class="prod-badge-offer">-<%= _pct %>%</span><span class="prod-badge-promo">Oferta</span></div>
          </div>
          <div class="oferta-body">
            <div class="oferta-name"><%= p.name %></div>
            <div class="oferta-prices">
              <span class="oferta-old"><%= _money(p.old_price) %></span>
              <span class="oferta-new"><%= _money(p) %></span>
            </div>
            <% if (p.promo_desc && p.promo_desc.indexOf('Precio rebajado') !== 0) { %>
              <div style="margin-top:6px;padding:5px 8px;border-radius:7px;font-size:11px;font-weight:700;background:linear-gradient(135deg,rgba(239,68,68,.12),rgba(255,87,34,.14));color:#dc2626;border:1px dashed rgba(239,68,68,.35);line-height:1.3;"><i class="bi bi-tag-fill"></i> <%= p.promo_desc %></div>
            <% } %>
            <% if (p.allow_installments) { %>
              <div><span class="installment-note">◐ <%= (p.installment_count || 6) %> abonos de <%= _rawMoney((p.price / (p.installment_count || 6)).toFixed(2)) %></span></div>
            <% } %>
            <div class="oferta-actions">
              <button class="prod-btn" onclick="event.stopPropagation();if(!addToCart(<%= p.id %>,'<%= p.name.replace(/'/g,"\\'") %>',<%= parseFloat(p.price)||0 %>,'',{slug:'<%= biz.slug %>',name:'<%= biz.name.replace(/'/g,"\\'") %>',whatsapp:'<%= _whatsapp %>',logo:'<%= (biz.logo||'').replace(/'/g,"\\'") %>'},'<%= (p.image||'').replace(/'/g,"\\'") %>'))return;this.classList.add('added');this.innerHTML='<i class=\'bi bi-check-lg\'></i> Agregado';setTimeout(()=>{this.classList.remove('added');this.innerHTML='<i class=\'bi bi-bag-plus\'></i> Agregar';},1200);"><i class="bi bi-bag-plus"></i> Agregar</button>
              <a class="prod-view-btn" href="/<%= biz.slug %>/p/<%= p.id %>" onclick="event.stopPropagation();" title="Ver producto"><i class="bi bi-eye"></i> Ver</a>
              <button class="prod-share-btn" onclick="event.stopPropagation();shareProduct(<%= p.id %>,'<%= p.name.replace(/'/g,"\\'") %>',<%= parseFloat(p.price)||0 %>)" title="Compartir" aria-label="Compartir <%= p.name %>"><i class="bi bi-share"></i></button>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ===== RECIÉN LLEGADOS / MÁS VENDIDOS (los prende el dueño en Configuración) ===== -->
  <% [ { id:'nuevos-track', title:'Recién llegados', icon:'bi-stars', tag:'NUEVO', list:_newest },
       { id:'top-track', title:'Los más vendidos', icon:'bi-graph-up-arrow', tag:'TOP', list:_best } ].forEach(function(sec){ if (!sec.list.length) return; %>
  <div class="ofertas-section xs-strip">
    <div class="wrap">
      <div class="ofertas-header">
        <div class="ofertas-title"><i class="bi <%= sec.icon %>"></i> <%= sec.title %></div>
        <div class="ofertas-arrows">
          <button type="button" class="ofertas-arrow" aria-label="Anterior" onclick="document.getElementById('<%= sec.id %>').scrollBy({left:-220,behavior:'smooth'})"><i class="bi bi-chevron-left"></i></button>
          <button type="button" class="ofertas-arrow" aria-label="Siguiente" onclick="document.getElementById('<%= sec.id %>').scrollBy({left:220,behavior:'smooth'})"><i class="bi bi-chevron-right"></i></button>
        </div>
      </div>
    </div>
    <div class="ofertas-track-wrap">
      <div class="ofertas-track" id="<%= sec.id %>">
        <% sec.list.forEach(function(p, pi){ %>
        <%- include("../partials/prod-card", { p: p, biz: biz, _money: _money, _rawMoney: _rawMoney, _whatsapp: _whatsapp, _imgAttrs: _imgAttrs, _ph: _ph, plain: true, badge: (sec.tag === 'TOP' ? ('Top ' + (pi + 1)) : 'Nuevo'), badgeCls: (sec.tag === 'TOP' ? 'prod-badge-rank' : 'prod-badge-new') }) %>
        <% }) %>
      </div>
    </div>
  </div>
  <% }) %>

  <!-- ===== CONTENIDO PRINCIPAL: sidebar + grid ===== -->
  <div class="main-layout">
    <div class="wrap main-inner">

      <!-- SIDEBAR DE FILTROS -->
      <aside class="filter-sidebar" id="filterSidebar">
        <div class="filter-header">
          <h3><i class="bi bi-funnel"></i> Filtros</h3>
          <button class="filter-close-movil" onclick="document.getElementById('filterSidebar').classList.remove('sidebar-open')">✕</button>
        </div>

        <!-- Buscador -->
        <div class="filter-group">
          <label class="filter-label">Buscar</label>
          <div class="filter-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="filterSearch" placeholder="Nombre del producto..." oninput="applyFilters()" class="filter-search">
          </div>
        </div>

        <!-- Precio -->
        <div class="filter-group">
          <label class="filter-label">Precio</label>
          <div class="filter-price-row">
            <input type="number" id="filterPriceMin" placeholder="Mín" min="0" oninput="applyFilters()" class="filter-input">
            <span class="filter-dash">–</span>
            <input type="number" id="filterPriceMax" placeholder="Máx" min="0" oninput="applyFilters()" class="filter-input">
          </div>
        </div>

        <!-- Categorías -->
        <% if (_catsShown.length > 1) { %>
        <div class="filter-group">
          <label class="filter-label">Categoría</label>
          <div class="filter-cats">
            <button class="filter-cat on" data-cat="all" onclick="catalogFilterCat('all',this)">Todos <span><%= _realProds.length %></span></button>
            <% _catsShown.forEach(function(cat) { %>
            <button class="filter-cat" data-cat="<%= cat.id %>" onclick="catalogFilterCat('<%= cat.id %>',this)"><%= cat.name %> <span><%= _catCount[String(cat.id)] || 0 %></span></button>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Atributos de los productos (solo los que tienen productos) -->
        <% _attrGroups.forEach(function (g) { %>
        <div class="filter-group">
          <label class="filter-label"><%= g.name %></label>
          <div class="filter-attrs">
            <% g.vals.forEach(function (x) { %>
            <button type="button" class="filter-attr" data-attr="<%= g.name %>" data-val="<%= x.v %>" onclick="catalogFilterAttr(this)"><%= x.v %> <span><%= x.n %></span></button>
            <% }) %>
          </div>
        </div>
        <% }) %>

        <!-- Atributos (precio rápido) -->
        <div class="filter-group">
          <label class="filter-label">Rango de precio</label>
          <div class="filter-range-btns">
            <button class="filter-range" onclick="setPriceRange(0,100)">< $100</button>
            <button class="filter-range" onclick="setPriceRange(100,500)">$100–$500</button>
            <button class="filter-range" onclick="setPriceRange(500,1000)">$500–$1K</button>
            <button class="filter-range" onclick="setPriceRange(1000,99999)">$1K+</button>
          </div>
        </div>

        <button class="filter-clear" onclick="clearFilters()"><i class="bi bi-x-lg"></i> Limpiar filtros</button>
      </aside>

      <!-- GRID DE PRODUCTOS -->
      <div class="main-content">
        <div class="sec-title"><i class="bi bi-grid-3x3-gap"></i> Productos <span style="font-weight:400;font-size:13px;color:var(--muted);margin-left:6px;">(<span id="prodCount"><%= _realProds.length %></span>)</span></div>
        <% if (_realProds.length) { %>
        <div class="prod-grid" id="prodGrid">
          <% _realProds.forEach(function(p) { %>
          <%- include("../partials/prod-card", { p: p, biz: biz, _money: _money, _rawMoney: _rawMoney, _whatsapp: _whatsapp, _imgAttrs: _imgAttrs, _ph: _ph }) %>
          <% }) %>
        </div>
        <div id="loadMoreWrap" style="display:none;text-align:center;padding:4px 0 48px;">
          <button type="button" class="load-more-btn" onclick="loadMoreProducts()"><i class="bi bi-arrow-down-circle"></i> Ver más productos</button>
          <div id="loadMoreInfo" style="font-size:12px;color:var(--text-secondary,#8A857C);margin-top:10px;letter-spacing:.04em;"></div>
        </div>
        <div id="noResults" style="display:none;text-align:center;padding:48px 16px;">
          <i class="bi bi-search" style="font-size:36px;display:block;margin-bottom:10px;color:var(--muted);"></i>
          <p style="font-size:14px;font-weight:700;color:var(--text,#141210);margin:0 0 4px;">No se encontraron productos con esos filtros</p>
          <p style="font-size:12px;color:var(--muted,#5C6B64);margin:0 0 16px;">Prueba con otro término o quita los filtros para ver todo el catálogo.</p>
          <button type="button" class="no-results-btn" onclick="clearFilters()">Limpiar filtros</button>
        </div>
        <% } else { %>
        <div class="empty" style="padding:64px 16px;">
          <i class="bi bi-box-seam" style="font-size:42px;color:var(--accent, #2563eb);opacity:.4;display:block;margin:0 auto 14px;"></i>
          <p style="font-size:16px;font-weight:800;color:var(--text, #141210);margin:0 0 6px;">Aún estamos acomodando el catálogo</p>
          <p style="font-size:13px;color:var(--text-secondary, #5C6B64);margin:0 0 18px;">Muy pronto tendremos productos en venta. ¿Algo en especial? Escríbenos.</p>
          <% if (_whatsapp) { %>
          <a href="https://wa.me/<%= _whatsapp %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;background:#25d366;color:#fff;padding:11px 22px;border-radius:999px;font-weight:800;font-size:13px;text-decoration:none;box-shadow:0 4px 14px rgba(37,211,102,.25);transition:transform .15s;">
            <i class="bi bi-whatsapp" style="font-size:16px;"></i> Pregúntanos por WhatsApp
          </a>
          <% } %>
        </div>
        <% } %>
        <div id="prodGridEnd" style="height:1px;"></div>
      </div>
    </div>
  </div>

  <!-- Botón filtros móvil: solo tiene sentido mientras se ven los productos, así
       que se oculta en cuanto el usuario baja hacia otras secciones (preguntas,
       footer, etc.) — antes se quedaba fijo en toda la página y tapaba botones. -->
  <button class="filter-fab" onclick="document.getElementById('filterSidebar').classList.toggle('sidebar-open')"><i class="bi bi-funnel"></i> Filtros</button>
  <script>
    (function () {
      var fab = document.querySelector('.filter-fab');
      // Sentinel al final de la cuadrícula: el botón solo debe flotar mientras
      // todavía haya productos a la altura donde él vive en pantalla (fijo,
      // pegado abajo). En cuanto ese punto de fin de cuadrícula sube por
      // encima de la propia zona del botón, ya no hay productos ahí — solo
      // el espacio en blanco o la siguiente sección — así que se oculta,
      // en vez de quedarse flotando sobre contenido ajeno.
      var sentinel = document.getElementById('prodGridEnd');
      if (!fab || !sentinel) return;
      function isMobile() { return window.matchMedia('(max-width:900px)').matches; }
      function update() {
        if (!isMobile()) { fab.style.display = 'none'; return; }
        var fabZoneTop = window.innerHeight - 140;
        var top = sentinel.getBoundingClientRect().top;
        fab.style.display = (top > fabZoneTop) ? 'flex' : 'none';
      }
      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { update(); ticking = false; });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    })();
  </script>

  <!-- ===== GALERÍA ===== -->
  <% if (_gallery.length) { %>
  <div class="gallery xs-sec<%- _xsBand() %>">
    <div class="xs-in">
      <%- _xsHead('Nuestro trabajo', 'Galería', '', 'xs-gal-t') %>
      <div class="gal-grid" id="galGrid">
        <% _gallery.forEach(function(url) { %>
        <img src="<%= url %>" alt="" loading="lazy" referrerpolicy="no-referrer" onclick="openLB(this.src)">
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ===== MODELOS / LOOKBOOK (fotos de personas usando los productos; sale solo si hay fotos) ===== -->
  <% if (_exMod) { var _mi = _exMod.images.slice(0, 6); %>
  <section class="xs-mod" aria-labelledby="xs-mod-t">
    <div class="mod-in">
      <header class="mod-head">
        <span class="mod-eyebrow">Lookbook</span>
        <h2 class="mod-title" id="xs-mod-t"><%= _exMod.title || 'Nuestros modelos' %></h2>
        <% if (_exMod.text) { %><p class="mod-sub"><%= _exMod.text %></p><% } %>
        <span class="mod-line" aria-hidden="true"></span>
      </header>
      <div class="xs-models mod-n<%= _mi.length %>" id="modScroller">
        <% _mi.forEach(function (m, i) { %>
        <figure class="xs-model"<%- _ph(m.src) %> data-src="<%= m.src %>" data-cap="<%= m.cap || '' %>">
          <img src="<%= m.src %>"<%- _imgAttrs(m.src, '(max-width:720px) 76vw, 420px') %> alt="<%= m.cap || 'Modelo' %>" loading="lazy" decoding="async">
          <span class="mod-idx"><%= (i + 1 < 10 ? '0' : '') + (i + 1) %></span>
          <% if (m.cap) { %><figcaption><span><%= m.cap %></span></figcaption><% } %>
        </figure>
        <% }) %>
      </div>
      <% if (_mi.length > 1) { %><div class="mod-dots" id="modDots" aria-hidden="true"><% _mi.forEach(function (m, i) { %><i<%= i === 0 ? ' class="on"' : '' %>></i><% }) %></div><% } %>
    </div>
  </section>
  <script>
    document.addEventListener('click', function (e) {
      var f = e.target.closest && e.target.closest('.xs-model');
      if (f && typeof expandImage === 'function') expandImage(f.getAttribute('data-src'), f.getAttribute('data-cap') || '');
    });
    (function () {
      var sc = document.getElementById('modScroller'), dots = document.querySelectorAll('#modDots i');
      if (!sc || !dots.length) return;
      var t = null;
      sc.addEventListener('scroll', function () {
        clearTimeout(t);
        t = setTimeout(function () {
          var first = sc.children[0], step = first ? first.getBoundingClientRect().width + 12 : 1;
          var i = Math.max(0, Math.min(dots.length - 1, Math.round(sc.scrollLeft / step)));
          for (var d = 0; d < dots.length; d++) dots[d].classList.toggle('on', d === i);
        }, 40);
      }, { passive: true });
    })();
  </script>
  <% } %>

  <!-- ===== CONÓCENOS (sale solo si el dueño escribió su texto; la foto es opcional) ===== -->
  <% if (_exAbout) { var _hasPh = !!_exAbout.image; %>
  <section class="xs-sec<%- _xsBand() %>" aria-labelledby="xs-about-t">
    <div class="xs-in">
      <div class="xs-about<%= _hasPh ? '' : ' no-photo' %>">
        <% if (_hasPh) { %><figure class="xs-photo"><img src="<%= _exAbout.image %>" alt="" loading="lazy" onerror="var a=this.closest('.xs-about');a.classList.add('no-photo');this.closest('.xs-photo').remove();"></figure><% } %>
        <div class="xs-about-text">
