<%
  var _sec = {};
  try { _sec = JSON.parse(biz.sections || '{}'); } catch(e) {}
  var _showHeader = _sec.showHeader !== false;
  var _showFooter = _sec.showFooter !== false;
  // Estilo visual elegido por el dueño: paleta + tipografía (ver CAT_DESIGNS en server.js)
  var _design = (typeof catDesign !== 'undefined' && catDesign) ? catDesign : 'catalogo';
  var _designFontHref = (typeof catDesignTokens !== 'undefined' && catDesignTokens && catDesignTokens.font && catDesignTokens.font.href)
    ? catDesignTokens.font.href
    : 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap';
  var _cats = categories || [];
  var _prods = products || [];
  // Fotos a la medida: las subidas al servidor se piden en varios anchos (ver /uploads/:file?w= en server.js)
  var _srcset = function (src) {
    if (!/^\/uploads\/[^\/?]+\.(jpe?g|png|webp)$/i.test(src || '')) return '';
    return src + '?w=480 480w, ' + src + '?w=800 800w, ' + src + '?w=1200 1200w';
  };
  // Fondo desenfocado de la propia foto (la foto se muestra completa, sin recortar; lo que sobra se rellena con su tono)
  var _ph = function (src) {
    if (!src || /sin-imagen/.test(src)) return '';
    var u = /^\/uploads\/[^\/?]+\.(jpe?g|png|webp)$/i.test(src) ? src + '?w=240' : src;
    return ' style="--ph:url(' + encodeURI(u).replace(/[()']/g, function (c) { return '%' + c.charCodeAt(0).toString(16); }) + ')"';
  };
  var _imgAttrs = function (src, sizes) { var ss = _srcset(src); return ss ? ' srcset="' + ss + '" sizes="' + sizes + '"' : ''; };
  var _rawMoney = (typeof money === "function") ? money : function(n){ return "$" + Number(n||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };
  var _money = function(p){ return _rawMoney(typeof p === "object" ? (p.price||0) : p); };
  var _whatsapp = biz.whatsapp ? (biz.whatsapp.startsWith('52') ? biz.whatsapp : '52' + biz.whatsapp) : '';
  var _horario = null;
  try { _horario = typeof biz.horario === 'string' ? JSON.parse(biz.horario) : biz.horario; } catch(e) {}
  function _to12(h) {
    if (!h) return '';
    var parts = String(h).split(':');
    var hr = parseInt(parts[0], 10);
    var mn = parseInt(parts[1], 10) || 0;
    if (isNaN(hr)) return h;
    var ampm = hr >= 12 ? 'pm' : 'am';
    var h12 = hr % 12 || 12;
    return h12 + ':' + String(mn).padStart(2, '0') + ' ' + ampm;
  }
  var _gallery = [];
  try { _gallery = JSON.parse(biz.galeria || '[]'); } catch(e) {}
  var _redes = {};
  try { _redes = JSON.parse(biz.redes || '{}'); } catch(e) {}
  // Redes sociales: el dueño puede capturar "@cuenta", "cuenta" o el enlace
  // completo (el placeholder de Configuración pide un enlace en Facebook) — antes
  // se pegaba siempre a "https://red.com/", así que un enlace completo salía
  // duplicado ("facebook.com/https://facebook.com/...") y el ícono no llevaba a nada.
  function _socialUrl(net, raw) {
    var v = String(raw || '').trim();
    if (!v) return '';
    if (/^https?:\/\//i.test(v)) return v;
    if (/^(www\.|m\.)?(instagram|facebook|tiktok|fb)\.[a-z.]+\//i.test(v)) return 'https://' + v;
    var h = v.replace(/^@/, '').replace(/^\/+/, '');
    if (net === 'tiktok') return 'https://www.tiktok.com/@' + encodeURIComponent(h);
    if (net === 'instagram') return 'https://www.instagram.com/' + encodeURIComponent(h) + '/';
    return 'https://www.facebook.com/' + encodeURI(h);
  }
  var _socials = [
    { net: 'instagram', label: 'Instagram', icon: 'bi-instagram' },
    { net: 'facebook', label: 'Facebook', icon: 'bi-facebook' },
    { net: 'tiktok', label: 'TikTok', icon: 'bi-tiktok' }
  ].map(function(s){ s.url = _socialUrl(s.net, _redes[s.net]); return s; }).filter(function(s){ return s.url; });
  // Contraste real contra el acento de CADA apariencia: el footer usaba texto
  // blanco fijo, invisible en los diseños de acento claro (dorado, cian, rosa…).
  function _lum(hex) {
    hex = String(hex || '').replace('#', '');
    if (hex.length === 3) hex = hex.split('').map(function(c){ return c + c; }).join('');
    var ch = [0, 2, 4].map(function(i){ var c = parseInt(hex.substr(i, 2), 16) / 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); });
    return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
  }
  function _contrast(a, b) { var x = _lum(a), y = _lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
  var _tk = (typeof catDesignTokens !== 'undefined' && catDesignTokens) ? catDesignTokens : { accent: '#1a3c5e', accentGlow: '#c9a86c' };
  var _onAccent = _contrast(_tk.accent, '#ffffff') >= _contrast(_tk.accent, '#111111') ? '#ffffff' : '#111111';
  var _ftrOnDark = _onAccent === '#ffffff';
  var _bgDark = _lum(_tk.bg || '#ffffff') < 0.35;
  var _ftrHead = _contrast(_tk.accent, _tk.accentGlow) >= 3 ? _tk.accentGlow : _onAccent;
  // Secciones extra que el dueño llena/enciende en Configuración (businesses.extras).
  // Las de texto salen solas cuando tienen contenido; las automáticas
  // (nuevos, más vendidos, cómo pedir) solo si están prendidas.
  var _ex = {};
  try { _ex = JSON.parse(biz.extras || '{}') || {}; } catch(e) { _ex = {}; }
  var _exAbout = (_ex.about && _ex.about.text) ? _ex.about : null;
  var _exMod = (_ex.modelos && Array.isArray(_ex.modelos.images) && _ex.modelos.images.length) ? _ex.modelos : null;
  var _exTesti = Array.isArray(_ex.testimonios) ? _ex.testimonios.filter(function(t){ return t && t.name && t.text; }) : [];
  var _PAGO_LBL = { efectivo:['bi-cash-coin','Efectivo'], transferencia:['bi-bank','Transferencia'], tarjeta:['bi-credit-card','Tarjeta'], contra_entrega:['bi-box-seam','Contra entrega'], abonos:['bi-calendar2-check','Pagos en abonos'], mercado_pago:['bi-shield-check','Mercado Pago'] };
  var _exPagos = (Array.isArray(_ex.pagos) ? _ex.pagos : []).filter(function(k){ return _PAGO_LBL[k]; });
  var _exShip = !!(_ex.envios || _exPagos.length || _ex.pagos_nota);
  function _xe(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function _xsHead(eyebrow, title, sub, id) {
    return '<div class="xs-head"><span class="xs-eyebrow">' + _xe(eyebrow) + '</span><h2 class="xs-title"' + (id ? ' id="' + id + '"' : '') + '>' + _xe(title) + '</h2>' + (sub ? '<p class="xs-sub">' + _xe(sub) + '</p>' : '') + '</div>';
  }
  // Alterna una banda tenue entre las secciones que SÍ se muestran (son opcionales,
  // así que no se puede fijar por posición).
  var _xsI = 0;
  function _xsBand() { return (_xsI++ % 2) ? ' xs-band' : ''; }
  var _faq = [];
  try { var _fq = JSON.parse(biz.faq || '[]'); if (Array.isArray(_fq)) _faq = _fq.filter(function(x){ return x && (x.q || '').toString().trim() && (x.a || '').toString().trim(); }); } catch(e) {}
  var _address = biz.address || '';
  var _addressEnc = encodeURIComponent(_address);
  var _gridCols = biz.grid_cols || 3;

  // Build horario display string
  var _horarioHtml = '';
  if (_horario && Array.isArray(_horario)) {
    var _diasCortos = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    _horario.forEach(function(h){
      if (h && h.o && h.c) {
        _horarioHtml += '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:13px;"><span>' + (_diasCortos[h.d]||'') + '</span><span style="font-weight:600;">' + _to12(h.o) + ' – ' + _to12(h.c) + '</span></div>';
      }
    });
  } else if (_horario && typeof _horario === 'object' && !Array.isArray(_horario)) {
    var _diasCortos = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    Object.keys(_horario).forEach(function(k){
      var v = _horario[k];
      if(v && (v.open || v.o)){
        var ap = v.open || v.o;
        var ci = v.close || v.c;
        _horarioHtml += '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:13px;"><span>' + (_diasCortos[k]||k) + '</span><span style="font-weight:600;">' + _to12(ap) + ' – ' + _to12(ci) + '</span></div>';
      }
    });
  }

  // Offered products
  var _ofertas = _prods.filter(function(p){ return p && p.old_price && p.old_price > p.price; });
  // Todos los productos activos (los sin foto usan el placeholder sin-imagen.svg en el <img>).
  // Se excluyen los slots de anuncios intercalados (isAd): se muestran en su propia sección "También te puede interesar".
  var _realProds = _prods.filter(function(p){ return p && !p.isAd; });
  // Filtros: solo lo que tiene productos (una categoría o un valor de atributo en 0 no aporta nada)
  var _catCount = {};
  _realProds.forEach(function (p) { var k = String(p.category_id || 0); _catCount[k] = (_catCount[k] || 0) + 1; });
  var _catsShown = (categories || []).filter(function (c) { return (_catCount[String(c.id)] || 0) > 0; });
  function _prodAttrs(p) {
    var vm = null;
    try { vm = typeof p.variants === 'string' ? JSON.parse(p.variants || 'null') : p.variants; } catch (e) { vm = null; }
    var out = [];
    if (vm && Array.isArray(vm.attrs)) vm.attrs.forEach(function (a) {
      var n = String((a && a.name) || '').trim();
      if (!n) return;
      (a.values || []).forEach(function (v) { v = String(v == null ? '' : v).trim(); if (v && out.indexOf(n + '=' + v) === -1) out.push(n + '=' + v); });
    });
    return out;
  }
  var _attrMap = {};
  _realProds.forEach(function (p) {
    p._attrs = _prodAttrs(p);
    p._attrs.forEach(function (kv) { var i = kv.indexOf('='), n = kv.slice(0, i), v = kv.slice(i + 1); (_attrMap[n] = _attrMap[n] || {})[v] = ((_attrMap[n] || {})[v] || 0) + 1; });
  });
  var _attrGroups = Object.keys(_attrMap).map(function (n) {
    var vals = Object.keys(_attrMap[n]).map(function (v) { return { v: v, n: _attrMap[n][v] }; }).filter(function (x) { return x.n > 0; })
      .sort(function (a, b) { return b.n - a.n || a.v.localeCompare(b.v, 'es'); }).slice(0, 14);
    return { name: n, vals: vals };
  }).filter(function (g) { return g.vals.length; }).slice(0, 4);
  // "Recién llegados": los últimos productos (id más alto). Con pocos productos
  // sería repetir todo el catálogo, así que solo aparece desde 4 en adelante.
  var _newest = (_ex.showNew && _realProds.length >= 4)
    ? _realProds.slice().sort(function(a, b){ return b.id - a.id; }).slice(0, 8) : [];
  var _bestIds = (typeof bestIds !== 'undefined' && bestIds) ? bestIds : [];
  var _best = _ex.showTop ? _bestIds.map(function(id){ return _realProds.filter(function(p){ return p.id === id; })[0]; }).filter(Boolean) : [];
%><!DOCTYPE html>
<html lang="es" data-style="<%= _design %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= biz.name %> · Catálogo</title>
  <meta name="description" content="<%= (biz.description || ('Catálogo en línea de ' + biz.name)).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= biz.name %> · Catálogo" />
  <meta property="og:description" content="<%= (biz.description || ('Catálogo en línea de ' + biz.name)).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>" /><meta name="twitter:image" content="<%= ogImage %>" /><% } %>
  <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : '' %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- ===== PWA: permite instalar el catálogo como app en el teléfono del cliente ===== -->
  <link rel="manifest" href="/<%= biz.slug %>/manifest.webmanifest">
  <meta name="theme-color" content="<%= (typeof catDesignTokens !== 'undefined' && catDesignTokens && catDesignTokens.accent) ? catDesignTokens.accent : '#1a3c5e' %>">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="<%= biz.name %>">
  <link rel="icon" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <script src="/pwa.js?v=20260919" defer></script>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="<%= _designFontHref %>" rel="stylesheet" />
  <!-- Capa de movimiento consolidada (ver public/css/premium-catalog.css): usa
       solo los tokens --accent/--bg-card/etc. de abajo, nunca color fijo. -->
  <link rel="stylesheet" href="/css/premium-catalog.css?v=20260915">
  <script src="/vendor/tailwind.js"></script>
  <style>
    /* ===== PALETA PREMIUM ===== */
    :root {
      --bg: #f8f6f2;
      --bg-card: #ffffff;
      --text: #1e1b1a;
      --text-secondary: #6b6562;
      --accent: #1a3c5e;
      --accent-light: #4a7a9c;
      --accent-glow: #c9a86c;
      --border: rgba(26, 60, 94, 0.08);
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
      --radius: 18px;
      --font-heading: 'Playfair Display', serif;
      --font-body: 'Inter', sans-serif;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family:var(--font-body);
      background:var(--bg);
      color:var(--text);
      min-height:100vh;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      text-rendering:optimizeLegibility;
    }
    h1,h2,h3 { font-family:var(--font-heading); font-weight:700; letter-spacing:-0.01em; text-wrap:balance; }
    a { color:inherit; text-decoration:none; }
    img { max-width:100%; }
    .wrap { margin:0 auto; padding:0 24px; }

    /* ---- Selección de texto ---- */
    ::selection { background:rgba(26,60,94,0.1); color:var(--text); }

    /* ---- Focus visible ---- */
    :focus-visible {
      outline:2px solid var(--accent);
      outline-offset:2px;
      border-radius:4px;
    }

    /* ---- Scrollbar elegante ---- */
    ::-webkit-scrollbar { width:5px; height:5px; }
    ::-webkit-scrollbar-track { background:var(--bg); }
    ::-webkit-scrollbar-thumb { background:var(--accent-light); border-radius:10px; }
    ::-webkit-scrollbar-thumb:hover { background:var(--accent); }

    /* ===== HERO ===== */
    .hero { position:relative; width:100%; min-height:360px; overflow:hidden; }
    .hero img.bg { width:100%; height:100%; object-fit:cover; display:block; position:absolute; inset:0; filter:brightness(.92) saturate(1.05); transition:transform .4s cubic-bezier(.22,1,.36,1); will-change:transform; }
    .hero-overlay { position:absolute; inset:0; background:linear-gradient(180deg, rgba(248,246,242,.15) 0%, rgba(248,246,242,.85) 70%, rgba(248,246,242,.98) 100%); display:flex; flex-direction:column; align-items:center; justify-content:flex-end; text-align:center; padding:40px 24px 48px; }
    .hero-logo { width:80px; height:80px; border-radius:20px; object-fit:cover; border:3px solid var(--bg-card); box-shadow:var(--shadow); margin-bottom:14px; background:var(--bg-card); }
    .hero-name { font-family:var(--font-heading); font-size:clamp(1.8rem,5vw,2.8rem); font-weight:700; color:var(--text); margin-bottom:4px; text-wrap:balance; }
    .hero-name span { color:var(--accent); font-style:italic; }
    .hero-desc { font-size:.9rem; color:var(--text-secondary); max-width:460px; }
    .hero-status { display:inline-flex; align-items:center; gap:5px; margin-top:10px; padding:5px 14px; border-radius:999px; font-size:11px; font-weight:600; background:var(--bg-card); border:1px solid var(--border); }
    .hero-status.open { color:#16a34a; }
    .hero-status.closed { color:var(--text-secondary); }
    /* Con banner: el banner manda en grande; el logo queda como insignia pequeña y el texto siempre legible */
    .hero.has-banner .hero-overlay { background:linear-gradient(180deg, rgba(10,10,14,.18) 0%, rgba(10,10,14,.60) 62%, rgba(10,10,14,.80) 100%); }
    .hero.has-banner .hero-logo { width:64px; height:64px; border:3px solid rgba(255,255,255,.92); box-shadow:0 6px 20px rgba(0,0,0,.35); }
    .hero.has-banner .hero-name { color:#fff; text-shadow:0 2px 14px rgba(0,0,0,.5); }
    .hero.has-banner .hero-name span { color:#ffd77a; }
    .hero.has-banner .hero-desc { color:rgba(255,255,255,.92); text-shadow:0 1px 8px rgba(0,0,0,.45); }
    .hero.has-banner .hero-status { background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.4); color:#fff; backdrop-filter:blur(6px); }
    .hero.has-banner .hero-status.open { color:#7ef0a4; }
    .hero.has-banner .hero-status.closed { color:rgba(255,255,255,.88); }

    /* ===== HEADER ===== */
    .hdr { position:sticky; top:0; z-index:50; background:var(--bg-card); background:color-mix(in srgb, var(--bg-card) 92%, transparent); backdrop-filter:blur(18px); border-bottom:1px solid var(--border); color:var(--text); }
    .hdr-inner { display:flex; align-items:center; justify-content:space-between; padding:12px 24px; }
    .hdr-left { display:flex; align-items:center; gap:10px; }
    .hdr-logo { width:32px; height:32px; border-radius:10px; object-fit:cover; }
    .hdr-title { font-family:var(--font-heading); font-weight:700; font-size:1.1rem; }
    .hdr-right { display:flex; align-items:center; gap:12px; }
    .hdr-cart {
      position:relative;
      background:var(--bg-card);
      border:1px solid var(--border);
      border-radius:12px;
      padding:8px 14px;
      cursor:pointer;
      font-size:14px;
      display:flex;
      align-items:center;
      gap:6px;
      transition:all .25s cubic-bezier(.22,1,.36,1);
      color:var(--text);
      font-weight:600;
    }
    .hdr-cart:hover {
      border-color:var(--accent-light);
      box-shadow:var(--shadow);
      transform:translateY(-1px);
    }
    .hdr-cart:active { transform:scale(.94); background:var(--accent-light); color:#fff; border-color:var(--accent); }
    .hdr-cart-count { display:none; position:absolute; top:-5px; right:-5px; background:var(--accent); color:#fff; font-size:10px; font-weight:800; min-width:18px; height:18px; border-radius:99px; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(26,60,94,.25); }
    .wa-pill {
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:#25d366;
      color:#fff;
      padding:8px 18px;
      border-radius:12px;
      font-weight:700;
      font-size:13px;
      text-decoration:none;
      box-shadow:0 4px 16px rgba(37,211,102,.2);
      transition:all .25s cubic-bezier(.22,1,.36,1);
    }
    .wa-pill:hover {
      transform:translateY(-2px) scale(1.02);
      box-shadow:0 8px 24px rgba(37,211,102,.3);
    }
    .wa-pill:active { transform:scale(0.97); }
    .admin-pill {
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:var(--accent);
      color:#fff;
      padding:8px 16px;
      border-radius:12px;
      font-weight:700;
      font-size:13px;
      text-decoration:none;
      box-shadow:0 4px 14px rgba(26,60,94,.18);
      transition:all .25s cubic-bezier(.22,1,.36,1);
    }
    .admin-pill:hover {
      transform:translateY(-2px) scale(1.02);
      box-shadow:0 8px 22px rgba(26,60,94,.28);
    }
    .admin-pill:active { transform:scale(0.97); }
    .install-pill {
      display:none;
      align-items:center;
      gap:8px;
      background:var(--accent);
      color:#fff;
      border:none;
      cursor:pointer;
      padding:8px 16px;
      border-radius:12px;
      font-weight:700;
      font-size:13px;
      font-family:inherit;
      box-shadow:0 4px 14px rgba(26,60,94,.18);
      transition:all .25s cubic-bezier(.22,1,.36,1);
    }
    .install-pill:hover { transform:translateY(-2px) scale(1.02); }
    .install-pill:active { transform:scale(0.97); }

    /* ===== OFERTAS SLIDER ===== */
    .ofertas-section { margin:20px 0 6px; position:relative; }
    .ofertas-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .ofertas-title { font-size:18px; font-weight:700; color:var(--text); display:flex; align-items:center; gap:8px; }
    .ofertas-title i { color:var(--accent); font-size:18px; }
    .ofertas-arrows { display:flex; gap:6px; }
    .ofertas-arrow {
      width:34px;
      height:34px;
      border-radius:50%;
      border:1px solid var(--border);
      background:var(--bg-card);
      color:var(--text-secondary);
      font-size:14px;
      cursor:pointer;
      display:flex;
      align-items:center;
      justify-content:center;
      transition:all .2s cubic-bezier(.22,1,.36,1);
      box-shadow:var(--shadow);
    }
    .ofertas-arrow:hover {
      border-color:var(--accent-light);
      color:var(--accent);
      transform:translateY(-1px);
    }
    .ofertas-arrow:active { transform:scale(0.95); }
    .ofertas-track-wrap { overflow:hidden; }
    .ofertas-track { display:flex; gap:14px; overflow-x:auto; scroll-behavior:smooth; scrollbar-width:none; padding:4px 0 8px; -webkit-overflow-scrolling:touch; }
    .ofertas-track::-webkit-scrollbar { display:none; }
    .oferta-card {
      flex:0 0 220px;
      background:var(--bg-card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
    }
    .oferta-card:hover {
      transform:translateY(-6px);
      box-shadow:0 16px 48px rgba(0,0,0,.08);
      border-color:rgba(26,60,94,.12);
    }
    .oferta-img-wrap { position:relative; overflow:hidden; }
    .oferta-img-wrap img { width:100%; aspect-ratio:4/3; object-fit:cover; display:block; transition:transform .5s cubic-bezier(.22,1,.36,1); }
    .oferta-card:hover .oferta-img-wrap img { transform:scale(1.05); }
    .oferta-badge-pct {
      position:absolute;
      top:8px;
      right:8px;
      background:#ef4444;
      color:#fff;
      font-size:11px;
      font-weight:800;
      padding:3px 10px;
      border-radius:6px;
      box-shadow:0 2px 12px rgba(239,68,68,.2);
      animation:badgeBounce .5s cubic-bezier(.22,1,.36,1) forwards;
    }
    .oferta-badge-tag {
      position:absolute;
      top:8px;
      left:8px;
      background:var(--accent-glow);
      color:#fff;
      font-size:9px;
      font-weight:700;
      padding:3px 10px;
      border-radius:6px;
      text-transform:uppercase;
      letter-spacing:.05em;
      animation:badgeBounce .5s .1s cubic-bezier(.22,1,.36,1) forwards;
    }
    @keyframes badgeBounce {
      0% { transform:scale(0) rotate(-12deg); }
      60% { transform:scale(1.15) rotate(2deg); }
      100% { transform:scale(1) rotate(0); }
    }
    .oferta-body { padding:12px 14px 14px; }
    .oferta-name { font-size:14px; font-weight:600; line-height:1.3; margin-bottom:4px; color:var(--text); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .oferta-prices { display:flex; align-items:baseline; gap:6px; }
    .oferta-old { font-size:12px; color:var(--text-secondary); text-decoration:line-through; opacity:.5; }
    .oferta-new { font-family:var(--font-heading); font-size:1.15rem; font-weight:700; color:var(--accent); }

    /* ===== CATEGORY PILLS ===== */
    .cats-bar { display:flex; gap:8px; overflow-x:auto; padding:6px 0 20px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
    .cats-bar::-webkit-scrollbar { display:none; }
    .cat-pill {
      flex-shrink:0;
      padding:8px 20px;
      border-radius:99px;
      font-size:13px;
      font-weight:600;
      cursor:pointer;
      border:1px solid var(--border);
      background:var(--bg-card);
      color:var(--text-secondary);
      transition:all .25s cubic-bezier(.22,1,.36,1);
      white-space:nowrap;
      box-shadow:var(--shadow);
      animation:fadeInScale .4s cubic-bezier(.22,1,.36,1) both;
    }
    .cat-pill:nth-child(1) { animation-delay:.05s; }
    .cat-pill:nth-child(2) { animation-delay:.1s; }
    .cat-pill:nth-child(3) { animation-delay:.15s; }
    .cat-pill:nth-child(4) { animation-delay:.2s; }
    .cat-pill:nth-child(5) { animation-delay:.25s; }
    @keyframes fadeInScale {
      0% { opacity:0; transform:scale(.85); }
      100% { opacity:1; transform:scale(1); }
    }
    .cat-pill:hover {
      border-color:var(--accent-light);
      color:var(--text);
      transform:translateY(-1px);
    }
    .cat-pill.on {
      background:var(--accent);
      color:#fff;
      border-color:var(--accent);
      box-shadow:0 4px 16px rgba(26,60,94,.2);
    }
    .cat-pill:active { transform:scale(0.97); }

    /* ===== SECTION TITLE ===== */
    .sec-title { font-size:22px; font-weight:700; color:var(--text); margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .sec-title i { color:var(--accent); font-size:20px; }

    /* ===== PRODUCT GRID ===== */
    .prod-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; padding:0 0 36px; }
    .prod-card {
      background:var(--bg-card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
      display:flex;
      flex-direction:column;
      cursor:pointer;
    }
    .prod-card:hover {
      transform:translateY(-6px);
      box-shadow:0 16px 48px rgba(0,0,0,.08), 0 0 0 1px rgba(26,60,94,.06);
      border-color:rgba(26,60,94,.12);
    }
    .prod-img-wrap { position:relative; overflow:hidden; background:var(--bg); }
    .prod-img-wrap img {
      width:100%;
      aspect-ratio:4/3;
      object-fit:cover;
      display:block;
      transition:transform .6s cubic-bezier(.22,1,.36,1);
    }
    .prod-card:hover .prod-img-wrap img { transform:scale(1.05); }
    .prod-img-wrap::after {
      content:''; position:absolute; inset:0;
      background:linear-gradient(180deg, transparent 50%, rgba(0,0,0,.12) 100%);
      opacity:0; transition:opacity .4s; pointer-events:none;
    }
    .prod-card:hover .prod-img-wrap::after { opacity:1; }
    .prod-badge-wrap { position:absolute; top:10px; left:10px; display:flex; flex-direction:column; gap:4px; }
    .prod-badge-offer {
      background:#ef4444;
      color:#fff;
      font-size:10px;
      font-weight:800;
      padding:3px 10px;
      border-radius:6px;
      box-shadow:0 2px 12px rgba(239,68,68,.2);
      animation:badgeBounce .5s cubic-bezier(.22,1,.36,1) forwards;
    }
    .prod-badge-promo {
      background:var(--accent-glow);
      color:#fff;
      font-size:10px;
      font-weight:800;
      padding:3px 10px;
      border-radius:6px;
      animation:badgeBounce .5s .1s cubic-bezier(.22,1,.36,1) forwards;
    }
    .prod-body { padding:10px 12px 12px; display:flex; flex-direction:column; flex:1; }
    .prod-name {
      font-family:var(--font-heading);
      font-size:14px;
      font-weight:600;
      margin-bottom:3px;
      line-height:1.25;
      color:var(--text);
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
    .prod-desc { font-size:12px; color:var(--text-secondary); margin-bottom:6px; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; opacity:.7; }
    .prod-prices { display:flex; align-items:baseline; flex-wrap:wrap; gap:4px 8px; margin-bottom:12px; margin-top:auto; }
    .prod-price { font-family:var(--font-heading); font-size:1.1rem; font-weight:700; color:var(--accent); overflow-wrap:anywhere; }
    .prod-old { font-size:12px; color:var(--text-secondary); text-decoration:line-through; opacity:.5; overflow-wrap:anywhere; }
    .load-more-btn { display:inline-flex; align-items:center; gap:8px; padding:13px 30px; background:var(--accent); color:#fff; border:none; border-radius:999px; font-size:13px; font-weight:800; cursor:pointer; box-shadow:0 6px 20px var(--accent-glow); transition:transform .2s cubic-bezier(.22,1,.36,1), box-shadow .2s, background .2s; }
    .load-more-btn:hover { transform:translateY(-2px); box-shadow:0 10px 28px var(--accent-glow); }
    .load-more-btn:active { transform:scale(.97); }
    .load-more-btn i { font-size:16px; }
    .prod-promo-strip {
      display:flex;
      align-items:center;
      gap:5px;
      margin-top:6px;
      padding:5px 8px;
      border-radius:7px;
      font-size:11px;
      font-weight:700;
      background:linear-gradient(135deg,rgba(239,68,68,.12),rgba(255,87,34,.14));
      color:#dc2626;
      border:1px dashed rgba(239,68,68,.35);
      line-height:1.3;
    }
    .prod-promo-strip i { font-size:11px; }
    .prod-btn {
      display:flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      width:100%;
      padding:8px;
      background:var(--accent);
      color:#fff;
      border:none;
      border-radius:10px;
      font-weight:700;
      font-size:12px;
      cursor:pointer;
      transition:all .25s cubic-bezier(.22,1,.36,1);
      position:relative;
      overflow:hidden;
    }
    .prod-btn:hover {
      background:var(--accent-light);
      transform:translateY(-2px);
      box-shadow:0 6px 20px rgba(26,60,94,.2);
    }
    .prod-btn:active { transform:scale(.97); }
    .prod-btn i { font-size:14px; }
    .prod-btn.added { background:#16a34a; }
    .prod-btn::after {
      content:''; position:absolute; top:50%; left:50%;
      width:0; height:0; border-radius:50%;
      background:rgba(255,255,255,.25);
      transform:translate(-50%,-50%);
      transition:width .5s, height .5s;
    }
    .prod-btn:active::after { width:200px; height:200px; }
    .empty { grid-column:1/-1; text-align:center; padding:48px 16px; color:var(--text-secondary); font-size:14px; }

    /* ===== GALLERY ===== */
    .gallery { padding:20px 0 28px; }
    .gal-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .gal-grid img { width:100%; aspect-ratio:1; object-fit:cover; border-radius:var(--radius); cursor:pointer; transition:transform .35s cubic-bezier(.22,1,.36,1); border:1px solid var(--border); }
    .gal-grid img:hover { transform:scale(1.03); }

    /* ===== CONTACT FORM ===== */
    .contact-section { padding:36px 0; }
    .contact-form-wrap { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:32px; margin:0 auto; box-shadow:var(--shadow); transition:all .6s cubic-bezier(.22,1,.36,1); }
    .contact-form-wrap h2 { font-size:24px; margin-bottom:4px; }
    .contact-sub { font-size:14px; color:var(--text-secondary); margin-bottom:20px; }
    .cf-row { display:flex; gap:12px; margin-bottom:12px; }
    .cf-input {
      flex:1;
      padding:11px 14px;
      border:1px solid var(--border);
      border-radius:var(--radius);
      font-size:14px;
      outline:none;
      font-family:var(--font-body);
      background:var(--bg);
      color:var(--text);
      width:100%;
      transition:border-color .2s ease, box-shadow .2s ease;
    }
    .cf-input::placeholder { color:var(--text-secondary); opacity:.6; }
    .cf-input:focus {
      border-color:var(--accent-light);
      box-shadow:0 0 0 3px rgba(26,60,94,.06);
    }
    .cf-textarea { resize:vertical; min-height:80px; width:100%; }
    .cf-submit {
      width:100%;
      padding:12px 24px;
      background:var(--accent);
      color:#fff;
      border:none;
      border-radius:var(--radius);
      font-weight:700;
      font-size:14px;
      cursor:pointer;
      transition:all .25s cubic-bezier(.22,1,.36,1);
      margin-top:6px;
      box-shadow:0 4px 16px rgba(26,60,94,.15);
    }
    .cf-submit:hover {
      background:var(--accent-light);
      transform:translateY(-2px);
      box-shadow:0 8px 24px rgba(26,60,94,.2);
    }
    .cf-submit:active { transform:scale(0.97); }

    /* ===== SPONSORED ===== */
    .sponsored-section { border-top:1px solid var(--border); padding:32px 0 40px; }
    .sponsored-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-secondary); opacity:.5; margin-bottom:12px; }
    .sponsored-ver-todos { background:var(--accent); color:#fff; border:none; border-radius:99px; padding:7px 14px; font-size:11px; font-weight:800; cursor:pointer; white-space:nowrap; transition:transform .15s, background .2s; }
    .sponsored-ver-todos:hover { background:var(--accent-light); transform:translateY(-1px); }
    .ofertas-track.sponsored-grid { flex-wrap:wrap; overflow-x:visible; }
    .ofertas-track.sponsored-grid .oferta-card { flex:1 1 calc(25% - 14px); min-width:200px; max-width:100%; }

    /* ===== FOOTER ===== */
    .ftr { background:var(--accent); color:var(--ftr-fg, #fff); padding:40px 24px 24px; }
    .ftr-inner { margin:0 auto; }
    .ftr-top { display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:28px; margin-bottom:28px; }
    .ftr h3 { margin-bottom:10px; color:var(--ftr-head, var(--accent-glow)); font-size:16px; }
    .ftr p,.ftr li { color:var(--ftr-soft, rgba(255,255,255,.7)); font-size:.85rem; line-height:1.6; }
    .ftr ul { list-style:none; }
    .ftr li { margin-bottom:4px; }
    .ftr-copy { text-align:center; border-top:1px solid var(--ftr-chip-line, rgba(255,255,255,.15)); padding-top:16px; font-size:.78rem; color:var(--ftr-soft, rgba(255,255,255,.4)); }
    .ftr-redes { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
    .ftr-redes a {
      display:flex;
      align-items:center;
      justify-content:center;
      width:44px;
      height:44px;
      border-radius:min(var(--radius), 14px);
      background:var(--ftr-chip, rgba(255,255,255,.12));
      border:1px solid var(--ftr-chip-line, rgba(255,255,255,.28));
      color:var(--ftr-fg, #fff);
      font-size:18px;
      text-decoration:none;
      transition:transform .2s cubic-bezier(.22,1,.36,1), background-color .2s cubic-bezier(.22,1,.36,1), color .2s cubic-bezier(.22,1,.36,1);
    }
    .ftr-redes a:hover { background:var(--ftr-fg, #fff); color:var(--accent); transform:translateY(-2px); }
    .ftr-redes a:focus-visible { outline:2px solid var(--ftr-fg, #fff); outline-offset:3px; }
    .ftr-redes a:active { transform:scale(0.95); }

    /* ===== SECCIONES DE CONTENIDO (Conócenos, Opiniones, Cómo pedir, Envíos y pago) =====
       Ritmo: cada sección respira (padding fluido), se alterna una banda tenue
       para separarlas sin cajas pesadas, y un mismo encabezado editorial las une.
       Todo sale de los tokens de la apariencia elegida. */
    .xs-sec { padding:clamp(44px,7vw,84px) 0; }
    .xs-band { background:color-mix(in srgb, var(--accent) 6%, var(--bg)); border-block:1px solid var(--border); }
    .xs-in { max-width:1080px; margin:0 auto; padding:0 24px; }
    .xs-head { text-align:center; max-width:640px; margin:0 auto clamp(28px,4vw,44px); }
    .xs-eyebrow { display:inline-flex; align-items:center; gap:12px; font-size:.72rem; font-weight:700; letter-spacing:.24em; text-transform:uppercase; color:var(--accent); }
    .xs-eyebrow::before, .xs-eyebrow::after { content:""; width:28px; height:1px; background:currentColor; opacity:.55; }
    .xs-title { margin:10px 0 0; font-family:var(--font-heading); font-size:clamp(1.65rem,3.2vw,2.35rem); font-weight:600; line-height:1.18; color:var(--text); }
    .xs-sub { margin:12px auto 0; color:var(--text-secondary); font-size:.98rem; line-height:1.65; }
    .xs-orn { display:flex; align-items:center; justify-content:center; gap:10px; margin:26px 0 0; color:var(--accent); opacity:.7; }
    .xs-orn::before, .xs-orn::after { content:""; width:44px; height:1px; background:currentColor; opacity:.6; }
    .xs-orn i { font-size:.6rem; }

    /* Conócenos: foto + texto (sin foto, columna centrada) */
    .xs-about { display:grid; grid-template-columns:5fr 6fr; gap:clamp(32px,6vw,72px); align-items:center; }
    .xs-about.no-photo { grid-template-columns:1fr; max-width:720px; margin:0 auto; text-align:center; }
    .xs-photo { position:relative; margin:0 14px 14px 0; }
    .xs-photo::before { content:""; position:absolute; inset:14px -14px -14px 14px; border:1px solid var(--accent); border-radius:min(var(--radius),26px); opacity:.55; }
    .xs-photo img { position:relative; display:block; width:100%; aspect-ratio:4/5; object-fit:cover; border-radius:min(var(--radius),26px); box-shadow:var(--shadow); background:var(--bg-card); }
    .xs-about-text .xs-head { text-align:left; margin:0 0 22px; }
    .xs-about-text .xs-eyebrow::before { display:none; }
    .xs-about.no-photo .xs-about-text .xs-head { text-align:center; margin:0 auto 22px; }
    .xs-about.no-photo .xs-about-text .xs-eyebrow::before { display:block; }
    .xs-prose { margin:0; font-size:1.06rem; line-height:1.9; color:var(--text); opacity:.88; white-space:pre-line; }
    .xs-about-text .xs-orn { justify-content:flex-start; }
    .xs-about-text .xs-orn::before { display:none; }
    .xs-about.no-photo .xs-orn { justify-content:center; }
    .xs-about.no-photo .xs-orn::before { display:block; }

    /* Opiniones */
    .xs-quotes { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr)); gap:20px; }
    .xs-quotes.n1 { grid-template-columns:minmax(0,640px); justify-content:center; }
    .xs-quotes.n2 { grid-template-columns:repeat(2,minmax(0,1fr)); max-width:820px; margin:0 auto; }
    .xs-quote { position:relative; display:flex; flex-direction:column; margin:0; padding:34px 28px 26px; background:var(--bg-card); border:1px solid var(--border); border-radius:min(var(--radius),20px); box-shadow:var(--shadow); }
    .xs-quote::before { content:"\201C"; position:absolute; top:8px; left:22px; font-family:Georgia,"Times New Roman",serif; font-size:4.6rem; line-height:1; color:var(--accent); opacity:.4; }
    .xs-stars { color:var(--accent); font-size:.9rem; letter-spacing:3px; margin:6px 0 14px; }
    .xs-quote blockquote { margin:0 0 22px; flex:1; font-size:1rem; line-height:1.75; color:var(--text); opacity:.9; }
    .xs-who { display:flex; align-items:center; gap:12px; padding-top:18px; border-top:1px solid var(--border); }
    .xs-av { flex:none; width:38px; height:38px; border-radius:50%; background:var(--accent); color:var(--soc-on-accent,#fff); display:flex; align-items:center; justify-content:center; font-family:var(--font-heading); font-weight:700; font-size:1rem; }
    .xs-who b { font-size:.92rem; color:var(--text); }

    /* Cómo pedir */
    .xs-steps { position:relative; display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }
    .xs-steps::before { content:""; position:absolute; top:33px; left:16.6%; right:16.6%; border-top:1px dashed color-mix(in srgb, var(--accent) 55%, transparent); }
    .xs-step { position:relative; text-align:center; padding:0 6px; }
    .xs-step-ic { position:relative; width:66px; height:66px; margin:0 auto 18px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:var(--accent); background:var(--bg); border:1px solid color-mix(in srgb, var(--accent) 55%, transparent); box-shadow:0 0 0 7px color-mix(in srgb, var(--accent) 8%, var(--bg)); }
    .xs-band .xs-step-ic { background:color-mix(in srgb, var(--accent) 6%, var(--bg)); }
    .xs-step-n { position:absolute; top:-4px; right:-6px; min-width:24px; height:24px; padding:0 6px; border-radius:99px; background:var(--accent); color:var(--soc-on-accent,#fff); font-family:var(--font-body); font-size:.72rem; font-weight:800; display:flex; align-items:center; justify-content:center; }
    .xs-step h3 { margin:0 0 6px; font-family:var(--font-heading); font-size:1.12rem; font-weight:600; color:var(--text); }
    .xs-step p { margin:0 auto; max-width:260px; font-size:.92rem; line-height:1.65; color:var(--text-secondary); }

    /* Envíos y formas de pago */
    .xs-ship { display:grid; grid-template-columns:1fr 1fr; background:var(--bg-card); border:1px solid var(--border); border-radius:min(var(--radius),22px); box-shadow:var(--shadow); overflow:hidden; }
    .xs-ship.solo { grid-template-columns:minmax(0,1fr); max-width:640px; margin:0 auto; }
    .xs-ship-col { padding:clamp(24px,4vw,40px); }
    .xs-ship-col + .xs-ship-col { border-left:1px solid var(--border); }
    .xs-ship-col h3 { display:flex; align-items:center; gap:12px; margin:0 0 20px; font-family:var(--font-heading); font-size:1.2rem; font-weight:600; color:var(--text); }
    .xs-ship-col h3 i { display:flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:min(var(--radius),12px); background:color-mix(in srgb, var(--accent) 12%, transparent); color:var(--accent); font-size:1.1rem; }
    .xs-list { list-style:none; margin:0; padding:0; display:grid; gap:14px; }
    .xs-list li { display:flex; gap:12px; align-items:flex-start; font-size:.98rem; line-height:1.6; color:var(--text); opacity:.9; }
    .xs-list li i { flex:none; margin-top:3px; color:var(--accent); }
    .xs-chips { display:flex; flex-wrap:wrap; gap:10px; }
    .xs-chip { display:inline-flex; align-items:center; gap:9px; padding:10px 16px; border-radius:999px; background:var(--bg); border:1px solid var(--border); color:var(--text); font-size:.9rem; font-weight:600; }
    .xs-chip i { color:var(--accent); font-size:1rem; }
    .xs-note { display:flex; gap:10px; margin:20px 0 0; padding:14px 16px; border-radius:min(var(--radius),14px); background:color-mix(in srgb, var(--accent) 8%, transparent); color:var(--text); font-size:.92rem; line-height:1.6; }
    .xs-note i { flex:none; margin-top:2px; color:var(--accent); }
    .xs-strip { margin:44px 0 6px; }

    @media (min-width:601px) and (max-width:980px) { .xs-quotes.n3 .xs-quote:last-child:nth-child(odd) { grid-column:1 / -1; } }
    @media (max-width:820px) {
      .xs-about { grid-template-columns:1fr; gap:36px; }
      .xs-photo { max-width:440px; margin-inline:auto 14px; }
      .xs-photo img { aspect-ratio:5/4; }
      .xs-quotes.n2 { grid-template-columns:1fr; }
      .xs-steps { grid-template-columns:1fr; gap:26px; }
      .xs-steps::before { display:none; }
      .xs-step { display:grid; grid-template-columns:66px 1fr; gap:0 18px; text-align:left; align-items:center; padding:0; }
      .xs-step-ic { margin:0; grid-row:1 / span 2; }
      .xs-step p { margin:0; max-width:none; }
      .xs-ship { grid-template-columns:1fr; }
      .xs-ship-col + .xs-ship-col { border-left:0; border-top:1px solid var(--border); }
    }



    /* ===== LIGHTBOX ===== */
    .lb { display:none; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,.92); flex-direction:column; align-items:center; justify-content:center; }
    .lb img { max-width:92vw; max-height:80vh; object-fit:contain; border-radius:var(--radius); }
    .lb-close {
      position:absolute;
      top:16px;
      right:20px;
      background:none;
      border:none;
      color:#fff;
      font-size:28px;
      cursor:pointer;
      transition:transform .2s ease;
    }
    .lb-close:hover { transform:scale(1.1); }
    .lb-nav {
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      background:rgba(255,255,255,.15);
      border:none;
      color:#fff;
      font-size:24px;
      width:44px;
      height:44px;
      border-radius:50%;
      cursor:pointer;
      display:flex;
      align-items:center;
      justify-content:center;
      transition:all .2s ease;
    }
    .lb-nav:hover { background:rgba(255,255,255,.3); transform:translateY(-50%) scale(1.05); }
    .lb-counter { color:rgba(255,255,255,.7); font-size:14px; margin-top:12px; }

    /* ===== MAIN LAYOUT ===== */
    .main-layout { background:var(--bg); }
    .main-inner { display:flex; gap:28px; padding-top:24px; padding-bottom:28px; align-items:flex-start; }
    .filter-sidebar { flex:0 0 260px; position:sticky; top:64px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:20px; box-shadow:var(--shadow); }
    .filter-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
    .filter-header h3 { font-size:16px; font-weight:700; display:flex; align-items:center; gap:6px; }
    .filter-close-movil { display:none; background:none; border:none; font-size:18px; cursor:pointer; color:var(--text-secondary); }
    .filter-group { margin-bottom:16px; }
    .filter-label { display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); margin-bottom:6px; }
    .filter-search-wrap { position:relative; }
    .filter-search-wrap i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-secondary); font-size:14px; }
    .filter-search { width:100%; padding:10px 12px 10px 36px; border:1px solid var(--border); border-radius:var(--radius); font-size:13px; outline:none; background:var(--bg); color:var(--text); }
    .filter-search::placeholder { color:var(--text-secondary); opacity:.5; }
    .filter-search:focus { border-color:var(--accent-light); box-shadow:0 0 0 3px rgba(26,60,94,.06); }
    .filter-price-row { display:flex; align-items:center; gap:8px; }
    .filter-input { flex:1 1 0; min-width:0; width:100%; padding:9px 10px; border:1px solid var(--border); border-radius:var(--radius); font-size:13px; outline:none; background:var(--bg); color:var(--text); }
    .filter-input::placeholder { color:var(--text-secondary); opacity:.5; }
    .filter-input:focus { border-color:var(--accent-light); }
    .filter-dash { color:var(--text-secondary); font-size:13px; }
    .filter-cats { display:flex; flex-direction:column; gap:3px; }
    .filter-cat { display:flex; align-items:center; justify-content:space-between; padding:8px 12px; border:1px solid transparent; border-radius:var(--radius); font-size:13px; font-weight:500; cursor:pointer; background:none; color:var(--text-secondary); text-align:left; }
    .filter-cat:hover { background:rgba(26,60,94,.04); color:var(--text); }
    .filter-cat.on { background:var(--accent); color:#fff; border-color:var(--accent); }
    .filter-cat span { font-size:11px; font-weight:700; opacity:.5; }
    .filter-attrs { display:flex; flex-wrap:wrap; gap:6px; }
    .filter-attr { display:inline-flex; align-items:center; gap:6px; min-height:36px; padding:0 12px; border:1px solid var(--border); border-radius:min(999px, calc(var(--radius) * 2.4)); background:var(--bg-card); color:var(--text); font-size:13px; font-weight:600; cursor:pointer; transition:background .2s, border-color .2s, color .2s; }
    .filter-attr:hover { border-color:var(--accent); }
    .filter-attr span { font-size:11px; font-weight:700; opacity:.5; }
    .filter-attr.on { background:var(--accent); color:var(--soc-on-accent, #fff); border-color:var(--accent); }
    .filter-attr.on span { opacity:.75; }
    .filter-cat.on span { opacity:.7; }
    .filter-range-btns { display:flex; flex-wrap:wrap; gap:6px; }
    .filter-range { padding:6px 12px; border:1px solid var(--border); border-radius:var(--radius); font-size:12px; font-weight:600; cursor:pointer; background:var(--bg-card); color:var(--text-secondary); transition:all .2s; }
    .filter-range:hover { border-color:var(--accent-light); color:var(--accent); }
    .filter-range.active { background:var(--accent); color:#fff; border-color:var(--accent); }
    .filter-clear { width:100%; padding:9px; border:1px solid var(--border); border-radius:var(--radius); font-size:12px; font-weight:600; cursor:pointer; background:none; color:var(--text-secondary); transition:all .2s; margin-top:10px; }
    .filter-clear:hover { border-color:#ef4444; color:#ef4444; }
    .filter-fab { display:none; position:fixed; left:12px; bottom:80px; z-index:100; background:var(--accent); color:var(--soc-on-accent,#fff); border:1px solid color-mix(in srgb, var(--accent) 70%, var(--text)); border-radius:min(999px, calc(var(--radius) * 2.4)); padding:12px 20px; font-size:13px; font-weight:700; cursor:pointer; box-shadow:0 6px 18px color-mix(in srgb, var(--accent) 32%, transparent); font-family:var(--font-body); transition:transform .18s cubic-bezier(.22,1,.36,1), background .2s; }
    .filter-fab:hover { background:var(--accent-light); }
    .filter-fab:active { transform:scale(.94); }
    .main-content { flex:1; min-width:0; }

    /* ===== ANIMATIONS ===== */
    /* ===== RESPONSIVE ===== */
    @media(max-width:900px) {
      .filter-sidebar { position:fixed; left:0; top:0; bottom:0; z-index:200; border-radius:0; width:300px; transform:translateX(-100%); transition:transform .3s cubic-bezier(.22,1,.36,1); overflow-y:auto; }
      .filter-sidebar.sidebar-open { transform:translateX(0); box-shadow:4px 0 32px rgba(0,0,0,.15); }
      .filter-close-movil { display:block; }
      .filter-fab { display:flex; align-items:center; gap:6px; }
      .main-inner { flex-direction:column; gap:0; padding-top:16px; }
      .cf-row { flex-direction:column; }
      /* El botón de filtros y el carrito quedan fijos abajo (fixed): sin este
         espacio, la última fila de productos queda tapada y sus botones
         "Agregar"/"Ver" no se pueden tocar al hacer scroll hasta el final. */
      .main-content { padding-bottom:104px; }
    }
    @media(max-width:768px) {
      .hero { min-height:240px; }
      .hero-name { font-size:1.6rem; }
      .hero-logo { width:56px; height:56px; }
      .prod-grid { grid-template-columns:repeat(3,1fr); gap:12px; }
      .ftr-top { grid-template-columns:1fr; gap:20px; }
      .gal-grid { grid-template-columns:repeat(2,1fr); }
      .oferta-card { flex:0 0 180px; }
    }
    @media(max-width:480px) {
      .hero { min-height:200px; }
      .hero-name { font-size:1.3rem; }
      .prod-grid { grid-template-columns:repeat(2,1fr); gap:8px; }
      .prod-body { padding:10px 10px 12px; }
      .prod-name { font-size:14px; }
      .prod-price { font-size:1.1rem; }
      .oferta-card { flex:0 0 160px; }
      .contact-form-wrap { padding:20px; }
      .filter-price-row { flex-direction:column; align-items:stretch; }
      .filter-dash { display:none; }
    }
    /* ===== AJUSTES DE ALINEACIÓN (tiras, contacto, footer, logos, opiniones en móvil) =====
       "body" delante para ganarle en especificidad a catalog-refine.css. */

    /* Tiras horizontales (ofertas, recién llegados, más vendidos, "también te puede interesar"):
       arrancan y terminan dentro del mismo ancho que el resto del contenido, no de borde a borde. */
    body .ofertas-track-wrap { max-width:1480px; margin:0 auto; }
    body .ofertas-track { padding-inline:24px; scroll-padding-inline:24px; }
    body .sponsored-section .ofertas-header { margin-bottom:14px; }

    /* Logos completos: antes se recortaban a un cuadrado (object-fit:cover). */
    body .hdr-logo { width:auto; height:34px; max-width:104px; object-fit:contain; border-radius:8px; }
    body .hero-logo, body .hero.has-banner .hero-logo { width:auto; max-width:min(220px,70vw); object-fit:contain; padding:5px; box-sizing:border-box; }
    body .hero-logo { height:80px; }
    body .hero.has-banner .hero-logo { height:64px; }

    /* Contacto: tarjeta compacta y centrada, con el mismo encabezado que las demás secciones. */
    body .contact-form-wrap { max-width:680px; padding:28px 30px; }
    .contact-form { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .contact-form .cf-input { margin:0 !important; width:100%; box-sizing:border-box; }
    .contact-form .cf-textarea, .contact-form .cf-submit { grid-column:1 / -1; }
    .contact-form .cf-textarea { min-height:96px; resize:vertical; }
    /* Select nativo con el diseño de la apariencia: mismo fondo, borde, radio y fuente
       que los demás campos, flecha del color del texto y lista con los colores del tema. */
    .contact-form select.cf-input {
      appearance:none; -webkit-appearance:none; cursor:pointer; padding-right:40px;
      background-color:var(--bg);
      background-image:linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
      background-position:calc(100% - 21px) 50%, calc(100% - 15px) 50%;
      background-size:6px 6px, 6px 6px; background-repeat:no-repeat;
    }
    .contact-form select.cf-input option { background:var(--bg-card); color:var(--text); }

    /* Footer: iconos en columna fija para que el texto alinee, aunque salte de línea. */
    .ftr li { display:flex; gap:10px; align-items:flex-start; }
    .ftr li i { flex:none; width:18px; margin:3px 0 0 !important; text-align:center; }

    /* Carrusel de opiniones: solo en móvil */
    .xs-dots { display:none; }

    @media (max-width:700px) {
      body .ofertas-track { padding-inline:18px; scroll-padding-inline:18px; gap:12px; }
      /* mismo ancho que una columna de la cuadrícula de productos (2 por fila) */
      body .oferta-card { flex:0 0 calc((100vw - 36px - 12px) / 2); }
      body .hero-logo { height:60px; }
      body .hero.has-banner .hero-logo { height:56px; }

      /* Formas de pago alineadas en cuadrícula */
      .xs-chips { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
      .xs-chip { justify-content:flex-start; border-radius:14px; padding:12px 14px; }

      /* Opiniones: carrusel con scroll-snap */
      .xs-quotes, .xs-quotes.n1, .xs-quotes.n2 { display:flex; grid-template-columns:none; max-width:none; margin:0 -24px; padding:4px 24px 10px; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-padding-inline:24px; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
      .xs-quotes::-webkit-scrollbar { display:none; }
      .xs-quotes .xs-quote { flex:0 0 84%; scroll-snap-align:start; }
      .xs-quotes.n1 .xs-quote { flex-basis:100%; }
      .xs-dots { display:flex; justify-content:center; gap:8px; margin-top:14px; }
      .xs-dots button { width:8px; height:8px; padding:0; border:0; border-radius:99px; background:var(--accent); opacity:.28; cursor:pointer; transition:opacity .2s, width .2s; }
      .xs-dots button.on { opacity:1; width:22px; }

      /* Contacto en una columna */
      .contact-form { grid-template-columns:1fr; }
      body .contact-form-wrap { padding:22px 18px; }

      /* Footer: bloques separados y espacio para que el carrito flotante no tape el copyright */
      .ftr-top > div + div { border-top:1px solid var(--ftr-chip-line, rgba(255,255,255,.2)); padding-top:20px; }
      .ftr { padding-bottom:88px; }
    }

    /* ===== EXTRAS (sin duplicar lo que ya vive en premium-catalog.css) ===== */

    /* Scroll fade-in: solo para las secciones que lo usan explícitamente
       (ofertas, colección filtrada, galería, contacto) — ver IntersectionObserver más abajo. */
    .anim-in.delay-1 { transition-delay:.08s; }
    .anim-in.delay-2 { transition-delay:.16s; }
    .anim-in.delay-3 { transition-delay:.24s; }
    .anim-in.delay-4 { transition-delay:.32s; }

    .prod-img-wrap { position:relative; overflow:hidden; background:var(--bg); }
    .prod-share-btn {
      position:absolute; top:10px; right:10px;
      width:32px; height:32px; border-radius:50%;
      background:rgba(255,255,255,.92); border:1px solid var(--border);
      color:var(--text-secondary); font-size:13px; cursor:pointer;
      display:flex; align-items:center; justify-content:center;
      opacity:0; transform:scale(.8);
      transition:opacity .2s var(--ease-premium,cubic-bezier(.16,1,.3,1)), transform .2s var(--ease-premium,cubic-bezier(.16,1,.3,1)), background-color .2s, color .2s, border-color .2s;
      box-shadow:0 2px 8px rgba(0,0,0,.08); z-index:5;
    }
    .prod-card:hover .prod-share-btn, .prod-card:focus-within .prod-share-btn { opacity:1; transform:scale(1); }
    .prod-view-btn { transition:border-color .2s var(--ease-premium,cubic-bezier(.16,1,.3,1)), color .2s var(--ease-premium,cubic-bezier(.16,1,.3,1)), transform .2s var(--ease-premium,cubic-bezier(.16,1,.3,1)); }
    .prod-view-btn:hover { border-color:var(--accent,#1a3c5e); color:var(--accent,#1a3c5e); transform:translateY(-1px); }
    .prod-share-btn:hover { background:var(--accent); color:#fff; border-color:var(--accent); }

    .prod-img-wrap::after {
      content:''; position:absolute; inset:0;
      background:linear-gradient(180deg, transparent 50%, rgba(0,0,0,.12) 100%);
      opacity:0; transition:opacity .3s; pointer-events:none;
    }
    .prod-card:hover .prod-img-wrap::after { opacity:1; }
    .prod-card:hover .prod-img-wrap img { transform:scale(1.06); }

    .oferta-img-wrap::after {
      content:''; position:absolute; inset:0;
      background:radial-gradient(circle at 30% 40%, rgba(255,255,255,.15) 0%, transparent 60%);
      opacity:0; transition:opacity .3s; pointer-events:none;
    }
    .oferta-card:hover .oferta-img-wrap::after { opacity:1; }
    .oferta-card:hover .oferta-img-wrap img { transform:scale(1.06); }

    .gal-grid img { transition:transform .3s var(--ease-premium,cubic-bezier(.16,1,.3,1)), box-shadow .3s; }
    .gal-grid img:hover { transform:scale(1.04); box-shadow:0 12px 40px rgba(0,0,0,.15); z-index:2; }

    /* Sección: aparece solo la primera vez que entra al viewport */
    .sec-title { transform:translateX(-16px); opacity:0; transition:transform .35s var(--ease-premium,cubic-bezier(.16,1,.3,1)), opacity .35s var(--ease-premium,cubic-bezier(.16,1,.3,1)); }
    .sec-title.visible { transform:none; opacity:1; }

    .contact-form-wrap { opacity:0; transform:translateY(20px); }
    .contact-form-wrap.visible { opacity:1; transform:none; transition:opacity .4s var(--ease-premium,cubic-bezier(.16,1,.3,1)), transform .4s var(--ease-premium,cubic-bezier(.16,1,.3,1)); }

    /* Imagen expandida (click para ver grande) */
    .img-expand-overlay {
      display:none; position:fixed; inset:0; z-index:99999;
      background:rgba(0,0,0,.88); backdrop-filter:blur(8px);
      flex-direction:column; align-items:center; justify-content:center;
      cursor:zoom-out; opacity:0; transition:opacity .3s;
    }
    .img-expand-overlay.show { display:flex; opacity:1; }
    .img-expand-overlay img {
      max-width:90vw; max-height:85vh; object-fit:contain;
      border-radius:12px; box-shadow:0 20px 80px rgba(0,0,0,.5);
      transform:scale(.9); transition:transform .4s cubic-bezier(.22,1,.36,1);
    }
    .img-expand-overlay.show img { transform:scale(1); }
    .img-expand-overlay .expand-close {
      position:absolute; top:20px; right:24px;
      background:rgba(255,255,255,.15); border:none; color:#fff;
      width:40px; height:40px; border-radius:50%; font-size:20px;
      cursor:pointer; display:flex; align-items:center; justify-content:center;
      transition:background .2s;
    }
    .img-expand-overlay .expand-close:hover { background:rgba(255,255,255,.3); }
    .img-expand-overlay .expand-caption {
      color:rgba(255,255,255,.8); font-size:14px; margin-top:14px;
      text-align:center; max-width:600px;
    }

    <%- theme.css || '' %>

    /* ===== ESTILO SELECCIONADO: paleta + tipografía dinámica (ver CAT_DESIGNS en server.js) ===== */
    <% if (typeof catDesignTokens !== 'undefined' && catDesignTokens) { %>
    :root {
      --bg: <%- catDesignTokens.bg %>;
      --bg-card: <%- catDesignTokens.card %>;
      --text: <%- catDesignTokens.text %>;
      --text-secondary: <%- catDesignTokens.textSec %>;
      --accent: <%- catDesignTokens.accent %>;
      --accent-light: <%- catDesignTokens.accentLight %>;
      --accent-glow: <%- catDesignTokens.accentGlow %>;
      --border: <%- catDesignTokens.border %>;
      --shadow: <%- catDesignTokens.shadow %>;
      --radius: <%- catDesignTokens.radius %>px;
      --font-heading: <%- catDesignTokens.font.heading %>;
      --font-body: <%- catDesignTokens.font.body %>;
    }
    <% } %>
    :root {
      color-scheme: <%- _bgDark ? 'dark' : 'light' %>;
      --soc-on-accent: <%- _onAccent %>;
      --ftr-fg: <%- _onAccent %>;
      --ftr-head: <%- _ftrHead %>;
      --ftr-soft: <%- _ftrOnDark ? 'rgba(255,255,255,.78)' : 'rgba(17,17,17,.78)' %>;
      --ftr-chip: <%- _ftrOnDark ? 'rgba(255,255,255,.14)' : 'rgba(17,17,17,.10)' %>;
      --ftr-chip-line: <%- _ftrOnDark ? 'rgba(255,255,255,.3)' : 'rgba(17,17,17,.28)' %>;
    }

    /* ===== ACCESIBILIDAD: respetar "reducir movimiento" ===== */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      .anim-in, .sec-title, .contact-form-wrap { opacity:1 !important; transform:none !important; }
      *, *::before, *::after {
        animation-duration:.001ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.001ms !important;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/catalog-refine.css?v=20260917c">
  <link rel="stylesheet" href="/css/catalog-motion.css?v=20260919a">
