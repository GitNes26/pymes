<!-- ============================================================
EDITOR DE IMAGEN — recorte + rotar (compartido entre productos, config y diseno)
Incluir con: EJS include de partials/img-editor pasando upUrl (endpoint de subida) y z (z-index).
API globales compatibles:
  abrirEditorImagen(src, onDone?, onCancel?)  — o pasar un contenedor [data-url] con img
  cerrarEditorImagen() / aplicarEditorImagen()
Hooks opcionales de la página (definir antes de abrir):
  window.imgeUploaded(url)            → tras subir la imagen editada con éxito
  window.imgeContainerApplied(el,url) → tras aplicar sobre un contenedor [data-url]
============================================================ -->
<style>
  .imge-ov{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:14px;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);opacity:0;pointer-events:none;transition:opacity .18s ease;}
  .imge-ov.open{opacity:1;pointer-events:auto;}
  .imge-card{background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(15,23,42,.35);width:100%;max-width:640px;max-height:94vh;display:flex;flex-direction:column;overflow:hidden;font-family:inherit;color:#0f172a;}
  .imge-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #eef1f6;flex-shrink:0;}
  .imge-head .imge-logo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:15px;}
  .imge-head h3{margin:0;font-size:15px;font-weight:800;flex:1;}
  .imge-x{width:30px;height:30px;border:none;border-radius:9px;background:#f1f5f9;color:#64748b;font-size:15px;font-weight:800;cursor:pointer;}
  .imge-x:hover{background:#fee2e2;color:#b91c1c;}
  .imge-body{display:flex;flex-direction:column;min-height:0;overflow-y:auto;}
  .imge-stage{position:relative;min-height:320px;display:flex;align-items:center;justify-content:center;background:#f8fafc;background-image:linear-gradient(45deg,#eef1f6 25%,transparent 25%),linear-gradient(-45deg,#eef1f6 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eef1f6 75%),linear-gradient(-45deg,transparent 75%,#eef1f6 75%);background-size:18px 18px;background-position:0 0,0 9px,9px -9px,-9px 0;overflow:hidden;touch-action:none;}
  .imge-stage canvas{max-width:100%;max-height:52vh;display:block;box-shadow:0 4px 22px rgba(15,23,42,.16);border-radius:8px;background:#fff;cursor:grab;}
  .imge-stage.drag canvas{cursor:grabbing;}
  .imge-cdims{position:absolute;right:10px;bottom:10px;background:rgba(15,23,42,.55);color:#fff;font-size:10px;font-weight:700;padding:4px 8px;border-radius:8px;letter-spacing:.3px;}
  .imge-toolbar{padding:14px 18px;display:flex;flex-direction:column;gap:12px;flex-shrink:0;}
  .imge-row{display:flex;align-items:center;gap:10px;}
  .imge-row .lbl{font-size:11px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;width:64px;flex-shrink:0;}
  .imge-zoom{flex:1;accent-color:#4f46e5;min-width:0;}
  .imge-zoomval{width:40px;text-align:right;font-size:11px;font-weight:800;color:#64748b;flex-shrink:0;}
  .imge-chips{display:flex;flex-wrap:wrap;gap:6px;flex:1;}
  .imge-chip{font-size:11.5px;font-weight:800;color:#475569;background:#fff;border:1px solid #e2e8f0;border-radius:9px;padding:6px 11px;cursor:pointer;transition:all .12s;}
  .imge-chip:hover{border-color:#c7d2fe;}
  .imge-chip.on{background:#4f46e5;border-color:#4f46e5;color:#fff;box-shadow:0 2px 8px rgba(79,70,229,.3);}
  .imge-rotbtn{width:34px;height:34px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#475569;background:#fff;border:1px solid #e2e8f0;border-radius:9px;cursor:pointer;transition:all .12s;}
  .imge-rotbtn:hover{background:#eef2ff;border-color:#c7d2fe;color:#4338ca;}
  .imge-foot{display:flex;gap:10px;padding:12px 16px;border-top:1px solid #eef1f6;flex-shrink:0;background:#fff;}
  .imge-foot button{flex:1;padding:10px;border-radius:10px;font-size:13px;font-weight:800;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#475569;}
  .imge-foot button:hover{border-color:#cbd5e1;background:#f8fafc;}
  .imge-foot .imge-cancel:hover{background:#fef2f2;border-color:#fecaca;color:#b91c1c;}
  .imge-foot .imge-apply{background:#4f46e5;border-color:#4f46e5;color:#fff;}
  .imge-foot .imge-apply:hover{background:#4338ca;}
  .imge-foot .imge-apply:disabled{opacity:.55;cursor:wait;}
  @media (max-width:520px){ .imge-stage{min-height:240px;} .imge-stage canvas{max-height:40vh;} .imge-row .lbl{width:52px;} }
</style>

<div id="imge-ov" class="imge-ov" style="z-index:<%= (typeof z !== 'undefined') ? z : 9000 %>">
  <div class="imge-card" role="dialog" aria-modal="true" aria-label="Editor de imagen">
    <div class="imge-head">
      <div class="imge-logo">🖼️</div>
      <h3>Editar imagen</h3>
      <button type="button" class="imge-x" onclick="imgeClose()" title="Cerrar">✕</button>
    </div>

    <div class="imge-body">
      <div class="imge-stage" id="imge-stage">
        <canvas id="imge-canvas" width="800" height="800"></canvas>
        <span class="imge-cdims" id="imge-dims"></span>
      </div>

      <div class="imge-toolbar">
        <div class="imge-row">
          <span class="lbl">Proporción</span>
          <div class="imge-chips" id="imge-aspects"></div>
        </div>
        <div class="imge-row">
          <span class="lbl">Zoom</span>
          <input type="range" id="imge-zoom" class="imge-zoom" min="1" max="4" step="0.01" value="1">
          <span class="imge-zoomval" id="imge-zoomval">100%</span>
        </div>
        <div class="imge-row">
          <span class="lbl">Girar</span>
          <button type="button" class="imge-rotbtn" onclick="imgeRot90(-1)" title="Girar 90° a la izquierda">⟲</button>
          <button type="button" class="imge-rotbtn" onclick="imgeRot90(1)" title="Girar 90° a la derecha">⟳</button>
        </div>
      </div>
    </div>

    <div class="imge-foot">
      <button type="button" class="imge-cancel" onclick="imgeClose()">Cancelar</button>
      <button type="button" onclick="imgeResetAll()">↺ Restablecer</button>
      <button type="button" class="imge-apply" id="imge-apply" onclick="imgeApply()">✓ Aplicar</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  if (window.__imgeLoaded) return; // evitar doble carga si la página incluye el partial dos veces
  window.__imgeLoaded = true;

  var UP_URL = '<%= (typeof upUrl !== 'undefined') ? upUrl : "" %>';
  var S = {
    img: null, aspect: '1:1',
    zoom: 1, panX: 0, panY: 0, baseScale: 1,
    rotQ: 0,
    outW: 800, outH: 800,
    applying: false,
    cbDone: null, cbCancel: null, container: null
  };

  var ASPECTS = [
    { v: '1:1', w: 1, h: 1 }, { v: '4:5', w: 4, h: 5 }, { v: '3:4', w: 3, h: 4 },
    { v: '4:3', w: 4, h: 3 }, { v: '16:9', w: 16, h: 9 }, { v: 'libre', w: 0, h: 0 }
  ];

  var $ = function (id) { return document.getElementById(id); };

  function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

  function totToast(msg, tipo) {
    try { if (window.mostrarToast) window.mostrarToast(msg, tipo || 'error'); }
    catch (e) { try { alert(msg); } catch (e2) {} }
  }

  function csrf() { try { return (window.__csrfValue && window.__csrfValue()) || ''; } catch (e) { return ''; } }

  function rotation() { return S.rotQ % 360; }

  function bboxOf() {
    var img = S.img, r = rotation() * Math.PI / 180;
    var c = Math.abs(Math.cos(r)), sn = Math.abs(Math.sin(r));
    return { w: img.width * c + img.height * sn, h: img.width * sn + img.height * c };
  }

  function outSize() {
    if (S.aspect === 'libre') {
      var bb = bboxOf();
      var m = Math.max(bb.w, bb.h), k = Math.min(1, 1600 / (m || 1));
      return { W: Math.max(64, Math.round(bb.w * k)), H: Math.max(64, Math.round(bb.h * k)) };
    }
    var a = null;
    for (var i = 0; i < ASPECTS.length; i++) if (ASPECTS[i].v === S.aspect) a = ASPECTS[i];
    if (!a) a = ASPECTS[0];
    var MAX = 1200;
    var W, H;
    if (a.w >= a.h) { W = MAX; H = Math.round(MAX * a.h / a.w); }
    else { H = MAX; W = Math.round(MAX * a.w / a.h); }
    return { W: W, H: H };
  }

  function draw() {
    var canvas = $('imge-canvas'), img = S.img;
    if (!canvas || !img) return;
    var sz = outSize();
    if (canvas.width !== sz.W) canvas.width = sz.W;
    if (canvas.height !== sz.H) canvas.height = sz.H;
    S.outW = sz.W; S.outH = sz.H;
    var ctx = canvas.getContext('2d');
    var bb = bboxOf();
    var scale = Math.max(sz.W / bb.w, sz.H / bb.h) * S.zoom;
    var rot = rotation() * Math.PI / 180;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, sz.W, sz.H);
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, sz.W, sz.H);
    ctx.save();
    ctx.translate(sz.W / 2, sz.H / 2);
    if (rot) ctx.rotate(rot);
    ctx.drawImage(img, -img.width / 2 + S.panX, -img.height / 2 + S.panY, img.width * scale, img.height * scale);
    ctx.restore();
    $('imge-dims').textContent = sz.W + ' × ' + sz.H;
  }

  function recalc() {
    if (!S.img) return;
    var sz = outSize();
    var bb = bboxOf();
    S.baseScale = Math.max(sz.W / bb.w, sz.H / bb.h);
    S.zoom = 1;
    S.panX = 0; S.panY = 0;
    var z = $('imge-zoom'); if (z) z.value = 1;
    var zv = $('imge-zoomval'); if (zv) zv.textContent = '100%';
    draw();
  }

  function panClamp() {
    var sz = outSize(), bb = bboxOf();
    var w = bb.w * S.baseScale * S.zoom, h = bb.h * S.baseScale * S.zoom;
    var maxX = Math.max(0, (w - sz.W) / 2), maxY = Math.max(0, (h - sz.H) / 2);
    S.panX = clamp(S.panX, -maxX, maxX);
    S.panY = clamp(S.panY, -maxY, maxY);
  }

  function zoomSet(v, updateInput) {
    S.zoom = clamp(parseFloat(v) || 1, 1, 4);
    panClamp();
    var zv = $('imge-zoomval'); if (zv) zv.textContent = Math.round(S.zoom * 100) + '%';
    if (updateInput) { var z = $('imge-zoom'); if (z) z.value = S.zoom; }
    draw();
  }

  // ---- Construcción de controles ----
  function buildAspects() {
    var box = $('imge-aspects');
    box.innerHTML = '';
    ASPECTS.forEach(function (a) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'imge-chip' + (a.v === S.aspect ? ' on' : '');
      b.textContent = a.v === 'libre' ? 'Libre' : a.v;
      b.onclick = function () {
        S.aspect = a.v;
        buildAspects();
        recalc();
      };
      box.appendChild(b);
    });
  }

  // ---- Acciones públicas (compatibles con los onclick de las páginas) ----
  function imgeRot90(dir) { S.rotQ = (S.rotQ + dir * 90 + 360) % 360; recalc(); }
  function imgeResetAll() {
    S.aspect = '1:1'; S.zoom = 1; S.panX = 0; S.panY = 0; S.rotQ = 0;
    buildAspects();
    recalc();
  }
  function imgeClose() {
    var cancel = S.cbCancel;
    S.cbDone = null; S.cbCancel = null; S.container = null;
    $('imge-ov').classList.remove('open');
    document.body.style.overflow = '';
    if (cancel) try { cancel(); } catch (e) {}
  }
  function imgeOpen(src, onDone, onCancel, container, aspect) {
    if (!src) return;
    S.cbDone = onDone || null;
    S.cbCancel = onCancel || null;
    S.container = container || null;
    var img = new Image();
    img.onload = function () {
      S.img = img;
      S.aspect = aspect || '1:1'; S.rotQ = 0;
      buildAspects();
      $('imge-ov').classList.add('open');
      document.body.style.overflow = 'hidden';
      recalc();
    };
    img.onerror = function () { totToast('No se pudo cargar la imagen'); };
    img.src = src;
  }
  function imgeApply() {
    var canvas = $('imge-canvas');
    if (!canvas || !S.img || S.applying) return;
    S.applying = true;
    draw();
    var btn = $('imge-apply'); if (btn) btn.disabled = true;
    canvas.toBlob(function (blob) {
      if (!blob) { S.applying = false; if (btn) btn.disabled = false; totToast('No se pudo procesar la imagen'); return; }
      var cbDone = S.cbDone, container = S.container;
      S.cbDone = null; S.cbCancel = null; S.container = null;
      var fd = new FormData();
      fd.append('foto', blob, 'editada.png');
      var tok = csrf();
      if (tok) fd.append('_csrf', tok);
      fetch(UP_URL + (window.__imgeTrim ? (UP_URL.indexOf('?') > -1 ? '&' : '?') + 'trim=1' : ''), { method: 'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {}, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          imgeClose();
          S.applying = false; if (btn) btn.disabled = false;
          if (d && d.url) {
            try { if (window.imgeUploaded) window.imgeUploaded(d.url); } catch (e) {}
            if (container) {
              container.setAttribute('data-url', d.url);
              var im = container.querySelector('img');
              if (im) im.src = d.url;
              try { if (window.imgeContainerApplied) window.imgeContainerApplied(container, d.url); } catch (e) {}
            }
            if (cbDone) try { cbDone(d.url); } catch (e) {}
            totToast('Imagen aplicada ✓', 'ok');
          } else {
            totToast('No se pudo guardar la imagen');
            if (cbDone) try { cbDone(null); } catch (e) {}
          }
        })
        .catch(function () {
          imgeClose();
          S.applying = false; if (btn) btn.disabled = false;
          totToast('Error al guardar la imagen');
        });
    }, 'image/png');
  }

  // ---- Gestos ----
  function initGestures() {
    var stage = $('imge-stage');
    var dragging = false, sx = 0, sy = 0, sox = 0, soy = 0;
    function pt(e) { return (e.touches && e.touches.length) ? e.touches[0] : e; }
    function start(e) {
      if (!S.img) return;
      dragging = true;
      var p = pt(e);
      sx = p.clientX; sy = p.clientY; sox = S.panX; soy = S.panY;
      stage.classList.add('drag');
      if (e.cancelable) e.preventDefault();
    }
    function move(e) {
      if (!dragging) return;
      var p = pt(e);
      var rect = stage.getBoundingClientRect();
      var sz = outSize();
      var kx = sz.W / (rect.width || 1), ky = sz.H / (rect.height || 1);
      S.panX = sox + (p.clientX - sx) * kx;
      S.panY = soy + (p.clientY - sy) * ky;
      panClamp();
      draw();
      if (e.cancelable) e.preventDefault();
    }
    function end() { dragging = false; stage.classList.remove('drag'); }
    stage.addEventListener('mousedown', start);
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    stage.addEventListener('touchstart', start, { passive: false });
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('touchend', end);
    stage.addEventListener('wheel', function (e) {
      if (!S.img) return;
      if (e.cancelable) e.preventDefault();
      zoomSet(S.zoom * (e.deltaY < 0 ? 1.1 : 0.9), true);
    }, { passive: false });
  }

  function initZoom() {
    var z = $('imge-zoom');
    z.addEventListener('input', function () { zoomSet(z.value, false); });
  }

  // API pública (compat con las páginas que ya llaman abrirEditorImagen)
  window.abrirEditorImagen = function (a, b, c, d) {
    if (a && a.nodeType === 1) {
      var url = a.getAttribute('data-url');
      imgeOpen(url, null, null, a);
    } else {
      imgeOpen(a, (typeof b === 'function') ? b : null, (typeof c === 'function') ? c : null, null, (typeof d === 'string') ? d : null);
    }
  };
  window.cerrarEditorImagen = imgeClose;
  window.aplicarEditorImagen = imgeApply;
  window.imgeOpen = imgeOpen;
  window.imgeClose = imgeClose;
  window.imgeApply = imgeApply;
  window.imgeRot90 = imgeRot90;
  window.imgeResetAll = imgeResetAll;

  initGestures();
  initZoom();
})();
</script>
