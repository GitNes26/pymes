    const r = blockRoot(key); if (!r) return;
    const st = stOf(key);
    const si = r.querySelector('.search-input');
    if (si) st.q = (si.value || '').toLowerCase();
    const pmin = r.querySelector('.price-min');
    const pmax = r.querySelector('.price-max');
    st.pmin = pmin ? pmin.value : '';
    st.pmax = pmax ? pmax.value : '';
  }
  function syncChipClasses(key) {
    const r = blockRoot(key); if (!r) return;
    const st = stOf(key);
    r.querySelectorAll('.cat-chip').forEach(b => {
      const isActive = (b.dataset.cat || '0') === String(st.cat) || (st.cat === 0 && !b.dataset.cat);
      b.classList.toggle('chip-active', isActive);
      b.classList.toggle('chip-idle', !isActive);
    });
  }
  function updateClearButton(key) {
    const r = blockRoot(key); if (!r) return;
    const btn = r.querySelector('.clear-filters');
    if (btn) btn.style.display = hasBlockFilters(key) ? '' : 'none';
  }
  function toggleNoResults(key) {
    const g = blockGrid(key); if (!g) return;
    let msg = g.querySelector('.no-results');
    const cards = blockCards(key);
    const anyVisible = cards.some(d => d.style.display !== 'none');
    if (cards.length && !anyVisible) {
      if (!msg) {
        msg = document.createElement('div');
        msg.className = 'no-results';
        msg.style.cssText = 'grid-column:1/-1;text-align:center;padding:48px 16px;';
        msg.innerHTML = '<div style="font-size:34px;line-height:1;margin-bottom:10px;">🔍</div>' +
          '<p style="font-size:14px;font-weight:700;color:var(--text,#141210);margin:0 0 4px;">No encontramos productos con esos filtros</p>' +
          '<p style="font-size:12px;color:var(--text-secondary,#5C6B64);margin:0 0 16px;">Prueba con otra búsqueda o quita los filtros para ver todo el catálogo.</p>' +
          '<button type="button" class="no-results-btn">Limpiar filtros</button>';
        g.appendChild(msg);
        msg.querySelector('.no-results-btn').addEventListener('click', function (e) { e.stopPropagation(); resetFilters(key); });
      }
    } else if (msg) { msg.remove(); }
  }
  function applySearch(key) {
    if (!key) { globalApplySearch(); return; }
    const r = blockRoot(key); if (!r) return;
    const st = stOf(key);
    readBlockInputs(key);
    pagStates[key] = { page: 1 };
    blockCards(key).forEach(c => {
      const show = cardMatches(c, st, false, null);
      if (show && !c.classList.contains('prod-more')) c.style.removeProperty('display');
      else if (!show) c.style.setProperty('display', 'none', 'important');
    });
    toggleNoResults(key);
    refreshFacets(key);
    updateClearButton(key);
    buildSuggest(key);
    applyPagination();
  }
  function globalApplySearch() {
    // Componente "filtros" suelto: aplica la búsqueda y el precio a todos los bloques.
    const si = document.getElementById('search-input');
    const q = (si ? si.value : '').toLowerCase();
    const pmin = document.getElementById('price-min');
    const pmax = document.getElementById('price-max');
    blockKeys().forEach(k => {
      const st = stOf(k);
      st.q = q;
      st.pmin = pmin ? pmin.value : '';
      st.pmax = pmax ? pmax.value : '';
      st.page = 1;
      pagStates[k] = { page: 1 };
      blockCards(k).forEach(c => {
        const show = cardMatches(c, st, false, null);
        if (show && !c.classList.contains('prod-more')) c.style.removeProperty('display');
        else if (!show) c.style.setProperty('display', 'none', 'important');
      });
      toggleNoResults(k);
      refreshFacets(k);
      updateClearButton(k);
    });
    applyPagination();
  }
  function filterCat(key, catId) {
    if (catId === undefined) {
      // Llamada global: filterCat(id) desde los componentes "filtros"/"categorías".
      const c = key;
      blockKeys().forEach(k => {
        stOf(k).cat = c;
        syncChipClasses(k);
        applySearch(k);
      });
      document.querySelectorAll('[data-sec="filtros"] .cat-chip, [data-sec="categorias"] .cat-chip').forEach(b => {
        const isActive = (b.dataset.cat || '0') === String(c) || (c === 0 && !b.dataset.cat);
        b.classList.toggle('chip-active', isActive);
        b.classList.toggle('chip-idle', !isActive);
      });
      return;
    }
    stOf(key).cat = catId;
    syncChipClasses(key);
    applySearch(key);
  }
  function resetFilters(key) {
    if (key === undefined) {
      // Componente suelto: limpia y aplica a todos los bloques.
      const si = document.getElementById('search-input'); if (si) si.value = '';
      const pmin = document.getElementById('price-min'); if (pmin) pmin.value = '';
      const pmax = document.getElementById('price-max'); if (pmax) pmax.value = '';
      blockKeys().forEach(k => {
        const st = stOf(k);
        st.q = ''; st.cat = 0; st.vars = {}; st.pmin = ''; st.pmax = '';
        const r = blockRoot(k);
        if (r) r.querySelectorAll('.vfilter-check').forEach(cb => { cb.checked = false; });
        syncChipClasses(k);
        applySearch(k);
      });
      document.querySelectorAll('[data-sec="filtros"] .cat-chip, [data-sec="categorias"] .cat-chip').forEach(b => {
        const isActive = !b.dataset.cat;
        b.classList.toggle('chip-active', isActive);
        b.classList.toggle('chip-idle', !isActive);
      });
      return;
    }
    const r = blockRoot(key); if (!r) return;
    const st = stOf(key);
    const si = r.querySelector('.search-input'); if (si) si.value = '';
    const pmin = r.querySelector('.price-min'); if (pmin) pmin.value = '';
    const pmax = r.querySelector('.price-max'); if (pmax) pmax.value = '';
    st.q = ''; st.cat = 0; st.vars = {}; st.pmin = ''; st.pmax = '';
    r.querySelectorAll('.vfilter-check').forEach(cb => { cb.checked = false; });
    syncChipClasses(key);
    applySearch(key);
  }

  // Paginación por páginas numeradas (grillas con data-pag="paginas")
  const pagStates = {};
  function pagList(cur, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const out = [1, total, cur - 1, cur, cur + 1]
      .filter((n, i, a) => n >= 1 && n <= total && a.indexOf(n) === i)
      .sort((a, b) => a - b);
    const res = [];
    let prev = 0;
    out.forEach(n => { if (n - prev > 1) res.push('...'); res.push(n); prev = n; });
    return res;
  }
  function applyPagination() {
    document.querySelectorAll('.prod-grid[data-pag="paginas"]').forEach(grid => {
      const block = grid.closest('[data-sec="productos"]');
      const key = block ? block.getAttribute('data-key') : '0';
      const st = pagStates[key] || (pagStates[key] = { page: 1 });
      const per = parseInt(grid.getAttribute('data-per')) || 8;
      const cards = Array.prototype.slice.call(grid.querySelectorAll('[data-search]'));
      const visible = cards.filter(c => c.style.display !== 'none');
      const pages = Math.max(1, Math.ceil(visible.length / per));
      if (st.page > pages) st.page = pages;
      cards.forEach(c => {
        c.classList.remove('prod-page-hide');
        if (c.style.display === 'none') return;
        const pIdx = visible.indexOf(c);
        if (Math.floor(pIdx / per) !== st.page - 1) c.classList.add('prod-page-hide');
      });
      const pager = grid.querySelector('.prod-pager');
      if (!pager) return;
      if (pages <= 1) { pager.innerHTML = ''; return; }
      let html = '<button type="button" data-pg="prev" class="pp-nav"' + (st.page === 1 ? ' disabled' : '') + ' title="Anterior">‹</button>';
      pagList(st.page, pages).forEach(item => {
        if (item === '...') { html += '<span class="pp-gap">…</span>'; return; }
        html += '<button type="button" data-pg="' + item + '"' + (item === st.page ? ' class="on"' : '') + '>' + item + '</button>';
      });
      html += '<button type="button" data-pg="next" class="pp-nav"' + (st.page === pages ? ' disabled' : '') + ' title="Siguiente">›</button>';
      pager.innerHTML = html;
    });
  }
  function goPage(key, page) {
    const st = pagStates[key] || (pagStates[key] = { page: 1 });
    const grid = document.querySelector('[data-sec="productos"][data-key="' + key + '"] .prod-grid[data-pag="paginas"]');
    if (!grid) return;
    const per = parseInt(grid.getAttribute('data-per')) || 8;
    const visible = Array.prototype.slice.call(grid.querySelectorAll('[data-search]')).filter(c => c.style.display !== 'none');
    const pages = Math.max(1, Math.ceil(visible.length / per));
    if (page === 'prev') st.page = Math.max(1, st.page - 1);
    else if (page === 'next') st.page = Math.min(pages, st.page + 1);
    else st.page = Math.max(1, Math.min(pages, parseInt(page, 10) || 1));
    applyPagination();
  }
  document.addEventListener('click', function (e) {
    const b = e.target && e.target.closest ? e.target.closest('.prod-pager button[data-pg]') : null;
    if (!b) return;
    e.preventDefault();
    const grid = b.closest('.prod-grid');
    const block = grid ? grid.closest('[data-sec="productos"]') : null;
    goPage(block ? block.getAttribute('data-key') : '0', b.getAttribute('data-pg'));
  });

  // Recalcula los conteos de cada filtro y oculta las opciones que no existen
  // con la combinación actual (vuelven a aparecer al limpiar los filtros).
  function refreshFacets(key) {
    const r = blockRoot(key); if (!r) return;
    const st = stOf(key);
    const catMatch = blockMatching(key, st, true, null);
    const byCat = {};
    catMatch.forEach(d => { const c = parseInt(d.dataset.cat || '0'); byCat[c] = (byCat[c] || 0) + 1; });
    r.querySelectorAll('.cat-chip').forEach(b => {
      const badge = b.querySelector('.cat-chip-count');
      if (b.dataset.cat) {
        const count = byCat[parseInt(b.dataset.cat)] || 0;
        if (badge) badge.textContent = count;
        b.style.display = count ? '' : 'none';
      } else if (badge) {
        badge.textContent = catMatch.length;
      }
    });
    const vf = r.querySelector('.variant-filters');
    if (!vf) return;
    vf.querySelectorAll('.vf-option').forEach(opt => {
      const name = opt.getAttribute('data-var');
      const val = opt.getAttribute('data-val');
      const matches = blockMatching(key, st, false, name);
      let count = 0;
      matches.forEach(d => {
        const p = PROMAP[String(d._pid)];
        const vm = normVariantModel(p.variants);
        const attr = vm.attrs.find(a => a.name === name);
        if (attr && attr.values.indexOf(val) !== -1) count++;
      });
      const badge = opt.querySelector('.vf-count');
      if (badge) badge.textContent = count;
      opt.style.display = count ? '' : 'none';
    });
    vf.querySelectorAll('.vf-group').forEach(g => {
      let any = false;
      g.querySelectorAll('.vf-option').forEach(o => { if (o.style.display !== 'none') any = true; });
      g.style.display = any ? '' : 'none';
    });
  }

  // Filtros por variantes: dropdowns con checkboxes (multi-selección)
  function escHtml(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function colorFor(v) {
    const map = { rojo:'#ef4444', azul:'#3b82f6', verde:'#22c55e', amarillo:'#eab308', negro:'#111827', blanco:'#f8fafc', gris:'#9ca3af', rosa:'#ec4899', morado:'#8b5cf6', naranja:'#f97316', cafe:'#8b5e3c', marron:'#6b4226', beige:'#e7d8c0', dorado:'#d4af37', plata:'#cbd5e1', turquesa:'#14b8a6', celeste:'#38bdf8', vino:'#9f1239' };
    const k = String(v).toLowerCase().trim();
    if (map[k]) return map[k];
    let h = 0; for (let i = 0; i < k.length; i++) h = (h * 31 + k.charCodeAt(i)) >>> 0;
    return 'hsl(' + (h % 360) + ',60%,62%)';
  }
  function buildVariantFilters(key) {
    const r = blockRoot(key); if (!r) return;
    const cont = r.querySelector('.variant-filters');
    if (!cont) return;
    const allowRaw = cont.getAttribute('data-attrs') || '';
    const allow = allowRaw.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
    const attrs = {};
    blockCards(key).forEach(d => {
      const pid = d._pid;
      const p = pid ? PROMAP[String(pid)] : null;
      if (!p) return;
      const vm = normVariantModel(p.variants);
      vm.attrs.forEach(a => {
        const name = a.name || '';
        const set = attrs[name] || {};
        a.values.forEach(v => { set[v] = (set[v] || 0) + 1; });
        attrs[name] = set;
      });
    });
    const names = Object.keys(attrs).sort((a, b) => (a === '' ? 1 : b === '' ? -1 : a.localeCompare(b))).filter(n => !allow.length || allow.indexOf(String(n).toLowerCase()) !== -1);
    if (!names.length) { cont.innerHTML = ''; return; }
    let html = '<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Filtros</p>';
    names.forEach(name => {
      const counts = attrs[name];
      const isColor = /color/i.test(name);
      html += '<div class="vf-group mb-3 border-b border-slate-100 pb-3" data-attr="' + escHtml(name) + '">';
      html += '<p class="text-sm font-semibold text-slate-700 mb-1.5">' + escHtml(name || 'Opciones') + '</p>';
      Object.keys(counts).forEach(v => {
        html += '<label class="vf-option flex items-center gap-2 py-0.5 text-sm text-slate-600 cursor-pointer hover:text-slate-800" data-var="' + escHtml(name) + '" data-val="' + escHtml(v) + '">';
        html += '<input type="checkbox" class="vfilter-check" data-var="' + escHtml(name) + '" data-val="' + escHtml(v) + '">';
        if (isColor) html += '<span class="w-4 h-4 rounded-full border border-slate-200 inline-block shrink-0" style="background:' + colorFor(v) + '"></span>';
        html += '<span class="truncate">' + escHtml(v) + '</span>';
        html += '<span class="vf-count ml-auto text-xs text-slate-400 shrink-0">' + counts[v] + '</span>';
        html += '</label>';
      });
      html += '</div>';
    });
    cont.innerHTML = html;
    cont.querySelectorAll('.vfilter-check').forEach(cb => {
      cb.addEventListener('change', () => {
        const st = stOf(key);
        const an = cb.getAttribute('data-var');
        const v = cb.getAttribute('data-val');
        const arr = st.vars[an] || [];
        if (cb.checked) { if (arr.indexOf(v) === -1) arr.push(v); }
        else { const i = arr.indexOf(v); if (i !== -1) arr.splice(i, 1); }
        if (arr.length) st.vars[an] = arr; else delete st.vars[an];
        applySearch(key);
      });
    });
  }

  // Autocompletado: lista de coincidencias bajo el buscador
  let suggestBox = null;
  let suggestInput = null;
  // position:fixed + compensación de visualViewport (igual que el autocomplete
  // de proveedores/searchable-select): en móvil el teclado encoge el visual
  // viewport sin mover el layout viewport, así que getBoundingClientRect() y
  // un elemento anclado al <body> quedan desalineados si no se compensa ese
  // desfase — era la causa de que la lista "se fuera a otro lado".
  function placeSuggest() {
    if (!suggestInput || !suggestBox || suggestBox.classList.contains('hidden')) return;
    const rect = suggestInput.getBoundingClientRect();
    const vv = window.visualViewport;
    const offX = (vv && vv.offsetLeft) || 0;
    const offY = (vv && vv.offsetTop) || 0;
    suggestBox.style.top = (rect.bottom - offY + 6) + 'px';
    suggestBox.style.left = (rect.left - offX) + 'px';
    suggestBox.style.width = rect.width + 'px';
  }
  function buildSuggest(key) {
    const r = blockRoot(key);
    const input = r ? r.querySelector('.search-input') : null;
    if (!input) return;
    if (!suggestBox) {
      suggestBox = document.createElement('div');
      suggestBox.className = 'hidden fixed top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 overflow-hidden';
      document.body.appendChild(suggestBox);
      document.addEventListener('click', (e) => { if (!e.target.closest('.search-input') && !suggestBox.contains(e.target)) suggestBox.classList.add('hidden'); });
      window.addEventListener('scroll', placeSuggest, true);
      window.addEventListener('resize', placeSuggest);
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', placeSuggest);
        window.visualViewport.addEventListener('scroll', placeSuggest);
      }
    }
    suggestInput = input;
    const q = (input.value || '').trim().toLowerCase();
    if (!q) { suggestBox.classList.add('hidden'); return; }
    const st = stOf(key);
    const cands = blockCards(key)
      .filter(d => (st.cat === 0 || parseInt(d.dataset.cat || '0') === st.cat) && (d.dataset.search || '').includes(q))
      .slice(0, 6);
    if (!cands.length) { suggestBox.classList.add('hidden'); return; }
    suggestBox.innerHTML = cands.map(d => {
      const title = d.dataset.search || '';
      const p = d._pid ? PROMAP[String(d._pid)] : null;
      return `<button type="button" class="flex items-center gap-3 w-full text-left px-3 py-2 hover:bg-slate-50 border-b border-slate-50 last:border-0" data-name="${title.replace(/"/g, '&quot;')}">
        <img src="${p ? p.image : NO_IMAGE}" onerror="this.src=NO_IMAGE" class="w-9 h-9 rounded-lg object-cover border border-slate-100 shrink-0">
        <span class="text-sm font-semibold text-slate-700 truncate">${title}</span>
      </button>`;
    }).join('');
    suggestBox.classList.remove('hidden');
    placeSuggest();
    suggestBox.querySelectorAll('button').forEach(b => {
      b.addEventListener('click', () => {
        input.value = b.getAttribute('data-name');
        suggestBox.classList.add('hidden');
        applySearch(key);
      });
    });
  }

  // ================= GALERÍA DE PRODUCTO (visor de fotos) =================
  let lbEl = null;
  let lbState = { imgs: [], idx: 0, zoom: 1, tx: 0, ty: 0 };

  function openLightbox(id, idx) {
    const p = PROMAP[String(id)];
    const imgs = (p && p.imgs && p.imgs.length) ? p.imgs : [];
    if (!imgs.length) return;
    closeLightbox();
    lbState = { imgs, idx: Math.max(0, Math.min(idx || 0, imgs.length - 1)), zoom: 1, tx: 0, ty: 0 };

    const d = document.createElement('div');
    d.id = 'lb';
    d.className = 'fixed inset-0 z-[2000] flex flex-col bg-black/95 backdrop-blur-sm lb-fade';
    d.innerHTML = `
      <div class="flex items-center justify-between gap-3 px-4 py-3 select-none">
        <p class="text-white text-sm font-bold truncate">${(p && p.name) || ''}</p>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" class="lb-zoom w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 text-white text-base font-black" title="Ampliar (doble clic)">⛶</button>
          <button type="button" class="lb-x w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 text-white text-base font-black" title="Cerrar (Esc)">✕</button>
        </div>
      </div>
      <div class="lb-stage relative flex-1 overflow-hidden">
        <img class="lb-img absolute inset-0 m-auto max-w-full max-h-full object-contain select-none" style="cursor:zoom-in" alt="">
        <button type="button" class="lb-prev absolute left-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white text-2xl font-black backdrop-blur-sm hidden" title="Anterior (←)">‹</button>
        <button type="button" class="lb-next absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white text-2xl font-black backdrop-blur-sm hidden" title="Siguiente (→)">›</button>
      </div>
      <div class="lb-thumbs flex items-center gap-2 px-4 py-3 overflow-x-auto justify-center"></div>`;
    document.body.appendChild(d);
    lbEl = d;

    const img = d.querySelector('.lb-img');
    const prev = d.querySelector('.lb-prev');
    const next = d.querySelector('.lb-next');
    const thumbs = d.querySelector('.lb-thumbs');
    const stage = d.querySelector('.lb-stage');

    let counter = document.createElement('span');
    counter.className = 'absolute bottom-3 left-1/2 -translate-x-1/2 text-white text-xs font-black bg-black/50 px-3 py-1 rounded-full backdrop-blur-sm';
    stage.appendChild(counter);

    function applyZoom() {
      img.style.transform = 'translate(' + lbState.tx + 'px,' + lbState.ty + 'px) scale(' + lbState.zoom + ')';
      img.style.cursor = lbState.zoom > 1 ? 'grab' : 'zoom-in';
    }
    function render() {
      img.src = lbState.imgs[lbState.idx];
      lbState.zoom = 1; lbState.tx = 0; lbState.ty = 0; applyZoom();
      prev.classList.toggle('hidden', lbState.imgs.length < 2);
      next.classList.toggle('hidden', lbState.imgs.length < 2);
      counter.textContent = (lbState.idx + 1) + ' / ' + lbState.imgs.length;
      thumbs.innerHTML = lbState.imgs.map((u, i) =>
        '<button type="button" class="lb-thumb w-12 h-12 rounded-xl overflow-hidden border-2 transition ' + (i === lbState.idx ? 'border-white' : 'border-transparent opacity-50 hover:opacity-100') + '"><img src="' + u + '" class="w-full h-full object-cover" onerror="this.src=NO_IMAGE"></button>'
      ).join('');
      thumbs.querySelectorAll('.lb-thumb').forEach((b, i) => b.addEventListener('click', () => { lbState.idx = i; render(); }));
    }
    function nav(delta) {
      lbState.idx = (lbState.idx + delta + lbState.imgs.length) % lbState.imgs.length;
      render();
    }
    function toggleZoom() {
      if (lbState.zoom > 1) { lbState.zoom = 1; lbState.tx = 0; lbState.ty = 0; }
      else { lbState.zoom = 2.5; }
      applyZoom();
    }
    prev.addEventListener('click', (e) => { e.stopPropagation(); nav(-1); });
    next.addEventListener('click', (e) => { e.stopPropagation(); nav(1); });
    d.querySelector('.lb-zoom').addEventListener('click', toggleZoom);
    d.querySelector('.lb-x').addEventListener('click', closeLightbox);
    d.addEventListener('click', (e) => { if (e.target === d || e.target === stage) closeLightbox(); });
    img.addEventListener('dblclick', (e) => { e.preventDefault(); toggleZoom(); });

    function onKey(e) {
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    }
    document.addEventListener('keydown', onKey);
    d._onKey = onKey;

    // Swipe táctil
    let sx = 0, sy = 0, moved = 0, touching = false;
    d.addEventListener('touchstart', (e) => { const t = e.touches[0]; sx = t.clientX; sy = t.clientY; moved = 0; touching = true; }, { passive: true });
    d.addEventListener('touchmove', (e) => {
      if (!touching || lbState.zoom > 1) return;
      const t = e.touches[0];
      const dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > Math.abs(dy)) moved = dx;
    }, { passive: true });
    d.addEventListener('touchend', () => {
      touching = false;
      if (lbState.zoom <= 1) { if (moved > 40) nav(-1); else if (moved < -40) nav(1); }
    });

    // Arrastrar para recorrer la imagen cuando está ampliada
    let px = 0, py = 0, panning = false;
    img.addEventListener('mousedown', (e) => {
      if (lbState.zoom > 1) { panning = true; px = e.clientX - lbState.tx; py = e.clientY - lbState.ty; img.style.cursor = 'grabbing'; e.preventDefault(); }
    });
    window.addEventListener('mousemove', (e) => {
      if (!panning) return;
      lbState.tx = e.clientX - px; lbState.ty = e.clientY - py; applyZoom();
    });
    window.addEventListener('mouseup', () => { panning = false; });

    render();
  }

  function closeLightbox() {
    if (!lbEl) return;
    if (lbEl._onKey) document.removeEventListener('keydown', lbEl._onKey);
    lbEl.remove();
    lbEl = null;
  }

  // Decora la tarjeta: clic abre el visor + miniaturas visibles en la foto
  function decorateGallery(card, p, id) {
    const imgs = (p.imgs && p.imgs.length) ? p.imgs : [];
    if (!imgs.length) return;
    const img = card.querySelector('img');
    if (!img) return;
    if (imgs.length === 1 && (img.getAttribute('src') || '').indexOf('sin-imagen') > -1) return;
    const wrap = img.parentElement;
    if (wrap && wrap.className.indexOf('relative') > -1) {
      wrap.style.cursor = 'pointer';
      const exp = document.createElement('span');
      exp.className = 'absolute bottom-3 right-3 min-w-6 h-6 px-1.5 rounded-full bg-black/40 text-white text-[10px] font-bold flex items-center justify-center shadow-sm backdrop-blur-sm';
      exp.textContent = imgs.length > 1 ? imgs.length : '⛶';
      exp.title = imgs.length > 1 ? ('Ver ' + imgs.length + ' fotos') : 'Ver foto';
      wrap.appendChild(exp);
      if (imgs.length > 1) {
        const strip = document.createElement('div');
        strip.className = 'absolute bottom-3 left-3 flex gap-1';
        imgs.slice(0, 3).forEach((u, i) => {
          const th = document.createElement('img');
          th.src = u;
          th.onerror = function () { this.style.display = 'none'; };
          th.className = 'w-7 h-7 rounded-md object-cover border shadow-sm ' + (i === 0 ? 'border-white' : 'border-white/40');
          strip.appendChild(th);
        });
        if (imgs.length > 3) {
          const more = document.createElement('span');
          more.className = 'w-7 h-7 rounded-md bg-black/50 text-white text-[9px] font-bold flex items-center justify-center border border-white/40 backdrop-blur-sm';
          more.textContent = '+' + (imgs.length - 3);
          strip.appendChild(more);
        }
        wrap.appendChild(strip);
      }
    }
    img.addEventListener('click', (e) => { e.stopPropagation(); location.href = '/' + SLUG + '/p/' + id; });
  }

  // Vuelta del checkout de Mercado Pago: el webhook es quien de verdad marca
  // el pedido como pagado (puede tardar unos segundos) — esto solo avisa al
  // cliente en pantalla y limpia el carrito si el pago salió bien.
  (function () {
    const params = new URLSearchParams(window.location.search);
    const pago = params.get('pago');
    if (!pago) return;
    if (pago === 'exito') { toast('¡Pago recibido! Ya puedes pasar por tu pedido 🎉', true); try { localStorage.removeItem(CART_KEY); } catch (e) {} }
    else if (pago === 'pendiente') toast('Tu pago está en proceso — te avisamos cuando se confirme', true);
    else if (pago === 'fallo') toast('El pago no se completó, intenta de nuevo', false);
    else if (pago === 'error') toast('No se pudo iniciar el pago, intenta de nuevo', false);
    params.delete('pago');
    const qs = params.toString();
    window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : ''));
  })();
  document.addEventListener('DOMContentLoaded', () => {
    buildChat();
    renderCart();
    catCards().forEach(card => {
      const id = card.getAttribute('data-id');
      const btn = card.querySelector('button[onclick^="addToCart"]');
      const mid = btn ? ((btn.getAttribute('onclick') || '').match(/addToCart\((\d+)/) || [])[1] : null;
      const pid = id || mid;
      if (!pid) return;
      const p = PROMAP[pid];
      if (!p) return;
      card._pid = pid;
      const hasVars = normVariantModel(p.variants).attrs.length > 0;
      const outOfStock = !p.madeToOrder && !hasVars && (p.stock === null || p.stock === undefined || p.stock <= 0);
      if (outOfStock && !card.querySelector('.abs-agotado')) {
        const badge = document.createElement('span');
        badge.className = 'abs-agotado absolute top-2 left-2 bg-red-500 text-white text-[10px] font-black px-2 py-1 rounded-full shadow';
        badge.textContent = 'AGOTADO';
        card.style.position = 'relative';
        card.appendChild(badge);
      }
      if (btn) {
        if (outOfStock) {
          btn.disabled = true;
          btn.classList.add('opacity-40', 'cursor-not-allowed');
        }
        if (hasVars) {
          btn.innerHTML = '<svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 7V6a6 6 0 1112 0v1h1a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2h1zm2 0h8V6a4 4 0 00-8 0v1z"/></svg>';
          btn.setAttribute('title', 'Elegir opciones');
        }
        decorateGallery(card, p, pid);
        const shareBtn = document.createElement('button');
        shareBtn.type = 'button';
        shareBtn.className = 'shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition';
        shareBtn.title = 'Compartir';
        shareBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 12v7a2 2 0 002 2h12a2 2 0 002-2v-7M16 6l-4-4-4 4M12 2v13"/></svg>';
        shareBtn.addEventListener('click', function (e) { e.stopPropagation(); shareProduct(pid, p.name, p.price); });
        if (btn.parentNode) {
          const wrap = document.createElement('div');
          wrap.className = 'flex items-center gap-1.5 w-full';
          btn.parentNode.insertBefore(wrap, btn);
          wrap.appendChild(btn);
          wrap.appendChild(shareBtn);
          btn.classList.add('flex-1', 'justify-center');
        }
      } else {
        decorateGallery(card, p, pid);
      }
      card.style.cursor = 'pointer';
      card.addEventListener('click', function (e) {
        if (e.target.closest('button, a, input, label')) return;
        location.href = '/' + SLUG + '/p/' + pid;
      });
    });
    blockKeys().forEach(function (k) {
      buildVariantFilters(k);
      applySearch(k);
    });
    renderCart();
    // Deep-link: ?p=ID resalta y lleva al producto compartido
    const qp2 = new URLSearchParams(location.search);
    const pid2 = qp2.get('p');
    if (pid2) {
      const target = catCards().find(c => c._pid === pid2);
      if (target) {
        setTimeout(function () {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.style.outline = '3px solid var(--md-primary, #2563eb)';
          target.style.outlineOffset = '3px';
        }, 300);
      }
    }
  });

  
  function copyLink(slug, id) {
    var url = location.origin + '/' + slug + '/p/' + id;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(function() {
        if (typeof toast === 'function') toast('Enlace copiado ✓', true);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = url; ta.style.position='fixed'; ta.style.left='-9999px';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      if (typeof toast === 'function') toast('Enlace copiado ✓', true);
    }
  }

  function shareProduct(id, name, price) {
    const p = PROMAP[String(id)];
    if (!name && p) name = p.name;
    if (price === undefined && p) price = p.price;
    const slug = name ? '-' + String(name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) : '';
    let url = location.origin + '/' + SLUG + '/p/' + id + slug;
    if (window.__prodSel) {
      const qs = new URLSearchParams();
      Object.keys(window.__prodSel).forEach(k => { const v = window.__prodSel[k]; if (v) qs.set(k, v); });
      const q = qs.toString();
      if (q) url += '?' + q;
    }
    const text = name + (price ? ' — ' + money(price) : '') + '\n' + url;
    if (navigator.share) {
      navigator.share({ title: name, text: name + ' ' + url, url: url }).catch(function () {});
      return;
    }
    const menu = document.createElement('div');
    menu.className = 'fixed inset-0 z-[1300] flex items-end sm:items-center justify-center bg-black/50 backdrop-blur-sm';
    menu.innerHTML = '<div class="bg-white w-full sm:w-80 sm:rounded-2xl rounded-t-2xl p-4 shadow-2xl m-pop">' +
      '<div class="flex items-center justify-between mb-3"><p class="font-bold text-slate-800 text-sm">Compartir producto</p><button type="button" data-close class="text-slate-400 hover:text-slate-600 font-bold">✕</button></div>' +
      '<div class="space-y-1.5">' +
      '<a href="https://wa.me/?text=' + encodeURIComponent(text) + '" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-xl px-3 py-2.5">💬 WhatsApp</a>' +
      '<a href="https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url) + '" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-xl px-3 py-2.5">📘 Facebook</a>' +
      '<a href="https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(name) + '" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-xl px-3 py-2.5">𝕏 X (Twitter)</a>' +
      '<button type="button" data-copy class="flex items-center gap-3 w-full text-left text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-xl px-3 py-2.5">🔗 Copiar enlace</button>' +
      '</div></div>';
    document.body.appendChild(menu);
    menu.addEventListener('click', function (e) { if (e.target === menu) menu.remove(); });
    menu.querySelector('[data-close]').addEventListener('click', function () { menu.remove(); });
    menu.querySelector('[data-copy]').addEventListener('click', function () {
      try { navigator.clipboard.writeText(url); } catch (e) {}
      menu.remove();
      toast('Enlace copiado ✓', true);
    });
  }
</script>
