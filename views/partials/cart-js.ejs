<style>
  .lb-fade { animation: lbFade .18s ease-out; }
  .lb-fade .lb-img { animation: lbZoom .18s ease-out; }
  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lbZoom { from { transform: scale(.92); opacity: .5; } }
  .vfilter-check { width:16px; height:16px; flex-shrink:0; }
  .prod-page-hide { display: none !important; }
  .prod-pager { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; }
  .prod-pager button {
    min-width:40px; height:40px; padding:0 10px; border-radius:12px;
    border:1px solid var(--border,#e2e8f0); background:var(--card,#fff);
    color:var(--muted,#475569); font-weight:700; font-size:14px; cursor:pointer;
    transition:border-color .15s, color .15s, background .15s, transform .15s, box-shadow .15s;
  }
  .prod-pager button:hover:not(:disabled) { border-color:var(--accent,#2563eb); color:var(--accent,#2563eb); transform:translateY(-1px); }
  .prod-pager button.on { background:var(--accent,#2563eb); border-color:var(--accent,#2563eb); color:#fff; box-shadow:0 6px 16px -6px var(--accent,#2563eb); }
  .prod-pager button.on:hover { transform:translateY(-1px); }
  .prod-pager button:disabled { opacity:.4; cursor:default; }
  .prod-pager .pp-gap { min-width:18px; text-align:center; color:var(--muted,#94a3b8); font-weight:700; font-size:15px; user-select:none; }
  .prod-pager .pp-nav { font-size:17px; line-height:1; padding:0 6px; }
  .no-results-btn { background:var(--accent,#2563eb); color:#fff; border:none; border-radius:999px; padding:9px 20px; font-weight:800; font-size:12px; cursor:pointer; }
  /* Botón flotante del carrito: animación leve y color al tocarlo */
  .cart-fab { transition: transform .18s cubic-bezier(.22,1,.36,1), background .25s, box-shadow .25s; -webkit-tap-highlight-color: transparent; }
  .cart-fab:active { transform: scale(.85); }
  @keyframes cartTap { 0% { transform:scale(1); } 35% { transform:scale(.82) rotate(-6deg); } 70% { transform:scale(1.07); } 100% { transform:scale(1); } }
  .cart-fab.tapped { animation:cartTap .4s cubic-bezier(.22,1,.36,1); }
  /* ===== El carrito toma la apariencia de la tienda (mismos tokens que el catálogo) ===== */
  #chat-fab, #chat-panel {
    --cx-on: var(--on-accent, var(--soc-on-accent, #fff));
    --cx-line: color-mix(in srgb, var(--text, #0f172a) 14%, transparent);
    --cx-soft: color-mix(in srgb, var(--text, #0f172a) 5%, var(--bg-card, #fff));
    --cx-radius: var(--radius, 16px);
  }
  #chat-fab.cart-fab { background: var(--accent, #1e293b) !important; box-shadow: 0 8px 22px color-mix(in srgb, var(--accent, #1e293b) 38%, transparent) !important; }
  #chat-fab svg { stroke: var(--cx-on) !important; }
  #chat-fab.cart-fab:active, #chat-fab.cart-fab.tapped { background: var(--accent-light, var(--accent, #1e293b)) !important; }
  #chat-panel { background: var(--bg-card, #fff) !important; color: var(--text, #0f172a); border: 1px solid var(--cx-line); border-radius: min(var(--cx-radius), 24px) !important; font-family: var(--font-body, inherit); }
  #chat-panel > div:first-child { background: var(--accent, #1e293b) !important; color: var(--cx-on) !important; }
  #chat-panel > div:first-child * { color: var(--cx-on) !important; }
  #chat-panel > div:first-child #chat-close { background: color-mix(in srgb, var(--cx-on) 18%, transparent) !important; }
  #chat-panel > div:first-child > div > div:first-child { font-family: var(--font-heading, inherit); }
  #chat-panel > div:last-child { background: var(--cx-soft) !important; border-top: 1px solid var(--cx-line) !important; }
  #chat-panel input { background: var(--bg-card, #fff) !important; color: var(--text, #0f172a) !important; border: 1px solid var(--cx-line) !important; }
  #chat-panel input:focus { border-color: var(--accent, #1e293b) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #1e293b) 18%, transparent); }
  #chat-panel input::placeholder { color: var(--text-secondary, #64748b); opacity: .8; }
  #chat-panel [style*="color:#0f172a"] { color: var(--text, #0f172a) !important; }
  #chat-panel [style*="color:#64748b"], #chat-panel [style*="color:#94a3b8"], #chat-panel [style*="color:#475569"], #chat-panel [style*="color:#cbd5e1"] { color: var(--text-secondary, #64748b) !important; }
  #chat-panel [style*="background:#f8fafc"], #chat-panel [style*="background:#f1f5f9"], #chat-panel [style*="background:#e2e8f0"] { background: var(--cx-soft) !important; }
  #chat-panel [style*="solid #f1f5f9"], #chat-panel [style*="solid #e2e8f0"], #chat-panel [style*="solid #eef2f7"] { border-color: var(--cx-line) !important; }
  #chat-panel [style*="background:#1e293b"] { background: var(--accent, #1e293b) !important; color: var(--cx-on) !important; border-radius: min(var(--cx-radius), 14px) !important; }
  #chat-panel [style*="background:#e0f2fe"] { background: color-mix(in srgb, var(--accent, #0284c7) 16%, transparent) !important; color: var(--accent, #0284c7) !important; }
  #chat-panel [style*="color:#ef4444"] { color: #d1432f !important; }
  #chat-panel svg[stroke="#94a3b8"] { stroke: var(--text-secondary, #94a3b8); }
  .vp-val-on, .var-filter-active { background: var(--accent, #2563eb) !important; color: var(--on-accent, var(--soc-on-accent, #fff)) !important; border-color: var(--accent, #2563eb) !important; }
  .vfilter-check { accent-color: var(--accent, #2563eb); }

  /* ===== Pago con tarjeta dentro de la app ===== */
  .cp-overlay { position:fixed; inset:0; z-index:10001; display:flex; align-items:flex-end; justify-content:center; background:rgba(8,8,10,.55); backdrop-filter:blur(3px); opacity:0; transition:opacity .25s; }
  .cp-overlay.cp-in { opacity:1; }
  .cp-panel { width:100%; max-width:460px; max-height:94vh; overflow-y:auto; background:var(--bg-card, #fff); color:var(--text, #0f172a); border:1px solid color-mix(in srgb, var(--text, #0f172a) 14%, transparent); border-radius:min(var(--radius, 16px), 24px) min(var(--radius, 16px), 24px) 0 0; padding:18px 18px calc(18px + env(safe-area-inset-bottom)); font-family:var(--font-body, inherit); transform:translateY(24px); transition:transform .3s cubic-bezier(.22,1,.36,1); }
  .cp-overlay.cp-in .cp-panel { transform:none; }
  @media (min-width:560px) { .cp-overlay { align-items:center; } .cp-panel { border-radius:min(var(--radius, 16px), 24px); } }
  .cp-head { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:12px; }
  .cp-head b { display:block; font-family:var(--font-heading, inherit); font-size:1.15rem; }
  .cp-head span { font-size:13px; color:var(--text-secondary, #64748b); }
  .cp-x { min-width:44px; min-height:44px; border:0; border-radius:12px; background:none; color:var(--text-secondary, #64748b); font-size:16px; cursor:pointer; }
  .cp-x:hover { background:color-mix(in srgb, var(--text, #0f172a) 6%, transparent); }
  .cp-load { text-align:center; padding:28px 8px; font-size:13px; color:var(--text-secondary, #64748b); }
  .cp-err { color:#c2410c; font-weight:700; }
  .cp-alert { display:flex; gap:10px; align-items:flex-start; margin:0 0 12px; padding:12px 14px; border-radius:12px; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; font-size:13.5px; font-weight:700; line-height:1.4; animation:cpShake .4s; }
  .cp-alert i { font-style:normal; font-size:18px; line-height:1; }
  @keyframes cpShake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }
  .cp-note { margin-top:12px; font-size:11.5px; text-align:center; color:var(--text-secondary, #64748b); }
  .cp-ok { text-align:center; padding:20px 6px 6px; }
  .cp-ok-ic { width:64px; height:64px; margin:0 auto 12px; display:grid; place-items:center; border-radius:50%; background:color-mix(in srgb, var(--accent, #1e293b) 16%, transparent); color:var(--accent, #1e293b); font-size:30px; font-weight:800; }
  .cp-ok h3 { font-family:var(--font-heading, inherit); font-size:1.3rem; margin-bottom:6px; }
  .cp-ok p { font-size:14px; color:var(--text-secondary, #64748b); }
  .cp-done { margin-top:18px; width:100%; min-height:50px; border:0; border-radius:min(var(--radius, 16px), 14px); background:var(--accent, #1e293b); color:var(--on-accent, var(--soc-on-accent, #fff)); font-weight:700; font-size:15px; cursor:pointer; }

  /* ===== "Elige las opciones" (selector de variantes) con la apariencia de la tienda ===== */
  .vp-panel {
    --cx-on: var(--on-accent, var(--soc-on-accent, #fff));
    --cx-line: color-mix(in srgb, var(--text, #0f172a) 14%, transparent);
    --cx-soft: color-mix(in srgb, var(--text, #0f172a) 5%, var(--bg-card, #fff));
    background: var(--bg-card, #fff) !important; color: var(--text, #0f172a);
    border: 1px solid var(--cx-line); font-family: var(--font-body, inherit);
    border-radius: min(var(--radius, 16px), 24px) min(var(--radius, 16px), 24px) 0 0;
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
  }
  @media (min-width: 640px) { .vp-panel { border-radius: min(var(--radius, 16px), 24px); } }
  .vp-panel h3 { font-family: var(--font-heading, inherit); color: var(--text, #0f172a) !important; font-size: 1.1rem; }
  .vp-panel .text-slate-900, .vp-panel .text-slate-800 { color: var(--text, #0f172a) !important; }
  .vp-panel .text-slate-700, .vp-panel .text-slate-600, .vp-panel .text-slate-500, .vp-panel .text-slate-400 { color: var(--text-secondary, #64748b) !important; }
  .vp-panel .text-slate-400.hover\:text-slate-600, .vp-panel > div:first-child > button { min-width: 44px; min-height: 44px; border-radius: 12px; color: var(--text-secondary, #64748b) !important; }
  .vp-panel > div:first-child > button:hover { background: var(--cx-soft); color: var(--text, #0f172a) !important; }
  .vp-panel #vp-img { width: 72px; height: 72px; object-fit: contain; background: var(--cx-soft); border: 1px solid var(--cx-line) !important; border-radius: min(var(--radius, 16px), 16px) !important; box-shadow: none !important; }
  .vp-panel #vp-price { color: var(--accent, #1e293b) !important; font-family: var(--font-heading, inherit); font-size: 1.05rem; font-weight: 700; }
  .vp-panel .vp-val {
    min-height: 44px; padding: 0 18px !important; font-size: 14px !important;
    background: var(--bg-card, #fff) !important; color: var(--text, #0f172a) !important; border: 1px solid var(--cx-line) !important;
    border-radius: min(999px, calc(var(--radius, 16px) * 2.4)) !important;
    transition: border-color .2s, background .2s, transform .2s cubic-bezier(.34, 1.56, .64, 1);
  }
  .vp-panel .vp-val:hover { border-color: var(--accent, #1e293b) !important; }
  .vp-panel .vp-val:active { transform: scale(.95); }
  .vp-panel .vp-val.vp-val-on { background: var(--accent, #1e293b) !important; color: var(--cx-on) !important; border-color: var(--accent, #1e293b) !important; }
  .vp-panel #vp-add {
    min-height: 50px; background: var(--accent, #1e293b) !important; color: var(--cx-on) !important;
    border-radius: min(var(--radius, 16px), 14px) !important; font-size: 15px !important;
    transition: transform .2s cubic-bezier(.34, 1.56, .64, 1), background .2s;
  }
  .vp-panel #vp-add:hover:not(:disabled) { background: var(--accent-light, var(--accent, #1e293b)) !important; }
  .vp-panel #vp-add:active:not(:disabled) { transform: scale(.97); }
  .vp-panel #vp-add:disabled { background: var(--cx-soft) !important; color: var(--text-secondary, #94a3b8) !important; border: 1px solid var(--cx-line); }
  /* Drawer de filtros en móvil */
  @media (max-width: 1023px) {
    .catalog-sidebar {
      position: fixed !important; bottom: 0; left: 0; right: 0; z-index: 1250;
      background: #fff; border-radius: 20px 20px 0 0; padding: 16px 18px;
      max-height: 82vh; overflow-y: auto; margin: 0 !important; width: 100% !important;
      box-shadow: 0 -10px 40px rgba(0,0,0,.22);
      transform: translateY(112%); transition: transform .28s cubic-bezier(.2,0,0,1);
    }
    .catalog-sidebar.drawer-open { transform: translateY(0); }
    .catalog-sidebar > div { position: static !important; }
  }
</style>
<script>
  const SLUG = '<%= biz.slug %>';
  const STORE_NAME = '<%= biz.name.replace(/'/g, "\\'") %>';
  const STORE_WHATSAPP = '<%= biz.whatsapp %>';
  const STORE_LOGO = '<%= biz.logo || "/img/sin-imagen.svg" %>';
  const CURRENCY_SYMBOL = '<%= typeof currencySymbol !== "undefined" && currencySymbol ? currencySymbol : "$" %>';
  const CURRENCY_CODE = '<%= biz.currency || "MXN" %>';
  const CART_KEY = 'nessik_cart';
  const NO_IMAGE = '/img/sin-imagen.svg';
  function money(n) { return CURRENCY_SYMBOL + (Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')); }
  const PROMAP = Object.fromEntries(
    <%- safeJson((products || []).filter(p => !p.isAd).map(p => [String(p.id), { name: p.name, price: p.price, priceBase: p.price_base == null ? p.price : p.price_base, stock: p.stock === null || p.stock === undefined ? null : p.stock, madeToOrder: !!p.made_to_order, image: p.image || '/img/sin-imagen.svg', imgs: (p.imgs && p.imgs.length ? p.imgs : [p.image || '/img/sin-imagen.svg']), variants: (typeof p.variants === 'string' ? p.variants : ''), promoType: p.promo_type || '', promoGift: p.promo_gift || '', promoDesc: p.promo_desc || '' }])) %>
  );
  const CURRENT_STORE = { slug: SLUG, name: STORE_NAME, whatsapp: STORE_WHATSAPP, logo: STORE_LOGO, wa_message: <%- safeJson(biz.wa_message || '') %> };
  // Pago en línea: solo aplica al carrito de ESTA tienda (no a productos de
  // otras tiendas que llegaron como anuncio) — cada quien cobra con su propia
  // cuenta de Mercado Pago, ver Configuración → Pagos en línea. Por ahora
  // está oculto en el admin (ver config.ejs) y por lo tanto siempre false.
  const MP_ENABLED = <%- biz.mp_enabled ? 'true' : 'false' %>;
  // Pago con tarjeta dentro de la app: requiere Access Token + Public Key de la tienda
  const MP_PUBLIC_KEY = <%- safeJson((biz.mp_enabled && biz.mp_access_token && biz.mp_public_key) ? biz.mp_public_key : '') %>;
  const MP_CARD = !!MP_PUBLIC_KEY;
  // Dueño/empleado con sesión activa: puede registrar la venta como pago en efectivo
  const IS_ADMIN = <%- (typeof isAdmin !== 'undefined' && isAdmin) ? 'true' : 'false' %>;
  // Transferencia bancaria: igual solo para el carrito de esta tienda.
  const TRANSFER = null; // la transferencia bancaria ya no se ofrece: solo pago en línea
  const HORARIO_RAW = <%- safeJson(biz.horario || '') %>;
  const HORARIO_MSG = <%- safeJson(biz.horario_msg || '') %>;

  function horarioAbierto() {
    let arr = [];
    try { arr = JSON.parse(HORARIO_RAW || '[]'); } catch (e) { arr = []; }
    if (!Array.isArray(arr) || !arr.length) return true;
    const now = new Date();
    const dow = now.getDay();
    const dayNum = dow === 0 ? 7 : dow;
    const mins = now.getHours() * 60 + now.getMinutes();
    const dia = arr.find(x => x && Number(x.d) === dayNum);
    if (!dia || !dia.o || !dia.c) return false;
    const toM = s => { const p = String(s).split(':'); return (parseInt(p[0], 10) || 0) * 60 + (parseInt(p[1], 10) || 0); };
    return mins >= toM(dia.o) && mins < toM(dia.c);
  }
  function closedMsg() { return HORARIO_MSG || 'Estamos cerrados ahora. Recibimos tu pedido y te respondemos en cuanto abramos.'; }

  function normVariantModel(v) {
    const empty = { attrs: [], images: {}, stock: {}, prices: {} };
    if (!v) return empty;
    let raw = v;
    if (typeof v === 'string') {
      const s = v.trim();
      if (!s) return empty;
      try { raw = JSON.parse(s); } catch (e) { raw = s; }
    }
    if (raw == null) return empty;
    if (!Array.isArray(raw) && raw && Array.isArray(raw.attrs)) {
      const attrs = raw.attrs.map(a => ({ name: String((a && a.name) || '').trim(), values: Array.isArray(a && a.values) ? a.values.map(x => String(x).trim()).filter(Boolean) : [] })).filter(a => a.name && a.values.length);
      const images = (raw.images && typeof raw.images === 'object') ? raw.images : {};
      const stock = (raw.stock && typeof raw.stock === 'object') ? raw.stock : {};
      const prices = (raw.prices && typeof raw.prices === 'object') ? raw.prices : {};
      const baseprices = (raw.baseprices && typeof raw.baseprices === 'object') ? raw.baseprices : null;
      return { attrs, images, stock, prices, baseprices };
    }
    if (Array.isArray(raw)) {
      const values = [];
      const images = {};
      raw.forEach(x => {
        if (typeof x === 'string') { const n = x.trim(); if (n && values.indexOf(n) === -1) values.push(n); }
        else if (x && typeof x === 'object') { const n = String(x.name || '').trim(); if (!n) return; if (values.indexOf(n) === -1) values.push(n); if (x.image) images[n] = String(x.image).trim(); }
      });
      if (!values.length) return empty;
      return { attrs: [{ name: '', values }], images, stock: {}, prices: {} };
    }
    if (typeof raw === 'string') {
      const values = raw.split(',').map(s => s.trim()).filter(Boolean);
      if (!values.length) return empty;
      return { attrs: [{ name: '', values }], images: {}, stock: {}, prices: {} };
    }
    return empty;
  }

  function loadCart() {
    try {
      const raw = localStorage.getItem(CART_KEY);
      const obj = raw ? JSON.parse(raw) : {};
      Object.keys(obj).forEach(k => {
        if (!obj[k] || !obj[k].store) { delete obj[k]; return; }
        obj[k].qty = parseInt(obj[k].qty) || 0;
      });
      return obj;
    } catch (e) { return {}; }
  }
  let cart = loadCart();
  function saveCart() {
    try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) {}
  }

  function toast(msg, ok) {
    let t = document.getElementById('cart-toast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'cart-toast';
      t.className = 'fixed left-1/2 -translate-x-1/2 bottom-24 z-[10001] px-4 py-2.5 rounded-xl text-sm font-bold text-white shadow-lg transition-all duration-300 opacity-0 translate-y-2';
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.style.background = ok ? '#10b981' : '#ef4444';
    t.style.opacity = '1';
    t.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(t._t);
    t._t = setTimeout(() => { t.style.opacity = '0'; }, 2200);
  }

  function variantPicker(id) {
    const p = PROMAP[String(id)];
    const vm = normVariantModel(p.variants);
    if (!vm.attrs.length) return;
    const sel = {};
    vm.attrs.forEach(a => { if (a.values && a.values.length === 1) sel[a.name] = a.values[0]; });
    // Quién abrió el selector — para devolverle el foco al cerrar y para que
    // la relación espacial (tarjeta que originó la acción) se conserve.
    const opener = document.activeElement;
    const modal = document.createElement('div');
    // z-[10000]: por encima del modal de vista rápida del producto (.pd-overlay,
    // z-index:9998) — si no, el selector de variantes abría oculto detrás de él
    // (parecía que no pasaba nada / que el producto no tenía variantes).
    // vp-overlay/vp-panel: overlay y contenido entran por separado (140ms /
    // 280-360ms) — en móvil sube como bottom sheet, en escritorio panel centrado.
    modal.className = 'vp-overlay fixed inset-0 z-[10000] flex items-end sm:items-center justify-center bg-black/50 backdrop-blur-sm';
    function close() {
      modal.classList.remove('vp-in');
      document.removeEventListener('keydown', onKeydown);
      setTimeout(function () { modal.remove(); }, 300);
      if (opener && opener.focus) opener.focus({ preventScroll: true });
    }
    function onKeydown(e) { if (e.key === 'Escape') close(); }
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', onKeydown);

    const panel = document.createElement('div');
    panel.className = 'vp-panel bg-white w-full sm:max-w-sm sm:rounded-2xl rounded-t-2xl p-5 shadow-2xl max-h-[92vh] overflow-y-auto';
    panel.setAttribute('tabindex', '-1');
    panel.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-extrabold text-slate-900">Elige las opciones</h3>
        <button type="button" class="text-slate-400 hover:text-slate-600 font-bold px-2">✕</button>
      </div>
      <div class="flex items-center gap-3 mb-4">
        <img id="vp-img" src="${p.image}" onerror="this.src=NO_IMAGE" class="w-16 h-16 rounded-2xl object-cover border border-slate-100 shadow-sm">
        <div class="min-w-0">
          <p class="text-sm font-bold text-slate-800 truncate">${p.name}</p>
          <p id="vp-price" class="text-sm text-slate-500 font-bold mt-0.5">${money(p.price)}</p>
          <p id="vp-sel" class="text-xs text-slate-400 mt-0.5"></p>
        </div>
      </div>
      <div id="vp-groups" class="space-y-3"></div>
      <button id="vp-add" type="button" disabled class="w-full mt-4 bg-blue-600 disabled:bg-slate-300 disabled:cursor-not-allowed text-white text-sm font-bold px-5 py-3 rounded-xl transition">Agregar</button>`;

    const groups = panel.querySelector('#vp-groups');
    const img = panel.querySelector('#vp-img');
    const selEl = panel.querySelector('#vp-sel');
    const priceEl = panel.querySelector('#vp-price');
    const addBtn = panel.querySelector('#vp-add');

    function comboKey() {
      return vm.attrs.map(a => sel[a.name] || '').join('|');
    }
    function refresh() {
      const key = comboKey();
      img.src = vm.images[key] || p.image;
      const parts = vm.attrs.map(a => sel[a.name] || '…');
      const complete = vm.attrs.every(a => sel[a.name]);
      const st = complete ? vm.stock[key] : undefined;
      const comboPrice = (complete && vm.prices[key]) ? Number(vm.prices[key]) : p.price;
      priceEl.textContent = money(comboPrice);
      let hint = parts.join(' / ');
      if (complete) hint += p.madeToOrder ? ' · Por pedido' : (st !== undefined ? (st <= 0 ? ' · Agotado' : ' · quedan ' + st) : '');
      selEl.textContent = hint;
      addBtn.disabled = !complete || (!p.madeToOrder && st !== undefined && st <= 0);
      addBtn.textContent = (complete && !p.madeToOrder && st !== undefined && st <= 0) ? 'Agotado' : 'Agregar';
    }

    vm.attrs.forEach(attr => {
      const name = attr.name || 'Atributo';
      const grp = document.createElement('div');
      grp.innerHTML = '<p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-1.5">' + name.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</p>';
      const row = document.createElement('div');
      row.className = 'flex flex-wrap gap-1.5';
      attr.values.forEach(v => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'vp-val text-sm font-semibold px-3 py-1.5 rounded-full border border-slate-200 bg-white text-slate-600 transition';
        b.textContent = v;
        b.addEventListener('click', () => {
          sel[attr.name] = v;
          row.querySelectorAll('.vp-val').forEach(x => { x.classList.remove('vp-val-on'); });
          b.classList.add('vp-val-on');
          refresh();
        });
        row.appendChild(b);
      });
      grp.appendChild(row);
      groups.appendChild(grp);
    });

    addBtn.addEventListener('click', () => {
      const label = vm.attrs.map(a => sel[a.name]).join(' / ');
      const key = comboKey();
      const imgv = vm.images[key] || p.image;
      const comboPrice = (vm.prices[key]) ? Number(vm.prices[key]) : p.price;
      // Solo cierra (y por tanto solo entonces puede dispararse la animación
      // hacia el carrito, ver addToCart) si de verdad se agregó.
      if (addToCart(id, p.name, comboPrice, label, CURRENT_STORE, imgv)) close();
    });

    panel.querySelector('button').addEventListener('click', close);
    modal.appendChild(panel);
    document.body.appendChild(modal);
    refresh();
    requestAnimationFrame(function () { requestAnimationFrame(function () { modal.classList.add('vp-in'); }); });
    setTimeout(function () { panel.focus({ preventScroll: true }); }, 320);
  }

  function itemKey(storeSlug, id, variant) {
    return storeSlug + ':' + String(id) + (variant ? '|' + variant : '');
  }
  // Devuelve true solo si de verdad se agregó al carrito. Los llamadores que
  // encadenan "✓ Agregado" / auto-cerrar en el mismo onclick deben checar este
  // valor: si el producto tiene variantes y aún no se eligió una, esto solo
  // abre el selector (variantPicker) y no agrega nada todavía.
  function addToCart(id, name, price, variant, store, image) {
    const s = store || CURRENT_STORE;
    const p = PROMAP[String(id)];
    if (!p) { toast('Producto no encontrado', false); return false; }
    if (!name) name = p.name;
    name = String(name).replace(/<[^>]*>/g, '').trim();
    if (!name) name = 'Producto';
    if (price == null || price === 0) price = p.price;
    if (!price || price <= 0) { toast('Precio invalido', false); return false; }
    if (!image) image = p.image;
    const pvm = normVariantModel(p.variants);
    if (!p.madeToOrder && !pvm.attrs.length && (p.stock === null || p.stock === undefined || p.stock <= 0)) { toast('Producto agotado 😕', false); return false; }
    // Variante única (cada atributo con una sola opción): se agrega directo, sin selector
    if (pvm.attrs.length && !variant && pvm.attrs.every(a => a.values && a.values.length === 1)) variant = pvm.attrs.map(a => a.values[0]).join(' / ');
    if (pvm.attrs.length && !variant) { variantPicker(id); return false; }
    const key = itemKey(s.slug, id, variant);
    // stock por combinación
    if (!p.madeToOrder && variant && pvm.stock) {
      const ck = variant.split(' / ').join('|');
      const st = pvm.stock[ck];
      if (st === undefined || st <= 0) { toast('Esa combinación está agotada 😕', false); return false; }
    }
    cart[key] = cart[key] || { store: s, id, name, price: Number(price), image: image || p.image, variant: variant || '', qty: 0 };
    if (!p.madeToOrder && !pvm.attrs.length && p.stock !== null && cart[key].qty + 1 > p.stock) { toast('Stock máximo disponible', false); return false; }
    if (!p.madeToOrder && variant && pvm.stock) {
      const ck = variant.split(' / ').join('|');
      const st = pvm.stock[ck];
      if (st !== undefined && cart[key].qty + 1 > st) { toast('Solo quedan ' + st + ' de esa combinación', false); return false; }
    }
    cart[key].qty++;
    saveCart();
    renderCart();
    if (window.haptic) window.haptic();
    toast('Agregado al pedido ✓', true);
    // Conecta la tarjeta que originó la acción con el contador del carrito —
    // segundo momento importante de la experiencia. Se ubica por el botón
    // recién pulsado (activeElement en un click síncrono) para no tener que
    // pasar el elemento por cada uno de los muchos onclick="addToCart(...)".
    try {
      var originBtn = document.activeElement;
      var originCard = originBtn && originBtn.closest ? originBtn.closest('.prod-card, .oferta-card, .pd-modal, .vp-panel') : null;
      if (originCard && window.flyToCart) {
        var originImg = originCard.querySelector('.prod-img-wrap img, .oferta-img-wrap img, .pd-img-col img, #vp-img');
        window.flyToCart(originImg || originCard, image);
      }
    } catch (e) {}
    return true;
  }
  function addAdToCart(btn) {
    const d = btn.dataset;
    const store = { slug: d.storeSlug, name: d.storeName, whatsapp: d.storeWhatsapp, logo: d.storeLogo || NO_IMAGE, wa_message: d.storeWaMessage || '' };
    addToCart(d.id, d.name, parseFloat(d.price), '', store, d.image || NO_IMAGE);
  }
  // Actualiza cifra y total en el propio DOM (sin reconstruir todo el carrito)
  // cuando la fila ya está pintada; si no, deja que renderCart() haga el
  // trabajo normal (p.ej. la primera vez que aparece un producto nuevo).
  function _bump(el) {
    if (!el) return;
    el.style.transform = 'scale(1.22)';
    requestAnimationFrame(function () { el.style.transform = ''; });
  }
  function _patchCartRow(key) {
    const it = cart[key];
    if (!it) return false;
    const qtyEl = document.querySelector('[data-qty="' + CSS.escape(key) + '"]');
    const lineEl = document.querySelector('[data-line="' + CSS.escape(key) + '"]');
    if (!qtyEl || !lineEl) return false;
    qtyEl.textContent = it.qty;
    _bump(qtyEl);
    lineEl.textContent = money(it.price * it.qty);
    const row = qtyEl.closest('[data-row]');
    const groupEl = row ? row.closest('[data-store-group]') : null;
    if (groupEl) {
      const slug = groupEl.getAttribute('data-store-group');
      const g = storeGroups().find(function (x) { return x.store.slug === slug; });
      const subEl = document.querySelector('[data-store-sub="' + CSS.escape(slug) + '"]');
      if (g && subEl) {
        const n = g.items.reduce(function (s, i) { return s + i.qty; }, 0);
        const t = g.items.reduce(function (s, i) { return s + i.qty * i.price; }, 0);
        subEl.textContent = n + ' producto' + (n === 1 ? '' : 's') + ' · Total ' + money(t);
      }
    }
    const sub = document.getElementById('chat-sub');
    if (sub) {
      const groups = storeGroups();
      const n = cartItems().reduce(function (s, i) { return s + i.qty; }, 0);
      sub.textContent = groups.length ? (groups.length + (groups.length === 1 ? ' tienda · ' : ' tiendas · ') + n + ' producto' + (n === 1 ? '' : 's')) : 'Tu carrito está vacío';
    }
    return true;
  }
  // Colapsa la fila eliminada (fade + escala, técnica barata) y solo entonces
  // corre el callback que quita el ítem y refresca totales.
  function _removeCartRow(key, cb) {
    const row = document.querySelector('[data-row="' + CSS.escape(key) + '"]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!row || reducedMotion) { cb(); return; }
    row.classList.add('chat-row-leaving');
    setTimeout(cb, 190);
  }
  function setQty(key, delta) {
    const it = cart[key];
    if (!it) return;
    const p = PROMAP[String(it.id)];
    it.qty += delta;
    if (isNaN(it.qty) || it.qty <= 0) {
      _removeCartRow(key, function () { delete cart[key]; saveCart(); renderCart(); });
      return;
    }
    if (p && !p.madeToOrder) {
      const pvm = normVariantModel(p.variants);
      // Con variantes, p.stock siempre es null (vive por combinación) —
      // antes eso hacía que el tope de stock se saltara por completo al
      // subir la cantidad desde el carrito con los botones +/-.
      let cap = null;
      if (it.variant && pvm.stock) {
        const ck = it.variant.split(' / ').join('|');
        const st = pvm.stock[ck];
        if (st !== undefined) cap = st;
      } else if (p.stock !== null) {
        cap = p.stock;
      }
      if (cap !== null && it.qty > cap) {
        if (cap <= 0) {
          _removeCartRow(key, function () { delete cart[key]; saveCart(); renderCart(); });
          toast('Ya no hay disponibles', false);
          return;
        }
        it.qty = cap;
        toast('Stock máximo disponible', false);
      }
    }
    saveCart();
    if (!_patchCartRow(key)) renderCart();
    else { renderFab(); const totEl = document.getElementById('cart-total'); if (totEl) { const subtotal = cartItems().reduce((s, i) => s + i.qty * i.price, 0); totEl.textContent = money(subtotal); } const countEl = document.getElementById('cart-count'); if (countEl) countEl.textContent = cartItems().reduce((s, i) => s + i.qty, 0); }
  }
  function cartItems() {
    return Object.values(cart);
  }
  function storeGroups() {
    const g = {};
    Object.keys(cart).forEach(k => {
      const it = cart[k];
      if (!it || !it.store) return;
      (g[it.store.slug] = g[it.store.slug] || { store: it.store, items: [] }).items.push(Object.assign({ key: k }, it));
    });
    return Object.values(g);
  }
  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function jattr(v) { return JSON.stringify(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }
  function renderCart() {
    const items = cartItems();
    const total = items.reduce((s, it) => s + it.qty, 0);
    const subtotal = items.reduce((s, it) => s + (it.qty * it.price), 0);
    const countEl = document.getElementById('cart-count');
    if (countEl) { countEl.textContent = total; countEl.style.display = total > 0 ? 'flex' : 'none'; }
    const totEl = document.getElementById('cart-total');
    if (totEl) totEl.textContent = money(subtotal);
    const bar = document.getElementById('cart-bar');
    if (bar) {
      if (total > 0) { bar.classList.remove('hidden'); bar.classList.add('flex'); }
      else { bar.classList.add('hidden'); bar.classList.remove('flex'); }
    }
    renderChat();
    renderFab();
  }

