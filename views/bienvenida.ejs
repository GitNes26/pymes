<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Bienvenida', biz }) %>
</head>
<body class="m-material min-h-screen" style="background:var(--ap-bg);color:var(--ap-text)">

  <main class="max-w-2xl mx-auto px-4 py-10 md:py-16">

    <!-- Progreso -->
    <div class="flex items-center justify-center gap-2 mb-10" id="wz-dots">
      <span class="wz-dot" data-dot="1"></span>
      <span class="wz-dot" data-dot="2"></span>
      <span class="wz-dot" data-dot="3"></span>
    </div>

    <form method="POST" action="/<%= biz.slug %>/admin/bienvenida" id="wz-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="giro_preset" id="wz-giro-preset" value="">
      <input type="hidden" name="estilo" id="wz-estilo" value="">
      <input type="hidden" name="color" id="wz-color" value="">

      <!-- ===== Paso 1: giro ===== -->
      <section class="wz-step" data-step="1">
        <div class="text-center mb-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color:var(--ap-text-sec)">Paso 1 de 3</p>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight mt-2" style="color:var(--ap-text)">Hola, <%= biz.name %> 👋</h1>
          <p class="mt-3 text-[15px] max-w-md mx-auto" style="color:var(--ap-text-sec)">Cuéntanos a qué te dedicas y preparamos tu catálogo a tu medida — diseño, categorías y todo listo para que solo agregues tus productos.</p>
        </div>

        <div class="relative max-w-sm mx-auto mb-5">
          <input type="text" id="wz-giro-search" placeholder="Busca tu giro (ej: panadería, ropa, taller...)" class="w-full text-sm rounded-full px-4 py-2.5 outline-none" style="border:1px solid var(--ap-border);background:var(--ap-card);color:var(--ap-text)">
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="wz-giro-grid">
          <% GIRO_PRESETS.forEach(p => { %>
            <button type="button" class="wz-card" data-giro="<%= p.id %>" data-search="<%= (p.nombre + ' ' + p.descripcion).toLowerCase() %>">
              <span class="text-2xl"><%= p.emoji %></span>
              <span class="wz-card-title"><%= p.nombre %></span>
              <span class="wz-card-desc"><%= p.descripcion %></span>
            </button>
          <% }) %>
          <p class="text-sm text-center col-span-2 sm:col-span-3 hidden" id="wz-giro-empty" style="color:var(--ap-text-sec)">Ningún giro coincide — elige "Otro negocio" o prueba con otra palabra.</p>
        </div>

        <div class="text-center mt-8 wz-cta-bar">
          <button type="button" class="m-btn m-btn-filled px-8" id="wz-next-1" disabled>Siguiente →</button>
          <p class="mt-4">
            <button type="submit" name="skip" value="1" class="text-[13px] font-medium" style="color:var(--ap-text-sec);background:none;border:none;cursor:pointer;text-decoration:underline">Prefiero configurarlo yo mismo</button>
          </p>
        </div>
      </section>

      <!-- ===== Paso 2: vibra / estilo ===== -->
      <section class="wz-step hidden" data-step="2">
        <div class="text-center mb-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color:var(--ap-text-sec)">Paso 2 de 3</p>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight mt-2" style="color:var(--ap-text)">¿Qué vibra quieres transmitir?</h1>
          <p class="mt-3 text-[15px] max-w-md mx-auto" style="color:var(--ap-text-sec)">Ya elegimos algo que suele funcionar para tu giro. Si prefieres otra onda, tú decides.</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="wz-vibe-grid">
          <% VIBE_OPTIONS.forEach(v => { %>
            <button type="button" class="wz-card wz-vibe-card" data-estilo="<%= v.estilo %>" data-color="<%= v.color %>">
              <span class="wz-swatch" data-swatch="<%= v.color %>"></span>
              <span class="wz-card-title"><%= v.nombre %></span>
              <span class="wz-card-badge" data-recommended-badge hidden>Recomendado</span>
            </button>
          <% }) %>
        </div>

        <div class="text-center mt-8 flex items-center justify-center gap-3">
          <button type="button" class="m-btn m-btn-outlined px-6" id="wz-back-2">← Atrás</button>
          <button type="button" class="m-btn m-btn-filled px-8" id="wz-next-2">Siguiente →</button>
        </div>
      </section>

      <!-- ===== Paso 3: resumen ===== -->
      <section class="wz-step hidden" data-step="3">
        <div class="text-center mb-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em]" style="color:var(--ap-text-sec)">Paso 3 de 3</p>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight mt-2" style="color:var(--ap-text)">Así vamos a preparar tu catálogo</h1>
          <p class="mt-3 text-[15px] max-w-md mx-auto" style="color:var(--ap-text-sec)">Puedes cambiar cualquier cosa después, desde tu panel.</p>
        </div>

        <div class="rounded-2xl p-6 md:p-8" style="background:var(--ap-card);border:1px solid var(--ap-border);box-shadow:var(--ap-shadow)">
          <div class="flex items-center gap-4 pb-5" style="border-bottom:1px solid var(--ap-border)">
            <span class="text-3xl" id="wz-summary-emoji"></span>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em]" style="color:var(--ap-text-sec)">Giro</p>
              <p class="font-semibold text-[15px]" id="wz-summary-giro" style="color:var(--ap-text)"></p>
            </div>
          </div>
          <div class="flex items-center gap-4 py-5" style="border-bottom:1px solid var(--ap-border)">
            <span class="wz-swatch" id="wz-summary-swatch"></span>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em]" style="color:var(--ap-text-sec)">Vibra</p>
              <p class="font-semibold text-[15px]" id="wz-summary-vibe" style="color:var(--ap-text)"></p>
            </div>
          </div>
          <div class="pt-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] mb-2" style="color:var(--ap-text-sec)">Categorías que crearemos por ti</p>
            <div class="flex flex-wrap gap-1.5" id="wz-summary-cats"></div>
          </div>
        </div>

        <!-- Demo animada: con el plan gratis, el catálogo muestra productos de
             otras tiendas ("también te puede interesar") — se enseña aquí para
             que el dueño vea cómo se ve en vez de solo leerlo. -->
        <div class="rounded-2xl p-5 md:p-6 mt-4" style="background:var(--ap-card);border:1px solid var(--ap-border);box-shadow:var(--ap-shadow)">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-lg">📣</span>
            <p class="font-semibold text-[15px]" style="color:var(--ap-text)">Así se verán los anuncios de otras tiendas</p>
          </div>
          <p class="text-[13px] mb-4" style="color:var(--ap-text-sec)">Con el plan gratis, tu catálogo incluye una franja "También te puede interesar" con productos de otras tiendas — te ayuda a empezar sin costo. Puedes quitarla cuando quieras con el plan Pro.</p>
          <div class="wz-ad-demo" id="wz-ad-demo">
            <div class="wz-ad-demo-label">También te puede interesar</div>
            <div class="wz-ad-demo-track">
              <% const wzAdDemo = [
                { c1: '#fb923c', c2: '#ef4444', store: 'Ferretería El Toro', price: '$189.00' },
                { c1: '#34d399', c2: '#0ea5e9', store: 'Cafetería Aroma', price: '$65.00' },
                { c1: '#a78bfa', c2: '#ec4899', store: 'Boutique Lía', price: '$349.00' },
                { c1: '#fbbf24', c2: '#f97316', store: 'Dulcería Sol', price: '$45.00' }
              ]; %>
              <% wzAdDemo.forEach((ad, i) => { %>
                <div class="wz-ad-demo-card" style="animation-delay:<%= i * 0.18 %>s">
                  <div class="wz-ad-demo-img" style="background:linear-gradient(135deg,<%= ad.c1 %>,<%= ad.c2 %>)"></div>
                  <div class="wz-ad-demo-store"><%= ad.store %></div>
                  <div class="wz-ad-demo-price"><%= ad.price %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="text-center mt-8 flex items-center justify-center gap-3">
          <button type="button" class="m-btn m-btn-outlined px-6" id="wz-back-3">← Atrás</button>
          <button type="submit" class="m-btn m-btn-filled px-8" id="wz-submit">Crear mi catálogo 🚀</button>
        </div>
      </section>

    </form>
  </main>

  <style>
    .wz-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--ap-border); transition: background .2s, width .2s; }
    .wz-dot.wz-dot-active { background: var(--ap-accent); width: 22px; }
    .wz-dot.wz-dot-done { background: var(--ap-accent); opacity: .4; }

    .wz-card {
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px;
      padding: 18px 10px; border-radius: var(--ap-radius); border: 1px solid var(--ap-border);
      background: var(--ap-card); cursor: pointer; transition: border-color .15s, box-shadow .15s;
    }
    .wz-card:hover { border-color: rgba(44,44,46,.3); }
    .wz-card.wz-card-selected { border-color: var(--ap-accent); box-shadow: 0 0 0 1px var(--ap-accent); }
    .wz-card-title { font-size: 13px; font-weight: 600; color: var(--ap-text); }
    .wz-card-desc { font-size: 11px; color: var(--ap-text-sec); }
    .wz-card-badge {
      font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
      color: var(--ap-accent-text); background: rgba(44,44,46,.08); border-radius: 999px; padding: 2px 8px; margin-top: 2px;
    }
    .wz-swatch { width: 28px; height: 28px; border-radius: 8px; display: inline-block; flex: none; }
    #wz-giro-search:focus { border-color: var(--ap-accent); }
    /* El paso 1 muestra 100 giros — sin esto, el botón "Siguiente" solo se
       ve hasta scrollear toda la cuadrícula. Al quedar sticky, siempre está
       a un tap de distancia sin importar cuántos giros haya arriba. */
    .wz-cta-bar {
      position: sticky; bottom: 0; z-index: 10;
      background: var(--ap-bg); padding-top: 14px; padding-bottom: 14px;
      margin-left: -16px; margin-right: -16px; padding-left: 16px; padding-right: 16px;
    }

    /* Demo animada de la franja de anuncios (paso 3) */
    .wz-ad-demo { border-radius: var(--ap-radius); background: var(--ap-bg); padding: 14px; overflow: hidden; }
    .wz-ad-demo-label { font-size: 11px; font-weight: 700; color: var(--ap-text-sec); margin-bottom: 10px; }
    .wz-ad-demo-track { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 2px; }
    .wz-ad-demo-card {
      flex: 0 0 100px; opacity: 0; transform: translateY(10px) scale(.94);
      animation: wzAdIn .5s cubic-bezier(.22,1,.36,1) forwards;
    }
    .wz-ad-demo-img {
      width: 100px; height: 72px; border-radius: 12px; margin-bottom: 6px;
      box-shadow: 0 6px 16px -6px rgba(0,0,0,.25);
      background-size: 200% 200%; animation: wzAdGlow 3.5s ease-in-out infinite;
    }
    .wz-ad-demo-store { font-size: 10px; font-weight: 700; color: var(--ap-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wz-ad-demo-price { font-size: 11px; font-weight: 800; color: var(--ap-accent-text); }
    @keyframes wzAdIn { to { opacity: 1; transform: none; } }
    @keyframes wzAdGlow { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    /* Al reentrar al paso 3 se reinicia la animación quitando y reponiendo la clase */
    .wz-ad-demo-replay .wz-ad-demo-card { animation: none; }
  </style>

  <script>
    var GIRO_PRESETS = <%- safeJson(GIRO_PRESETS) %>;
    var VIBE_OPTIONS = <%- safeJson(VIBE_OPTIONS) %>;
    var COLORS_SWATCH = <%- safeJson(COLORS.map(function (c) { return { id: c.id, c1: c.c1, c2: c.c2 }; })) %>;
    var GIRO_CATEGORIAS = <%- safeJson(GIRO_CATEGORIAS) %>;

    function swatchGradient(colorId) {
      var c = COLORS_SWATCH.find(function (x) { return x.id === colorId; });
      if (!c) return '#e2e8f0';
      return 'linear-gradient(135deg,' + c.c1 + ',' + c.c2 + ')';
    }
    document.querySelectorAll('[data-swatch]').forEach(function (el) {
      el.style.background = swatchGradient(el.getAttribute('data-swatch'));
    });

    var state = { giro: null, estilo: null, color: null };

    function setDot(step) {
      document.querySelectorAll('.wz-dot').forEach(function (d) {
        var n = parseInt(d.getAttribute('data-dot'), 10);
        d.classList.toggle('wz-dot-active', n === step);
        d.classList.toggle('wz-dot-done', n < step);
      });
    }
    function goStep(step) {
      document.querySelectorAll('.wz-step').forEach(function (s) {
        s.classList.toggle('hidden', parseInt(s.getAttribute('data-step'), 10) !== step);
      });
      setDot(step);
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // Reinicia la animación de la demo de anuncios cada vez que se vuelve al paso 3
      if (step === 3) {
        var demo = document.getElementById('wz-ad-demo');
        if (demo) {
          demo.classList.add('wz-ad-demo-replay');
          void demo.offsetWidth; // fuerza reflow para que el navegador "olvide" el estado anterior
          demo.classList.remove('wz-ad-demo-replay');
        }
      }
    }

    // Buscador del paso 1: filtra los 100 giros por nombre/descripción para
    // no obligar a scrollear toda la cuadrícula buscando el propio.
    (function () {
      var search = document.getElementById('wz-giro-search');
      var empty = document.getElementById('wz-giro-empty');
      if (!search) return;
      search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        var cards = document.querySelectorAll('#wz-giro-grid .wz-card');
        var visible = 0;
        cards.forEach(function (card) {
          var match = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
          // Ojo: .wz-card ya define display:flex en su propia regla, así que
          // la clase utilitaria "hidden" de Tailwind pierde el empate de
          // especificidad y no ocultaba nada — por eso se fuerza inline.
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      });
    })();

    // Paso 1: elegir giro
    document.querySelectorAll('#wz-giro-grid .wz-card').forEach(function (card) {
      card.addEventListener('click', function () {
        document.querySelectorAll('#wz-giro-grid .wz-card').forEach(function (c) { c.classList.remove('wz-card-selected'); });
        card.classList.add('wz-card-selected');
        state.giro = card.getAttribute('data-giro');
        document.getElementById('wz-giro-preset').value = state.giro;
        document.getElementById('wz-next-1').disabled = false;
      });
    });
    document.getElementById('wz-next-1').addEventListener('click', function () {
      if (!state.giro) return;
      var preset = GIRO_PRESETS.find(function (p) { return p.id === state.giro; });
      // Preselecciona la vibra recomendada para este giro (si existe entre las opciones)
      var rec = VIBE_OPTIONS.find(function (v) { return v.estilo === preset.estilo; }) || VIBE_OPTIONS[0];
      document.querySelectorAll('#wz-vibe-grid .wz-card').forEach(function (c) {
        var isRec = c.getAttribute('data-estilo') === rec.estilo && c.getAttribute('data-color') === rec.color;
        c.querySelector('[data-recommended-badge]').hidden = !isRec;
      });
      selectVibe(rec.estilo, rec.color);
      goStep(2);
    });

    // Paso 2: elegir vibra
    function selectVibe(estilo, color) {
      state.estilo = estilo; state.color = color;
      document.getElementById('wz-estilo').value = estilo;
      document.getElementById('wz-color').value = color;
      document.querySelectorAll('#wz-vibe-grid .wz-card').forEach(function (c) {
        c.classList.toggle('wz-card-selected', c.getAttribute('data-estilo') === estilo && c.getAttribute('data-color') === color);
      });
    }
    document.querySelectorAll('#wz-vibe-grid .wz-card').forEach(function (card) {
      card.addEventListener('click', function () {
        selectVibe(card.getAttribute('data-estilo'), card.getAttribute('data-color'));
      });
    });
    document.getElementById('wz-back-2').addEventListener('click', function () { goStep(1); });
    document.getElementById('wz-next-2').addEventListener('click', function () {
      var preset = GIRO_PRESETS.find(function (p) { return p.id === state.giro; });
      var vibe = VIBE_OPTIONS.find(function (v) { return v.estilo === state.estilo && v.color === state.color; });
      document.getElementById('wz-summary-emoji').textContent = preset.emoji;
      document.getElementById('wz-summary-giro').textContent = preset.nombre;
      document.getElementById('wz-summary-vibe').textContent = vibe.nombre;
      document.getElementById('wz-summary-swatch').style.background = swatchGradient(state.color);
      var cats = GIRO_CATEGORIAS[state.giro] || GIRO_CATEGORIAS.otros;
      var catsWrap = document.getElementById('wz-summary-cats');
      catsWrap.innerHTML = '';
      cats.forEach(function (name) {
        var chip = document.createElement('span');
        chip.className = 'm-badge m-badge-neutral';
        chip.textContent = name;
        catsWrap.appendChild(chip);
      });
      goStep(3);
    });
    document.getElementById('wz-back-3').addEventListener('click', function () { goStep(2); });

    setDot(1);
  </script>
</body>
</html>
