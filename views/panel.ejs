<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Panel', biz }) %>
</head>
<body class="m-material min-h-screen" style="background:var(--ap-bg);color:var(--ap-text)">
  <%- include('admin/sidebar', { biz, active: 'panel', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="px-4 md:px-8 py-4 md:py-6 pb-24 md:pb-6">

      <!-- Encabezado compacto -->
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <div>
          <h1 class="text-lg md:text-xl font-extrabold tracking-tight" style="color:var(--ap-text);letter-spacing:-0.015em">Hola, <%= biz.name.split(' ')[0] %> 👋</h1>
          <p class="text-xs mt-0.5" style="color:var(--ap-text-sec)">Resumen de tu catálogo hoy.</p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/<%= biz.slug %>" target="_blank" class="m-btn m-btn-tonal m-btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
            Ver catálogo
          </a>

        </div>
      </div>

      <% if (error) { %>
        <div id="panel-error" class="mb-3 bg-[var(--md-error-container)] text-[#8c1d18] text-sm font-bold px-4 py-3 rounded-xl m-pop flex items-center gap-2">
          <span class="shrink-0">⚠️</span><%= error %>
        </div>
      <% } %>

      <% if (typeof bienvenida !== 'undefined' && bienvenida) { %>
        <div class="mb-3 rounded-2xl p-4 flex items-center gap-3 m-pop" style="background:rgba(44,44,46,.06);border:1px solid rgba(44,44,46,.15)">
          <span class="text-xl">🎉</span>
          <div>
            <p class="font-semibold text-sm" style="color:var(--ap-text)">¡Tu catálogo está listo, <%= biz.name.split(' ')[0] %>!</p>
            <p class="text-xs mt-0.5" style="color:var(--ap-text-sec)">Ya preparamos el diseño y las categorías. Ahora solo agrega tus productos.</p>
          </div>
        </div>
      <% } %>

      <% if (biz.plan === 'free') { %>
        <div class="mb-3 text-white rounded-2xl shadow-[var(--md-elevation-1)] px-4 py-3 flex items-center justify-between flex-wrap gap-2 m-ripple" style="background:#2c2c2e">
          <div class="flex items-center gap-3">
            <span class="text-xl">🚀</span>
            <div>
              <p class="font-extrabold text-sm">Plan Gratuito · <%= allProducts.length %>/<%= planMax %> productos</p>
              <p class="text-[11px] mt-0.5" style="color:rgba(255,255,255,.7)">Productos ilimitados y atributos con el plan Pro.</p>
            </div>
          </div>
          <a href="/<%= biz.slug %>/admin/config" class="m-btn m-btn-filled m-btn-sm !bg-white" style="color:#2c2c2e">Mejorar plan</a>
        </div>
      <% } %>

      <!-- Comparte tu catálogo (compacto) -->
      <section class="share-card mb-3 p-4 !text-white" style="border-radius:var(--ap-radius)">
        <div class="flex items-center justify-between flex-wrap gap-3" style="position:relative;z-index:1">
          <div class="flex-1 min-w-52">
            <p class="font-extrabold text-sm">Comparte tu catálogo 🚀</p>
            <div class="flex items-center gap-1.5 bg-white/15 rounded-full pl-3 pr-1.5 py-1 mt-2">
              <code class="flex-1 truncate text-[11px] font-bold"><%= storeUrl %></code>
              <button onclick="navigator.clipboard.writeText('<%= storeUrl %>').then(()=>{this.textContent='¡Copiado!';setTimeout(()=>this.textContent='Copiar',1500)})" class="m-btn m-btn-filled m-btn-sm !bg-white !text-emerald-700 shrink-0 !min-h-0 !py-1">Copiar</button>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-2">
              <a href="https://wa.me/?text=<%= encodeURIComponent('Mira mi catálogo: ' + storeUrl) %>" target="_blank" class="m-btn m-btn-sm !bg-white/15 !text-white hover:!bg-white/25">💬 WhatsApp</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(storeUrl) %>" target="_blank" class="m-btn m-btn-sm !bg-white/15 !text-white hover:!bg-white/25">📘 Facebook</a>
            </div>
          </div>
          <% if (typeof qrUrl !== 'undefined' && qrUrl) { %>
            <div class="rounded-2xl p-2 shrink-0 mx-auto md:mx-0" style="background:var(--ap-card)">
              <img src="<%= qrUrl %>" alt="Código QR del catálogo" class="w-24 h-24">
            </div>
          <% } %>
        </div>
      </section>

      <!-- Métricas clave -->
      <% const cards = [
        { label: 'Visitas hoy', value: stats.today, isNum: true, delta: stats.weekDelta, deltaLabel: 'vs. semana pasada', target: '#sec-charts' },
        { label: 'Ingresos cobrados', value: stats.revenue, isMoney: true, delta: stats.revenueDelta, deltaLabel: 'vs. semana pasada', title: 'Dinero que realmente entró: abonos cobrados + pedidos de contado cobrados (sin pendientes ni cancelados)', target: '#sec-pedidos' },
        { label: 'Pedidos WhatsApp', value: stats.waClicks, isNum: true, target: '#sec-funnel' },
        { label: 'Conversión', value: stats.conv, isPct: true, target: '#sec-funnel' }
      ]; %>
      <% if (stats.hasCostData) { cards.push({ label: 'Ganancia estimada', value: stats.profit, isMoney: true, title: 'Ingresos cobrados menos el costo de los productos vendidos que ya tienen costo capturado — si un producto no tiene costo, no se descuenta (es una estimación, no exacta).', target: '#sec-pedidos' }); } %>
      <section class="grid grid-cols-2 <%= cards.length > 4 ? 'lg:grid-cols-5' : 'lg:grid-cols-4' %> gap-4 md:gap-6 mb-8 md:mb-10">
        <% cards.forEach((c) => { %>
          <div class="rounded-2xl p-5 md:p-7 cursor-pointer transition-colors" style="background:var(--ap-card);border:1px solid var(--ap-border);box-shadow:var(--ap-shadow)" title="<%= c.title || '' %>" data-scroll-target="<%= c.target %>">
            <p class="text-[10.5px] font-semibold uppercase tracking-[0.12em]" style="color:var(--ap-text-sec)"><%= c.label %></p>
            <% if (c.isMoney) { %><p class="text-2xl md:text-3xl font-bold tracking-tight mt-3" style="color:var(--ap-text)" data-count="<%= c.value %>" data-prefix="$" data-decimals="2">$0.00</p><% } else if (c.isPct) { %><p class="text-2xl md:text-3xl font-bold tracking-tight mt-3" style="color:var(--ap-text)" data-count="<%= c.value %>" data-decimals="1">0.0%</p><% } else { %><p class="text-2xl md:text-3xl font-bold tracking-tight mt-3" style="color:var(--ap-text)" data-count="<%= c.value %>">0</p><% } %>
            <% if (typeof c.delta !== 'undefined') { %>
              <div class="mt-3 flex items-center gap-1.5">
                <span class="inline-flex items-center gap-0.5 rounded-full px-2 py-0.5 text-[11px] font-semibold"
                  style="<%= c.delta > 0 ? 'background:rgba(44,44,46,.08);color:var(--ap-accent-text)' : c.delta < 0 ? 'background:rgba(180,50,50,.08);color:#b43232' : 'background:var(--ap-bg);color:var(--ap-text-sec)' %>">
                  <% if (c.delta > 0) { %><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                  <% } else if (c.delta < 0) { %><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                  <% } %><%= Math.abs(c.delta) %>%
                </span>
                <span class="text-[11px]" style="color:var(--ap-text-sec)"><%= c.deltaLabel %></span>
              </div>
            <% } %>
          </div>
        <% }) %>
      </section>

      <% if (lowStock && lowStock.length > 0) { %>
        <section class="warning-card mb-3 px-4 py-3">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="text-xl">⚠️</span>
            <div class="flex-1 min-w-[200px]">
              <p class="text-sm font-extrabold" style="color:#a07d3c">Stock bajo en <%= lowStock.length %> producto(s)</p>
              <p class="text-xs mt-0.5 truncate" style="color:#b8892e">
                <% lowStock.slice(0, 6).forEach((p, i) => { %><%= i > 0 ? ' · ' : '' %><b><%= p.name %></b> (<%= p.stock <= 0 ? 'agotado' : p.stock %><% }) %>
                <% if (lowStock.length > 6) { %> y <%= lowStock.length - 6 %> más<% } %>
              </p>
            </div>
            <a href="/<%= biz.slug %>/admin/productos" class="m-btn m-btn-sm" style="background:var(--ap-accent-gold);color:#fff">Ver productos</a>
          </div>
        </section>
      <% } %>

      <% if (priceHistory && priceHistory.length > 0) { %>
        <section class="m-card p-4 mb-3">
          <div class="flex items-center justify-between mb-2">
            <h2 class="font-bold text-sm" style="color:var(--ap-text)">Historial de precios y promos</h2>
            <a href="/<%= biz.slug %>/admin/reporte" class="text-xs font-bold" style="color:var(--ap-accent-light)">Descargar CSV</a>
          </div>
          <div class="space-y-1 max-h-64 overflow-y-auto m-scroll">
            <% priceHistory.forEach(h => { %>
              <div class="flex items-center gap-2 text-xs py-1.5" style="border-bottom:1px solid var(--ap-border)">
                <span class="shrink-0 w-32" style="color:var(--ap-text-sec)"><%= fmtFecha(h.created_at) %></span>
                <span class="font-semibold truncate flex-1" style="color:var(--ap-text)"><%= h.name %></span>
                <span class="font-black shrink-0" style="color:var(--ap-text)"><%= money(h.price) %></span>
                <% if (h.old_price) { %><span class="line-through shrink-0" style="color:var(--ap-text-sec);opacity:0.5"><%= money(h.old_price) %></span><% } %>
                <% if (h.promo_type === 'regalo') { %><span class="m-badge m-badge-error shrink-0">🎁 <%= h.promo_gift %></span><% } else if (h.promo_type) { %><span class="m-badge m-badge-warn shrink-0"><%= h.promo_type %></span><% } %>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- Funnel + pedidos semana en una fila -->
      <div class="grid lg:grid-cols-3 gap-2.5 mb-3" id="sec-funnel">
        <section class="lg:col-span-2 m-card p-5">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="font-bold text-sm" style="color:var(--ap-text)">Funnel de ventas</h2>
              <p class="text-[11px]" style="color:var(--ap-text-sec)">De la visita al pedido</p>
            </div>
            <span class="m-badge m-badge-success" title="Abonos cobrados + contado cobrado en los últimos 7 días"><%= money(stats.revenueWeek) %> cobrado esta semana</span>
            <span class="m-badge m-badge-primary">Ticket prom. <%= money(stats.avgOrder) %></span>
          </div>
          <% const steps = [
            { label: 'Visitas', value: stats.total, pct: 100, color: 'from-neutral-800 to-neutral-600' },
            { label: 'Abrieron WhatsApp', value: stats.waClicks, pct: stats.total > 0 ? Math.round((stats.waClicks / stats.total) * 100) : 0, color: 'from-neutral-600 to-neutral-400' },
            { label: 'Pedidos', value: stats.orders, pct: stats.total > 0 ? Math.round((stats.orders / stats.total) * 100) : 0, color: 'from-emerald-500 to-teal-400' }
          ]; %>
          <div class="flex items-end justify-center gap-3">
            <% steps.forEach((s, si) => { %>
              <div class="flex-1 flex flex-col items-center gap-1.5">
                <div class="w-full rounded-lg bg-gradient-to-r <%= s.color %> transition-all duration-700" data-bar-v="<%= (s.pct / 100) * 64 %>" style="height: 0px"></div>
                <div class="text-center">
                  <p class="font-bold text-sm" style="color:var(--ap-text)"><%= s.value %></p>
                  <p class="text-[10px] font-semibold" style="color:var(--ap-text-sec)"><%= s.label %></p>
                  <p class="text-[10px] font-bold" style="color:<%= s.pct === 100 ? 'var(--ap-accent)' : 'var(--ap-text-sec)' %>"><%= s.pct %>%</p>
                </div>
              </div>
            <% }) %>
          </div>
          <p class="text-[11px] mt-2.5 text-center" style="color:var(--ap-text-sec)">Pedido → <b style="color:var(--ap-text)"><%= stats.orderRate %>%</b> · WhatsApp → <b style="color:var(--ap-text)"><%= stats.clickRate %>%</b></p>
        </section>

        <section class="m-card p-4">
          <h2 class="font-bold text-sm mb-3" style="color:var(--ap-text)">Productos más vistos</h2>
          <% if (stats.topProducts.length > 0) { %>
            <div class="space-y-2.5">
              <% const maxC = Math.max(...stats.topProducts.map(t => t.c), 1); %>
              <% stats.topProducts.forEach((t, i) => { %>
                <div>
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-semibold truncate pr-2" style="color:var(--ap-text)"><%= i + 1 %>. <%= t.name %></span>
                    <span class="font-bold shrink-0" style="color:var(--ap-text-sec)"><%= t.c %> <span class="font-normal opacity-70">vistas</span></span>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-bar-fill blue" style="width: 0%" data-bar="<%= Math.round((t.c / maxC) * 100) %>"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-6">
              <p class="text-2xl mb-1">🔍</p>
              <p class="text-xs text-slate-500 font-semibold">Sin datos todavía</p>
            </div>
          <% } %>
        </section>
      </div>

      <!-- Productos que más se piden por WhatsApp -->
      <% if (stats.topWaProducts && stats.topWaProducts.length > 0) { %>
        <section class="m-card p-4 mb-3">
          <h2 class="font-bold text-sm mb-3" style="color:var(--ap-text)">Productos que más se piden por WhatsApp 💬</h2>
          <div class="space-y-2.5">
            <% const maxW = Math.max(...stats.topWaProducts.map(t => t.c), 1); %>
            <% stats.topWaProducts.forEach((t, i) => { %>
              <div>
                <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-semibold truncate pr-2" style="color:var(--ap-text)"><%= i + 1 %>. <%= t.name %></span>
                    <span class="font-bold shrink-0" style="color:var(--ap-text-sec)"><%= t.c %> <span class="font-normal opacity-70">pedidos</span></span>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-bar-fill green" style="width: <%= Math.round((t.c / maxW) * 100) %>%"></div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- Productos más vendidos -->
      <% if (stats.topSellers && stats.topSellers.length > 0) { %>
        <section class="m-card p-4 mb-3">
          <h2 class="font-bold text-sm mb-3" style="color:var(--ap-text)">Productos más vendidos 🏆</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
            <% const maxS = Math.max(...stats.topSellers.map(t => t.c), 1); %>
            <% stats.topSellers.forEach((t, i) => { %>
              <div class="flex items-center gap-3 p-3 rounded-xl" style="border:1px solid var(--ap-border)">
                <span class="w-8 h-8 rounded-xl text-xs font-black flex items-center justify-center shrink-0" style="background:rgba(201,168,108,0.1);color:#a07d3c"><%= i + 1 %></span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold truncate" style="color:var(--ap-text)"><%= t.name %></p>
                  <div class="progress-bar mt-1">
                    <div class="progress-bar-fill gold" style="width: <%= Math.round((t.c / maxS) * 100) %>%"></div>
                  </div>
                </div>
                <span class="text-sm font-black shrink-0" style="color:var(--ap-text)"><%= t.c %></span>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- Gráficas de 7 días -->
      <div class="grid lg:grid-cols-2 gap-6 mb-10" id="sec-charts">
        <section class="rounded-2xl p-6 md:p-8" style="background:var(--ap-card);border:1px solid var(--ap-border);box-shadow:var(--ap-shadow)">
          <div class="mb-8 flex items-start justify-between">
            <div>
              <h2 class="text-base font-semibold" style="color:var(--ap-text)">Visitas</h2>
              <p class="mt-1 text-[13px]" style="color:var(--ap-text-sec)">Últimos 7 días</p>
            </div>
            <span class="text-[13px] font-medium" style="color:var(--ap-text-sec)"><%= stats.week %> <span style="opacity:.55">total</span></span>
          </div>
          <% if (stats.daily.length > 0) { %>
            <% const peakV = Math.max(...stats.daily.map(d => d.c)); %>
            <div class="flex items-end gap-2.5 h-40">
              <% stats.daily.forEach(d => { %>
                <div class="flex-1 flex flex-col items-center gap-2" title="<%= d.d %>: <%= d.c %> visitas">
                  <div class="w-full rounded-t-md transition-all" style="height:0;background:<%= d.c === peakV && peakV > 0 ? 'var(--ap-accent)' : 'var(--ap-border)' %>" data-bar-v="<%= Math.max(6, Math.round((d.c / (stats.week || 1)) * 130)) %>"></div>
                  <span class="text-[11px] font-medium truncate w-full text-center" style="color:var(--ap-text-sec)"><%= d.d.slice(8) %></span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-8 px-3">
              <p class="text-sm font-semibold" style="color:var(--ap-text)">Aún no hay visitas esta semana</p>
              <p class="text-[12px] mt-1" style="color:var(--ap-text-sec)">Comparte tu catálogo para comenzar a recibir visitas.</p>
            </div>
          <% } %>
        </section>

        <section class="rounded-2xl p-6 md:p-8" style="background:var(--ap-card);border:1px solid var(--ap-border);box-shadow:var(--ap-shadow)">
          <div class="mb-8 flex items-start justify-between">
            <div>
              <h2 class="text-base font-semibold" style="color:var(--ap-text)">Pedidos</h2>
              <p class="mt-1 text-[13px]" style="color:var(--ap-text-sec)">Últimos 7 días</p>
            </div>
          </div>
          <% if (stats.ordersDaily.length > 0) { %>
            <% const maxO = Math.max(...stats.ordersDaily.map(d => d.c), 1); %>
            <% const peakO = Math.max(...stats.ordersDaily.map(d => d.c)); %>
            <div class="flex items-end gap-2.5 h-40">
              <% stats.ordersDaily.forEach(d => { %>
                <div class="flex-1 flex flex-col items-center gap-2" title="<%= d.d %>: <%= d.c %> pedidos · <%= money(d.s) %>">
                  <div class="w-full rounded-t-md transition-all" style="height:0;background:<%= d.c === peakO && peakO > 0 ? 'var(--ap-accent)' : 'var(--ap-border)' %>" data-bar-v="<%= Math.max(6, Math.round((d.c / maxO) * 130)) %>"></div>
                  <span class="text-[11px] font-medium truncate w-full text-center" style="color:var(--ap-text-sec)"><%= d.d.slice(8) %></span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-8 px-3">
              <p class="text-sm font-semibold" style="color:var(--ap-text)">Sin pedidos esta semana todavía</p>
              <p class="text-[12px] mt-1" style="color:var(--ap-text-sec)">Los pedidos por WhatsApp aparecerán aquí apenas lleguen.</p>
            </div>
          <% } %>
        </section>
      </div>

      <!-- Pedidos recientes -->
      <section class="m-card p-4 mb-3" id="sec-pedidos">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-2.5">
          <div class="flex items-center gap-2">
            <h2 class="font-bold text-sm" style="color:var(--ap-text)">Pedidos recientes</h2>
            <% if (pending > 0) { %>
              <span class="m-badge m-badge-warn"><%= pending %> por cobrar</span>
            <% } %>
          </div>
          <a href="/<%= biz.slug %>/admin/reporte" class="m-btn m-btn-outlined m-btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 10v6m0 0l-3-3m3 3l3-3M4 18V6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2z"/></svg>
            Reporte Excel
          </a>
        </div>

        <% const estados = [
          { f: 'all', label: 'Todos', n: orders.length, cl: 'm-badge-neutral' },
          { f: 'nuevo', label: 'Nuevos', n: orders.filter(o => o.status === 'nuevo').length, cl: 'm-badge-primary' },
          { f: 'pendiente', label: 'Por cobrar', n: orders.filter(o => !o.paid && o.status !== 'cancelado').length, cl: 'm-badge-warn' },
          { f: 'abonos', label: 'Abonos', n: orders.filter(o => o.is_installment && (o.installment_paid || 0) < o.total && o.status !== 'cancelado').length, cl: 'm-badge-primary' },
          { f: 'pagado', label: 'Pagados', n: orders.filter(o => o.status === 'pagado').length, cl: 'm-badge-success' },
          { f: 'entregado', label: 'Entregados', n: orders.filter(o => o.status === 'entregado').length, cl: 'm-badge-success' },
          { f: 'cancelado', label: 'Cancelados', n: orders.filter(o => o.status === 'cancelado').length, cl: 'm-badge-error' }
        ]; %>

        <div class="flex flex-wrap items-center gap-1.5 mb-3" id="order-filters">
          <% estados.forEach(es => { %>
            <button data-f="<%= es.f %>" class="m-chip <%= es.f === 'all' ? 'm-chip-selected' : '' %>"><%= es.label %> <span class="m-badge <%= es.cl %> !h-5 !text-[10px]" style="<%= es.f === 'all' ? 'background:rgba(255,255,255,0.2);color:#fff' : '' %>"><%= es.n %></span></button>
          <% }) %>
        </div>

        <div class="flex flex-wrap items-center gap-2 mb-3">
          <div class="relative flex-1 min-w-[160px]">
            <input id="order-search" type="text" placeholder="Buscar pedido (producto o cliente)…" class="w-full text-xs" style="border:1px solid var(--ap-border);border-radius:12px;padding:6px 12px 6px 36px;background:var(--ap-card);color:var(--ap-text);outline:none">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
          </div>
          <select id="order-orden" class="border border-slate-200 rounded-lg px-2 py-1.5 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-neutral-400" style="background:var(--ap-card);color:var(--ap-text)">
            <option value="recientes">↓ Más recientes</option>
            <option value="antiguos">↑ Más antiguos</option>
            <option value="mayor">$ Mayor monto</option>
            <option value="menor">$ Menor monto</option>
          </select>
          <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto">
            <input id="order-desde" type="date" class="flex-1 min-w-0 sm:flex-none sm:w-auto border border-slate-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-neutral-400" title="Desde">
            <span class="text-slate-400 text-xs shrink-0">–</span>
            <input id="order-hasta" type="date" class="flex-1 min-w-0 sm:flex-none sm:w-auto border border-slate-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-neutral-400" title="Hasta">
            <button type="button" onclick="limpiarFiltrosPedidos()" class="text-xs font-bold text-neutral-600 hover:text-neutral-800 shrink-0">Limpiar</button>
          </div>
        </div>
        <p id="order-count" class="text-[11px] font-bold mb-2" style="color:var(--ap-text-sec)"></p>

        <% if (orders.length === 0) { %>
          <div class="text-center py-10 px-4 rounded-xl" style="border:2px dashed var(--ap-border)">
            <p class="text-3xl mb-2">🧾</p>
            <p class="text-sm font-bold" style="color:var(--ap-text)">Aún no hay pedidos</p>
            <p class="text-xs mt-1 mb-3" style="color:var(--ap-text-sec)">Tu catálogo está listo. Comparte el enlace y recibe tu primer pedido por WhatsApp.</p>
            <button type="button" onclick="document.querySelector('.share-card').scrollIntoView({behavior:'smooth'})" class="m-btn m-btn-filled m-btn-sm">📣 Compartir mi catálogo</button>
          </div>
        <% } else { %>
          <div class="divide-y divide-slate-100" id="order-list">            <% orders.forEach(o => { %>
              <% var oRest = Math.max(0, (o.total || 0) - (o.installment_paid || 0));
                 var oPend = o.is_installment && oRest > 0;
                 var sNext = null, sOverdue = 0;
                 if (o.schedule) { o.schedule.forEach(function(s){ if (!s.covered && !sNext) sNext = s; if (s.overdue) sOverdue++; }); } %>
              <div class="m-list-item m-ripple px-2 py-2.5 flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3 first:pt-1 last:pb-1" data-active-layer
                   data-order-status="<%= o.status %>" data-paid="<%= o.paid ? 1 : 0 %>" data-confirm-anchor
                   data-installment="<%= o.is_installment ? 1 : 0 %>" data-pend="<%= oPend ? 1 : 0 %>" data-total="<%= o.total || 0 %>"
                   data-search="<%= (o.items + ' ' + (o.customer_name || '')).toLowerCase().replace(/"/g, '&quot;') %>" data-created="<%= o.created_at %>">
                <div class="flex items-start gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background:rgba(44,44,46,0.06);color:var(--ap-accent-text)">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1 5h12M7 13L5.4 5M7 13l.4 2M10 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <% var oBadgeTxt = o.status === 'entregado' ? (oPend ? '✓ ENTREGADO · POR COBRAR' : '✓ ENTREGADO')
                       : ({ nuevo: '● NUEVO', pagado: '● PAGADO', cancelado: '✕ CANCELADO' })[o.status] || '○ POR COBRAR';
                       var oBadgeCls = o.status === 'cancelado' ? 'm-badge-error'
                         : o.status === 'entregado' ? (oPend ? 'm-badge-warn' : 'm-badge-success')
                         : o.paid ? 'm-badge-success' : 'm-badge-warn'; %>
                    <p class="font-bold text-sm" style="color:var(--ap-text)"><%= money(o.total) %></p>
                    <span class="m-badge <%= oBadgeCls %> !h-5 !text-[10px] shrink-0"><%= oBadgeTxt %></span>
                  </div>
                  <p class="text-[11px] mt-0.5" style="color:var(--ap-text-sec);white-space:pre-line;line-height:1.5"><%= (o.items || '').replace(/ \| /g, '\n') %></p>
                  <% if (o.customer_name) { %>
                    <p class="text-[11px] text-neutral-600 font-semibold truncate mt-0.5">👤 <%= o.customer_name %></p>
                  <% } %>
                  <% if (o.is_installment && o.total > 0) { 
                    var pct = Math.round(((o.installment_paid || 0) / o.total) * 100);
                  %>
                    <div style="margin-top:6px;">
                      <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--ap-text-sec);margin-bottom:3px;">
                        <span>Abonado: <%= money(o.installment_paid || 0) %> / <%= money(o.total) %></span>
                        <span><%= pct %>%</span>
                      </div>
                      <div style="height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden;">
                        <div style="height:100%;width:<%= pct %>%;background:#10b981;border-radius:3px;"></div>
                      </div>
                    </div>
                  <% } %>
                  <% if (o.schedule && o.schedule.length) { %>
                    <div style="margin-top:6px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:6px 8px;">
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
                        <span style="font-size:10px;font-weight:700;color:var(--ap-text-sec)">📅 Abonos <%= o.schedule.length %></span>
                        <% if (sNext) { %>
                          <span style="font-size:10px;font-weight:700;color:<%= sNext.overdue ? '#dc2626' : '#2563eb' %>">
                            <%= sNext.overdue ? '⚠ Vencido' : '★ Próximo' %>: <%= fmtFecha(sNext.date, true) %> · <%= money(sNext.amount) %>
                          </span>
                        <% } else { %>
                          <span style="font-size:10px;font-weight:700;color:#059669">✓ Todos al día</span>
                        <% } %>
                      </div>
                      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;">
                        <% o.schedule.forEach(function(s){ %>
                          <span title="Abono <%= s.i %> de <%= o.schedule.length %>: <%= money(s.amount) %> el <%= fmtFecha(s.date, 'fecha') %><%= s.early ? ' · pagado antes de tiempo' : '' %>"
                                style="display:inline-flex;align-items:center;padding:1px 6px;border-radius:6px;font-size:9px;font-weight:700;<%= s.covered ? 'background:#d1fae5;color:#047857' : (s.overdue ? 'background:#fee2e2;color:#b91c1c' : (s.next ? 'background:#dbeafe;color:#1d4ed8' : 'background:#f1f5f9;color:#64748b')) %>">
                            <%= s.i %>·<%= fmtFecha(s.date, true) %><%= s.covered ? (s.early ? ' ⤴' : ' ✓') : '' %>
                          </span>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                  <% if (oPend) { %>
                    <p class="text-[10px] font-bold mt-1" style="color:#d97706">⚠️ Quedan <%= money(oRest) %> por cobrar</p>
                  <% } %>
                  <p class="text-[10px] mt-0.5" style="color:var(--ap-text-sec)"><%= fmtFecha(o.created_at) %></p>
                </div>
                </div>
                <div class="flex flex-wrap items-center gap-1 justify-start sm:justify-end sm:shrink-0">
                  <% if (o.is_installment && o.status !== 'cancelado' && oRest > 0) { %>
                    <button type="button" class="m-btn m-btn-sm m-btn-tonal !min-h-0 !py-1.5 !text-emerald-600 !border-emerald-200 hover:!bg-emerald-50" 
                            onclick="modalAbono(<%= o.id %>, <%= oRest %>, <%= sNext ? sNext.amount : 0 %>, '<%= sNext ? fmtFecha(sNext.date, true) : '' %>')">
                      Abono
                    </button>
                  <% } %>
                  <% if (o.status !== 'entregado' && o.status !== 'cancelado') { %>
                    <form method="POST" action="/<%= biz.slug %>/admin/order/<%= o.id %>/entregado" class="inline" data-confirm="<%= oPend ? '¿Entregar el pedido? Quedan ' + money(oRest) + ' por cobrar: se entrega pero NO se marca como pagado. Se registra el abono después.' : 'Marcar como ENTREGADO y cobrado?' %>" data-confirm-ok="Sí, entregar">
                      <button class="m-btn m-btn-sm m-btn-outlined !min-h-0 !py-1.5"><%= oPend ? 'Entregar · falta ' + money(oRest) : '✓ Entregado' %></button>
                    </form>
                    <form method="POST" action="/<%= biz.slug %>/admin/order/<%= o.id %>/cancelado" class="inline" data-confirm="¿Cancelar este pedido?">
                      <button class="m-btn m-btn-sm m-btn-outlined !min-h-0 !py-1.5 !text-red-500 !border-red-200 hover:!bg-red-50">✕ Cancelar</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/<%= biz.slug %>/admin/order/<%= o.id %>/eliminar" data-confirm="¿Eliminar pedido?" class="inline">
                    <button class="m-btn-icon !w-8 !h-8 hover:!bg-red-50 hover:!text-red-500" title="Eliminar">✕</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
          <div id="order-pager"></div>
        <% } %>
      </section>

    </div>
  </main>

  <!-- Modal Registrar Abono -->
  <div id="modal-abono" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="rounded-2xl shadow-2xl w-full max-w-sm p-5 mx-4" style="background:var(--ap-card)">
      <h3 class="font-bold text-sm mb-3" style="color:var(--ap-text)">Registrar abono</h3>
      <form method="POST" id="abono-form">
        <div class="m-field">
          <label>Monto</label>
          <input name="amount" id="abono-amount" type="number" min="0.01" step="0.01" required>
          <p class="text-[10px] mt-1" style="color:var(--ap-text-sec)">Pendiente: <span id="abono-pending"></span></p>
          <p class="text-[10px] mt-1 font-bold" style="color:#2563eb" id="abono-next"></p>
          <p class="text-[10px] mt-1" style="color:var(--ap-text-sec)">💡 Si el cliente viene <b>antes</b> de su fecha, puedes <b>adelantar el abono</b>: escribe el monto que te paga.</p>
        </div>
        <div class="m-field">
          <label>Nota (opcional)</label>
          <input name="note" placeholder="Ej: Abono semana 3">
        </div>
        <div class="flex gap-2 mt-3">
          <button type="button" onclick="document.getElementById('modal-abono').classList.add('hidden')" class="m-btn m-btn-outlined flex-1">Cancelar</button>
          <button type="submit" class="m-btn m-btn-filled flex-1" style="background:#10b981!important;color:#fff!important;">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <script>
    var BIZ_SLUG = <%- safeJson(biz.slug) %>;
    var CURRENCY_SYMBOL = <%- safeJson(typeof currencySymbol !== 'undefined' && currencySymbol ? currencySymbol : '$') %>;
    function moneyFmt(n) { return CURRENCY_SYMBOL + (Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')); }

    // ===== Tarjetas de métricas: clic para saltar a la sección relacionada =====
    (function () {
      document.querySelectorAll('.metric-card[data-scroll-target]').forEach(function (card) {
        card.addEventListener('click', function () {
          var sel = card.getAttribute('data-scroll-target');
          var target = sel && document.querySelector(sel);
          if (!target) return;
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          target.style.transition = 'box-shadow .3s ease';
          target.style.boxShadow = '0 0 0 3px var(--ap-accent-light)';
          setTimeout(function () { target.style.boxShadow = ''; }, 1200);
        });
      });
    })();

    // ===== Filtros, búsqueda, orden y rango de fechas de "Pedidos recientes" =====
    (function () {
      var list = document.getElementById('order-list');
      if (!list) return;
      var rows = Array.prototype.slice.call(list.querySelectorAll('[data-order-status]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('#order-filters button[data-f]'));
      var search = document.getElementById('order-search');
      var desde = document.getElementById('order-desde');
      var hasta = document.getElementById('order-hasta');
      var ordenSel = document.getElementById('order-orden');
      var countEl = document.getElementById('order-count');
      var currentFilter = 'all';

      function matchesFilter(r, f) {
        var status = r.getAttribute('data-order-status');
        var paid = r.getAttribute('data-paid') === '1';
        var installment = r.getAttribute('data-installment') === '1';
        var pend = r.getAttribute('data-pend') === '1';
        if (f === 'all') return true;
        if (f === 'nuevo') return status === 'nuevo';
        if (f === 'pendiente') return !paid && status !== 'cancelado';
        if (f === 'abonos') return installment && pend && status !== 'cancelado';
        if (f === 'pagado') return status === 'pagado';
        if (f === 'entregado') return status === 'entregado';
        if (f === 'cancelado') return status === 'cancelado';
        return true;
      }

      function apply() {
        var q = (search.value || '').trim().toLowerCase();
        var d1 = desde.value, d2 = hasta.value;
        var visibles = 0;
        rows.forEach(function (r) {
          var okF = matchesFilter(r, currentFilter);
          var okQ = !q || (r.getAttribute('data-search') || '').indexOf(q) !== -1;
          var created = (r.getAttribute('data-created') || '').slice(0, 10);
          var okD1 = !d1 || created >= d1;
          var okD2 = !d2 || created <= d2;
          var show = okF && okQ && okD1 && okD2;
          r.style.display = show ? '' : 'none';
          if (show) visibles++;
        });
        if (countEl) countEl.textContent = visibles === rows.length ? '' : ('Mostrando ' + visibles + ' de ' + rows.length + ' pedidos');
      }

      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          chips.forEach(function (x) { x.classList.remove('m-chip-selected'); });
          c.classList.add('m-chip-selected');
          currentFilter = c.getAttribute('data-f');
          apply();
        });
      });
      search.addEventListener('input', apply);
      desde.addEventListener('change', apply);
      hasta.addEventListener('change', apply);
      if (ordenSel) {
        ordenSel.addEventListener('change', function () {
          var mode = ordenSel.value;
          var sorted = rows.slice().sort(function (a, b) {
            if (mode === 'antiguos') return new Date(a.getAttribute('data-created')) - new Date(b.getAttribute('data-created'));
            if (mode === 'mayor') return (+b.getAttribute('data-total')) - (+a.getAttribute('data-total'));
            if (mode === 'menor') return (+a.getAttribute('data-total')) - (+b.getAttribute('data-total'));
            return new Date(b.getAttribute('data-created')) - new Date(a.getAttribute('data-created'));
          });
          sorted.forEach(function (r) { list.appendChild(r); });
        });
      }

      window.limpiarFiltrosPedidos = function () {
        search.value = ''; desde.value = ''; hasta.value = '';
        chips.forEach(function (x) { x.classList.remove('m-chip-selected'); });
        var allChip = document.querySelector('#order-filters button[data-f="all"]');
        if (allChip) allChip.classList.add('m-chip-selected');
        currentFilter = 'all';
        apply();
      };
    })();

    // ===== Modal: registrar abono =====
    function modalAbono(orderId, rest, nextAmount, nextDateLabel) {
      var form = document.getElementById('abono-form');
      form.action = '/' + BIZ_SLUG + '/admin/order/' + orderId + '/abono';
      var pendEl = document.getElementById('abono-pending');
      if (pendEl) pendEl.textContent = moneyFmt(rest);
      var amountInp = document.getElementById('abono-amount');
      if (amountInp) { amountInp.max = rest; amountInp.value = nextAmount > 0 ? nextAmount.toFixed(2) : ''; }
      var nextEl = document.getElementById('abono-next');
      if (nextEl) nextEl.textContent = (nextAmount > 0 && nextDateLabel) ? ('★ Próximo abono sugerido: ' + moneyFmt(nextAmount) + ' · ' + nextDateLabel) : '';
      document.getElementById('modal-abono').classList.remove('hidden');
    }

    // ===== Tarjeta para redes sociales (canvas → PNG) =====
    var CARD = {
      name: <%- safeJson(biz.name) %>,
      desc: <%- safeJson(biz.description || '') %>,
      url: <%- safeJson(storeUrl) %>,
      logo: <%- safeJson(biz.logo || '') %>,
      qr: <%- safeJson(typeof qrUrl !== 'undefined' ? qrUrl : '') %>,
      accent: <%- safeJson(biz.color_hex || '#2563eb') %>,
      accent2: <%- safeJson(biz.color_hex2 || biz.color_hex || '#4f46e5') %>
    };

    function roundRect(ctx, x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
    }

    function textColorOver(hex) {
      const m = /^#?([0-9a-f]{6})$/i.exec(hex || '#000000');
      if (!m) return '#111827';
      const r = parseInt(m[1].slice(0, 2), 16), g = parseInt(m[1].slice(2, 4), 16), b = parseInt(m[1].slice(4, 6), 16);
      return (r * 0.299 + g * 0.587 + b * 0.114) > 155 ? '#111827' : '#F9FAFB';
    }

    function logoFallback(ctx, x, y, r, color) {
      ctx.fillStyle = color;
      roundRect(ctx, x, y, r * 2, r * 2, r);
      ctx.fill();
      ctx.fillStyle = textColorOver(color);
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = `bold ${Math.round(r * 0.85)}px "Segoe UI", Arial, sans-serif`;
      const abbr = String(CARD.name.slice(0, 2)).toUpperCase();
      ctx.fillText(abbr, x + r, y + r);
    }

    function wrapText(ctx, text, x, y, maxW, lineH, maxLines) {
      const words = String(text || '').split(/\s+/).filter(Boolean);
      let line = '';
      const lines = [];
      for (const w of words) {
        const test = line ? line + ' ' + w : w;
        if (ctx.measureText(test).width > maxW && line) { lines.push(line); line = w; }
        else line = test;
      }
      if (line) lines.push(line);
      (maxLines !== undefined ? lines.slice(0, maxLines) : lines).forEach((l, i) => ctx.fillText(l, x, y + i * lineH));
    }

    function pill(ctx, x, y, w, h, r, fill, text, tc) {
      ctx.fillStyle = fill;
      roundRect(ctx, x, y, w, h, r);
      ctx.fill();
      ctx.fillStyle = tc;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const fs = 16;
      ctx.font = '700 ' + fs + 'px "Segoe UI", Arial, sans-serif';
      let t = text;
      let attempts = 0;
      while (ctx.measureText(t).width > w - 24 && attempts < 6) { t = t.slice(0, -1); attempts++; }
      if (t.length < text.length) t = t.slice(0, -3) + '…';
      ctx.fillText(t, x + w / 2, y + h / 2);
    }

    function descargarTarjeta() {
      const W = 1080, H = 1080;
      const canvas = document.createElement('canvas');
      canvas.width = W; canvas.height = H;
      const ctx = canvas.getContext('2d');

      // Fondo degradado diagonal entre los dos colores del negocio
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, CARD.accent);
      g.addColorStop(1, CARD.accent2);
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      // Decoración: círculos suaves en la esquina opuesta
      ctx.fillStyle = 'rgba(255,255,255,0.10)';
      ctx.beginPath(); ctx.arc(W * 0.82, H * 0.12, 280, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(W * 0.12, H * 0.82, 210, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.05)';
      ctx.beginPath(); ctx.arc(W * 0.9, H * 0.78, 220, 0, Math.PI * 2); ctx.fill();

      // Panel blanco central con bordes del giro
      ctx.fillStyle = '#FFFFFF';
      roundRect(ctx, 44, 44, W - 88, H - 88, 36);
      ctx.fill();

      // Borde fino del panel
      ctx.strokeStyle = 'rgba(0,0,0,0.05)';
      ctx.lineWidth = 2;
      roundRect(ctx, 44, 44, W - 88, H - 88, 36);
      ctx.stroke();

      // Cabecera del panel: barra del color del negocio
      ctx.fillStyle = CARD.accent;
      roundRect(ctx, 44, 44, W - 88, 30, 36);
      ctx.arc(44 + 30, 44 + 30, 30, Math.PI, Math.PI * 1.5);
      ctx.fill();

      // Texto de cabecera: "CATÁLOGO EN LÍNEA"
      ctx.fillStyle = textColorOver(CARD.accent);
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.font = '700 18px "Segoe UI", Arial, sans-serif';
      wrapText(ctx, 'CATÁLOGO EN LÍNEA', 80, 59, W - 200, 22);

      // Logo del negocio: círculo perfurado con borde en color del negocio
      const centerY = 392;
      const logoR = 112;
      ctx.save();
      ctx.beginPath();
      ctx.arc(W / 2, centerY, logoR, 0, Math.PI * 2);
      ctx.closePath();

      // Oscurece ligeramente detrás del logo para que brille
      ctx.shadowColor = 'rgba(0,0,0,0.06)';
      ctx.shadowBlur = 18;
      ctx.fillStyle = '#FFFFFF';
      ctx.fill();
      ctx.shadowBlur = 0;

      // Borde fino del círculo del logo
      ctx.strokeStyle = CARD.accent;
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.arc(W / 2, centerY, logoR, 0, Math.PI * 2);
      ctx.stroke();

      // Agujeros decorativos
      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath(); ctx.arc(W / 2 - logoR * 0.5, centerY - logoR * 0.3, 8, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(W / 2 + logoR * 0.45, centerY - logoR * 0.25, 8, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      let logoDrawn = false;
      let qrDrawn = false;
      function bothOK() { if (logoDrawn && qrDrawn) mountPointer(); }

      if (CARD.logo) {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = function () {
          ctx.save();
          ctx.beginPath();
          ctx.arc(W / 2, centerY, logoR - 6, 0, Math.PI * 2);
          ctx.closePath();
          ctx.clip();
          ctx.drawImage(img, W / 2 - logoR, centerY - logoR, logoR * 2, logoR * 2);
          ctx.restore();
          logoDrawn = true; bothOK();
        };
        img.onerror = function () { logoFallback(ctx, W / 2 - logoR, centerY - logoR, logoR - 6, CARD.accent); logoDrawn = true; bothOK(); };
        img.src = CARD.logo;
      } else {
        logoFallback(ctx, W / 2 - logoR, centerY - logoR, logoR - 6, '#FFFFFF');
        logoDrawn = true; bothOK();
      }

      // Nombre del negocio bajo el logo
      ctx.fillStyle = '#111827';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '800 58px "Segoe UI", Arial, sans-serif';
      const name = CARD.name.length > 34 ? CARD.name.slice(0, 32) + '…' : CARD.name;
      ctx.fillText(name, W / 2, centerY + logoR + 78);

      // Línea divisoria decorativa
      ctx.strokeStyle = CARD.accent;
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(W / 2 - 60, centerY + logoR + 122);
      ctx.lineTo(W / 2 + 60, centerY + logoR + 122);
      ctx.stroke();

      // Descripción
      ctx.fillStyle = '#4B5563';
      ctx.font = '400 24px "Segoe UI", Arial, sans-serif';
      wrapText(ctx, CARD.desc, W / 2, centerY + logoR + 170, W - 260, 30, 3);

      // Paleta de color del negocio: 3 chips alineados a la derecha de la descripción
      const chips = [
        CARD.accent,
        CARD.accent2,
        (function () {
          const ha = CARD.accent.replace('#',''), hb = CARD.accent2.replace('#','');
          const r = Math.min(255, ((parseInt(ha.slice(0,2),16)+parseInt(hb.slice(0,2),16))/2)|0);
          const gg = Math.min(255, ((parseInt(ha.slice(2,4),16)+parseInt(hb.slice(2,4),16))/2)|0);
          const bb = Math.min(255, ((parseInt(ha.slice(4,6),16)+parseInt(hb.slice(4,6),16))/2)|0);
          return '#' + [r, gg, bb].map(v => v.toString(16).padStart(2,'0')).join('');
        })()
      ];
      const chipY = centerY + logoR + 222;
      const chipW = 30;
      const chipGap = 14;
      const chipX0 = W - 112;
      chips.forEach(function (c, i) {
        ctx.fillStyle = c;
        roundRect(ctx, chipX0 + i * (chipW + chipGap), chipY - chipW / 2, chipW, chipW, 6);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,0.10)';
        ctx.lineWidth = 1;
        roundRect(ctx, chipX0 + i * (chipW + chipGap), chipY - chipW / 2, chipW, chipW, 6);
        ctx.stroke();
      });

      // Código QR + botón de micropagina
      const qrSize = 228;
      const qrCornerR = 22;
      const qrBgY = centerY + logoR + 308;
      const qrBgX = (W - qrSize - 140) / 2;

      // Etiqueta sobre el QR
      if (CARD.qr) {
        pill(ctx, W / 2 - 90, qrBgY - 66, 180, 42, 21, CARD.accent, 'Escanea el catálogo', textColorOver(CARD.accent));
      }

      // Marco blanco del QR: cuadrado con bordes redondeados (o círculo si no hay QR)
      ctx.fillStyle = '#FFFFFF';
      if (CARD.qr) {
        roundRect(ctx, qrBgX, qrBgY, qrSize, qrSize, qrCornerR);
      } else {
        ctx.beginPath();
        ctx.arc(W / 2, qrBgY + qrSize / 2, qrSize / 2, 0, Math.PI * 2);
      }
      ctx.fill();

      // QR dibujado
      if (CARD.qr) {
        const q = new Image();
        q.crossOrigin = 'anonymous';
        q.onload = function () {
          ctx.drawImage(q, qrBgX + 12, qrBgY + 12, qrSize - 24, qrSize - 24);
          qrDrawn = true; bothOK();
        };
        q.onerror = function () { qrDrawn = true; bothOK(); };
        q.src = CARD.qr;
      } else {
        // Espacio reservado circular: logo del negocio pequeño perfurado
        ctx.save();
        ctx.beginPath();
        ctx.arc(W / 2, qrBgY + qrSize / 2, qrSize / 2 - 6, 0, Math.PI * 2);
        ctx.closePath();
        ctx.clip();
        ctx.fillStyle = CARD.accent;
        roundRect(ctx, W / 2 - 70, qrBgY + 40, 140, 140, 24);
        ctx.fill();
        ctx.fillStyle = textColorOver(CARD.accent);
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = 'bold 80px "Segoe UI", Arial, sans-serif';
        ctx.fillText(String(CARD.name.slice(0, 2)).toUpperCase(), W / 2, qrBgY + qrSize / 2);
        ctx.restore();
        qrDrawn = true; bothOK();
      }

      // Láminas "micropagina de catálogo" + pie
      function mountPointer() {
        const pointerY = qrBgY + qrSize + 40;
        ctx.fillStyle = '#111827';
        ctx.font = '700 26px "Segoe UI", Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('micropagina de catálogo', W / 2, pointerY);

        ctx.fillStyle = '#6B7280';
        ctx.font = '400 18px "Segoe UI", Arial, sans-serif';
        ctx.fillText(CARD.url.replace(/^https?:\/\//, '').slice(0, 56), W / 2, pointerY + 42);

        // Línea punteada decorativa debajo del QR
        ctx.strokeStyle = 'rgba(0,0,0,0.08)';
        ctx.setLineDash([6, 8]);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(W / 2, pointerY + 84);
        ctx.lineTo(W / 2, pointerY + 120);
        ctx.stroke();
        ctx.setLineDash([]);

        // Pie izquierdo: "Creado para" + nombre
        const footerY = H - 92;
        ctx.fillStyle = '#9CA3AF';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.font = '400 18px "Segoe UI", Arial, sans-serif';
        ctx.fillText('Creado para', 92, footerY);
        ctx.fillStyle = '#111827';
        ctx.font = '700 22px "Segoe UI", Arial, sans-serif';
        ctx.fillText(CARD.name, 92, footerY + 28);

        // Pie derecho: "Visítanos" + dominio corto
        const urlShort = CARD.url.replace(/^https?:\/\//, '').slice(0, 32);
        ctx.fillStyle = '#6B7280';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.font = '400 18px "Segoe UI", Arial, sans-serif';
        ctx.fillText('Visítanos', W - 92, footerY);
        ctx.fillStyle = CARD.accent;
        ctx.font = '700 22px "Segoe UI", Arial, sans-serif';
        ctx.fillText(urlShort, W - 92, footerY + 28);

        // Descarga del PNG
        const a = document.createElement('a');
        a.download = 'tarjeta-' + CARD.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') + '.png';
        a.href = canvas.toDataURL('image/png');
        a.click();
        mostrarToast('Tarjeta descargada ✓', 'ok');
      }

      if (!CARD.qr) mountPointer();
    }

  </script>
</body>