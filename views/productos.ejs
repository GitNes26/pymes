  <style>
    .pf-step { display:flex; flex-direction:column; align-items:center; gap:2px; min-width:64px; cursor:pointer; }
    .pf-dot { width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; background:#e2e8f0; color:#64748b; transition:all .22s cubic-bezier(.22,1,.36,1); }
    .pf-step.on .pf-dot { background:var(--md-primary, #2563eb); color:#fff; transform:scale(1.06); }
    .pf-step.done .pf-dot { background:var(--md-primary-container, #dbeafe); color:var(--md-on-primary-container, #1d4ed8); }
    .pf-lbl { font-size:10px; font-weight:700; color:#94a3b8; transition:color .22s cubic-bezier(.22,1,.36,1); }
    .pf-step.on .pf-lbl { color:var(--md-primary, #2563eb); }
    .pf-tipo-card { display:flex; align-items:center; gap:10px; text-align:left; padding:12px 14px; border-radius:14px; border:2px solid #e2e8f0; background:#fff; cursor:pointer; transition:all .25s cubic-bezier(.22,1,.36,1); }
    .pf-tipo-card:hover { border-color:#93c5fd; background:#f0f7ff; transform:translateY(-1px); }
    .pf-tipo-card.active { border-color:var(--md-primary, #2563eb); background:var(--md-primary-container, #dbeafe); box-shadow:0 2px 10px rgba(37,99,235,.15); }
    .pf-tipo-ico { font-size:22px; line-height:1; transition:transform .25s cubic-bezier(.22,1,.36,1); }
    .pf-tipo-card:hover .pf-tipo-ico { transform:scale(1.12) rotate(-4deg); }
    .pf-tipo-tit { display:block; font-size:13px; font-weight:800; color:#1e293b; }
    .pf-tipo-sub { display:block; font-size:10px; font-weight:600; color:#64748b; margin-top:1px; }
    .pf-advanced { border:1px dashed #e2e8f0; border-radius:14px; padding:10px 12px; margin-top:4px; }
    .pf-advanced[open] { padding-bottom:14px; }
    .pf-advanced summary { list-style:none; cursor:pointer; font-size:12px; font-weight:800; color:#475569; padding:2px 0; user-select:none; }
    .pf-advanced summary::-webkit-details-marker { display:none; }
    .pf-advanced summary::before { content:'›'; display:inline-block; margin-right:6px; font-size:15px; font-weight:900; transition:transform .2s cubic-bezier(.22,1,.36,1); }
    .pf-advanced[open] summary::before { transform:rotate(90deg); }
    .pf-advanced summary:hover { color:#1e293b; }
    .pf-advanced-body { margin-top:12px; }
    /* Tabs: Productos | Categorías | Atributos */
    .prod-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; background:var(--ap-card); border:1px solid var(--ap-border); padding:6px; border-radius:var(--ap-radius); box-shadow:var(--ap-shadow); }
    .prod-tab { display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:12px; font-size:12px; font-weight:800; color:var(--ap-text-sec); background:transparent; border:none; cursor:pointer; transition:all .25s cubic-bezier(.22,1,.36,1); }
    .prod-tab:hover { background:rgba(44,44,46,.06); color:var(--ap-text); }
    .prod-tab.active { background:var(--ap-accent); color:#fff; box-shadow:0 4px 10px rgba(44,44,46,.25); }
    .prod-tab .cnt { background:rgba(100,116,139,.14); color:var(--ap-text-sec); font-size:10px; font-weight:900; padding:1px 7px; border-radius:999px; transition:background .25s cubic-bezier(.22,1,.36,1), color .25s cubic-bezier(.22,1,.36,1); }
    .prod-tab.active .cnt { background:rgba(255,255,255,.22); color:#fff; }
    .prod-tab-panel { display:none; }
    .prod-tab-panel.active { display:block; animation:prodFade .35s cubic-bezier(.22,1,.36,1) both; }
    @keyframes prodFade { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
    #prod-loading { display:none; }
    .bg-checker { background-image: linear-gradient(45deg,#eef1f6 25%,transparent 25%),linear-gradient(-45deg,#eef1f6 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eef1f6 75%),linear-gradient(-45deg,transparent 75%,#eef1f6 75%); background-size:16px 16px; background-position:0 0,0 8px,8px -8px,-8px 0; }
    .img-aspect { font-size:10px; font-weight:700; padding:4px 8px; border-radius:999px; border:1px solid #e2e8f0; color:#64748b; transition:all .2s cubic-bezier(.22,1,.36,1); }
    .img-aspect.on { border-color:#2c2c2e; background:#f0f0f1; color:#2c2c2e; }
    #prod-grid > * { transition:opacity .2s cubic-bezier(.22,1,.36,1); }

    /* Catálogo visual con inspector lateral — dirección aprobada para esta superficie */
