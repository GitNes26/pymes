      box-shadow:0 3px 10px rgba(20,24,31,.04);
    }
    .product-catalog #prod-search::placeholder { color:#687781; opacity:1; }
    .product-catalog #prod-filters { gap:6px; margin-bottom:14px; }
    .product-catalog #prod-filters .m-chip {
      min-height:30px;
      padding:0 11px;
      border:1px solid rgba(44,44,46,.10);
      background:rgba(255,255,255,.66);
      color:#52616c;
      box-shadow:0 2px 7px rgba(20,24,31,.035);
    }
    .product-catalog #prod-filters .m-chip-selected {
      border-color:transparent;
      background:#454548 !important;
      color:#fff;
      box-shadow:0 4px 10px rgba(44,44,46,.22);
    }
    .product-result-summary {
      min-height:18px;
      margin:-6px 0 10px;
      color:#697781;
      font-size:11px;
      font-weight:650;
    }
    .product-filter-empty {
      min-height:220px;
      padding:34px 18px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:7px;
      text-align:center;
      color:#687781;
      border:1px dashed rgba(44,44,46,.18);
