<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Productos', biz }) %>
</head>
<body class="m-material products-admin-page bg-slate-100 min-h-screen">
  <!--
    THESIS: gestionar el catálogo debe sentirse como trabajar sobre un mostrador visual, no como editar una tabla apretada.
    OWN-WORLD: campo gris perla frío con luz cian/violeta, tinta azul petróleo, tarjetas fotográficas y controles compactos.
    STORY: el dueño localiza un producto, entiende su estado de un vistazo y crea o edita sin perder el catálogo.
    FIRST VIEWPORT: navegación y filtros arriba; catálogo en tres columnas a la izquierda; editor persistente a la derecha.
    FORM: catálogo operativo con inspector lateral; seed key: user-reference-11l692; comp aprobada: Gemini_Generated_Image_11l69211l69211l6 (2).jpeg.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
  -->
  <%- include('admin/sidebar', { biz, active: 'productos', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="px-4 md:px-8 py-4 md:py-6 pb-24 md:pb-6">
      <script type="application/json" id="attr-templates-json"><%- safeJson(attributeTemplates || []) %></script>
      <script type="application/json" id="cat-json"><%- safeJson(categories || []) %></script>
      <script type="application/json" id="formdata-json"><%- safeJson(typeof formdata !== 'undefined' ? formdata : null) %></script>

      <!-- CRUD separado por tabs: Productos · Categorías · Atributos (tabs según permiso) -->
      <% const puedeCrear = perms.includes('productos.crear'); %>
      <% const puedeEditarP = perms.includes('productos.editar'); %>
      <% const puedeEliminarP = perms.includes('productos.eliminar'); %>
      <% const puedeCategorias = perms.includes('categorias.gestionar'); %>
      <% const puedeAtributos = perms.includes('atributos.gestionar'); %>
      <div class="prod-tabs" role="tablist" aria-label="Secciones del catálogo">
        <button type="button" id="tabbtn-productos" class="prod-tab active" onclick="switchCrudTab('productos')"><i class="bi bi-box-seam" aria-hidden="true"></i> Productos <span class="cnt" id="tabcnt-productos"><%= allProducts.length %></span></button>
        <% if (puedeCategorias) { %>
        <button type="button" id="tabbtn-categorias" class="prod-tab" onclick="switchCrudTab('categorias')"><i class="bi bi-collection" aria-hidden="true"></i> Categorías <span class="cnt" id="tabcnt-categorias"><%= categories.length %></span></button>
        <% } %>
        <% if (puedeAtributos) { %>
        <button type="button" id="tabbtn-atributos" class="prod-tab" onclick="switchCrudTab('atributos')"><i class="bi bi-sliders2" aria-hidden="true"></i> Atributos <span class="cnt" id="tabcnt-atributos">0</span></button>
        <% } %>
      </div>
      <div id="tabpane-productos" class="prod-tab-panel active">

      <!-- Encabezado -->
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <div>
          <h1 class="text-lg md:text-xl font-black tracking-tight text-slate-900">Mis productos</h1>
          <p class="text-xs text-slate-500 mt-0.5">
            <%= allProducts.length %> productos
            <% if (planMax !== Infinity) { %> · <%= allProducts.length %>/<%= planMax %> de tu plan <% } %>
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap justify-end">
          <a href="/<%= biz.slug %>/admin/exportar.xlsx" class="m-btn m-btn-outlined m-btn-sm" title="Descargar catálogo en Excel">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 10v6m0 0l-3-3m3 3l3-3M4 4h16v4H4zM4 12h16v8H4z"/></svg>
            Excel
          </a>
          <a href="/<%= biz.slug %>/admin/catalogo-print" target="_blank" class="m-btn m-btn-outlined m-btn-sm" title="Vista para imprimir / guardar PDF">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
            Imprimir
          </a>

          <% if (perms.includes('productos.crear')) { %>
          <a href="#nuevo-producto" class="m-btn m-btn-filled m-btn-sm" onclick="return irNuevoProducto(event)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Nuevo
          </a>
          <% } %>
        </div>
      </div>

      <% const prodLimiteAlcanzado = planMax !== Infinity && allProducts.length >= planMax; %>
      <% if (error && planBlock) { %>
        <!-- Límite de plan: aviso claro en lugar de un error genérico -->
        <div class="mb-3 flex flex-wrap items-center gap-3 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm m-pop">
          <span class="text-xl shrink-0">⚠️</span>
          <div class="flex-1 min-w-[220px]">
            <p class="font-extrabold text-amber-900">Ya llegaste al límite de tu plan <%= planBlock.plan %></p>
            <p class="text-amber-800 mt-0.5">Tu plan permite hasta <b><%= planBlock.max %></b> producto<%= planBlock.max === 1 ? '' : 's' %> y ya tienes <b><%= planBlock.count %></b> registrados. Puedes seguir <b>editando o borrando</b> los que ya tienes, pero no registrar nuevos.</p>
          </div>
          <a href="/<%= biz.slug %>/admin/planes" class="m-btn m-btn-sm !bg-amber-500 !border-amber-500 !text-white shrink-0">Ver planes</a>
        </div>
      <% } else if (error) { %>
        <div id="panel-error" class="mb-3 bg-[var(--md-error-container)] text-[#8c1d18] text-sm font-bold px-4 py-3 rounded-xl m-pop flex items-center gap-2">
          <span class="shrink-0">⚠️</span><%= error %>
        </div>
      <% } else if (prodLimiteAlcanzado) { %>
        <!-- Aviso anticipado: se ve antes de llenar el formulario -->
        <div class="mb-3 flex flex-wrap items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50/70 px-4 py-3 text-sm">
          <span class="text-xl shrink-0">ℹ️</span>
          <div class="flex-1 min-w-[220px]">
            <p class="font-bold text-amber-900">Estás en el límite de productos de tu plan (<%= allProducts.length %> de <%= planMax %>)</p>
            <p class="text-amber-800 mt-0.5">Ya no puedes registrar productos nuevos con tu plan actual. Borra los que ya no vendas o mejora tu plan para tener productos ilimitados.</p>
          </div>
          <a href="/<%= biz.slug %>/admin/planes" class="m-btn m-btn-outlined m-btn-sm !border-amber-300 !text-amber-800 shrink-0">Ver planes</a>
        </div>
      <% } %>

      <% if (biz.plan === 'free') { %>
        <div class="prod-plan">
          <span class="prod-plan__ic" aria-hidden="true"><i class="bi bi-stars"></i></span>
          <p class="prod-plan__txt">
            <b>Plan Gratuito</b> · <%= planMax === Infinity ? (allProducts.length + ' productos') : (allProducts.length + '/' + planMax + ' productos') %>
            <span><%= planMax === Infinity ? 'Atributos y más funciones con el plan Pro.' : 'Productos ilimitados y atributos con el plan Pro.' %></span>
          </p>
          <a href="/<%= biz.slug %>/admin/config" class="m-btn m-btn-outlined m-btn-sm">Mejorar plan</a>
        </div>
      <% } %>

      <div class="products-workspace">
      <!-- Lista de productos -->
      <section id="productos" class="product-catalog mb-3 m-stagger relative">
        <div id="prod-loading" class="hidden absolute inset-0 z-20 items-center justify-center bg-white/70 backdrop-blur-[1px] rounded-xl">
          <div class="flex flex-col items-center gap-2">
            <span class="w-7 h-7 border-[3px] border-[var(--md-primary)] border-t-transparent rounded-full animate-spin"></span>
            <p class="text-xs font-bold text-slate-500">Cargando…</p>
          </div>
        </div>
        <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
          <h2 class="font-extrabold text-slate-900 text-sm">Catálogo <span class="m-badge m-badge-neutral !ml-1.5"><%= allProducts.length %></span></h2>
          <div class="relative">
            <input id="prod-search" type="search" placeholder="Buscar producto…" aria-label="Buscar productos por nombre, etiqueta o descripción" autocomplete="off" class="w-36 sm:w-56 border border-slate-200 rounded-full pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-neutral-1000 focus:border-neutral-1000 transition">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 mb-3" id="prod-filters">
          <button type="button" data-f="all" aria-pressed="true" class="m-chip m-chip-selected !h-8">Todos <span class="m-badge m-badge-neutral !h-5 !text-[10px]"><%= allProducts.length %></span></button>
          <% const visibles = allProducts.filter(p => p.active).length; %>
          <button type="button" data-f="active" aria-pressed="false" class="m-chip !h-8">Visibles <span class="m-badge m-badge-success !h-5 !text-[10px]"><%= visibles %></span></button>
          <button type="button" data-f="hidden" aria-pressed="false" class="m-chip !h-8">Ocultos <span class="m-badge m-badge-neutral !h-5 !text-[10px]"><%= allProducts.length - visibles %></span></button>
          <% const agotados = allProducts.filter(p => !p.made_to_order && p.displayStock !== null && p.displayStock <= 0).length; %>
          <button type="button" data-f="out" aria-pressed="false" class="m-chip !h-8">Agotados <span class="m-badge m-badge-error !h-5 !text-[10px]"><%= agotados %></span></button>
          <% const bajos = allProducts.filter(p => !p.made_to_order && p.displayStock !== null && p.displayStock > 0 && p.displayStock <= 5).length; %>
          <button type="button" data-f="low" aria-pressed="false" class="m-chip !h-8">Stock bajo <span class="m-badge m-badge-warn !h-5 !text-[10px]"><%= bajos %></span></button>
          <% const enPromo = allProducts.filter(p => p.old_price).length; %>
          <button type="button" data-f="promo" aria-pressed="false" class="m-chip !h-8"><i class="bi bi-tag" aria-hidden="true"></i> En promo <span class="m-badge m-badge-error !h-5 !text-[10px]"><%= enPromo %></span></button>
        </div>

        <p id="prod-result-summary" class="product-result-summary" aria-live="polite"></p>

        <% if (allProducts.length === 0) { %>
          <div class="text-center py-6 border-2 border-dashed border-slate-200 rounded-xl">
            <p class="text-2xl mb-1">📦</p>
            <p class="text-xs text-slate-500 font-semibold mb-3">Aún no tienes productos</p>
            <% if (perms.includes('productos.crear')) { %><a href="#nuevo-producto" class="m-btn m-btn-filled m-btn-sm" onclick="return irNuevoProducto(event)">Agregar mi primer producto</a><% } %>
          </div>
        <% } else { %>
          <div id="prod-grid" class="product-grid">
            <% allProducts.forEach((p, i) => { %>
              <article class="product-card m-ripple <%= i >= 12 ? 'hidden' : '' %>" data-active-layer
                   data-search="<%= [p.name, p.tags, p.description].filter(Boolean).join(' ').toLowerCase() %>" data-state="<%= p.active ? 'active' : 'hidden' %>" data-stock="<%= p.displayStock === null ? '' : (p.displayStock > 5 ? 'ok' : (p.displayStock > 0 ? 'low' : 'out')) %>" data-promo="<%= p.old_price ? 1 : 0 %>"
                   data-edit-id="<%= p.id %>" data-edit-name="<%= (p.name || '').replace(/"/g, '&quot;') %>" data-edit-price="<%= p.price %>" data-edit-old="<%= p.old_price || '' %>" data-edit-cost="<%= p.cost || '' %>"
                   data-edit-cat="<%= p.category_id || '' %>" data-edit-desc="<%= (p.description || '').replace(/"/g, '&quot;') %>" data-edit-image="<%= (p.image || '').replace(/"/g, '&quot;') %>" data-edit-galeria="<%= (p.galeria || '').replace(/"/g, '&quot;') %>"
                   data-edit-stock="<%= p.stock === null ? '' : p.stock %>" data-edit-made-to-order="<%= p.made_to_order ? 1 : 0 %>" data-edit-show-stock="<%= (p.show_stock === 0 || p.show_stock === '0') ? 0 : 1 %>" data-edit-variants="<%= encodeURIComponent(JSON.stringify(p.variants || [])) %>" data-edit-featured="<%= p.featured ? 1 : 0 %>" data-edit-promo="<%= p.promo_ends_at || '' %>"
                   data-edit-promo-type="<%= p.promo_type || '' %>" data-edit-promo-value="<%= p.promo_value || '' %>" data-edit-promo-gift="<%= (p.promo_gift || '').replace(/"/g, '&quot;') %>"
                   data-edit-sku="<%= (p.sku || '').replace(/"/g, '&quot;') %>" data-edit-tags="<%= (p.tags || '').replace(/"/g, '&quot;') %>" data-edit-video="<%= (p.video || '').replace(/"/g, '&quot;') %>" data-edit-specs="<%= (p.specs || '').replace(/"/g, '&quot;') %>" data-edit-barcode="<%= (p.barcode || '').replace(/"/g, '&quot;') %>"
                   data-edit-installments="<%= p.allow_installments ? 1 : 0 %>" data-edit-inst-count="<%= p.installment_count || 6 %>" data-edit-inst-down="<%= p.installment_min_down || 0 %>" data-edit-inst-freq="<%= p.installment_frequency || 'semanal' %>">
                <div class="product-card__main">
                <button type="button" class="product-card__image-button" data-product-name="<%= p.name %>" onclick="abrirImagenProducto(this.querySelector('img'), this.dataset.productName)" aria-label="Ampliar imagen de <%= p.name %>">
                  <img src="<%= p.cover || p.image || "/img/sin-imagen.svg" %>" alt="Foto de <%= p.name %>" loading="lazy" class="product-card__image" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'">
                  <span class="product-card__zoom" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i></span>
                </button>
                <div class="product-card__info">
                  <p class="font-semibold text-sm text-slate-800 truncate">
                    <% if (p.featured) { %><i class="bi bi-star-fill text-amber-400 align-[-2px]" title="Destacado"></i><% } %> <%= p.name %>
                  </p>
                  <div class="pc-price">
                    <span class="pc-price__now"><%= money(p.price) %></span>
                    <% if (p.old_price) { %>
                      <span class="pc-price__old"><%= money(p.old_price) %></span>
                      <span class="m-badge !h-5 !text-[10px] m-badge-error"><i class="bi bi-percent" aria-hidden="true"></i> <%= p.promo_days !== undefined ? p.promo_days + ' días' : 'Promo' %></span>
                    <% } else if (p.promo_badge) { %>
                      <span class="m-badge !h-5 !text-[10px] m-badge-error"><%= p.promo_badge %></span>
                    <% } %>
                  </div>
                  <div class="pc-status">
                    <span class="m-badge !h-5 !text-[10px] <%= p.active ? 'm-badge-success' : 'm-badge-neutral' %>"><%= p.active ? 'Visible' : 'Oculto' %></span>
                    <% if (p.made_to_order) { %><span class="m-badge m-badge-primary !h-5 !text-[10px]">Por pedido</span><% } else { %><span class="m-badge !h-5 !text-[10px] <%= (p.displayStock === null || p.displayStock <= 0) ? 'm-badge-error' : 'm-badge-primary' %>"><%= (p.displayStock === null || p.displayStock <= 0) ? 'Agotado' : p.displayStock + ' en stock' %></span><% } %>
                    <% if (p.variantCount > 0) { %>
                      <span class="m-badge !h-5 !text-[10px] m-badge-warn"><%= p.variantCount %> var.</span>
                    <% } %>
                    <% if (p.allow_installments) { %>
                      <span class="m-badge !h-5 !text-[10px]" style="background:rgba(16,185,129,.1);color:#10b981;">Abonos</span>
                    <% } %>
                  </div>
                </div>
                </div>
                <div class="product-card__actions">
                  <button type="button" class="m-btn-icon !w-8 !h-8 hover:!bg-emerald-50 hover:!text-emerald-600" title="Tarjeta para redes" onclick="abrirTarjetaProducto(this.closest('[data-edit-id]'))">
                    <i class="bi bi-share text-base leading-none"></i>
                  </button>
                  <a href="/<%= biz.slug %>/admin/producto/<%= p.id %>/poster" target="_blank" class="m-btn-icon !w-8 !h-8 hover:!bg-amber-50 hover:!text-amber-600" title="Póster imprimible con QR">
                    <i class="bi bi-qr-code text-base leading-none"></i>
                  </a>
                  <% if (puedeEditarP) { %>
                  <button class="m-btn-icon !w-8 !h-8 hover:!bg-neutral-100 hover:!text-neutral-800" title="Editar" onclick="editarProducto(this.closest('[data-edit-id]'))">
                    <i class="bi bi-pencil-square text-base leading-none"></i>
                  </button>
                  <% } %>
                  <details class="product-card__more">
                    <summary class="m-btn-icon" title="Más acciones" aria-label="Más acciones para <%= p.name %>"><i class="bi bi-three-dots"></i></summary>
                    <div class="product-card__menu">
                      <% if (puedeEditarP) { %>
                      <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/mover">
                        <input type="hidden" name="dir" value="up">
                        <button title="Subir producto"><i class="bi bi-arrow-up"></i><span>Subir posición</span></button>
                      </form>
                      <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/mover">
                        <input type="hidden" name="dir" value="down">
                        <button title="Bajar producto"><i class="bi bi-arrow-down"></i><span>Bajar posición</span></button>
                      </form>
                      <% } %>
                      <% if (perms.includes('productos.crear')) { %>
                      <button type="button" title="Duplicar" onclick="duplicarProducto(this.closest('[data-edit-id]'))"><i class="bi bi-copy"></i><span>Duplicar</span></button>
                      <% } %>
                      <% if (puedeEditarP) { %>
                      <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/featured">
                        <button title="Destacar"><i class="bi <%= p.featured ? 'bi-star-fill' : 'bi-star' %>"></i><span><%= p.featured ? 'Quitar destacado' : 'Destacar' %></span></button>
                      </form>
                      <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/toggle">
                        <button title="<%= p.active ? 'Ocultar producto' : 'Mostrar producto' %>"><i class="bi <%= p.active ? 'bi-eye-slash' : 'bi-eye' %>"></i><span><%= p.active ? 'Ocultar' : 'Mostrar' %></span></button>
                      </form>
                      <% } %>
                      <% if (puedeEliminarP) { %>
                      <form method="POST" action="/<%= biz.slug %>/admin/producto/<%= p.id %>/eliminar" data-confirm="¿Eliminar <%= p.name.replace(/'/g, "\\'") %>?">
                        <button class="danger" title="Eliminar"><i class="bi bi-trash3"></i><span>Eliminar</span></button>
                      </form>
                      <% } %>
                    </div>
                  </details>
                </div>
              </article>
            <% }) %>
          </div>
          <div id="prod-empty-filter" class="product-filter-empty hidden" role="status">
            <i class="bi bi-search" aria-hidden="true"></i>
            <strong>Sin productos que coincidan</strong>
            <span>Prueba otra búsqueda o limpia los filtros.</span>
            <button type="button" id="prod-clear-filters" class="m-btn m-btn-outlined m-btn-sm">Ver todos</button>
          </div>
          <nav id="prod-pager" class="product-pager" aria-label="Paginación de productos"></nav>
        <% } %>
      </section>

      <% if (perms.includes('productos.crear') || perms.includes('productos.editar')) { %>
      <!-- Agregar / editar producto (stepper) -->
      <section id="nuevo-producto" class="m-card p-4 mb-3" data-stepper>
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h2 id="pf-title" class="font-extrabold text-slate-900 text-sm">Agregar producto</h2>
          <button type="button" id="pf-cancel" onclick="cancelarEdicion()" class="hidden text-xs font-bold text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-full transition">✕ Cancelar edición</button>
        </div>

        <div id="pf-steps" class="flex items-center gap-1 mb-4 overflow-x-auto scrollbar-thin"></div>
        <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden mb-4">
          <div id="pf-bar" class="h-full bg-[var(--md-primary)] rounded-full transition-all duration-300" style="width:25%"></div>
        </div>

        <form method="POST" action="/<%= biz.slug %>/admin/producto" class="grid md:grid-cols-2 gap-x-4" id="pf-form">
          <div data-step-pane="1" class="md:col-span-2 grid md:grid-cols-2 gap-x-4">
            <div class="md:col-span-2">
              <label class="font-bold text-xs text-slate-600 mb-2 block">Tipo de producto</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="f-tipo-cards">
                <button type="button" data-tipo="unico" class="pf-tipo-card active" onclick="setTipo('unico')">
                  <span class="pf-tipo-ico"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                  <span><span class="pf-tipo-tit">Producto único</span><span class="pf-tipo-sub">Un precio; stock opcional si vendes por pedido</span></span>
                </button>
                <button type="button" data-tipo="variantes" class="pf-tipo-card" onclick="setTipo('variantes')">
                  <span class="pf-tipo-ico"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                  <span><span class="pf-tipo-tit">Con variantes</span><span class="pf-tipo-sub">Tallas o colores con precio propio; stock opcional por pedido</span></span>
                </button>
              </div>
              <input type="hidden" name="tipo" id="f-tipo" value="unico">
            </div>
            <div class="m-field">
              <label for="f-name">Nombre *</label>
              <input name="name" id="f-name" required placeholder="Ej: Taladro percutor 13mm">
            </div>
            <div class="m-field">
              <label for="f-cat">Categoría</label>
              <select name="category_id" id="f-cat">
                <option value="">Sin categoría</option>
                <% categories.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
              <p id="f-cat-hint" class="text-[11px] text-slate-400 mt-1 <%= categories.length ? 'hidden' : '' %>"><% if (puedeCategorias) { %>Aún no tienes categorías. Créala en la pestaña <button type="button" class="font-bold text-neutral-800 hover:underline" onclick="switchCrudTab('categorias')">Categorías</button>.<% } else { %>Aún no hay categorías. Pídele al dueño de la tienda que las cree.<% } %></p>
            </div>
            <div class="m-field" id="f-price-wrap">
              <label for="f-price" id="f-price-label">Precio *</label>
              <input name="price" id="f-price" required type="text" inputmode="decimal" data-mask="money" placeholder="0.00">
              <p id="f-price-note" class="hidden text-[11px] font-bold text-amber-600 mt-1">Con variantes, el precio se pone por cada variante en el paso 2 (Variantes) — es obligatorio en todas.</p>
            </div>
            <div class="m-field" id="f-stock-wrap">
              <label for="f-stock" id="f-stock-label">Stock * <span class="font-normal text-slate-400">(0 = agotado)</span></label>
              <input name="stock" id="f-stock" type="number" min="0" placeholder="Piezas disponibles">
              <p id="f-stock-note" class="hidden text-[11px] font-bold text-amber-600 mt-1">Con variantes, el stock se llena por cada variante en el paso 2 (Variantes) — 0 significa agotada.</p>
            </div>
            <label class="md:col-span-2 flex items-start gap-2.5 rounded-xl border px-4 py-3 cursor-pointer" style="border-color:var(--ap-border);background:var(--ap-card)">
              <input type="checkbox" name="made_to_order" id="f-made-to-order" value="1" class="mt-0.5 accent-neutral-800" onchange="syncStockField(); var ed=window.VAR_EDITORS && window.VAR_EDITORS.f; if(ed) ed.renderCombos(); if(pfStep===4) renderResumen()">
              <span><strong class="block text-xs" style="color:var(--ap-text)">Sin stock · por pedido</strong><span class="block text-[11px] mt-0.5" style="color:var(--ap-text-sec)">Siempre visible y disponible para pedir. No se pide cantidad ni se limita la compra por existencias.</span></span>
            </label>
            <label class="md:col-span-2 flex items-start gap-2.5 rounded-xl border px-4 py-3 cursor-pointer" style="border-color:var(--ap-border);background:var(--ap-card)">
              <input type="hidden" name="show_stock_set" value="1">
              <input type="checkbox" name="show_stock" id="f-show-stock" value="1" checked class="mt-0.5 accent-neutral-800">
              <span><strong class="block text-xs" style="color:var(--ap-text)">Mostrar el stock en el catálogo</strong><span class="block text-[11px] mt-0.5" style="color:var(--ap-text-sec)">El cliente verá "Quedan 3" o "12 disponibles". Si lo desmarcas no se muestra la cantidad; "Agotado" siempre se avisa.</span></span>
            </label>
            <div class="m-field md:col-span-2">
              <label for="f-cost">Costo del proveedor <span class="font-normal text-slate-400">(opcional — para tus reportes de ganancia)</span></label>
              <input name="cost" id="f-cost" type="text" inputmode="decimal" data-mask="money" placeholder="0.00">
            </div>
            <div class="m-field md:col-span-2">
              <label for="f-desc">Descripción atractiva</label>
              <textarea name="description" id="f-desc" rows="2" placeholder="Describe los beneficios…"></textarea>
            </div>

            <!-- Todo lo demás es opcional/poco usado — se guarda colapsado para
                 no abrumar con 10+ campos de golpe; se abre solo (o al editar
                 un producto que ya trae algo aquí, o si algo falla al validar). -->
            <details class="md:col-span-2 pf-advanced" id="pf-advanced">
              <summary>+ Más detalles <span class="font-normal text-slate-400">(promoción, SKU, video, abonos…)</span></summary>
              <div class="grid md:grid-cols-2 gap-x-4 pf-advanced-body">
                <div class="m-field md:col-span-2">
                  <label for="f-promo-type">Promoción <span class="font-normal text-slate-400">(opcional)</span></label>
                  <select name="promo_type" id="f-promo-type" onchange="onPromoTypeChange()">
                    <option value="">Sin promoción</option>
                    <option value="descuento">💵 Precio rebajado (antes/ahora)</option>
                    <option value="porcentaje">📉 Porcentaje de descuento</option>
                    <option value="2x1">🛍️ 2x1 · lleva 2 paga 1</option>
                    <option value="3x2">🛍️ 3x2 · lleva 3 paga 2</option>
                    <option value="regalo">🎁 Lleva de regalo</option>
                  </select>
                </div>
                <div id="promo-desc" class="m-field hidden">
                  <label for="f-old">Precio antes</label>
                  <input name="old_price" id="f-old" type="text" inputmode="decimal" data-mask="money" placeholder="0.00">
                </div>
                <div id="promo-pct" class="m-field hidden">
                  <label for="f-promo-value">% de descuento</label>
                  <input name="promo_value" id="f-promo-value" type="number" min="1" max="99" placeholder="20">
                </div>
                <div id="promo-gift" class="m-field hidden">
                  <label for="f-promo-gift">¿Qué regalas?</label>
                  <input name="promo_gift" id="f-promo-gift" placeholder="Ej: Martillo de uña 16oz">
                </div>
                <div id="promo-ends" class="m-field hidden">
                  <label for="f-promo">La promo vence el… (opcional)</label>
                  <input name="promo_ends_at" id="f-promo" type="date" placeholder=" ">
                </div>
                <div class="m-field">
                  <label for="f-sku">SKU / código interno <span class="font-normal text-slate-400">(opcional)</span></label>
                  <input name="sku" id="f-sku" placeholder="Ej: TAL-001">
                </div>
                <div class="m-field">
                  <label for="f-barcode">Código de barras <span class="font-normal text-slate-400">(opcional)</span></label>
                  <input name="barcode" id="f-barcode" placeholder="Ej: 7501234567890">
                </div>
                <div class="m-field md:col-span-2">
                  <label for="f-tags">Etiquetas <span class="font-normal text-slate-400">(separadas por coma — mejoran la búsqueda)</span></label>
                  <input name="tags" id="f-tags" placeholder="Ej: taladro, inalámbrico, batería">
                </div>
                <div class="m-field md:col-span-2">
                  <label for="f-video">Video <span class="font-normal text-slate-400">(opcional, 1 por producto — pega una URL)</span></label>
                  <input name="video" id="f-video" placeholder="https://… (YouTube, Vimeo o .mp4)">
                </div>
                <div class="m-field md:col-span-2">
                  <label for="f-specs">Características <span class="font-normal text-slate-400">(una por línea: "Marca: Bosch")</span></label>
                  <textarea name="specs" id="f-specs" rows="3" placeholder="Marca: Bosch&#10;Material: Acero&#10;Garantía: 1 año"></textarea>
                </div>
                <div class="md:col-span-2 rounded-2xl border border-slate-200 p-3">
                  <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="checkbox" name="allow_installments" id="f-installments" value="1" class="w-4 h-4 accent-emerald-500" onchange="toggleInstallmentFields()">
                    <span class="text-sm font-bold text-slate-700">Vender por abonos</span>
                  </label>
                  <div id="installment-fields" class="hidden mt-3 grid grid-cols-1 gap-3">
                    <div class="m-field">
                      <label for="f-inst-count">N&uacute;mero de abonos</label>
                      <input name="installment_count" id="f-inst-count" type="number" min="2" max="48" value="6" placeholder="6">
                    </div>
                    <div class="m-field">
                      <label for="f-inst-down">Enganche m&iacute;nimo</label>
                      <input name="installment_min_down" id="f-inst-down" type="number" min="0" step="0.01" placeholder="0">
                    </div>
                    <div class="m-field">
                      <label for="f-inst-freq">Frecuencia</label>
                      <select name="installment_frequency" id="f-inst-freq">
                        <option value="semanal">Semanal</option>
                        <option value="quincenal">Quincenal</option>
                        <option value="mensual">Mensual</option>
                      </select>
                    </div>
                  </div>
                </div>
                <label class="md:col-span-2 flex items-center gap-2.5 bg-slate-50 rounded-xl px-4 py-3 text-sm font-bold text-slate-600 cursor-pointer">
                  <input type="checkbox" name="featured" id="f-featured" value="1" class="w-4.5 h-4.5 accent-amber-500">
                  ⭐ Producto destacado
                </label>
              </div>
            </details>
          </div>

          <div data-step-pane="2" class="md:col-span-2 hidden">
            <label class="font-bold text-xs text-slate-600 mb-1.5 block">Fotos del producto <span class="font-normal text-slate-400">(puedes subir varias — la primera es la portada)</span></label>
            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2" id="f-fotos"></div>
            <label class="group cursor-pointer border-2 border-dashed border-slate-200 hover:border-[var(--md-primary)] hover:bg-neutral-100/30 rounded-2xl p-4 text-center transition block mt-2">
              <input id="f-fotos-input" type="file" accept="image/*" multiple class="hidden" onchange="subirVarias('f', this)">
              <div class="text-2xl mb-1 group-hover:scale-110 transition">📷</div>
              <p class="text-xs font-bold text-slate-600">Subir fotos</p>
              <p class="text-[10px] text-slate-400 mt-0.5">Elige varias a la vez · .jpg .png .webp (máx 5MB c/u)</p>
            </label>
            <input type="hidden" name="image" id="f-image">
            <input type="hidden" name="galeria" id="f-galeria">
          </div>

          <div data-step-pane="3" class="md:col-span-2 hidden">
            <div class="rounded-2xl border border-slate-200 p-3 mb-4">
              <p class="font-bold text-xs text-slate-700 mb-2">1 · Elige los atributos (Talla, Color…)</p>
              <div id="f-tpl-pills" class="flex flex-wrap gap-2 items-center"></div>
              <p id="f-tpl-empty" class="text-[11px] text-slate-400 mt-1.5"></p>
              <div class="flex items-center gap-2 mt-2">
                <input type="text" id="f-tpl-new-name" placeholder="+ Nuevo atributo al momento (ej: Color)" class="flex-1 min-w-[140px] text-xs border border-dashed border-slate-300 rounded-full px-3 py-1.5 bg-white focus:outline-none focus:border-neutral-500">
                <button type="button" id="f-tpl-new-add" class="shrink-0 text-xs font-bold text-white bg-neutral-800 hover:bg-neutral-700 rounded-full px-3 py-1.5">Agregar</button>
              </div>
            </div>

            <div class="mb-4">
              <p class="font-bold text-xs text-slate-700 mb-2">2 · Atributos seleccionados <span class="font-normal text-slate-400">(puedes ajustar los valores aquí)</span></p>
              <div id="f-var-box" class="space-y-2"></div>
            </div>

            <div>
              <p class="font-bold text-xs text-slate-700 mb-2">3 · Variantes generadas <span class="font-normal text-slate-400">(precio obligatorio; stock solo si administras existencias; toca la foto para cambiarla)</span></p>
              <div id="f-combo-box"></div>
            </div>
            <input type="hidden" name="variants" id="f-var-hidden">
          </div>

          <div data-step-pane="4" class="md:col-span-2 hidden">
            <div id="pf-resumen" class="rounded-2xl bg-slate-50 border border-slate-100 p-4 text-sm"></div>
          </div>

          <div id="pf-upload-error" role="alert" class="md:col-span-2 hidden mt-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-semibold text-amber-900">
            <p>Una foto no se pudo subir. Tus datos siguen aquí. Vuelve a seleccionar la foto o continúa sin las fotos fallidas.</p>
            <button type="button" onclick="ignorarFotosFallidas()" class="mt-2 underline underline-offset-2 font-bold">Continuar sin esas fotos</button>
          </div>

          <div class="md:col-span-2 mt-4 flex items-center gap-2">
            <button type="button" id="pf-back" class="m-btn m-btn-outlined hidden">← Atrás</button>
            <button type="button" id="pf-next" class="m-btn m-btn-filled">Siguiente →</button>
            <button type="submit" id="pf-save" class="m-btn m-btn-filled flex-1 hidden">Guardar producto</button>
          </div>
        </form>
      </section>
      <% } %>
      </div><!-- /products-workspace -->
      </div><!-- /tabpane-productos -->

      <% if (puedeCategorias) { %>
      <div id="tabpane-categorias" class="prod-tab-panel">
      <section id="categorias" class="m-card p-4 mb-3">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h3 class="font-bold text-sm text-slate-700">Categorías <span class="m-badge m-badge-neutral !ml-1.5"><span id="cat-count"><%= categories.length %></span></span></h3>
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <input id="cat-name" placeholder="Nueva categoría" class="w-full sm:w-52 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-1000 focus:border-neutral-1000 transition">
            <button type="button" onclick="agregarCategoria()" class="m-btn m-btn-tonal m-btn-sm shrink-0">Crear</button>
          </div>
        </div>
        <div id="cat-list" class="flex flex-wrap gap-1.5"></div>
      </section>
      </div><!-- /tabpane-categorias -->
      <% } %>

      <% if (puedeAtributos) { %>
      <div id="tabpane-atributos" class="prod-tab-panel">
      <section id="mis-atributos" class="m-card p-4 mb-3">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-sm text-slate-700">Mis atributos <span class="m-badge m-badge-neutral !ml-1.5"><span id="attr-count">0</span></span></h3>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 w-full mb-3">
          <input id="attr-name" placeholder="Nombre (ej: Talla)" class="w-full sm:w-44 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-1000 focus:border-neutral-1000 transition">
          <input id="attr-values" placeholder="Valores separados por coma (XS, M, L)" class="w-full sm:flex-1 border border-slate-200 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-1000 focus:border-neutral-1000 transition">
          <button type="button" onclick="agregarAtributo()" class="m-btn m-btn-tonal m-btn-sm shrink-0">Guardar</button>
        </div>
        <p class="text-[11px] text-slate-400 mb-3">Guárdalos una sola vez y úsalos en cualquier producto. Guardar con el mismo nombre actualiza los valores.</p>
        <div id="attr-list" class="flex flex-wrap gap-1.5"></div>
      </section>
      </div><!-- /tabpane-atributos -->
      <% } %>

    </div>
  </main>

  <% if (perms.includes('productos.crear') || perms.includes('productos.editar')) { %>
  <a href="#nuevo-producto" class="m-fab m-ripple" title="Agregar producto" onclick="return irNuevoProducto(event)">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
  </a>
  <% } %>

  <dialog id="product-image-dialog" class="product-image-dialog" aria-labelledby="product-image-caption" onclick="cerrarImagenProductoDesdeFondo(event)">
    <div class="product-image-dialog__surface">
      <button type="button" class="product-image-dialog__close" onclick="cerrarImagenProducto()" aria-label="Cerrar imagen ampliada">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
      <img id="product-image-expanded" alt="" src="">
      <p id="product-image-caption"></p>
    </div>
  </dialog>

  <%- include('partials/img-editor', { upUrl: '/' + biz.slug + '/admin/upload', z: 130 }) %>
  <script>window.imgeContainerApplied = function () { if (typeof renderFotos === 'function') renderFotos('f'); };</script>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>
