  </style>

  <script>
    var CURRENCY_SYMBOL = '<%= typeof currencySymbol !== "undefined" && currencySymbol ? currencySymbol : "$" %>';
    function money(n) { return CURRENCY_SYMBOL + (Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')); }

    function abrirImagenProducto(img, nombre) {
      var dialog = document.getElementById('product-image-dialog');
      var expanded = document.getElementById('product-image-expanded');
      var caption = document.getElementById('product-image-caption');
      if (!dialog || !expanded || !img) return;
      expanded.src = img.currentSrc || img.src;
      expanded.alt = 'Imagen ampliada de ' + (nombre || 'producto');
      if (caption) caption.textContent = nombre || 'Producto';
      if (!dialog.open) dialog.showModal();
    }
    function cerrarImagenProducto() {
      var dialog = document.getElementById('product-image-dialog');
      if (dialog && dialog.open) dialog.close();
    }
    function cerrarImagenProductoDesdeFondo(event) {
      if (event && event.target === event.currentTarget) cerrarImagenProducto();
    }

    // Tabs: Productos | Categorías | Atributos
    function switchCrudTab(name) {
      ['productos', 'categorias', 'atributos'].forEach(function (n) {
        var b = document.getElementById('tabbtn-' + n);
        if (b) b.classList.toggle('active', n === name);
        var p = document.getElementById('tabpane-' + n);
        if (p) p.classList.toggle('active', n === name);
      });
      if (name === 'categorias') renderCatList();
      if (name === 'atributos') renderAttrCatalog();
    }

    function irNuevoProducto(e) {
      if (e && e.preventDefault) e.preventDefault();
      switchCrudTab('productos');
      var w = document.getElementById('nuevo-producto');
      if (w) setTimeout(function () {
        w.scrollIntoView({ behavior: 'smooth', block: 'start' });
        var nameEl = document.getElementById('f-name');
        if (nameEl) setTimeout(function () { nameEl.focus(); }, 220);
      }, 60);
      return false;
    }

    // ====== Componente de variantes (atributos + combinaciones con foto) ======
    function initVariantes(pref, valor) {
      var box = document.getElementById(pref + '-var-box');
      var hidden = document.getElementById(pref + '-var-hidden');
      if (!box || !hidden) return;

      var model = { attrs: [], images: {}, stock: {}, prices: {}, costs: {}, skus: {}, barcodes: {} };
      try {
        var raw = (valor !== undefined && valor !== null && valor !== '') ? valor : hidden.value;
        var p = JSON.parse(raw);
        if (p && !Array.isArray(p) && Array.isArray(p.attrs)) {
          model = { attrs: p.attrs.map(function (a) { return { name: a.name || '', values: a.values || [] }; }), images: p.images || {}, stock: p.stock || {}, prices: p.prices || {}, costs: p.costs || {}, skus: p.skus || {}, barcodes: p.barcodes || {} };
        } else if (Array.isArray(p)) {
          var vals = p.map(function (v) { return typeof v === 'string' ? v : (v.name || ''); }).filter(Boolean);
          if (vals.length) model = { attrs: [{ name: '', values: vals }], images: {}, stock: {}, prices: {}, costs: {}, skus: {}, barcodes: {} };
        }
      } catch (e) { model = { attrs: [], images: {}, stock: {}, prices: {}, costs: {}, skus: {}, barcodes: {} }; }

      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
      function save() { hidden.value = JSON.stringify(model); }
      function comboKey(vals) { return vals.join('|'); }
      function combos() {
        var lists = model.attrs.map(function (a) { return (a.values && a.values.length) ? a.values : ['']; });
        if (!lists.length) return [];
        return lists.reduce(function (acc, arr) {
          if (!acc.length) return arr.map(function (v) { return [v]; });
          var out = [];
          acc.forEach(function (prefix) { arr.forEach(function (v) { out.push(prefix.concat([v])); }); });
          return out;
        }, []);
      }
      function subirCombo(key) {
        var inp = document.createElement('input');
        inp.type = 'file'; inp.accept = 'image/*';
        inp.onchange = function () {
          var f = inp.files && inp.files[0]; if (!f) return;
          var uploadKey = 'combo:' + key;
          pfUploadStart();
          comprimirImagen(f).then(function (finalFile) {
            var fd = new FormData(); fd.append('foto', finalFile, nombreFotoSubida(finalFile, f));
            var tok = (window.__csrfValue && window.__csrfValue()) || '';
            if (tok) fd.append('_csrf', tok);
            return fetch('/<%= biz.slug %>/admin/upload', { method: 'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {} });
          })
            .then(leerRespuestaFoto)
            .then(function (d) {
              if (d.url) { setPhotoUploadFailed(uploadKey, false); model.images[key] = d.url; save(); renderCombos(); }
              else { setPhotoUploadFailed(uploadKey, true); if (window.mostrarToast) mostrarToast('No se pudo subir la foto', 'error'); }
            })
            .catch(function (e) { setPhotoUploadFailed(uploadKey, true); if (window.mostrarToast) mostrarToast(e.message || 'Error al subir la foto', 'error'); })
            .finally(pfUploadEnd);
        };
        inp.click();
      }

      function render() {
        box.innerHTML = '';
        model.attrs.forEach(function (attr, ai) {
          var row = document.createElement('div');
          row.className = 'rounded-xl border border-slate-200 p-2.5';
          row.innerHTML =
            '<div class="flex items-center gap-2 mb-2">' +
              '<span class="var-attr-name flex-1 text-xs font-bold text-slate-700 truncate">' + (esc(attr.name) || '(atributo)') + '</span>' +
              '<button type="button" class="var-attr-del text-slate-400 hover:text-red-500 font-bold px-1.5 shrink-0" title="Quitar atributo">✕</button>' +
            '</div>' +
            '<div class="var-values flex flex-wrap gap-1.5 items-center">' +
              '<input type="text" placeholder="Valor + Enter (ej: XS)" class="var-val-input flex-1 min-w-[90px] text-xs bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-neutral-500">' +
              '<button type="button" class="var-val-add shrink-0 text-xs font-bold text-white bg-neutral-800 hover:bg-neutral-700 rounded-lg px-2.5 py-1.5">+</button>' +
            '</div>';
          var valuesWrap = row.querySelector('.var-values');
          var valInput = row.querySelector('.var-val-input');
          var valAddBtn = row.querySelector('.var-val-add');
          function renderValues() {
            valuesWrap.querySelectorAll('.var-chip').forEach(function (c) { c.remove(); });
            attr.values.forEach(function (v, vi) {
              var chip = document.createElement('span');
              chip.className = 'var-chip inline-flex items-center gap-1 bg-neutral-100 text-neutral-800 text-xs font-bold px-2 py-0.5 rounded-full';
              chip.innerHTML = esc(v) + ' <button type="button" class="var-chip-del leading-none hover:text-red-500">✕</button>';
              chip.querySelector('.var-chip-del').onclick = function () { attr.values.splice(vi, 1); renderValues(); renderCombos(); save(); };
              valuesWrap.insertBefore(chip, valInput);
            });
          }
          // Botón "+" además de Enter/coma: en algunos teclados de celular
          // (con autocompletar/predictivo) el Enter no siempre dispara un
          // keydown normal, así que no conviene depender solo de eso.
          function addValueFromInput() {
            var v = valInput.value.trim();
            if (v && attr.values.indexOf(v) === -1) attr.values.push(v);
            valInput.value = '';
            renderValues(); renderCombos(); save();
          }
          valInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ',' || e.keyCode === 13 || e.keyCode === 188) {
              e.preventDefault();
              addValueFromInput();
            }
          });
          valAddBtn.addEventListener('click', addValueFromInput);
          row.querySelector('.var-attr-del').onclick = function () { model.attrs.splice(ai, 1); render(); save(); renderTplPills(pref); };
          renderValues();
          box.appendChild(row);
        });

        renderCombos();
        syncStockField();
        syncPriceField();
      }

      function renderCombos() {
        var cbox = document.getElementById(pref + '-combo-box');
        if (!cbox) return;
        cbox.innerHTML = '';
        var cs = combos();
        if (!cs.length) return;
        var m = document.createElement('p');
        m.className = 'text-[11px] font-bold text-neutral-800 bg-neutral-100 border border-neutral-100 rounded-lg px-2.5 py-1.5 mb-3';
        var madeToOrder = !!(document.getElementById('f-made-to-order') && document.getElementById('f-made-to-order').checked);
        m.textContent = 'Sigue siendo 1 producto: una descripción para todos, y cada variante con su propia foto y precio' + (madeToOrder ? ', disponible por pedido' : ' y stock') + '. Los atributos crean ' + cs.length + ' variante' + (cs.length === 1 ? '' : 's') + '.';
        cbox.appendChild(m);

        // Precio general opcional: rellena todas las variantes de un jalón,
        // pero cada una se puede seguir editando aparte después — nunca es
        // "un precio para todo el producto", siempre queda guardado por
        // variante (así lo pide el servidor).
        var bulk = document.createElement('div');
        bulk.className = 'flex items-end gap-2 mb-3 p-2.5 rounded-xl bg-neutral-50 border border-neutral-100';
        bulk.innerHTML =
          '<div class="flex-1">' +
            '<label class="block text-[10px] font-bold text-slate-500 mb-1">Precio general <span class="font-normal text-slate-400">(opcional — lo aplicas a todas y luego ajustas la que quieras)</span></label>' +
            '<input type="number" min="0" step="0.01" placeholder="0.00" class="combo-bulk-price w-full text-sm border border-slate-300 rounded-lg px-2.5 py-2 bg-white text-slate-900 focus:outline-none focus:border-neutral-500" style="color-scheme:light">' +
          '</div>' +
          '<button type="button" class="combo-bulk-apply m-btn m-btn-outlined !h-[38px] !text-xs shrink-0">Aplicar a todas</button>';
        bulk.querySelector('.combo-bulk-apply').onclick = function () {
          var v = bulk.querySelector('.combo-bulk-price').value;
          if (v === '' || isNaN(parseFloat(v))) { if (window.mostrarToast) mostrarToast('Escribe un precio válido primero', 'error'); return; }
          cs.forEach(function (vals) { model.prices[comboKey(vals)] = parseFloat(v) || 0; });
          save();
          renderCombos();
          if (window.mostrarToast) mostrarToast('Precio aplicado a las ' + cs.length + ' variantes ✓', 'ok');
        };
        cbox.appendChild(bulk);

        var t = document.createElement('p');
        t.className = 'text-xs font-bold text-slate-600 mb-2';
        t.textContent = 'Cada variante — ' + (madeToOrder ? 'precio propio, sin control de stock' : 'precio y stock propios') + ' (toca la foto para cambiarla)';
        cbox.appendChild(t);

        var list = document.createElement('div');
        list.className = 'flex flex-col gap-2';
        cs.forEach(function (vals) {
          var key = comboKey(vals);
          var label = vals.join(' / ');
          var img = model.images[key] || '';
          var st = (model.stock[key] !== undefined && model.stock[key] !== '') ? model.stock[key] : '';
          var pr = (model.prices && model.prices[key] !== undefined && model.prices[key] !== '') ? model.prices[key] : '';
          var co = (model.costs && model.costs[key] !== undefined && model.costs[key] !== '') ? model.costs[key] : '';
          var sk = (model.skus && model.skus[key]) ? model.skus[key] : '';
          var bc = (model.barcodes && model.barcodes[key]) ? model.barcodes[key] : '';
          var inputCls = 'w-full text-xs border border-slate-300 rounded-lg px-2 py-1.5 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-neutral-500 focus:ring-1 focus:ring-neutral-400';
          var cell = document.createElement('div');
          cell.className = 'var-combo-block rounded-xl border border-slate-200 bg-white overflow-hidden';
          cell.innerHTML =
            '<div class="flex gap-3 p-2.5">' +
              '<div class="relative shrink-0">' +
                '<button type="button" class="combo-photo w-16 h-16 rounded-lg overflow-hidden border border-slate-200 bg-slate-50 flex items-center justify-center" title="Foto para: ' + esc(label) + '">' +
                  (img ? '<img src="' + esc(img) + '" class="w-full h-full object-cover">' : '<span class="text-slate-300 text-xl">🖼</span>') +
                '</button>' +
                (img ?
                  '<div class="absolute -top-1.5 -right-1.5 flex gap-1">' +
                    '<button type="button" class="combo-photo-edit w-5 h-5 rounded-full bg-black/60 text-white text-[10px] font-bold flex items-center justify-center hover:bg-neutral-800 transition" title="Editar foto">✎</button>' +
                    '<button type="button" class="combo-photo-del w-5 h-5 rounded-full bg-black/60 text-white text-[10px] font-bold flex items-center justify-center hover:bg-red-600 transition" title="Quitar foto">✕</button>' +
                  '</div>'
                : '') +
              '</div>' +
              '<div class="flex-1 min-w-0">' +
                '<p class="text-xs font-bold text-slate-800 truncate mb-1.5">' + esc(label) + '</p>' +
                '<div class="grid grid-cols-2 gap-2">' +
                  '<div>' +
                    '<label class="block text-[10px] font-bold text-slate-500 mb-0.5">Precio* de esta variante</label>' +
                    '<input type="number" min="0" step="0.01" placeholder="0.00" value="' + esc(pr) + '" class="combo-price ' + inputCls + '" style="color-scheme:light" title="Precio obligatorio de esta variante">' +
                  '</div>' +
                  (madeToOrder ? '' : '<div>' +
                    '<label class="block text-[10px] font-bold text-slate-500 mb-0.5">Stock*</label>' +
                    '<input type="number" min="0" placeholder="0" value="' + esc(st) + '" class="combo-stock ' + inputCls + '" style="color-scheme:light" title="Stock obligatorio de esta variante (0 = agotada)">' +
                  '</div>') +
                  '<div>' +
                    '<label class="block text-[10px] font-bold text-slate-500 mb-0.5">SKU <span class="font-normal text-slate-400">(opc.)</span></label>' +
                    '<input type="text" placeholder="—" value="' + esc(sk) + '" class="combo-sku ' + inputCls + '" style="color-scheme:light">' +
                  '</div>' +
                  '<div>' +
                    '<label class="block text-[10px] font-bold text-slate-500 mb-0.5">Código de barras <span class="font-normal text-slate-400">(opc.)</span></label>' +
                    '<input type="text" placeholder="—" value="' + esc(bc) + '" class="combo-barcode ' + inputCls + '" style="color-scheme:light">' +
                  '</div>' +
                  '<div>' +
                    '<label class="block text-[10px] font-bold text-slate-500 mb-0.5">Costo del proveedor <span class="font-normal text-slate-400">(opc. — para reportes)</span></label>' +
                    '<input type="number" min="0" step="0.01" placeholder="0.00" value="' + esc(co) + '" class="combo-cost ' + inputCls + '" style="color-scheme:light">' +
                  '</div>' +
                '</div>' +
                (madeToOrder ? '' : '<p class="combo-stock-warn hidden text-[10px] font-black text-red-500 mt-1">¡Falta stock!</p>') +
              '</div>' +
            '</div>';
          cell.querySelector('.combo-photo').onclick = function () { subirCombo(key); };
          var editBtn = cell.querySelector('.combo-photo-edit');
          if (editBtn) editBtn.onclick = function (e) {
            e.stopPropagation();
            abrirEditorImagen(img, function (newUrl) {
              if (!newUrl) return;
              model.images[key] = newUrl; save(); renderCombos();
            });
          };
          var delBtn = cell.querySelector('.combo-photo-del');
          if (delBtn) delBtn.onclick = function (e) {
            e.stopPropagation();
            delete model.images[key]; save(); renderCombos();
          };
          var stInp = cell.querySelector('.combo-stock');
          if (stInp) (function (inp) {
            function syncSt() {
              var missing = inp.value.trim() === '';
              inp.style.borderColor = missing ? '#f87171' : '';
              inp.style.boxShadow = missing ? '0 0 0 2px rgba(248,113,113,.15)' : '';
              var tag = cell.querySelector('.combo-stock-warn');
              if (tag) tag.classList.toggle('hidden', !missing);
            }
            inp.addEventListener('input', function () {
              var v = this.value;
              if (v === '') delete model.stock[key]; else model.stock[key] = parseInt(v) || 0;
              save();
              syncSt();
            });
            syncSt();
          })(stInp);
          var prInp = cell.querySelector('.combo-price');
          (function (inp) {
            function syncPr() {
              var missing = inp.value.trim() === '';
              inp.style.borderColor = missing ? '#f87171' : '';
              inp.style.boxShadow = missing ? '0 0 0 2px rgba(248,113,113,.15)' : '';
            }
            inp.addEventListener('input', function () {
              var v = this.value;
              if (v === '') delete model.prices[key]; else model.prices[key] = parseFloat(v) || 0;
              save();
              syncPr();
            });
            syncPr();
          })(prInp);
          cell.querySelector('.combo-sku').addEventListener('input', function () {
            var v = this.value.trim();
            if (v === '') delete model.skus[key]; else model.skus[key] = v;
            save();
          });
          cell.querySelector('.combo-barcode').addEventListener('input', function () {
            var v = this.value.trim();
            if (v === '') delete model.barcodes[key]; else model.barcodes[key] = v;
            save();
          });
          cell.querySelector('.combo-cost').addEventListener('input', function () {
            var v = this.value;
            if (v === '') delete model.costs[key]; else model.costs[key] = parseFloat(v) || 0;
            save();
          });
          list.appendChild(cell);
        });
        cbox.appendChild(list);
      }

      window.VAR_EDITORS = window.VAR_EDITORS || {};
      window.VAR_EDITORS[pref] = {
        model: model,
        save: save,
        render: render,
        renderCombos: renderCombos,
        toggleAttr: function (name, values) {
          var idx = -1;
          model.attrs.forEach(function (a, i) { if ((a.name || '').toLowerCase() === String(name).toLowerCase()) idx = i; });
          if (idx >= 0) { model.attrs.splice(idx, 1); }
          else { model.attrs.push({ name: String(name || '').trim(), values: (values || []).slice() }); }
          render(); save(); renderTplPills(pref);
        }
      };
      render();
    }

    // ====== Componente de fotos (subir varias a la vez, sin campos URL) ======
    function renderFotos(pref) {
      var box = document.getElementById(pref + '-fotos');
      var hiddenImg = document.getElementById(pref + '-image');
      var hiddenGal = document.getElementById(pref + '-galeria');
      if (!box) return;
      var list = [];
      box.querySelectorAll('[data-url]').forEach(function (el) { list.push(el.getAttribute('data-url')); });
      box.innerHTML = '';
      list.forEach(function (u, i) {
        var w = document.createElement('div');
        w.className = 'relative rounded-xl overflow-hidden border border-slate-200 bg-white aspect-square';
        w.setAttribute('data-url', u);
        w.innerHTML =
          '<img src="' + u + '" class="w-full h-full object-cover">' +
          (i === 0 ? '<span class="absolute top-1 left-1 text-[9px] font-black text-white bg-black/60 rounded-md px-1.5 py-0.5">Portada</span>' : '') +
          '<div class="absolute top-1 right-1 flex flex-col gap-1">' +
            '<button type="button" title="Editar imagen" class="photo-edit w-6 h-6 rounded-full bg-black/50 text-white text-xs font-bold flex items-center justify-center hover:bg-neutral-800 transition">✎</button>' +
            '<button type="button" title="Quitar" class="photo-del w-6 h-6 rounded-full bg-black/50 text-white text-xs font-bold flex items-center justify-center hover:bg-red-600 transition">✕</button>' +
          '</div>';
        w.querySelector('.photo-edit').addEventListener('click', function (e) { e.stopPropagation(); abrirEditorImagen(w); });
        w.querySelector('.photo-del').addEventListener('click', function () { w.remove(); renderFotos(pref); });
        box.appendChild(w);
      });
      if (hiddenImg) hiddenImg.value = list[0] || '';
      if (hiddenGal) hiddenGal.value = JSON.stringify(list.slice(1));
    }

    // Comprime la imagen (reduce tamaño y peso) antes de subirla.
    function comprimirImagen(file) {
      return new Promise(function (resolve) {
        if (!file || !file.type || file.type.indexOf('image/') !== 0) { resolve(file); return; }
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () {
          var MAX = 1600;
          var w = img.width, h = img.height;
          var scale = Math.min(1, MAX / Math.max(w, h));
          w = Math.round(w * scale); h = Math.round(h * scale);
          var canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          canvas.toBlob(function (blob) { resolve(blob || file); }, 'image/jpeg', 0.85);
        };
        img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }

    function nombreFotoSubida(finalFile, originalFile) {
      // El canvas entrega JPEG aunque la cámara haya dado un nombre .heic/.png.
      // Multer valida extensión y MIME; ambos deben describir el archivo enviado.
      return finalFile.type === 'image/jpeg' ? 'foto.jpg' : (originalFile.name || 'foto.jpg');
    }

    function leerRespuestaFoto(response) {
      return response.text().then(function (body) {
        var data;
        try { data = JSON.parse(body); } catch (e) { data = {}; }
        if (response.redirected) throw new Error('Tu sesión expiró. Entra de nuevo y vuelve a subir la foto.');
        if (!response.ok) throw new Error(data.error || (response.status === 403 ? 'Sesión vencida. Recarga la página e intenta de nuevo.' : 'No se pudo subir la foto.'));
        return data;
      });
    }

    function subirVarias(pref, input) {
      if (!input || !input.files || !input.files.length) return;
      var files = Array.prototype.slice.call(input.files);
      var tok = (window.__csrfValue && window.__csrfValue()) || '';
      var pending = files.length, done = 0;
      if (window.mostrarToast) mostrarToast('Subiendo ' + files.length + ' foto(s)…', 'info');
      files.forEach(function (file) {
        var uploadKey = photoUploadKey(file);
        pfUploadStart();
        comprimirImagen(file).then(function (finalFile) {
          var fd = new FormData();
          fd.append('foto', finalFile, nombreFotoSubida(finalFile, file));
          if (tok) fd.append('_csrf', tok);
          return fetch('/<%= biz.slug %>/admin/upload', { method: 'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {} });
        })
          .then(leerRespuestaFoto)
          .then(function (d) {
            if (d.url) {
              setPhotoUploadFailed(uploadKey, false);
              var box = document.getElementById(pref + '-fotos');
              if (box) {
                var w = document.createElement('div');
                w.className = 'relative rounded-xl overflow-hidden border border-slate-200 bg-white aspect-square';
                w.setAttribute('data-url', d.url);
                w.innerHTML = '<img src="' + d.url + '" class="w-full h-full object-cover">' +
                  '<button type="button" title="Quitar" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/50 text-white text-xs font-bold flex items-center justify-center hover:bg-red-600 transition">✕</button>';
                w.querySelector('button').addEventListener('click', function () { w.remove(); renderFotos(pref); });
                box.appendChild(w);
              }
              done++;
            } else {
              setPhotoUploadFailed(uploadKey, true);
              if (window.mostrarToast) mostrarToast('No se pudo subir una foto.', 'error');
            }
          })
          .catch(function (e) { setPhotoUploadFailed(uploadKey, true); if (window.mostrarToast) mostrarToast(e.message || 'Error al subir una foto.', 'error'); })
          .finally(function () {
            pending--;
            pfUploadEnd();
            if (pending === 0) {
              renderFotos(pref);
              input.value = '';
              if (done > 0 && window.mostrarToast) mostrarToast(done + ' foto(s) subidas ✓', 'ok');
            }
          });
      });
    }

    function initFotos(pref, imagen, galeria) {
      var box = document.getElementById(pref + '-fotos');
      if (!box) return;
      box.innerHTML = '';
      var lista = [];
      if (imagen) lista.push(imagen);
      if (galeria) {
        try { var g = JSON.parse(galeria); if (Array.isArray(g)) g.forEach(function (u) { if (u) lista.push(u); }); } catch (e) {}
      }
      lista.forEach(function (u) {
        var w = document.createElement('div');
        w.className = 'relative rounded-xl overflow-hidden border border-slate-200 bg-white aspect-square';
        w.setAttribute('data-url', u);
        w.innerHTML = '<img src="' + u + '" class="w-full h-full object-cover">' +
          '<button type="button" title="Quitar" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/50 text-white text-xs font-bold flex items-center justify-center hover:bg-red-600 transition">✕</button>';
        w.querySelector('button').addEventListener('click', function () { w.remove(); renderFotos(pref); });
        box.appendChild(w);
      });
      renderFotos(pref);
    }

    // ====== Filtro en vivo + paginación de productos ======
    var PROD_PAGE_SIZE = 6;
    function initProdFilter() {
      var input = document.getElementById('prod-search');
      var chips = document.querySelectorAll('#prod-filters button');
      if (!input || input.getAttribute('data-catalog-ready') === 'true') return;
      input.setAttribute('data-catalog-ready', 'true');
      var state = 'all', q = '', page = 1, current = [];
      var summary = document.getElementById('prod-result-summary');
      var empty = document.getElementById('prod-empty-filter');
      var clear = document.getElementById('prod-clear-filters');
      function normalize(value) {
        var text = String(value || '').toLowerCase();
        return typeof text.normalize === 'function' ? text.normalize('NFD').replace(/[\u0300-\u036f]/g, '') : text;
      }
      function cardsAll() {
        return Array.prototype.slice.call(document.querySelectorAll('#prod-grid [data-search]'));
      }
      function compute() {
        return cardsAll().filter(function (card) {
          var ok = true;
          if (state === 'active' && card.getAttribute('data-state') !== 'active') ok = false;
          if (state === 'hidden' && card.getAttribute('data-state') !== 'hidden') ok = false;
          if (state === 'out' && card.getAttribute('data-stock') !== 'out') ok = false;
          if (state === 'low' && card.getAttribute('data-stock') !== 'low') ok = false;
          if (state === 'promo' && card.getAttribute('data-promo') !== '1') ok = false;
          if (q && normalize(card.getAttribute('data-search')).indexOf(q) === -1) ok = false;
          return ok;
        });
      }
      function show() {
        current = compute();
        var pages = Math.max(1, Math.ceil(current.length / PROD_PAGE_SIZE));
        if (page > pages) page = pages;
        var start = (page - 1) * PROD_PAGE_SIZE;
        var slice = current.slice(start, start + PROD_PAGE_SIZE);
        cardsAll().forEach(function (c) { c.classList.add('hidden'); });
        slice.forEach(function (c) { c.classList.remove('hidden'); });
        if (empty) empty.classList.toggle('hidden', current.length !== 0);
        if (summary) summary.textContent = !current.length ? '0 productos encontrados' : 'Mostrando ' + (start + 1) + '–' + Math.min(start + PROD_PAGE_SIZE, current.length) + ' de ' + current.length + (current.length === 1 ? ' producto' : ' productos');
        renderPager(pages);
      }
      function renderPager(pages) {
        var box = document.getElementById('prod-pager');
        if (!box) return;
        if (pages <= 1) { box.innerHTML = ''; return; }
        var h = '<button type="button" class="product-page-arrow" data-pg="prev" aria-label="Página anterior"' + (page === 1 ? ' disabled' : '') + '><i class="bi bi-chevron-left" aria-hidden="true"></i></button>';
        for (var i = 1; i <= pages; i++) h += '<button type="button" class="product-page-number' + (i === page ? ' is-current' : '') + '" data-page="' + i + '"' + (i === page ? ' aria-current="page"' : '') + ' aria-label="Ir a la página ' + i + '">' + i + '</button>';
        h += '<button type="button" class="product-page-arrow" data-pg="next" aria-label="Página siguiente"' + (page === pages ? ' disabled' : '') + '><i class="bi bi-chevron-right" aria-hidden="true"></i></button>';
        box.innerHTML = h;
        box.querySelector('[data-pg="prev"]').onclick = function () { if (page > 1) { page--; show(); } };
        box.querySelector('[data-pg="next"]').onclick = function () { if (page < pages) { page++; show(); } };
        box.querySelectorAll('[data-page]').forEach(function (button) { button.onclick = function () { page = Number(button.getAttribute('data-page')) || 1; show(); }; });
      }

      chips.forEach(function (ch) {
        ch.onclick = function () {
          chips.forEach(function (c) { c.classList.remove('m-chip-selected'); });
          chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
          ch.classList.add('m-chip-selected');
          ch.setAttribute('aria-pressed', 'true');
          state = ch.getAttribute('data-f');
          page = 1;
          show();
        };
      });
      input.oninput = function () { q = normalize(input.value.trim()); page = 1; show(); };
      if (clear) clear.onclick = function () {
        input.value = ''; q = ''; page = 1; state = 'all';
        chips.forEach(function (c) { var selected = c.getAttribute('data-f') === 'all'; c.classList.toggle('m-chip-selected', selected); c.setAttribute('aria-pressed', selected ? 'true' : 'false'); });
        show(); input.focus();
      };
      show();
    }

    // ====== Stepper: Agregar / Editar / Duplicar producto ======
    var PF_STEPS = [
      { n: 1, t: 'Información' },
      { n: 2, t: 'Fotos' },
      { n: 3, t: 'Variantes' },
      { n: 4, t: 'Guardar' }
    ];
    var pfStep = 1;
    var pfMode = 'crear';
    var pfTipo = 'unico';

    // Cuenta fotos que se están subiendo (galería o por variante) para no
    // dejar avanzar/guardar a medias — si no, el resumen podía mostrarse sin
    // la foto porque la subida (fetch async) aún no había terminado.
    var pfUploadsPending = 0;
    var pfFailedPhotoUploads = {};
    function photoUploadKey(file) { return 'foto:' + file.name + ':' + file.size + ':' + file.lastModified; }
    function setPhotoUploadFailed(key, failed) {
      if (failed) pfFailedPhotoUploads[key] = true;
      else delete pfFailedPhotoUploads[key];
      var notice = document.getElementById('pf-upload-error');
      if (notice) notice.classList.toggle('hidden', !Object.keys(pfFailedPhotoUploads).length);
    }
    function ignorarFotosFallidas() {
      pfFailedPhotoUploads = {};
      var notice = document.getElementById('pf-upload-error');
      if (notice) notice.classList.add('hidden');
    }
    function pfUploadStart() { pfUploadsPending++; }
    function pfUploadEnd() {
      pfUploadsPending = Math.max(0, pfUploadsPending - 1);
      if (pfUploadsPending === 0 && pfStep === PF_STEPS.length) renderResumen();
    }

    function setVal(id, v) {
      var el = document.getElementById(id);
      if (!el) return;
      el.value = v;
      // Los <select> mejorados por searchable-select.js muestran su propio botón
      // (no el <select> nativo); ese botón solo se resincroniza escuchando
      // "change", así que hay que dispararlo a mano cuando el valor se pone por JS.
      if (el.tagName === 'SELECT') el.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function setTipo(t) {
      pfTipo = t;
      setVal('f-tipo', t);
      document.querySelectorAll('#f-tipo-cards .pf-tipo-card').forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-tipo') === t);
      });
      if (t === 'unico') {
        var ed = window.VAR_EDITORS && window.VAR_EDITORS.f;
        if (ed && ed.model && ed.model.attrs.length) {
          var hayValores = ed.model.attrs.some(function (a) { return (a.values || []).length; });
          if (hayValores && !window.confirm('Si eliges "Producto único" se quitarán los atributos ya seleccionados. ¿Continuar?')) {
            pfTipo = 'variantes';
            setVal('f-tipo', 'variantes');
            document.querySelectorAll('#f-tipo-cards .pf-tipo-card').forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-tipo') === 'variantes'); });
            return;
          }
          // Al pasar de "con variantes" a "único" los campos Precio/Stock se
          // muestran de nuevo pero se habían quedado vacíos (con variantes
          // viven ocultos y en blanco — el precio real está por combinación).
          // Se rescata algo razonable de las combinaciones que se están por
          // borrar: el precio de la primera y la suma de todo el stock.
          var fPrice = document.getElementById('f-price');
          var fStock = document.getElementById('f-stock');
          if (fPrice && !fPrice.value) {
            var priceVals = Object.keys(ed.model.prices || {}).map(function (k) { return parseFloat(ed.model.prices[k]); }).filter(function (v) { return !isNaN(v); });
            if (priceVals.length) fPrice.value = Math.min.apply(null, priceVals);
          }
          if (fStock && !fStock.value) {
            var stockVals = Object.keys(ed.model.stock || {}).map(function (k) { return parseInt(ed.model.stock[k], 10); }).filter(function (v) { return !isNaN(v); });
            if (stockVals.length) fStock.value = stockVals.reduce(function (a, b) { return a + b; }, 0);
          }
          ed.model.attrs = [];
          ed.model.stock = {}; ed.model.prices = {}; ed.model.costs = {}; ed.model.images = {}; ed.model.skus = {}; ed.model.barcodes = {};
          if (typeof ed.save === 'function') ed.save();
          if (typeof ed.render === 'function') ed.render();
        }
      }
      if (pfStep === 3 && t === 'unico') goStep(2);
      else if (pfStep === 2 && t === 'variantes') goStep(3);
      else {
        renderSteps();
        if (pfStep === PF_STEPS.length) renderResumen();
      }
      syncStockField();
      syncPriceField();
    }

    function renderSteps() {
      var box = document.getElementById('pf-steps');
      if (!box) return;
      box.innerHTML = '';
      var vis = PF_STEPS.filter(function (s) { return !(pfTipo === 'unico' && s.n === 3) && !(pfTipo === 'variantes' && s.n === 2); });
      var idx = 0;
      vis.forEach(function (s, i) { if (s.n === pfStep) idx = i; });
      vis.forEach(function (s, i) {
        var el = document.createElement('div');
        el.className = 'pf-step' + (s.n === pfStep ? ' on' : (i < idx ? ' done' : ''));
        el.innerHTML = '<div class="pf-dot">' + (i < idx ? '✓' : (i + 1)) + '</div><div class="pf-lbl">' + s.t + '</div>';
        el.onclick = function () { goStep(Number(s.n)); };
        box.appendChild(el);
      });
      var bar = document.getElementById('pf-bar');
      if (bar) bar.style.width = (idx / (vis.length - 1) * 100) + '%';
      var first = vis[0].n, last = vis[vis.length - 1].n;
      document.getElementById('pf-back').classList.toggle('hidden', pfStep === first);
      document.getElementById('pf-next').classList.toggle('hidden', pfStep === last);
      document.getElementById('pf-save').classList.toggle('hidden', pfStep !== last);
    }

    function goStep(n) {
      if (n < 1) n = 1;
      if (n > PF_STEPS.length) n = PF_STEPS.length;
      if (pfTipo === 'unico' && n === 3) n = n < pfStep ? 2 : 4;
      if (pfTipo === 'variantes' && n === 2) n = n < pfStep ? 1 : 3;
      if (n > 1 && !validarPaso1()) { n = 1; }
      pfStep = n;
      document.querySelectorAll('#nuevo-producto [data-step-pane]').forEach(function (p) {
        p.classList.toggle('hidden', p.getAttribute('data-step-pane') !== String(n));
      });
      renderSteps();
      if (n === PF_STEPS.length) renderResumen();
      document.getElementById('nuevo-producto').scrollIntoView({ behavior: 'auto', block: 'start' });
    }

    // Campos "avanzados" — colapsados por defecto para no abrumar con 10+
    // campos de golpe (queja de dueños: "el formulario de producto es muy
    // complicado"). Se abren solos si el producto que se edita ya trae algo
    // ahí, o si un error de validación cae dentro.
    function openAdvancedIfHasData() {
      var det = document.getElementById('pf-advanced');
      if (!det) return;
      var ids = ['f-promo-type', 'f-sku', 'f-barcode', 'f-tags', 'f-video', 'f-specs'];
      var hasText = ids.some(function (id) {
        var el = document.getElementById(id);
        return el && (el.value || '').trim();
      });
      var featuredEl = document.getElementById('f-featured');
      var installEl = document.getElementById('f-installments');
      if (hasText || (featuredEl && featuredEl.checked) || (installEl && installEl.checked)) det.open = true;
    }

    // ====== Validación con hints inline en cada campo ======
    function setError(id, msg) {
      var el = document.getElementById(id);
      if (!el) return;
      var det = el.closest && el.closest('#pf-advanced');
      if (det) det.open = true;
      clearError(id);
      el.style.borderColor = '#f87171';
      el.style.boxShadow = '0 0 0 3px rgba(248,113,113,.15)';
      var p = document.createElement('p');
      p.className = 'field-err text-[11px] font-bold text-red-500 mt-1';
      p.textContent = msg;
      el.parentNode.appendChild(p);
    }
    function clearError(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.style.borderColor = '';
      el.style.boxShadow = '';
      var p = el.parentNode.querySelector('.field-err');
      if (p) p.remove();
    }
    function validarPaso1() {
      var ok = true;
      var name = (document.getElementById('f-name').value || '').trim();
      if (!name) { setError('f-name', 'Escribe el nombre del producto'); ok = false; }
      else clearError('f-name');

      var priceEl = document.getElementById('f-price');
      var pnum = parseFloat((priceEl.value || '').replace(/,/g, ''));
      var priceWrap = document.getElementById('f-price-wrap');
      var hasVarsPrice = priceWrap && priceWrap.classList.contains('price-hidden');
      if (hasVarsPrice) { clearError('f-price'); }
      else if (priceEl.value === '' || isNaN(pnum)) { setError('f-price', 'Escribe el precio (un número, ej: 25.50)'); ok = false; }
      else if (pnum < 0) { setError('f-price', 'El precio no puede ser negativo'); ok = false; }
      else clearError('f-price');

      var tipo = document.getElementById('f-promo-type').value;
      if (tipo === 'descuento') {
        var oldEl = document.getElementById('f-old');
        var oldV = parseFloat((oldEl.value || '').replace(/,/g, ''));
        if (!oldEl.value || isNaN(oldV)) { setError('f-old', 'Escribe el precio anterior'); ok = false; }
        else if (!isNaN(pnum) && oldV <= pnum) { setError('f-old', 'Debe ser mayor al precio actual'); ok = false; }
        else clearError('f-old');
      } else clearError('f-old');

      if (tipo === 'porcentaje') {
        var pct = parseFloat(document.getElementById('f-promo-value').value);
        if (isNaN(pct) || pct < 1 || pct > 99) { setError('f-promo-value', 'Entre 1% y 99%'); ok = false; }
        else clearError('f-promo-value');
      } else clearError('f-promo-value');

      if (tipo === 'regalo') {
        var gift = (document.getElementById('f-promo-gift').value || '').trim();
        if (!gift) { setError('f-promo-gift', 'Escribe qué producto regalas'); ok = false; }
        else clearError('f-promo-gift');
      } else clearError('f-promo-gift');

      var stockWrap = document.getElementById('f-stock-wrap');
      var hasVars = stockWrap && stockWrap.classList.contains('stock-hidden');
      var madeToOrder = document.getElementById('f-made-to-order').checked;
      if (!hasVars && !madeToOrder) {
        var sv = document.getElementById('f-stock').value;
        if (sv === '') { setError('f-stock', 'El stock es obligatorio: escribe cuántas piezas tienes (0 si está agotado)'); ok = false; }
        else if (isNaN(parseInt(sv)) || parseInt(sv) < 0) { setError('f-stock', 'Stock inválido (número entero ≥ 0)'); ok = false; }
        else clearError('f-stock');
      } else clearError('f-stock');
      return ok;
    }
    function bindValidation() {
      ['f-name', 'f-price', 'f-old', 'f-promo-value', 'f-promo-gift', 'f-stock'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', function () { clearError(id); });
      });
    }
    function syncStockField() {
      var wrap = document.getElementById('f-stock-wrap');
      var note = document.getElementById('f-stock-note');
      var input = document.getElementById('f-stock');
      var label = document.getElementById('f-stock-label');
      if (!wrap) return;
      var madeToOrder = document.getElementById('f-made-to-order').checked;
      wrap.classList.toggle('hidden', madeToOrder);
      if (pfTipo === 'variantes' || madeToOrder) {
        if (pfTipo === 'variantes') input.value = '';
        input.classList.add('hidden');
        if (label) label.classList.add('hidden');
        if (note) note.classList.toggle('hidden', madeToOrder);
        wrap.classList.add('stock-hidden');
      } else {
        input.classList.remove('hidden');
        if (label) label.classList.remove('hidden');
        if (note) note.classList.add('hidden');
        wrap.classList.remove('stock-hidden');
      }
    }
    // Con variantes, cada combinación tiene su propio precio (paso 2) — el
    // precio "general" no aplica y solo confundía (¿cuál de los dos manda?).
    // Se oculta aquí igual que ya se hace con el stock.
    function syncPriceField() {
      var wrap = document.getElementById('f-price-wrap');
      var note = document.getElementById('f-price-note');
      var input = document.getElementById('f-price');
      var label = document.getElementById('f-price-label');
      if (!wrap) return;
      if (pfTipo === 'variantes') {
        input.value = '';
        input.required = false;
        input.classList.add('hidden');
        if (label) label.classList.add('hidden');
        if (note) note.classList.remove('hidden');
        wrap.classList.add('price-hidden');
      } else {
        input.required = true;
        input.classList.remove('hidden');
        if (label) label.classList.remove('hidden');
        if (note) note.classList.add('hidden');
        wrap.classList.remove('price-hidden');
      }
    }

    function renderResumen() {
      var box = document.getElementById('pf-resumen');
      if (!box) return;
      var name = document.getElementById('f-name').value || '(sin nombre)';
      var old = Number(document.getElementById('f-old').value.replace(/,/g, '')) || 0;
      var catSel = document.getElementById('f-cat');
      var catName = (catSel && catSel.options[catSel.selectedIndex]) ? catSel.options[catSel.selectedIndex].text : 'Sin categoría';
      var desc = document.getElementById('f-desc').value || '';
      var stock = document.getElementById('f-stock').value;
      var madeToOrder = document.getElementById('f-made-to-order').checked;
      var promoEnds = document.getElementById('f-promo').value;
      var promoType = document.getElementById('f-promo-type').value;
      var featured = document.getElementById('f-featured').checked;
      var sku = document.getElementById('f-sku').value || '';
      var barcode = document.getElementById('f-barcode').value || '';
      var tags = document.getElementById('f-tags').value || '';
      var video = document.getElementById('f-video').value || '';
      var specs = document.getElementById('f-specs').value || '';
      var installments = document.getElementById('f-installments').checked;
      var fotoEls = document.querySelectorAll('#f-fotos [data-url]');
      var ed = window.VAR_EDITORS && window.VAR_EDITORS.f;
      var attrs = (ed && ed.model.attrs) || [];
      var hasVariantes = pfTipo === 'variantes' && attrs.length > 0;
      var portada = fotoEls.length ? fotoEls[0].getAttribute('data-url') : '/img/sin-imagen.svg';
      if (!fotoEls.length && attrs.length && ed && ed.model.images) {
        var imgsR = Object.keys(ed.model.images).map(function (k) { return ed.model.images[k]; }).filter(Boolean);
        if (imgsR.length) portada = imgsR[0];
      }

      // Precio: si es "único" viene del campo de arriba; con variantes se
      // calcula de los precios capturados por combinación (paso 2), que es
      // donde en verdad viven — el campo de arriba ni se muestra ni se pide.
      var priceVals = [];
      if (hasVariantes) {
        var prc = (ed && ed.model && ed.model.prices) || {};
        Object.keys(prc).forEach(function (k) { var v = Number(prc[k]); if (!isNaN(v)) priceVals.push(v); });
      }
      var price = hasVariantes ? (priceVals.length ? Math.min.apply(null, priceVals) : 0) : (Number(document.getElementById('f-price').value.replace(/,/g, '')) || 0);

      var titulo = pfMode === 'editar' ? '✏️ Editando producto' : pfMode === 'duplicar' ? '📄 Duplicando producto' : '🛒 Producto listo para guardar';

      var h = '<div class="font-black text-slate-900 mb-3">' + titulo + '</div>';
      h += '<div class="flex gap-4">';
      h += '<img src="' + escHTML(portada) + '" class="w-24 h-24 rounded-2xl object-cover border border-slate-200 shrink-0 bg-white">';
      h += '<div class="flex-1 min-w-0">';
      h += '<div class="font-extrabold text-slate-900 truncate">' + escHTML(name) + '</div>';
      h += '<div class="flex items-baseline gap-2 mt-1">';
      if (hasVariantes) {
        h += '<span class="font-black text-lg text-slate-900">' + (priceVals.length ? 'Desde ' + money(price) : 'Sin precio aún') + '</span>';
      } else {
        h += '<span class="font-black text-lg text-slate-900">' + money(price) + '</span>';
        if (old > price) h += '<span class="text-xs text-slate-400 line-through">' + money(old) + '</span>';
      }
      h += '</div>';
      h += '<div class="text-xs text-slate-500 mt-0.5">' + escHTML(catName) + (madeToOrder ? ' · Por pedido, sin límite de stock' : (!hasVariantes && stock !== '' ? ' · Stock: ' + stock : '')) + (promoEnds ? ' · Promo vence ' + promoEnds : '') + '</div>';
      if (featured) h += '<span class="inline-block mt-1 text-[11px] font-bold bg-amber-100 text-amber-700 rounded-full px-2 py-0.5">⭐ Destacado</span>';
      h += '</div></div>';

      if (desc) h += '<p class="text-xs text-slate-500 mt-3 border-l-2 border-slate-200 pl-3">' + escHTML(desc) + '</p>';

      // Promoción: mismo tipo de detalle que ve el cliente en el catálogo.
      if (promoType) {
        var promoLabels = { descuento: '💵 Precio rebajado', porcentaje: '📉 % de descuento', '2x1': '🛍️ 2x1', '3x2': '🛍️ 3x2', regalo: '🎁 Regalo' };
        var promoDetail = promoLabels[promoType] || promoType;
        if (promoType === 'porcentaje') promoDetail += ' — ' + (document.getElementById('f-promo-value').value || '0') + '%';
        if (promoType === 'regalo') promoDetail += ' — ' + escHTML(document.getElementById('f-promo-gift').value || '');
        h += '<div class="mt-2 text-xs font-bold text-red-500">' + promoDetail + '</div>';
      }

      if (hasVariantes) {
        h += '<div class="mt-4">';
        attrs.forEach(function (a) {
          h += '<div class="flex items-start gap-2 py-1.5 border-b border-slate-100">';
          h += '<span class="text-xs font-bold text-slate-700 w-16 shrink-0 pt-0.5">' + escHTML(a.name || '(sin nombre)') + '</span>';
          h += '<span class="flex flex-wrap gap-1">';
          (a.values || []).forEach(function (v) { h += '<span class="text-[11px] bg-neutral-100 text-neutral-800 font-bold px-2 py-0.5 rounded-full">' + escHTML(v) + '</span>'; });
          h += '</span></div>';
        });
        var nCombos = 1;
        attrs.forEach(function (a) { nCombos *= (a.values && a.values.length) || 1; });
        h += '<div class="mt-2 text-xs text-slate-500 font-bold">1 producto · ' + nCombos + ' variante' + (nCombos === 1 ? '' : 's') + ' (misma descripción; cada variante con su propia foto y precio' + (madeToOrder ? ', por pedido' : ' y stock') + ')</div>';
        var stok = (ed && ed.model && ed.model.stock) || {};
        var prcs = (ed && ed.model && ed.model.prices) || {};
        var stockVals = [];
        var totalStock = 0, sinStock = 0, sinPrecio = 0;
        (function walk(i, prefix) {
          if (i === attrs.length) {
            var k = prefix.join('|');
            var s = stok[k];
            if (s === undefined || s === '') sinStock++;
            else { stockVals.push(Number(s)); totalStock += Number(s); }
            var p = prcs[k];
            if (p === undefined || p === '') sinPrecio++;
            return;
          }
          var vals = (attrs[i].values && attrs[i].values.length) ? attrs[i].values : [''];
          vals.forEach(function (v) { walk(i + 1, prefix.concat([v])); });
        })(0, []);
        if (!madeToOrder && stockVals.length) h += '<div class="text-xs text-slate-500 mt-0.5">Stock por variante: <b class="text-slate-700">' + stockVals.join(', ') + '</b> · Total <b class="text-slate-700">' + totalStock + '</b></div>';
        if (!madeToOrder && sinStock) h += '<div class="text-xs font-bold text-amber-600 mt-1">⚠ ' + sinStock + ' variante' + (sinStock === 1 ? '' : 's') + ' sin stock definido — revísalo en el paso 2 (Variantes)</div>';
        if (sinPrecio) h += '<div class="text-xs font-bold text-amber-600 mt-1">⚠ ' + sinPrecio + ' variante' + (sinPrecio === 1 ? '' : 's') + ' sin precio definido — revísalo en el paso 2 (Variantes)</div>';
        var thumbs = [];
        Object.keys(ed.model.images || {}).forEach(function (k) { if (ed.model.images[k]) thumbs.push(ed.model.images[k]); });
        if (thumbs.length) {
          h += '<div class="flex flex-wrap gap-1.5 mt-2">';
          thumbs.slice(0, 14).forEach(function (u) { h += '<img src="' + escHTML(u) + '" class="w-9 h-9 rounded-lg object-cover border border-slate-200">'; });
          h += '</div>';
        }
        h += '</div>';
      } else {
        h += '<div class="mt-3 text-xs text-slate-400">Sin atributos · el producto se vende tal cual.</div>';
      }

      // Datos sueltos que antes no se veían en ningún lado antes de guardar.
      var extras = [];
      if (sku) extras.push('SKU: ' + escHTML(sku));
      if (barcode) extras.push('Código: ' + escHTML(barcode));
      if (tags) extras.push('Etiquetas: ' + escHTML(tags));
      if (video) extras.push('🎬 Video adjunto');
      if (specs) extras.push('📋 ' + specs.split('\n').filter(Boolean).length + ' característica(s)');
      if (installments) extras.push('◐ Vende por abonos (' + (document.getElementById('f-inst-count').value || 6) + ')');
      if (extras.length) h += '<div class="mt-3 text-[11px] text-slate-500 flex flex-wrap gap-x-3 gap-y-1">' + extras.map(function (e) { return '<span>' + e + '</span>'; }).join('') + '</div>';

      h += '<div class="mt-3 pt-2 border-t border-slate-100 text-xs text-slate-400">📷 ' + fotoEls.length + ' foto(s)' + (hasVariantes ? ' · 🏷️ ' + attrs.length + ' atributo(s)' : '') + '</div>';

      box.innerHTML = h;
    }

    function prefilledFrom(card) {
      setVal('f-name', card.getAttribute('data-edit-name'));
      setVal('f-cat', card.getAttribute('data-edit-cat'));
      setVal('f-price', card.getAttribute('data-edit-price'));
      setVal('f-old', card.getAttribute('data-edit-old'));
      setVal('f-promo', card.getAttribute('data-edit-promo'));
      setVal('f-stock', card.getAttribute('data-edit-stock'));
      document.getElementById('f-made-to-order').checked = card.getAttribute('data-edit-made-to-order') === '1';
      document.getElementById('f-show-stock').checked = card.getAttribute('data-edit-show-stock') !== '0';
      setVal('f-desc', card.getAttribute('data-edit-desc'));
      setVal('f-promo-type', card.getAttribute('data-edit-promo-type') || '');
      setVal('f-promo-value', card.getAttribute('data-edit-promo-value') || '');
      setVal('f-promo-gift', card.getAttribute('data-edit-promo-gift') || '');
      setVal('f-cost', card.getAttribute('data-edit-cost') || '');
      setVal('f-sku', card.getAttribute('data-edit-sku') || '');
      setVal('f-tags', card.getAttribute('data-edit-tags') || '');
      setVal('f-video', card.getAttribute('data-edit-video') || '');
      setVal('f-specs', card.getAttribute('data-edit-specs') || '');
      setVal('f-barcode', card.getAttribute('data-edit-barcode') || '');
      document.getElementById('f-featured').checked = card.getAttribute('data-edit-featured') === '1';
      document.getElementById('f-installments').checked = card.getAttribute('data-edit-installments') === '1';
      setVal('f-inst-count', card.getAttribute('data-edit-inst-count') || '6');
      setVal('f-inst-down', card.getAttribute('data-edit-inst-down') || '0');
      setVal('f-inst-freq', card.getAttribute('data-edit-inst-freq') || 'semanal');
      toggleInstallmentFields();
      onPromoTypeChange();
      openAdvancedIfHasData();
      initVariantes('f', decodeURIComponent(card.getAttribute('data-edit-variants') || ''));
      initFotos('f', card.getAttribute('data-edit-image'), card.getAttribute('data-edit-galeria'));
      var edTipo = window.VAR_EDITORS && window.VAR_EDITORS.f;
      setTipo((edTipo && edTipo.model && edTipo.model.attrs.length) ? 'variantes' : 'unico');
      if (window.applyMasks) window.applyMasks();
    }

    function editarProducto(card) {
      pfMode = 'editar';
      prefilledFrom(card);
      var form = document.getElementById('pf-form');
      form.action = '/<%= biz.slug %>/admin/producto/' + card.getAttribute('data-edit-id');
      document.getElementById('pf-title').textContent = 'Editar producto';
      document.getElementById('pf-cancel').classList.remove('hidden');
      document.getElementById('pf-save').textContent = 'Guardar cambios';
      goStep(1);
    }

    function duplicarProducto(card) {
      pfMode = 'duplicar';
      prefilledFrom(card);
      setVal('f-name', (card.getAttribute('data-edit-name') || '') + ' (copia)');
      // La copia nace LIMPIA de datos por variante: los combos de la copia aún no
      // existen, así que no heredan fotos, stock, precios, SKU ni códigos de barra.
      // El usuario los captura de nuevo en el paso de variantes.
      var edDup = window.VAR_EDITORS && window.VAR_EDITORS.f;
      if (edDup && edDup.model) {
        edDup.model.images = {}; edDup.model.stock = {}; edDup.model.prices = {}; edDup.model.costs = {}; edDup.model.skus = {}; edDup.model.barcodes = {};
        if (typeof edDup.save === 'function') edDup.save();
        if (typeof edDup.render === 'function') { edDup.render(); edDup.renderCombos(); }
      }
      // Igual las fotos generales: si solo existían como portada heredada de
      // variantes, se van; si el dueño subió fotos reales, también se piden de nuevo.
      document.getElementById('f-fotos').innerHTML = '';
      setVal('f-image', ''); setVal('f-galeria', '');
      initFotos('f', '', '');
      syncStockField();
      syncPriceField();
      var form = document.getElementById('pf-form');
      form.action = '/<%= biz.slug %>/admin/producto';
      document.getElementById('pf-title').textContent = 'Duplicar producto';
      document.getElementById('pf-cancel').classList.remove('hidden');
      document.getElementById('pf-save').textContent = 'Guardar copia';
      goStep(1);
    }

    function cancelarEdicion() {
      ignorarFotosFallidas();
      pfMode = 'crear';
      var form = document.getElementById('pf-form');
      form.reset();
      document.getElementById('f-made-to-order').checked = false;
      document.getElementById('f-show-stock').checked = true;
      setVal('f-cat', '');
      form.action = '/<%= biz.slug %>/admin/producto';
      document.getElementById('pf-title').textContent = 'Agregar producto';
      document.getElementById('pf-cancel').classList.add('hidden');
      document.getElementById('pf-save').textContent = 'Guardar producto';
      document.getElementById('f-fotos').innerHTML = '';
      setVal('f-image', ''); setVal('f-galeria', '');
      initVariantes('f', '');
      setTipo('unico');
      document.getElementById('f-installments').checked = false;
      toggleInstallmentFields();
      onPromoTypeChange();
      var det = document.getElementById('pf-advanced');
      if (det) det.open = false;
      goStep(1);
    }

    function onPromoTypeChange() {
      var sel = document.getElementById('f-promo-type');
      var t = sel ? sel.value : '';
      document.getElementById('promo-desc').classList.toggle('hidden', t !== 'descuento');
      document.getElementById('promo-pct').classList.toggle('hidden', t !== 'porcentaje');
      document.getElementById('promo-gift').classList.toggle('hidden', t !== 'regalo');
      document.getElementById('promo-ends').classList.toggle('hidden', t === '');
    }

    function toggleInstallmentFields() {
      var el = document.getElementById('installment-fields');
      if (el) el.classList.toggle('hidden', !document.getElementById('f-installments').checked);
    }

    function initStepper() {
      document.getElementById('pf-next').onclick = function () { goStep(pfStep + 1); };
      document.getElementById('pf-back').onclick = function () { goStep(pfStep - 1); };
      // Al abrir "+ Más detalles" el contenido nuevo puede quedar por debajo
      // del viewport sin que el navegador reajuste el scroll solo — se fuerza
      // aquí para que siempre se pueda bajar a verlo.
      var advDet = document.getElementById('pf-advanced');
      if (advDet) advDet.addEventListener('toggle', function () {
        if (advDet.open) setTimeout(function () { advDet.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 80);
      });
      // Agregar un atributo nuevo (ej: "Color") al momento, sin tener que
      // salirse a la pestaña Atributos primero — solo aplica a este
      // producto; si además quiere reutilizarlo luego, ya lo guarda aparte.
      // Botón "Agregar" además de Enter: en algunos teclados de celular
      // (sobre todo con autocompletar/predictivo activo) la tecla Enter no
      // siempre manda un keydown normal, así que no conviene depender solo
      // de eso.
      var tplNewInput = document.getElementById('f-tpl-new-name');
      var tplNewAdd = document.getElementById('f-tpl-new-add');
      function agregarAtributoAlMomento() {
        if (!tplNewInput) return;
        var name = tplNewInput.value.trim();
        if (!name) return;
        var ed = window.VAR_EDITORS && window.VAR_EDITORS.f;
        if (!ed) return;
        var yaExiste = (ed.model.attrs || []).some(function (a) { return (a.name || '').toLowerCase() === name.toLowerCase(); });
        if (yaExiste) { if (window.mostrarToast) mostrarToast('Ya tienes un atributo "' + name + '" en este producto', 'error'); return; }
        ed.toggleAttr(name, []);
        renderTplPills('f');
        tplNewInput.value = '';
        if (window.mostrarToast) mostrarToast('Atributo "' + name + '" agregado — escribe sus valores abajo', 'ok');
      }
      if (tplNewInput) tplNewInput.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.keyCode !== 13) return;
        e.preventDefault();
        agregarAtributoAlMomento();
      });
      if (tplNewAdd) tplNewAdd.addEventListener('click', agregarAtributoAlMomento);
      document.getElementById('pf-form').addEventListener('submit', function (e) {
        if (pfUploadsPending > 0) {
          e.preventDefault();
          e.stopPropagation();
          if (window.mostrarToast) window.mostrarToast('⏳ Espera a que terminen de subirse las fotos', 'error');
          return;
        }
        if (Object.keys(pfFailedPhotoUploads).length) {
          e.preventDefault();
          e.stopPropagation();
          if (window.mostrarToast) window.mostrarToast('Una foto no se subió. Reinténtala o continúa sin ella; tus datos siguen aquí.', 'error');
          var notice = document.getElementById('pf-upload-error');
          if (notice) notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
        if (pfTipo !== 'variantes') return;
        var ed = window.VAR_EDITORS && window.VAR_EDITORS.f;
        // Sin al menos un atributo con valores, "Con variantes" no genera
        // ninguna variante real — no tiene caso guardar así.
        if (!ed || !ed.model || !ed.model.attrs.length) {
          e.preventDefault();
          e.stopPropagation();
          if (window.mostrarToast) window.mostrarToast('⚠ Agrega al menos un atributo (Talla, Color…) para generar las variantes', 'error');
          goStep(3);
          return;
        }
        var faltanStock = [], faltanPrecio = [];
        (function walk(i, prefix) {
          if (i === ed.model.attrs.length) {
            var k = prefix.join('|');
            var s = ed.model.stock && ed.model.stock[k];
            var pr = ed.model.prices && ed.model.prices[k];
            if (!document.getElementById('f-made-to-order').checked && (s === undefined || s === '')) faltanStock.push(prefix.join(' / ') || '(variante)');
            if (pr === undefined || pr === '') faltanPrecio.push(prefix.join(' / ') || '(variante)');
            return;
          }
          var vals = (ed.model.attrs[i].values && ed.model.attrs[i].values.length) ? ed.model.attrs[i].values : [''];
          vals.forEach(function (v) { walk(i + 1, prefix.concat([v])); });
        })(0, []);
        if (faltanPrecio.length) {
          e.preventDefault();
          e.stopPropagation();
          if (window.mostrarToast) window.mostrarToast('⚠ Falta precio en ' + faltanPrecio.slice(0, 3).join(', ') + (faltanPrecio.length > 3 ? ' y ' + (faltanPrecio.length - 3) + ' más' : '') + ' — complétalo en el paso 2 (Variantes)', 'error');
          goStep(3);
          return;
        }
        if (faltanStock.length) {
          e.preventDefault();
          e.stopPropagation();
          if (window.mostrarToast) window.mostrarToast('⚠ Falta stock en ' + faltanStock.slice(0, 3).join(', ') + (faltanStock.length > 3 ? ' y ' + (faltanStock.length - 3) + ' más' : '') + ' — complétalo en el paso 2 (Variantes)', 'error');
          goStep(3);
          return;
        }
        // Portada automática: si no se subieron fotos de producto, la portada es la primera foto de variante.
        var ed0 = window.VAR_EDITORS && window.VAR_EDITORS.f;
        var fotoEls0 = document.querySelectorAll('#f-fotos [data-url]');
        if (!fotoEls0.length && ed0 && ed0.model && ed0.model.images) {
          var imgs0 = Object.keys(ed0.model.images).map(function (k) { return ed0.model.images[k]; }).filter(Boolean);
          if (imgs0.length) setVal('f-image', imgs0[0]);
        }
      });
      renderSteps();
    }

    function initProductos() {
      loadPageData();
      initProdFilter();
      renderCatList();
      renderAttrCatalog();
      // El wizard de captura solo existe si hay permiso de crear o editar productos.
      if (!document.getElementById('pf-form')) return;
      // El panel es SPA-lite: al guardar, panel-ajax.ejs solo reemplaza el
      // innerHTML de <main> (no vuelve a ejecutar este <script>), así que
      // pfStep/pfTipo/pfMode quedaban con el valor de ANTES de guardar —
      // el HTML fresco ya mostraba el paso 1, pero el indicador de pasos
      // seguía marcando "Guardar" como activo. Se resetea aquí siempre;
      // restoreFormOnError() lo vuelve a ajustar más abajo si hubo error.
      pfStep = 1;
      pfMode = 'crear';
      pfTipo = 'unico';
      ignorarFotosFallidas();
      initVariantes('f', '');
      initStepper();
      onPromoTypeChange();
      bindValidation();
      syncStockField();
      syncPriceField();
      renderTplPills('f');
      restoreFormOnError();
    }

    function restoreFormOnError() {
      try {
        var fd = JSON.parse(document.getElementById('formdata-json').textContent);
        if (!fd || typeof fd !== 'object') return;
        setVal('f-name', fd.name || '');
        setVal('f-cat', fd.category_id || '');
        setVal('f-price', fd.price || '');
        setVal('f-old', fd.old_price || '');
        setVal('f-desc', fd.description || '');
        setVal('f-stock', fd.stock || '');
        document.getElementById('f-made-to-order').checked = fd.made_to_order === '1' || fd.made_to_order === 1;
        document.getElementById('f-show-stock').checked = fd.show_stock_set ? !!fd.show_stock : true;
        setVal('f-cost', fd.cost || '');
        setVal('f-sku', fd.sku || '');
        setVal('f-tags', fd.tags || '');
        setVal('f-video', fd.video || '');
        setVal('f-specs', fd.specs || '');
        setVal('f-barcode', fd.barcode || '');
        setVal('f-promo-type', fd.promo_type || '');
        setVal('f-promo-value', fd.promo_value || '');
        setVal('f-promo-gift', fd.promo_gift || '');
        setVal('f-promo', fd.promo_ends_at || '');
        document.getElementById('f-featured').checked = fd.featured === '1' || fd.featured === 1;
        document.getElementById('f-installments').checked = fd.allow_installments === '1' || fd.allow_installments === 1;
        setVal('f-inst-count', fd.installment_count || '6');
        setVal('f-inst-down', fd.installment_min_down || '0');
        setVal('f-inst-freq', fd.installment_frequency || 'semanal');
        toggleInstallmentFields();
        onPromoTypeChange();
        openAdvancedIfHasData();
        // Restaurar tipo de producto y variantes (si el usuario iba con variantes, no perderlas)
        initVariantes('f', fd.variants || '');
        var edFd = window.VAR_EDITORS && window.VAR_EDITORS.f;
        if (edFd && typeof edFd.save === 'function') edFd.save();
        var tipoFd = fd.tipo === 'variantes' ? 'variantes' : 'unico';
        setTipo(tipoFd);
        setVal('f-image', fd.image || '');
        setVal('f-galeria', fd.galeria || '');
        initFotos('f', fd.image || '', fd.galeria || '');
        goStep(1);
      } catch (e) {}
    }
    window.onPanelSwap = initProductos;
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initProductos);
    else initProductos();

    // ====== Catálogo de atributos y categorías (sin recargar el formulario) ======
    function loadPageData() {
      try { window.ATTR_TEMPLATES = JSON.parse(document.getElementById('attr-templates-json').textContent) || []; } catch (e) { window.ATTR_TEMPLATES = []; }
      try { window.ATTR_CATEGORIES = JSON.parse(document.getElementById('cat-json').textContent) || []; } catch (e) { window.ATTR_CATEGORIES = []; }
    }
    function escHTML(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

    function renderTplPills(pref) {
      var cont = document.getElementById(pref + '-tpl-pills');
      if (!cont) return;
      var list = window.ATTR_TEMPLATES || [];
      var ed = window.VAR_EDITORS && window.VAR_EDITORS[pref];
      var selected = (ed && ed.model.attrs || []).map(function (a) { return (a.name || '').toLowerCase(); });
      cont.innerHTML = '';

      list.forEach(function (t) {
        var isSel = selected.indexOf(String(t.name).toLowerCase()) > -1;
        var b = document.createElement('button');
        b.type = 'button';
        b.title = (isSel ? 'Quitar ' : 'Usar ') + t.name + ' (' + t.values.join(', ') + ')';
        b.className = isSel
          ? 'tpl-pill inline-flex items-center gap-1 text-xs font-bold px-3 py-1.5 rounded-full border transition border-neutral-800 bg-neutral-800 text-white'
          : 'tpl-pill inline-flex items-center gap-1 text-xs font-bold px-3 py-1.5 rounded-full border transition border-slate-200 bg-white text-slate-600 hover:border-neutral-400 hover:bg-neutral-100';
        b.innerHTML = (isSel ? '✓ ' : '＋ ') + escHTML(t.name) + ' <span class="opacity-70 font-semibold">' + t.values.length + '</span>';
        b.onclick = function () {
          if (!ed) return;
          ed.toggleAttr(t.name, t.values);
          renderTplPills(pref);
        };
        cont.appendChild(b);
      });

      var empty = document.getElementById(pref + '-tpl-empty');
      if (empty) {
        empty.innerHTML = '';
        if (!list.length) {
          empty.textContent = 'Aún no tienes atributos guardados. Créalos en la pestaña ';
          var go = document.createElement('button');
          go.type = 'button';
          go.className = 'font-bold text-neutral-800 hover:underline';
          go.textContent = 'Atributos';
          go.onclick = function () { switchCrudTab('atributos'); };
          empty.appendChild(go);
          empty.appendChild(document.createTextNode('.'));
        }
      }
    }

    function agregarAtributo() {
      var name = (document.getElementById('attr-name').value || '').trim();
      var vals = (document.getElementById('attr-values').value || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      if (!name) { mostrarToast('Escribe el nombre del atributo (ej: Talla)', 'error'); return; }
      if (!vals.length) { mostrarToast('Escribe al menos un valor (ej: XS, M, L)', 'error'); return; }
      fetch('/<%= biz.slug %>/admin/atributo/guardar', {
        method: 'POST',
        body: new URLSearchParams({ name: name, values: JSON.stringify(vals) }),
        headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (d.ok) {
          upsertLocalTemplate(d);
          document.getElementById('attr-name').value = '';
          document.getElementById('attr-values').value = '';
          mostrarToast(d.updated ? 'Atributo actualizado ✓' : 'Atributo guardado ✓', 'ok');
        } else {
          mostrarToast(d.error || 'No se pudo guardar', 'error');
        }
      }).catch(function () { mostrarToast('Error de red', 'error'); });
    }

    function upsertLocalTemplate(d) {
      var list = window.ATTR_TEMPLATES || [];
      var idx = -1;
      list.forEach(function (t, i) { if (String(t.id) === String(d.id)) idx = i; });
      if (idx >= 0) list[idx] = d; else list.push(d);
      window.ATTR_TEMPLATES = list;
      renderTplPills('f'); renderAttrCatalog();
    }

    function eliminarAtributo(id) {
      pedirConfirmacion('¿Eliminar este atributo de tu catálogo? (no afecta productos ya guardados)').then(function (ok) {
        if (!ok) return;
        fetch('/<%= biz.slug %>/admin/atributo/' + id + '/eliminar', {
          method: 'POST',
          headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.ok) {
            window.ATTR_TEMPLATES = (window.ATTR_TEMPLATES || []).filter(function (t) { return String(t.id) !== String(id); });
            renderTplPills('f'); renderAttrCatalog();
            mostrarToast('Atributo eliminado', 'ok');
          } else { mostrarToast('No se pudo eliminar', 'error'); }
        }).catch(function () { mostrarToast('Error de red', 'error'); });
      });
    }

    function renderAttrCatalog() {
      var list = window.ATTR_TEMPLATES || [];
      var box = document.getElementById('attr-list');
      var count = document.getElementById('attr-count');
      if (count) count.textContent = String(list.length);
      var tc = document.getElementById('tabcnt-atributos');
      if (tc) tc.textContent = String(list.length);
      if (!box) return;
      box.innerHTML = '';
      if (!list.length) {
        box.innerHTML = '<p class="text-xs text-slate-400">Aún no guardas atributos. Ejemplo: <b>Talla</b> con XS, M, L y <b>Color</b> con Blanco, Azul.</p>';
        return;
      }
      list.forEach(function (t) {
        var chip = document.createElement('div');
        chip.className = 'inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full pl-3 pr-1.5 py-1.5';
        var info = document.createElement('span');
        info.className = 'text-xs';
        info.innerHTML = '<b class="text-slate-700">' + escHTML(t.name) + '</b> <span class="text-slate-300">·</span> <span class="text-slate-500">' + t.values.map(escHTML).join(', ') + '</span>';
        var editar = document.createElement('button');
        editar.type = 'button';
        editar.className = 'text-slate-400 hover:text-neutral-1000 font-bold px-0.5';
        editar.title = 'Editar atributo (nombre y valores)';
        editar.textContent = '✎';
        editar.onclick = function () { editarAtributo(t.id, t.name, t.values, chip); };
        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'text-slate-400 hover:text-red-500 font-bold px-1';
        del.title = 'Eliminar atributo';
        del.textContent = '✕';
        del.onclick = function () { eliminarAtributo(t.id); };
        chip.appendChild(info); chip.appendChild(editar); chip.appendChild(del);
        box.appendChild(chip);
      });
    }

    function agregarCategoria() {
      var inp = document.getElementById('cat-name');
      var name = (inp.value || '').trim();
      if (!name) { mostrarToast('Escribe el nombre de la categoría', 'error'); return; }
      fetch('/<%= biz.slug %>/admin/categoria', {
        method: 'POST',
        body: new URLSearchParams({ name: name }),
        headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (d.ok) {
          window.ATTR_CATEGORIES = (window.ATTR_CATEGORIES || []).concat([d]);
          inp.value = '';
          renderCatList(); repopulateCatSelects();
          mostrarToast('Categoría creada ✓', 'ok');
        } else { mostrarToast(d.error || 'No se pudo crear', 'error'); }
      }).catch(function () { mostrarToast('Error de red', 'error'); });
    }

    function eliminarCategoria(id) {
      pedirConfirmacion('¿Eliminar esta categoría? Los productos se quedan sin categoría.').then(function (ok) {
        if (!ok) return;
        fetch('/<%= biz.slug %>/admin/categoria/' + id + '/eliminar', {
          method: 'POST',
          headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.ok) {
            window.ATTR_CATEGORIES = (window.ATTR_CATEGORIES || []).filter(function (c) { return String(c.id) !== String(id); });
            renderCatList(); repopulateCatSelects();
            mostrarToast('Categoría eliminada', 'ok');
          } else { mostrarToast('No se pudo eliminar', 'error'); }
        }).catch(function () { mostrarToast('Error de red', 'error'); });
      });
    }

    function renderCatList() {
      var list = window.ATTR_CATEGORIES || [];
      var box = document.getElementById('cat-list');
      if (!box) return;
      var cnt = document.getElementById('tabcnt-categorias');
      if (cnt) cnt.textContent = String(list.length);
      var hdr = document.getElementById('cat-count');
      if (hdr) hdr.textContent = String(list.length);
      box.innerHTML = '';
      if (!list.length) { box.innerHTML = '<p class="text-xs text-slate-400">Sin categorías. Crea la primera arriba.</p>'; return; }
      list.forEach(function (c) {
        var chip = document.createElement('span');
        chip.className = 'm-chip';
        var inner = document.createElement('span');
        inner.className = 'flex items-center gap-1.5';
        var info = document.createElement('span'); info.textContent = c.name;
        var editar = document.createElement('button');
        editar.type = 'button';
        editar.className = 'text-slate-400 hover:text-neutral-1000 font-bold leading-none';
        editar.title = 'Editar nombre';
        editar.textContent = '✎';
        editar.onclick = function () { editarCategoria(c.id, c.name, chip); };
        var del = document.createElement('button');
        del.type = 'button';
        del.className = 'text-slate-400 hover:text-red-500 font-bold leading-none';
        del.title = 'Eliminar categoría';
        del.textContent = '✕';
        del.onclick = function () { eliminarCategoria(c.id); };
        inner.appendChild(info); inner.appendChild(editar); inner.appendChild(del);
        chip.appendChild(inner);
        box.appendChild(chip);
      });
    }

    function repopulateCatSelects() {
      var opts = '<option value="">Sin categoría</option>';
      var list = window.ATTR_CATEGORIES || [];
      list.forEach(function (c) { opts += '<option value="' + c.id + '">' + escHTML(c.name) + '</option>'; });
      var hint = document.getElementById('f-cat-hint');
      if (hint) hint.classList.toggle('hidden', list.length > 0);
      ['f-cat'].forEach(function (id) {
        var sel = document.getElementById(id);
        if (!sel) return;
        var val = sel.value;
        sel.innerHTML = opts;
        sel.value = val;
      });
    }

    function editarCategoria(id, nombre, chip) {
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.value = nombre;
      inp.className = 'text-xs font-semibold border border-neutral-400 rounded-full px-2 py-1 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-neutral-1000 w-28';
      var save = document.createElement('button');
      save.type = 'button'; save.className = 'text-emerald-600 hover:bg-emerald-50 rounded-full px-1.5 py-0.5 font-bold'; save.textContent = '✓';
      var cancel = document.createElement('button');
      cancel.type = 'button'; cancel.className = 'text-slate-400 hover:bg-slate-100 rounded-full px-1.5 py-0.5 font-bold'; cancel.textContent = '✕';
      var wrap = document.createElement('span');
      wrap.className = 'flex items-center gap-1';
      wrap.appendChild(inp); wrap.appendChild(save); wrap.appendChild(cancel);
      chip.innerHTML = '';
      chip.appendChild(wrap);
      inp.focus();
      function salir() { renderCatList(); }
      cancel.onclick = salir;
      inp.onkeydown = function (e) { if (e.key === 'Enter') save.click(); else if (e.key === 'Escape') salir(); };
      save.onclick = function () {
        var v = inp.value.trim();
        if (!v) { mostrarToast('Escribe un nombre', 'error'); return; }
        fetch('/<%= biz.slug %>/admin/categoria/' + id, {
          method: 'POST',
          body: new URLSearchParams({ name: v }),
          headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
        }).then(function (res) { return res.json(); }).then(function (d) {
          if (d.ok) {
            window.ATTR_CATEGORIES = (window.ATTR_CATEGORIES || []).map(function (c) { return String(c.id) === String(id) ? { id: id, name: d.name } : c; });
            renderCatList(); repopulateCatSelects();
            mostrarToast('Categoría actualizada ✓', 'ok');
          } else { mostrarToast(d.error || 'No se pudo actualizar', 'error'); renderCatList(); }
        }).catch(function () { mostrarToast('Error de red', 'error'); renderCatList(); });
      };
    }

    function editarAtributo(id, nombre, valores, chip) {
      var inpName = document.createElement('input');
      inpName.type = 'text'; inpName.value = nombre;
      inpName.className = 'text-xs font-bold border border-neutral-400 rounded-full px-2 py-1 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-neutral-1000 w-24';
      var inpVals = document.createElement('input');
      inpVals.type = 'text'; inpVals.value = (valores || []).join(', ');
      inpVals.className = 'text-xs border border-neutral-400 rounded-full px-2 py-1 bg-white text-slate-600 focus:outline-none focus:ring-2 focus:ring-neutral-1000 w-40';
      var save = document.createElement('button');
      save.type = 'button'; save.className = 'text-emerald-600 hover:bg-emerald-50 rounded-full px-1.5 py-0.5 font-bold'; save.textContent = '✓';
      var cancel = document.createElement('button');
      cancel.type = 'button'; cancel.className = 'text-slate-400 hover:bg-slate-100 rounded-full px-1.5 py-0.5 font-bold'; cancel.textContent = '✕';
      var wrap = document.createElement('span');
      wrap.className = 'flex items-center gap-1 flex-wrap';
      wrap.appendChild(inpName); wrap.appendChild(inpVals); wrap.appendChild(save); wrap.appendChild(cancel);
      chip.innerHTML = '';
      chip.appendChild(wrap);
      inpName.focus();
      function salir() { renderAttrCatalog(); }
      cancel.onclick = salir;
      inpName.onkeydown = function (e) { if (e.key === 'Escape') salir(); };
      inpVals.onkeydown = function (e) { if (e.key === 'Enter') save.click(); else if (e.key === 'Escape') salir(); };
      save.onclick = function () {
        var n = inpName.value.trim();
        var vals = inpVals.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        if (!n) { mostrarToast('Escribe el nombre', 'error'); return; }
        if (!vals.length) { mostrarToast('Escribe al menos un valor', 'error'); return; }
        fetch('/<%= biz.slug %>/admin/atributo/' + id, {
          method: 'POST',
          body: new URLSearchParams({ name: n, values: JSON.stringify(vals) }),
          headers: { 'x-csrf-token': (window.__csrfValue && window.__csrfValue()) || '' }
        }).then(function (res) { return res.json(); }).then(function (d) {
          if (d.ok) {
            window.ATTR_TEMPLATES = (window.ATTR_TEMPLATES || []).map(function (t) { return String(t.id) === String(id) ? d : t; });
            renderAttrCatalog(); renderTplPills('f');
            mostrarToast('Atributo actualizado ✓', 'ok');
          } else { mostrarToast(d.error || 'No se pudo actualizar', 'error'); renderAttrCatalog(); }
        }).catch(function () { mostrarToast('Error de red', 'error'); renderAttrCatalog(); });
      };
    }



  </script>

