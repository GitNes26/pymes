    }
    .product-catalog > .flex:first-of-type {
      padding-bottom:10px;
      border-bottom:1px solid rgba(44,44,46,.10);
    }
    .product-catalog #prod-search {
      min-height:36px;
      background:rgba(255,255,255,.86);
      border-color:rgba(44,44,46,.12);
