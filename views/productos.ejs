  <script>
    // ===== Tarjeta de producto para redes (canvas → PNG) =====
    var TPCARD_BIZ = <%- safeJson({ name: biz.name, slug: biz.slug, cur: biz.currency || 'MXN', accent: biz.color_hex || '#17324a', accent2: biz.color_hex2 || biz.color_hex || '#2c2c2e' }) %>;
    // Colores de fábrica (los de la tienda) — para el botón "Restablecer" del
    // selector de colores de la pieza. TPCARD_BIZ.accent/accent2 SÍ se mutan
    // al elegir un color (todos los estilos ya leen de ahí), esto no.
    var TPCARD_DEFAULT_COLORS = { accent: TPCARD_BIZ.accent, accent2: TPCARD_BIZ.accent2 };
    // Cuatro formatos con las proporciones que de verdad se usan en pauta y
    // redes (nada de improvisar tamaños): cuadrado 1:1 es el más compatible
    // entre plataformas, 4:5 es el que más alto ocupa en el feed (más
    // impacto), 9:16 es historias/estados, y 1.91:1 es el estándar de
    // anuncios de enlace (Facebook Ads, vista previa de link en WhatsApp).
    var TP_FORMATS = {
      square:    { label: 'Cuadrada 1:1',      note: '1080 × 1080 px · Feed universal (Instagram/Facebook)', w: 1080, h: 1080 },
      feed:      { label: 'Publicación 4:5',   note: '1080 × 1350 px · La que más alto ocupa en el feed',     w: 1080, h: 1350 },
      story:     { label: 'Historia 9:16',     note: '1080 × 1920 px · Historias y estados de WhatsApp',      w: 1080, h: 1920 },
      landscape: { label: 'Horizontal 1.91:1', note: '1200 × 628 px · Anuncios de enlace y banners',          w: 1200, h: 628 }
    };
    var TPCARD = { row: null, url: '', photo: '', photoImg: null, qrImg: null, canvases: {}, format: 'square', style: 'diagonal', opener: null, variantKey: null };

    // El producto con variantes no tiene "una" foto/precio propios (viven por
    // combinación) — antes la tarjeta siempre usaba el precio base y la
    // primera foto que encontrara entre todas las variantes, sin dejar elegir
    // cuál mostrar. Estos helpers resuelven precio/foto según la variante
    // elegida en el selector (ver tpSeleccionarVariante), y cualquier builder
    // de estilo que ya lea row.getAttribute('data-edit-price'/'data-edit-old')
    // los usa sin tener que tocar cada uno.
    function tpVariantModel(row) {
      try {
        var vraw = decodeURIComponent(row.getAttribute('data-edit-variants') || '');
        var vm = JSON.parse(vraw);
        return (vm && !Array.isArray(vm) && Array.isArray(vm.attrs) && vm.attrs.length) ? vm : null;
      } catch (e) { return null; }
    }
    function tpCombos(vm) {
      var lists = vm.attrs.map(function (a) { return (a.values && a.values.length) ? a.values : ['']; });
      return lists.reduce(function (acc, arr) {
        if (!acc.length) return arr.map(function (v) { return [v]; });
        var out = [];
        acc.forEach(function (prefix) { arr.forEach(function (v) { out.push(prefix.concat([v])); }); });
        return out;
      }, []);
    }
    function tpEffectivePrice(row) {
      var vm = tpVariantModel(row);
      if (vm && TPCARD.variantKey && vm.prices && vm.prices[TPCARD.variantKey] != null && vm.prices[TPCARD.variantKey] !== '') {
        return vm.prices[TPCARD.variantKey];
      }
      return row.getAttribute('data-edit-price');
    }
    function tpEffectiveOld(row) {
      // Las variantes no tienen "precio anterior" propio — al elegir una no
      // se tacha nada para no mezclar el descuento del producto base con un
      // precio que no es el suyo.
      if (TPCARD.variantKey && tpVariantModel(row)) return '';
      return row.getAttribute('data-edit-old');
    }
    function tpPoblarVariantes(row) {
      var wrap = document.getElementById('tp-variant-wrap');
      var chipsBox = document.getElementById('tp-variant-chips');
      var vm = tpVariantModel(row);
      if (!vm) { wrap.classList.add('hidden'); chipsBox.innerHTML = ''; TPCARD.variantKey = null; return; }
      var combos = tpCombos(vm);
      TPCARD.variantKey = combos.length ? combos[0].join('|') : null;
      chipsBox.innerHTML = combos.map(function (vals, i) {
        var key = vals.join('|');
        var label = vals.filter(Boolean).join(' / ') || ('Variante ' + (i + 1));
        return '<button type="button" class="tp-format-btn' + (i === 0 ? ' is-active' : '') + '" data-variant-key="' + key.replace(/"/g, '&quot;') + '" onclick="tpSeleccionarVariante(this)">' + label.replace(/</g, '&lt;') + '</button>';
      }).join('');
      wrap.classList.remove('hidden');
    }
    function tpSeleccionarVariante(btn) {
      TPCARD.variantKey = btn.getAttribute('data-variant-key');
      document.querySelectorAll('#tp-variant-chips .tp-format-btn').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
      TPCARD.photo = ''; TPCARD.photoImg = null;
      tpDibujar(null);
      tpCargarFoto(0);
      if (!TPCARD.dirty) tpTono(TPCARD.tone || 'venta');
    }

    function tpSym(n) {
      var SYM = { MXN:'$', USD:'$', EUR:'€', COP:'$', ARS:'$', CLP:'$', PEN:'S/', GBP:'£', BRL:'R$' };
      return (SYM[TPCARD_BIZ.cur] || '$') + Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }
    function tpText(hex) {
      var m = /^#?([0-9a-f]{6})$/i.exec(hex || '#000');
      if (!m) return '#111827';
      var r = parseInt(m[1].slice(0,2),16), g = parseInt(m[1].slice(2,4),16), b = parseInt(m[1].slice(4,6),16);
      return (r*0.299 + g*0.587 + b*0.114) > 155 ? '#111827' : '#F9FAFB';
    }
    function tpRR(ctx, x, y, w, h, r) {
      r = Math.min(r, w/2, h/2);
      ctx.beginPath();
      ctx.moveTo(x+r, y);
      ctx.arcTo(x+w, y, x+w, y+h, r); ctx.arcTo(x+w, y+h, x, y+h, r);
      ctx.arcTo(x, y+h, x, y, r); ctx.arcTo(x, y, x+w, y, r);
      ctx.closePath();
    }
    function tpWrap(ctx, text, x, y, maxW, lineH, maxLines) {
      var words = String(text || '').split(/\s+/).filter(Boolean), line = '', lines = [];
      for (var i = 0; i < words.length; i++) {
        var t = line ? line + ' ' + words[i] : words[i];
        if (ctx.measureText(t).width > maxW && line) { lines.push(line); line = words[i]; } else line = t;
      }
      if (line) lines.push(line);
      lines.slice(0, maxLines).forEach(function (l, i) { ctx.fillText(l, x, y + i * lineH); });
      return Math.min(lines.length, maxLines);
    }
    function tpCover(ctx, img, x, y, w, h) {
      var ir = img.width / img.height, r = w / h, sw, sh, sx, sy;
      if (ir > r) { sh = img.height; sw = sh * r; sx = (img.width - sw) / 2; sy = 0; }
      else { sw = img.width; sh = sw / r; sx = 0; sy = (img.height - sh) / 2; }
      ctx.drawImage(img, sx, sy, sw, sh, x, y, w, h);
    }
    function tpHex(hex) {
      var m = /^#?([0-9a-f]{6})$/i.exec(hex || '#2563eb');
      if (!m) return { r: 37, g: 99, b: 235 };
      return { r: parseInt(m[1].slice(0,2),16), g: parseInt(m[1].slice(2,4),16), b: parseInt(m[1].slice(4,6),16) };
    }
    function tpRgba(hex, a) { var c = tpHex(hex); return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + a + ')'; }
    function tpMix(hex, hex2, t) {
      var a = tpHex(hex), b = tpHex(hex2);
      return 'rgb(' + Math.round(a.r+(b.r-a.r)*t) + ',' + Math.round(a.g+(b.g-a.g)*t) + ',' + Math.round(a.b+(b.b-a.b)*t) + ')';
    }
    function abrirTarjetaProducto(row) {
      if (!row) return;
      TPCARD.row = row; TPCARD.url = ''; TPCARD.photo = ''; TPCARD.photoImg = null; TPCARD.qrImg = null; TPCARD.canvases = {}; TPCARD.opener = document.activeElement;
      TPCARD.style = 'diagonal'; TPCARD.tone = 'venta'; TPCARD.dirty = false;
      TPCARD_BIZ.accent = TPCARD_DEFAULT_COLORS.accent; TPCARD_BIZ.accent2 = TPCARD_DEFAULT_COLORS.accent2;
      tpSyncColorInputs();
      tpPoblarVariantes(row);
      Object.keys(TP_STYLE_BUILDERS).forEach(function (key) {
        var b = document.getElementById('tp-style-' + key);
        if (b) b.classList.toggle('is-active', key === 'diagonal');
      });
      seleccionarFormatoTarjeta('square');
      document.getElementById('tp-modal').classList.add('open');
      document.getElementById('tp-preview').innerHTML = '<span class="w-8 h-8 border-[3px] border-[var(--md-primary,#2563eb)] border-t-transparent rounded-full animate-spin"></span>';
      fetch('/<%= biz.slug %>/admin/producto/' + row.getAttribute('data-edit-id') + '/qr')
        .then(function (r) {
          // Si la sesión expiró o el servidor truena, esto no regresa JSON
          // (regresa la página de login u otra HTML) — antes eso tronaba en
          // r.json() y siempre se veía el mismo mensaje genérico sin pista.
          if (!r.ok && r.status === 401) throw new Error('Tu sesión expiró — recarga la página e inicia sesión de nuevo.');
          var ct = r.headers.get('content-type') || '';
          if (ct.indexOf('application/json') === -1) throw new Error('El servidor no respondió correctamente (código ' + r.status + ') — recarga la página e intenta de nuevo.');
          return r.json();
        })
        .then(function (d) {
          if (!d.ok) throw new Error(d.error || 'No se pudo preparar la tarjeta');
          TPCARD.url = d.url;
          var li = document.getElementById('tp-link'); if (li) li.value = d.url;
          TPCARD.dirty = false; tpTono(TPCARD.tone || 'venta');
          tpPintar();
          if (d.qr) {
            var qr = new Image();
            qr.onload = function () { TPCARD.qrImg = qr; tpDibujar(TPCARD.photoImg); };
            qr.src = d.qr;
          }
        })
        .catch(function (err) {
          console.error('tarjeta-producto:', err);
          mostrarToast((err && err.message) || 'No se pudo preparar la tarjeta', 'error');
          cerrarTarjetaProducto();
        });
    }
    function cerrarTarjetaProducto() {
      document.getElementById('tp-modal').classList.remove('open');
      if (TPCARD.opener && TPCARD.opener.focus) TPCARD.opener.focus();
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') cerrarTarjetaProducto(); });
    // Tocar la tarjeta abre la página de compra del producto
    document.getElementById('tp-preview').addEventListener('click', function () {
      if (TPCARD.url) window.open(TPCARD.url, '_blank');
    });

    function tpPintar() {
      var src = TPCARD.row.getAttribute('data-edit-image');
      if (src && src === TPCARD.photo && TPCARD.photoImg) { tpDibujar(TPCARD.photoImg); return; }
      TPCARD.photo = ''; TPCARD.photoImg = null;
      tpDibujar(null);
      tpCargarFoto(0);
    }

    // Carga la foto SIEMPRE vía nuestro proxy same-origin: evita el bloqueo CORS
    // que "contamina" el canvas y de paso esquiva hotlink-blockers externos.
    // Si la imagen principal falla, prueba con las de la galería del producto.
    function tpFotosCandidatas() {
      var row = TPCARD.row, lista = [];
      // La foto de la variante elegida va primero — si esa combinación tiene
      // su propia foto, es la que se debe usar, no una cualquiera de las demás.
      var vmSel = tpVariantModel(row);
      if (vmSel && TPCARD.variantKey && vmSel.images && vmSel.images[TPCARD.variantKey]) {
        lista.push(vmSel.images[TPCARD.variantKey]);
      }
      var main = row.getAttribute('data-edit-image');
      if (main && lista.indexOf(main) === -1) lista.push(main);
      try {
        var raw = decodeURIComponent(row.getAttribute('data-edit-galeria') || '');
        if (raw.indexOf('&quot;') !== -1) raw = raw.replace(/&quot;/g, '"').replace(/&amp;/g, '&');
        var gal = JSON.parse(raw);
        if (Array.isArray(gal)) gal.forEach(function (g) { if (g && lista.indexOf(g) === -1) lista.push(g); });
      } catch (e) {}
      // Producto con variantes: p.image/galeria suelen venir vacíos porque las
      // fotos viven por combo — sin esto la tarjeta siempre caía al placeholder.
      try {
        var vraw = decodeURIComponent(row.getAttribute('data-edit-variants') || '');
        var vm = JSON.parse(vraw);
        var images = (vm && !Array.isArray(vm) && vm.images) ? vm.images : null;
        if (images) Object.keys(images).forEach(function (k) { var g = images[k]; if (g && lista.indexOf(g) === -1) lista.push(g); });
      } catch (e) {}
      return lista;
    }
    function tpCargarFoto(idx) {
      var rowRef = TPCARD.row;
      var lista = tpFotosCandidatas();
      if (idx >= lista.length) return; // sin foto disponible: queda el respuesto
      var src = lista[idx];
      var proxy = '/<%= biz.slug %>/admin/img-proxy?u=' + encodeURIComponent(src);
      var im = new Image();
      im.onload = function () {
        if (TPCARD.row !== rowRef) return; // el usuario ya abrió otro producto
        TPCARD.photo = src; TPCARD.photoImg = im; tpDibujar(im);
      };
      im.onerror = function () { tpCargarFoto(idx + 1); };
      im.src = proxy;
    }

    function tpDrawPlaceholder(ctx, x, y, w, h) {
      ctx.fillStyle = '#E7E5E0'; ctx.fillRect(x, y, w, h);
      ctx.strokeStyle = '#C9C6BE'; ctx.lineWidth = 5;
      ctx.beginPath(); ctx.rect(x + w*.39, y + h*.36, w*.22, h*.22); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x+w*.39, y+h*.58); ctx.lineTo(x+w*.48, y+h*.47); ctx.lineTo(x+w*.54, y+h*.53); ctx.lineTo(x+w*.61, y+h*.43); ctx.stroke();
      ctx.fillStyle = '#6B6860'; ctx.font = '700 25px Inter, "Segoe UI", Arial, sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('Agrega una foto para destacar tu producto', x + w/2, y + h*.69); ctx.textAlign = 'left';
    }
    function tpDrawPrice(ctx, row, x, y, size, color) {
      var price = parseFloat(tpEffectivePrice(row)) || 0;
      var old = parseFloat(tpEffectiveOld(row)) || 0;
      ctx.fillStyle = color || '#151816'; ctx.font = '900 ' + size + 'px Inter, "Segoe UI", Arial, sans-serif';
      var ptxt = tpSym(price); ctx.fillText(ptxt, x, y);
      if (old > price && old > 0) {
        var pw = ctx.measureText(ptxt).width;
        ctx.fillStyle = (color === '#FFFFFF' || color === '#F9FAFB') ? 'rgba(255,255,255,.68)' : '#5C655F';
        ctx.font = '650 ' + Math.round(size*.38) + 'px Inter, "Segoe UI", Arial, sans-serif';
        var otxt = tpSym(old), ox = x + pw + 24; ctx.fillText(otxt, ox, y - 5);
        ctx.strokeStyle = ctx.fillStyle; ctx.lineWidth = Math.max(3, Math.round(size*.045)); ctx.beginPath(); ctx.moveTo(ox-2, y-size*.18); ctx.lineTo(ox+ctx.measureText(otxt).width+2, y-size*.18); ctx.stroke();
      }
    }
    function tpDrawOffer(ctx, row, x, y, size) {
      var price = parseFloat(tpEffectivePrice(row)) || 0;
      var old = parseFloat(tpEffectiveOld(row)) || 0;
      if (!(old > price && old > 0)) return;
      size = size || 28;
      var label = '−' + Math.round((1-price/old)*100) + '%  OFERTA';
      ctx.font = '850 ' + size + 'px Inter, "Segoe UI", Arial, sans-serif';
      var h = Math.round(size*2), w = ctx.measureText(label).width + Math.round(size*1.55);
      // Antes era un naranja fijo (#B5461C) sin importar el color elegido —
      // por eso el badge de oferta "no cambiaba" aunque se cambiara todo lo
      // demás. El borde blanco es solo por seguridad de contraste, para que
      // se siga leyendo aunque quede sobre un fondo parecido al acento.
      tpRR(ctx, x, y, w, h, Math.round(h*.24));
      ctx.fillStyle = TPCARD_BIZ.accent2 || TPCARD_BIZ.accent; ctx.fill();
      ctx.lineWidth = Math.max(2, size*.05); ctx.strokeStyle = 'rgba(255,255,255,.55)'; ctx.stroke();
      ctx.fillStyle = tpText(TPCARD_BIZ.accent2 || TPCARD_BIZ.accent); ctx.textBaseline = 'middle'; ctx.fillText(label, x+Math.round(size*.78), y+h/2+1); ctx.textBaseline = 'alphabetic';
    }
    function tpDrawBrand(ctx, x, y, maxW, light, size) {
      var color = light ? '#FFFFFF' : '#151816';
      var label = String(TPCARD_BIZ.name || 'Mi tienda');
      size = size || 30;
      ctx.fillStyle = color; ctx.font = '850 ' + size + 'px Inter, "Segoe UI", Arial, sans-serif';
      while (ctx.measureText(label).width > maxW && label.length > 8) label = label.slice(0,-2).trim() + '…';
      ctx.fillText(label, x, y);
      ctx.fillStyle = light ? 'rgba(255,255,255,.82)' : '#5C655F';
      ctx.font = '750 ' + Math.round(size*.4) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText('PIDE DIRECTO', x, y + Math.round(size*.8));
    }
    function tpDrawQR(ctx, x, y, size, lightLabel) {
      ctx.fillStyle = '#FFFFFF'; tpRR(ctx,x,y,size,size,Math.round(size*.12)); ctx.fill();
      if (TPCARD.qrImg) ctx.drawImage(TPCARD.qrImg,x+Math.round(size*.09),y+Math.round(size*.09),Math.round(size*.82),Math.round(size*.82));
      else {
        ctx.strokeStyle='#D1D5D1';ctx.lineWidth=4;tpRR(ctx,x+18,y+18,size-36,size-36,10);ctx.stroke();
      }
      ctx.fillStyle = lightLabel ? 'rgba(255,255,255,.78)' : '#5C655F';
      ctx.font = '750 ' + Math.max(15,Math.round(size*.12)) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.textAlign='center';ctx.fillText('ESCANEA',x+size/2,y+size+Math.round(size*.18));ctx.textAlign='left';
    }
    function tpDrawImage(ctx, photo, x, y, w, h, r) {
      ctx.save(); tpRR(ctx,x,y,w,h,r); ctx.clip();
      if(photo) tpCover(ctx,photo,x,y,w,h); else tpDrawPlaceholder(ctx,x,y,w,h);
      ctx.restore();
    }
    function tpCampaignPhoto(ctx, photo, w, h, darkFrom) {
      if (photo) tpCover(ctx,photo,0,0,w,h); else tpDrawPlaceholder(ctx,0,0,w,h);
      var shade=ctx.createLinearGradient(0,0,0,h);
      shade.addColorStop(0,'rgba(8,12,10,.52)');
      shade.addColorStop(Math.max(.2,Math.min(.8,darkFrom||.48)),'rgba(8,12,10,.04)');
      shade.addColorStop(1,'rgba(8,12,10,.68)');
      ctx.fillStyle=shade;ctx.fillRect(0,0,w,h);
    }
    function tpCampaignPanel(ctx, points, alpha) {
      ctx.save();ctx.globalAlpha=(alpha == null ? 0.96 : alpha);ctx.fillStyle=TPCARD_BIZ.accent;
      ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);
      for(var i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);
      ctx.closePath();ctx.fill();ctx.restore();
    }
    function tpCampaignName(ctx, name, x, y, maxW, size, lineH, lines, color) {
      ctx.fillStyle=color;ctx.font='900 '+size+'px Inter, "Segoe UI", Arial, sans-serif';
      return tpWrap(ctx,String(name||'').toUpperCase(),x,y,maxW,lineH,lines);
    }
    function tpCampaignCTA(ctx,x,y,color) {
      ctx.fillStyle=color;ctx.font='850 21px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText('MÍRALO. ESCANEA. PÍDELO.',x,y);
    }
    function tpBuildFeed(photo) {
      var W=1080,H=1350,row=TPCARD.row,c=document.createElement('canvas'); c.width=W;c.height=H;
      var ctx=c.getContext('2d'), name=row.getAttribute('data-edit-name')||'', desc=row.getAttribute('data-edit-desc')||'';
      tpCampaignPhoto(ctx,photo,W,H,.42);
      tpCampaignPanel(ctx,[[0,715],[1080,570],[1080,1350],[0,1350]],.96);
      var ink=tpText(TPCARD_BIZ.accent);
      tpDrawBrand(ctx,62,82,590,true,30);tpDrawOffer(ctx,row,770,54,30);
      var lines=tpCampaignName(ctx,name,62,830,880,76,82,3,ink);
      var descY=830+(lines-1)*82+56;
      if(desc){ctx.fillStyle=ink;ctx.globalAlpha=.76;ctx.font='600 27px Inter, "Segoe UI", Arial, sans-serif';tpWrap(ctx,desc,64,descY,700,38,2);ctx.globalAlpha=1;}
      tpDrawPrice(ctx,row,62,1190,102,ink);
      tpCampaignCTA(ctx,64,1281,ink);tpDrawQR(ctx,854,1110,150,ink==='#F9FAFB');
      return c;
    }
    function tpBuildStory(photo) {
      var W=1080,H=1920,row=TPCARD.row,c=document.createElement('canvas'); c.width=W;c.height=H;
      var ctx=c.getContext('2d'),name=row.getAttribute('data-edit-name')||'',desc=row.getAttribute('data-edit-desc')||'';
      tpCampaignPhoto(ctx,photo,W,H,.46);
      tpCampaignPanel(ctx,[[0,1050],[1080,850],[1080,1920],[0,1920]],.96);
      var ink=tpText(TPCARD_BIZ.accent);
      tpDrawBrand(ctx,64,152,660,true,34);tpDrawOffer(ctx,row,748,112,30);
      var lines=tpCampaignName(ctx,name,64,1210,890,86,94,4,ink);
      var descY=1210+(lines-1)*94+62;
      if(desc){ctx.fillStyle=ink;ctx.globalAlpha=.76;ctx.font='600 29px Inter, "Segoe UI", Arial, sans-serif';tpWrap(ctx,desc,66,descY,710,42,2);ctx.globalAlpha=1;}
      tpDrawPrice(ctx,row,64,1538,128,ink);tpDrawQR(ctx,836,1388,168,ink==='#F9FAFB');
      tpCampaignCTA(ctx,66,1784,ink);
      return c;
    }
    // Cuadrada 1:1 — misma composición que la publicación 4:5 pero recortada
    // a un lienzo cuadrado, que es el formato más compatible entre Instagram,
    // Facebook y WhatsApp cuando no se sabe dónde terminará publicándose.
    function tpBuildSquare(photo) {
      var W=1080,H=1080,row=TPCARD.row,c=document.createElement('canvas'); c.width=W;c.height=H;
      var ctx=c.getContext('2d'), name=row.getAttribute('data-edit-name')||'', desc=row.getAttribute('data-edit-desc')||'';
      tpCampaignPhoto(ctx,photo,W,H,.43);
      tpCampaignPanel(ctx,[[0,625],[1080,490],[1080,1080],[0,1080]],.96);
      var ink=tpText(TPCARD_BIZ.accent);
      tpDrawBrand(ctx,58,78,590,true,29);tpDrawOffer(ctx,row,772,50,28);
      var lines=tpCampaignName(ctx,name,58,738,850,66,72,3,ink);
      var descY=738+(lines-1)*72+45;
      if(desc){ctx.fillStyle=ink;ctx.globalAlpha=.75;ctx.font='600 24px Inter, "Segoe UI", Arial, sans-serif';tpWrap(ctx,desc,60,descY,650,34,1);ctx.globalAlpha=1;}
      tpDrawPrice(ctx,row,58,982,91,ink);tpDrawQR(ctx,850,838,144,ink==='#F9FAFB');
      tpCampaignCTA(ctx,60,1042,ink);
      return c;
    }
    // Horizontal 1.91:1 — composición partida (foto a un lado, texto al otro)
    // porque a este ancho tan bajo apilar todo verticalmente como en los demás
    // formatos deja el texto ilegible; es el estándar de anuncios de enlace
    // (Facebook Ads, vista previa de link) donde el layout SÍ cambia de forma.
    function tpBuildLandscape(photo) {
      var W=1200,H=628,row=TPCARD.row,c=document.createElement('canvas'); c.width=W;c.height=H;
      var ctx=c.getContext('2d'), name=row.getAttribute('data-edit-name')||'', desc=row.getAttribute('data-edit-desc')||'';
      tpCampaignPhoto(ctx,photo,W,H,.36);
      tpCampaignPanel(ctx,[[540,0],[1200,0],[1200,628],[450,628]],.96);
      var ink=tpText(TPCARD_BIZ.accent),tx=650,tw=485;
      tpDrawBrand(ctx,tx,68,tw,ink==='#F9FAFB',27);tpDrawOffer(ctx,row,42,42,23);
      var lines=tpCampaignName(ctx,name,tx,190,tw,48,53,3,ink);
      var descY=190+(lines-1)*53+35;
      if(desc){ctx.fillStyle=ink;ctx.globalAlpha=.74;ctx.font='600 19px Inter, "Segoe UI", Arial, sans-serif';tpWrap(ctx,desc,tx,descY,390,27,2);ctx.globalAlpha=1;}
      tpDrawPrice(ctx,row,tx,493,66,ink);tpCampaignCTA(ctx,tx,565,ink);tpDrawQR(ctx,1032,430,118,ink==='#F9FAFB');
      return c;
    }

    // ============================================================
    // Estilos adicionales — "diagonal" (arriba) tiene un diseño afinado a mano
    // por formato; estos tres son UNA sola función cada uno que se adapta al
    // ancho/alto que le toque (cuadrada, feed, historia u horizontal) en vez
    // de repetir 4 variantes — mismo resultado, un tercio del código.
    // ============================================================
    // Texto centrado que se encoge hasta caber en maxW (para el nombre
    // gigante de fondo — si no, un nombre largo se desbordaba del lienzo).
    function tpFitCenterText(ctx, text, cx, y, maxW, startSize, minSize, weight) {
      var size = startSize;
      ctx.textAlign = 'center';
      do {
        ctx.font = (weight || 900) + ' ' + Math.round(size) + 'px Inter, "Segoe UI", Arial, sans-serif';
        if (ctx.measureText(text).width <= maxW || size <= minSize) break;
        size -= 4;
      } while (true);
      ctx.fillText(text, cx, y);
      ctx.textAlign = 'left';
      return size;
    }
    function tpBuildGigante(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3;
      // Antes el color secundario no se usaba aquí — el fondo solo mezclaba
      // el principal con negro, así que "Secundario" no cambiaba nada visible.
      var bg = ctx.createLinearGradient(0, 0, wide ? W : 0, wide ? 0 : H);
      bg.addColorStop(0, tpMix(TPCARD_BIZ.accent, '#0B0D10', .8));
      bg.addColorStop(1, tpMix(TPCARD_BIZ.accent2 || TPCARD_BIZ.accent, '#0B0D10', .85));
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

      // Tipografía enorme detrás del producto — solo la primera palabra (efecto
      // póster) y se encoge hasta caber, nunca se desborda del lienzo.
      var bigWord = String(name || 'PRODUCTO').trim().split(/\s+/)[0].toUpperCase();
      ctx.save(); ctx.globalAlpha = .15; ctx.fillStyle = '#FFFFFF';
      tpFitCenterText(ctx, bigWord, W / 2, wide ? H * .58 : H * .28, W * .92, (wide ? H : W) * .34, 40, 900);
      ctx.restore();

      var ink = '#FFFFFF';
      if (wide) {
        tpDrawBrand(ctx, W * .05, H * .14, W * .34, true, Math.round(H * .06));
        var ph = H * 1.14, pw = ph, px = W * .52, py = (H - ph) / 2;
        ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.55)'; ctx.shadowBlur = H * .1;
        tpDrawImage(ctx, photo, px, py, pw, pw, Math.round(H * .05));
        ctx.restore();
        tpDrawOffer(ctx, row, px, H * .06, Math.round(H * .05));
        tpDrawPrice(ctx, row, W * .05, H * .92, Math.round(H * .16), ink);
      } else {
        var pw2 = W * 1.08, ph2 = H * .48, px2 = (W - pw2) / 2, py2 = H * .32;
        ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.55)'; ctx.shadowBlur = W * .06;
        tpDrawImage(ctx, photo, px2, py2, pw2, ph2, Math.round(H * .03));
        ctx.restore();
        tpDrawBrand(ctx, W * .055, H * .09, W * .55, true, Math.round(W * .03));
        tpDrawOffer(ctx, row, W * .055, py2 - H * .07, Math.round(W * .026));
        tpDrawPrice(ctx, row, W * .055, py2 + ph2 + H * .11, Math.round(W * .1), ink);
        tpDrawQR(ctx, W - W * .055 - H * .1, py2 + ph2 + H * .03, Math.round(H * .1), true);
      }
      return c;
    }

    function tpBuildSpotlight(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3;
      ctx.fillStyle = '#0A0A0C'; ctx.fillRect(0, 0, W, H);
      var cx = wide ? W * .68 : W * .5, cy = wide ? H * .5 : H * .4;
      // Antes el color secundario no se usaba aquí — el resplandor solo
      // salía del principal, "Secundario" no cambiaba nada visible.
      var glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(W, H) * .42);
      glow.addColorStop(0, tpRgba(TPCARD_BIZ.accent, .5));
      glow.addColorStop(.55, tpRgba(TPCARD_BIZ.accent2 || TPCARD_BIZ.accent, .28));
      glow.addColorStop(1, 'rgba(10,10,12,0)');
      ctx.fillStyle = glow; ctx.fillRect(0, 0, W, H);

      var box = (wide ? H : Math.min(W, H)) * .6;
      var bx = cx - box / 2, by = cy - box / 2;
      ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = box * .12;
      tpDrawImage(ctx, photo, bx, by, box, box, Math.round(box * .06));
      ctx.restore();

      var tx = wide ? W * .06 : W / 2, ta = wide ? 'left' : 'center';
      ctx.textAlign = ta;
      ctx.fillStyle = 'rgba(255,255,255,.72)'; ctx.font = '750 ' + Math.round((wide ? H : W) * .026) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(String(TPCARD_BIZ.name || 'Mi tienda').toUpperCase(), tx, wide ? H * .16 : H * .08);

      var nameY = wide ? H * .32 : by + box + H * .1;
      ctx.fillStyle = '#FFFFFF'; ctx.font = '800 ' + Math.round((wide ? H : W) * .055) + 'px Inter, "Segoe UI", Arial, sans-serif';
      var nLines = tpWrap(ctx, String(name || '').toUpperCase(), tx, nameY, wide ? W * .38 : W * .82, Math.round((wide ? H : W) * .062), 2);

      var priceY = nameY + nLines * Math.round((wide ? H : W) * .062) + (wide ? H * .08 : H * .05);
      ctx.fillStyle = TPCARD_BIZ.accent; ctx.font = '900 ' + Math.round((wide ? H : W) * .075) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), tx, priceY);
      ctx.textAlign = 'left';
      var qrSize = Math.round((wide ? H : Math.min(W, H)) * .12);
      tpDrawQR(ctx, wide ? W * .06 : W - qrSize - W * .06, wide ? H * .74 : H - qrSize - H * .05, qrSize, true);
      return c;
    }

    function tpBuildCollage(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3;
      ctx.fillStyle = TPCARD_BIZ.accent2 || TPCARD_BIZ.accent; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = TPCARD_BIZ.accent;
      if (wide) ctx.fillRect(0, 0, W * .56, H); else ctx.fillRect(0, 0, W, H * .56);
      ctx.save(); ctx.globalAlpha = .07; ctx.fillStyle = '#FFFFFF';
      for (var i = -H; i < W + H; i += Math.round(W * .09)) { ctx.save(); ctx.translate(i, 0); ctx.rotate(-.4); ctx.fillRect(0, -H, Math.round(W * .026), H * 3); ctx.restore(); }
      ctx.restore();

      var boxW = wide ? W * .38 : W * .7, boxH = wide ? H * .76 : boxW * .8;
      var bx = wide ? W * .54 : (W - boxW) / 2, by = wide ? (H - boxH) / 2 : H * .16;
      ctx.save();
      ctx.translate(bx + boxW / 2, by + boxH / 2); ctx.rotate(-3 * Math.PI / 180); ctx.translate(-(bx + boxW / 2), -(by + boxH / 2));
      var pad = Math.round(W * .014);
      ctx.fillStyle = '#FFFFFF'; tpRR(ctx, bx - pad, by - pad, boxW + pad * 2, boxH + pad * 2, Math.round(W * .02)); ctx.fill();
      tpDrawImage(ctx, photo, bx, by, boxW, boxH, Math.round(W * .015));
      ctx.restore();

      var price = parseFloat(tpEffectivePrice(row)) || 0;
      var stickerR = Math.round(Math.min(W, H) * .13);
      var sx = bx + boxW - stickerR * .35, sy = by + boxH - stickerR * .35;
      ctx.save(); ctx.translate(sx, sy); ctx.rotate(8 * Math.PI / 180);
      // Antes era un rosa fijo (#E11D48) — no cambiaba aunque se eligiera
      // otro color. Usa el acento principal (el fondo ya usa el secundario
      // por bloques) para que el sticker sí responda al selector de colores.
      ctx.fillStyle = TPCARD_BIZ.accent; ctx.beginPath(); ctx.arc(0, 0, stickerR, 0, Math.PI * 2); ctx.fill();
      var stickerInk = tpText(TPCARD_BIZ.accent);
      ctx.fillStyle = stickerInk; ctx.textAlign = 'center';
      ctx.font = '800 ' + Math.round(stickerR * .2) + 'px Inter, "Segoe UI", Arial, sans-serif'; ctx.fillText('¡OFERTA!', 0, -Math.round(stickerR * .3));
      ctx.font = '900 ' + Math.round(stickerR * .4) + 'px Inter, "Segoe UI", Arial, sans-serif'; ctx.fillText(tpSym(price), 0, Math.round(stickerR * .18));
      ctx.restore(); ctx.textAlign = 'left';

      tpDrawBrand(ctx, W * .05, H * .09, W * .55, true, Math.round(W * .03));
      var nameY = wide ? H * .84 : by + boxH + H * .1, nameX = wide ? W * .05 : W * .06;
      ctx.fillStyle = '#FFFFFF'; ctx.font = '900 ' + Math.round(W * .042) + 'px Inter, "Segoe UI", Arial, sans-serif';
      tpWrap(ctx, String(name || '').toUpperCase(), nameX, nameY, wide ? W * .42 : W * .88, Math.round(W * .047), 2);

      var qrSize = Math.round(H * .11);
      tpDrawQR(ctx, W - qrSize - W * .05, H * .06, qrSize, true);
      return c;
    }

    // Editorial elegante: mucho aire en blanco, tipografía serif, composición
    // asimétrica (foto a un lado, texto al otro) — nada de paneles de color.
    function tpBuildEditorial(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '', desc = row.getAttribute('data-edit-desc') || '';
      var wide = W > H * 1.3, ink = '#20221F', margin = W * .07;
      ctx.fillStyle = '#F7F4EE'; ctx.fillRect(0, 0, W, H);
      var serif = 'Georgia, "Times New Roman", serif';
      if (wide) {
        var pw = W * .4, ph = H * .72, px = W - margin - pw, py = (H - ph) / 2;
        tpDrawImage(ctx, photo, px, py, pw, ph, Math.round(W * .006));
        ctx.fillStyle = ink; ctx.font = '650 ' + Math.round(H * .05) + 'px ' + serif;
        ctx.fillText(String(TPCARD_BIZ.name || 'Mi tienda').toUpperCase(), margin, H * .18);
        // Antes la línea era solo del color principal — el secundario no se
        // veía en este estilo. Un degradado usa los dos sin perder la
        // sobriedad del diseño editorial (nada de bloques de color grandes).
        var ruleGrad = ctx.createLinearGradient(margin, 0, margin + W * .14, 0);
        ruleGrad.addColorStop(0, TPCARD_BIZ.accent); ruleGrad.addColorStop(1, TPCARD_BIZ.accent2 || TPCARD_BIZ.accent);
        ctx.strokeStyle = ruleGrad; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(margin, H * .23); ctx.lineTo(margin + W * .14, H * .23); ctx.stroke();
        ctx.font = '500 ' + Math.round(H * .09) + 'px ' + serif; ctx.fillStyle = ink;
        var lines = tpWrap(ctx, name, margin, H * .42, W * .42, Math.round(H * .1), 3);
        var priceY = H * .42 + lines * Math.round(H * .1) + H * .12;
        ctx.font = '400 ' + Math.round(H * .055) + 'px ' + serif; ctx.fillStyle = TPCARD_BIZ.accent;
        ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), margin, priceY);
        tpDrawQR(ctx, margin, H * .78, Math.round(H * .13), false);
      } else {
        var pw2 = W * .6, ph2 = H * .4, px2 = W - margin - pw2, py2 = H * .1;
        tpDrawImage(ctx, photo, px2, py2, pw2, ph2, Math.round(W * .006));
        ctx.fillStyle = ink; ctx.font = '650 ' + Math.round(W * .026) + 'px ' + serif;
        ctx.fillText(String(TPCARD_BIZ.name || 'Mi tienda').toUpperCase(), margin, H * .08);
        var ruleGrad2 = ctx.createLinearGradient(margin, 0, W - margin, 0);
        ruleGrad2.addColorStop(0, TPCARD_BIZ.accent); ruleGrad2.addColorStop(1, TPCARD_BIZ.accent2 || TPCARD_BIZ.accent);
        ctx.strokeStyle = ruleGrad2; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(margin, py2 + ph2 + H * .05); ctx.lineTo(W - margin, py2 + ph2 + H * .05); ctx.stroke();
        ctx.font = '500 ' + Math.round(W * .06) + 'px ' + serif; ctx.fillStyle = ink;
        var lines2 = tpWrap(ctx, name, margin, py2 + ph2 + H * .11, W * .86, Math.round(W * .066), 2);
        var descY = py2 + ph2 + H * .11 + lines2 * Math.round(W * .066) + H * .025;
        if (desc) { ctx.globalAlpha = .62; ctx.font = '400 ' + Math.round(W * .026) + 'px ' + serif; tpWrap(ctx, desc, margin, descY, W * .86, Math.round(W * .038), 2); ctx.globalAlpha = 1; }
        ctx.font = '400 ' + Math.round(W * .07) + 'px ' + serif; ctx.fillStyle = TPCARD_BIZ.accent;
        ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), margin, H * .93);
        tpDrawQR(ctx, W - margin - Math.round(W * .12), H * .82, Math.round(W * .12), false);
      }
      return c;
    }

    // Pop energético: bloques de color intensos, formas dinámicas y texto
    // extragrande — la vitrina "ruidosa" a propósito, opuesta a la editorial.
    function tpBuildPop(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3, mn = Math.min(W, H);
      ctx.fillStyle = TPCARD_BIZ.accent; ctx.fillRect(0, 0, W, H);
      var grad = ctx.createLinearGradient(0, 0, W, H);
      grad.addColorStop(0, tpRgba(TPCARD_BIZ.accent2 || TPCARD_BIZ.accent, .85));
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad; ctx.fillRect(0, 0, W, H);
      ctx.save(); ctx.globalAlpha = .16; ctx.fillStyle = '#FFFFFF';
      [[.1, .12, .1], [.92, .2, .07], [.06, .88, .08], [.92, .88, .06]].forEach(function (p) {
        ctx.beginPath(); ctx.arc(W * p[0], H * p[1], mn * p[2], 0, Math.PI * 2); ctx.fill();
      });
      ctx.restore();

      var box = wide ? H * .68 : mn * .56;
      var bx = wide ? W * .56 : (W - box) / 2, by = wide ? (H - box) / 2 : H * .18;
      ctx.save();
      ctx.translate(bx + box / 2, by + box / 2); ctx.rotate(2.5 * Math.PI / 180); ctx.translate(-(bx + box / 2), -(by + box / 2));
      var pad = Math.round(mn * .018);
      ctx.fillStyle = '#FFFFFF'; tpRR(ctx, bx - pad, by - pad, box + pad * 2, box + pad * 2, Math.round(mn * .03)); ctx.fill();
      tpDrawImage(ctx, photo, bx, by, box, box, Math.round(mn * .025));
      ctx.restore();

      var bigWord = String(name || 'PRODUCTO').trim().split(/\s+/)[0].toUpperCase();
      ctx.fillStyle = '#FFFFFF';
      if (wide) {
        ctx.save(); ctx.translate(W * .27, H * .2); ctx.rotate(-3 * Math.PI / 180);
        tpFitCenterText(ctx, bigWord, 0, 0, W * .46, H * .3, 40, 900);
        ctx.restore();
        tpDrawBrand(ctx, W * .05, H * .84, W * .3, true, Math.round(H * .05));
        tpDrawPrice(ctx, row, bx, by + box + H * .07, Math.round(H * .12), '#FFFFFF');
      } else {
        ctx.save(); ctx.translate(W * .5, by * .82); ctx.rotate(-2 * Math.PI / 180);
        tpFitCenterText(ctx, bigWord, 0, 0, W * .86, W * .19, 36, 900);
        ctx.restore();
        tpDrawBrand(ctx, W * .06, H * .09, W * .5, true, Math.round(W * .03));
        tpDrawPrice(ctx, row, W * .06, by + box + H * .1, Math.round(W * .095), '#FFFFFF');
        tpDrawQR(ctx, W - W * .06 - Math.round(H * .095), by + box + H * .02, Math.round(H * .095), true);
      }
      return c;
    }

    // Duotono: la foto se pinta en gris y se tiñe con los dos tonos de la
    // tienda (blend "color") — mismo truco que usan las portadas de disco.
    function tpBuildDuotono(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3;
      ctx.save();
      try { ctx.filter = 'grayscale(1) contrast(1.05)'; } catch (e) {}
      if (photo) tpCover(ctx, photo, 0, 0, W, H); else tpDrawPlaceholder(ctx, 0, 0, W, H);
      ctx.filter = 'none'; ctx.restore();
      var duo = ctx.createLinearGradient(0, 0, W, H);
      duo.addColorStop(0, TPCARD_BIZ.accent); duo.addColorStop(1, TPCARD_BIZ.accent2 || TPCARD_BIZ.accent);
      ctx.save(); ctx.globalCompositeOperation = 'color'; ctx.fillStyle = duo; ctx.fillRect(0, 0, W, H); ctx.restore();
      var shade = ctx.createLinearGradient(0, 0, 0, H);
      shade.addColorStop(wide ? 0 : .55, 'rgba(0,0,0,0)'); shade.addColorStop(1, 'rgba(0,0,0,.62)');
      ctx.fillStyle = shade; ctx.fillRect(0, 0, W, H);

      var margin = W * .06;
      tpDrawBrand(ctx, margin, H * .09, W * .5, true, Math.round((wide ? H : W) * .03));
      var nameY = wide ? H * .62 : H * .78;
      ctx.fillStyle = '#FFFFFF'; ctx.font = '800 ' + Math.round((wide ? H : W) * .056) + 'px Inter, "Segoe UI", Arial, sans-serif';
      var lines = tpWrap(ctx, String(name || '').toUpperCase(), margin, nameY, W * .84, Math.round((wide ? H : W) * .062), 2);
      var priceY = nameY + lines * Math.round((wide ? H : W) * .062) + H * .06;
      ctx.font = '900 ' + Math.round((wide ? H : W) * .075) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), margin, priceY);
      var qrSize = Math.round((wide ? H : W) * .11);
      tpDrawQR(ctx, W - margin - qrSize, H - qrSize - H * .06, qrSize, true);
      return c;
    }

    // Glow neón: fondo casi negro, resplandor de color detrás del producto y
    // texto con el mismo resplandor — efecto vitrina de antro/gaming.
    function tpBuildGlow(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3, mn = Math.min(W, H);
      ctx.fillStyle = '#070708'; ctx.fillRect(0, 0, W, H);
      var cx = wide ? W * .68 : W * .5, cy = wide ? H * .5 : H * .4;
      var r = (wide ? H : mn) * .42;
      var glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
      glow.addColorStop(0, tpRgba(TPCARD_BIZ.accent, .85));
      glow.addColorStop(.6, tpRgba(TPCARD_BIZ.accent2 || TPCARD_BIZ.accent, .3));
      glow.addColorStop(1, 'rgba(7,7,8,0)');
      ctx.fillStyle = glow; ctx.fillRect(0, 0, W, H);

      var box = (wide ? H : mn) * .48;
      ctx.save(); ctx.shadowColor = TPCARD_BIZ.accent; ctx.shadowBlur = box * .3;
      tpDrawImage(ctx, photo, cx - box / 2, cy - box / 2, box, box, Math.round(box * .08));
      ctx.restore();

      var tx = wide ? W * .06 : W / 2, ta = wide ? 'left' : 'center';
      ctx.textAlign = ta;
      ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.font = '750 ' + Math.round((wide ? H : W) * .026) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(String(TPCARD_BIZ.name || 'Mi tienda').toUpperCase(), tx, wide ? H * .16 : H * .08);

      var nameY = wide ? H * .86 : cy + box / 2 + H * .1;
      ctx.save(); ctx.shadowColor = TPCARD_BIZ.accent; ctx.shadowBlur = box * .12;
      ctx.fillStyle = '#FFFFFF'; ctx.font = '800 ' + Math.round((wide ? H : W) * .046) + 'px Inter, "Segoe UI", Arial, sans-serif';
      var lines = tpWrap(ctx, String(name || '').toUpperCase(), tx, nameY, wide ? W * .34 : W * .8, Math.round((wide ? H : W) * .052), 2);
      ctx.restore();

      var priceY = nameY + lines * Math.round((wide ? H : W) * .052) + H * .06;
      ctx.save(); ctx.shadowColor = TPCARD_BIZ.accent2 || TPCARD_BIZ.accent; ctx.shadowBlur = box * .14;
      ctx.fillStyle = TPCARD_BIZ.accent2 || TPCARD_BIZ.accent; ctx.font = '900 ' + Math.round((wide ? H : W) * .065) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), tx, priceY);
      ctx.restore(); ctx.textAlign = 'left';
      var qrSize = Math.round((wide ? H : mn) * .1);
      tpDrawQR(ctx, wide ? W * .06 : W - qrSize - W * .06, wide ? H * .68 : H - qrSize - H * .05, qrSize, true);
      return c;
    }

    // Levitación: fondo claro y aireado, el producto "flota" sobre una sombra
    // suave en vez de apoyarse en algo — sensación limpia, casi de spa.
    function tpBuildLevitacion(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3, mn = Math.min(W, H);
      var bg = ctx.createLinearGradient(0, 0, 0, H);
      bg.addColorStop(0, '#FFFFFF'); bg.addColorStop(1, tpRgba(TPCARD_BIZ.accent, .1));
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

      var cx = wide ? W * .68 : W * .5, cy = wide ? H * .42 : H * .32;
      var box = (wide ? H : mn) * .42;
      var shadowGrad = ctx.createRadialGradient(cx, cy + box * .62, box * .05, cx, cy + box * .62, box * .55);
      shadowGrad.addColorStop(0, 'rgba(20,20,25,.2)'); shadowGrad.addColorStop(1, 'rgba(20,20,25,0)');
      ctx.fillStyle = shadowGrad;
      ctx.beginPath(); ctx.ellipse(cx, cy + box * .62, box * .5, box * .12, 0, 0, Math.PI * 2); ctx.fill();

      ctx.save(); ctx.shadowColor = 'rgba(20,20,25,.16)'; ctx.shadowBlur = box * .1; ctx.shadowOffsetY = box * .05;
      tpDrawImage(ctx, photo, cx - box / 2, cy - box / 2, box, box, Math.round(box * .07));
      ctx.restore();

      // Antes los dos círculos flotantes usaban el mismo color principal —
      // el secundario no se veía reflejado en ningún lado de este estilo.
      ctx.save(); ctx.globalAlpha = .45; ctx.fillStyle = TPCARD_BIZ.accent;
      ctx.beginPath(); ctx.arc(cx - box * .56, cy - box * .48, box * .045, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = .32; ctx.fillStyle = TPCARD_BIZ.accent2 || TPCARD_BIZ.accent;
      ctx.beginPath(); ctx.arc(cx + box * .58, cy - box * .34, box * .03, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      var tx = wide ? W * .06 : W / 2, ta = wide ? 'left' : 'center';
      ctx.textAlign = ta;
      ctx.fillStyle = 'rgba(23,24,26,.55)'; ctx.font = '700 ' + Math.round((wide ? H : W) * .024) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(String(TPCARD_BIZ.name || 'Mi tienda').toUpperCase(), tx, wide ? H * .16 : H * .08);

      var nameY = wide ? H * .32 : cy + box * .68 + H * .1;
      ctx.fillStyle = '#17181A'; ctx.font = '800 ' + Math.round((wide ? H : W) * .05) + 'px Inter, "Segoe UI", Arial, sans-serif';
      var lines = tpWrap(ctx, String(name || '').toUpperCase(), tx, nameY, wide ? W * .32 : W * .8, Math.round((wide ? H : W) * .056), 2);

      var priceY = nameY + lines * Math.round((wide ? H : W) * .056) + H * .055;
      ctx.fillStyle = TPCARD_BIZ.accent; ctx.font = '900 ' + Math.round((wide ? H : W) * .062) + 'px Inter, "Segoe UI", Arial, sans-serif';
      ctx.fillText(tpSym(parseFloat(tpEffectivePrice(row)) || 0), tx, priceY);
      ctx.textAlign = 'left';
      var qrSize = Math.round((wide ? H : mn) * .1);
      tpDrawQR(ctx, wide ? W * .06 : W - qrSize - W * .06, wide ? H * .72 : H - qrSize - H * .05, qrSize, false);
      return c;
    }

    // Patrón de marca: fondo texturizado con círculos repetidos en los tonos
    // de la tienda, foto en tarjeta blanca flotante — se siente "de catálogo".
    function tpBuildPatron(photo, W, H) {
      var row = TPCARD.row, c = document.createElement('canvas'); c.width = W; c.height = H;
      var ctx = c.getContext('2d'), name = row.getAttribute('data-edit-name') || '';
      var wide = W > H * 1.3, mn = Math.min(W, H);
      ctx.fillStyle = '#F4F1EA'; ctx.fillRect(0, 0, W, H);
      var step = Math.round(mn * .09);
      ctx.save();
      for (var yy = 0; yy < H + step; yy += step) {
        for (var xx = 0; xx < W + step; xx += step) {
          var offset = (Math.round(yy / step) % 2) ? step / 2 : 0;
          ctx.globalAlpha = .12;
          ctx.fillStyle = (Math.round((xx + offset) / step + yy / step) % 2) ? TPCARD_BIZ.accent : (TPCARD_BIZ.accent2 || TPCARD_BIZ.accent);
          ctx.beginPath(); ctx.arc(xx + offset, yy, step * .16, 0, Math.PI * 2); ctx.fill();
        }
      }
      ctx.restore();

      var box = wide ? H * .58 : mn * .5, ink = '#20221F';
      var bx = wide ? W * .56 : (W - box) / 2, by = wide ? (H - box) / 2 : H * .16;
      ctx.save(); ctx.shadowColor = 'rgba(0,0,0,.14)'; ctx.shadowBlur = box * .08; ctx.shadowOffsetY = box * .03;
      var pad = Math.round(box * .05);
      ctx.fillStyle = '#FFFFFF'; tpRR(ctx, bx - pad, by - pad, box + pad * 2, box + pad * 2, Math.round(box * .06)); ctx.fill();
      ctx.restore();
      tpDrawImage(ctx, photo, bx, by, box, box, Math.round(box * .05));

      var tx = W * .07;
      if (wide) {
        tpDrawBrand(ctx, tx, H * .16, W * .4, false, Math.round(H * .045));
        ctx.fillStyle = ink; ctx.font = '800 ' + Math.round(H * .06) + 'px Inter, "Segoe UI", Arial, sans-serif';
        var lines = tpWrap(ctx, String(name || '').toUpperCase(), tx, H * .38, W * .4, Math.round(H * .07), 3);
        var priceY = H * .38 + lines * Math.round(H * .07) + H * .09;
        tpDrawPrice(ctx, row, tx, priceY, Math.round(H * .12), TPCARD_BIZ.accent);
        tpDrawQR(ctx, tx, H * .82, Math.round(H * .12), false);
      } else {
        tpDrawBrand(ctx, tx, H * .09, W * .5, false, Math.round(W * .03));
        var nameY = by + box + H * .1;
        ctx.fillStyle = ink; ctx.font = '800 ' + Math.round(W * .052) + 'px Inter, "Segoe UI", Arial, sans-serif';
        var lines2 = tpWrap(ctx, String(name || '').toUpperCase(), tx, nameY, W * .84, Math.round(W * .058), 2);
        var priceY2 = nameY + lines2 * Math.round(W * .058) + H * .03;
        tpDrawPrice(ctx, row, tx, priceY2, Math.round(W * .085), TPCARD_BIZ.accent);
        tpDrawQR(ctx, W - tx - Math.round(H * .095), H * .06, Math.round(H * .095), false);
      }
      return c;
    }

    // Formato → { w, h } ya vive en TP_FORMATS; el estilo "diagonal" conserva
    // sus 4 funciones afinadas a mano, los demás usan la misma función
    // adaptativa para los 4 formatos.
    var TP_STYLE_FNS = {
      gigante: tpBuildGigante, spotlight: tpBuildSpotlight, collage: tpBuildCollage,
      editorial: tpBuildEditorial, pop: tpBuildPop, duotono: tpBuildDuotono,
      glow: tpBuildGlow, levitacion: tpBuildLevitacion, patron: tpBuildPatron
    };
    var TP_STYLE_BUILDERS = {
      diagonal: { square: tpBuildSquare, feed: tpBuildFeed, story: tpBuildStory, landscape: tpBuildLandscape }
    };
    Object.keys(TP_STYLE_FNS).forEach(function (style) {
      var fn = TP_STYLE_FNS[style];
      var byFormat = {};
      Object.keys(TP_FORMATS).forEach(function (fmt) {
        byFormat[fmt] = function (photo) { return fn(photo, TP_FORMATS[fmt].w, TP_FORMATS[fmt].h); };
      });
      TP_STYLE_BUILDERS[style] = byFormat;
    });

    function tpDibujar(photo) {
      if (!TPCARD.row) return;
      TPCARD.canvases = {};
      var builders = TP_STYLE_BUILDERS[TPCARD.style] || TP_STYLE_BUILDERS.diagonal;
      Object.keys(builders).forEach(function (key) { TPCARD.canvases[key] = builders[key](photo); });
      tpRenderPreview();
    }
    function seleccionarEstiloTarjeta(style) {
      TPCARD.style = TP_STYLE_BUILDERS[style] ? style : 'diagonal';
      Object.keys(TP_STYLE_BUILDERS).forEach(function (key) {
        var b = document.getElementById('tp-style-' + key);
        if (b) b.classList.toggle('is-active', TPCARD.style === key);
      });
      tpDibujar(TPCARD.photoImg);
    }
    // Colores de la pieza — se mutan directo en TPCARD_BIZ porque los 10
    // estilos ya leen sus colores de ahí; así no hay que tocar cada builder.
    function tpSyncColorInputs() {
      var a = document.getElementById('tp-color-accent'), a2 = document.getElementById('tp-color-accent2');
      var ah = document.getElementById('tp-color-accent-hex'), a2h = document.getElementById('tp-color-accent2-hex');
      if (a) a.value = TPCARD_BIZ.accent; if (a2) a2.value = TPCARD_BIZ.accent2;
      if (ah) ah.textContent = TPCARD_BIZ.accent; if (a2h) a2h.textContent = TPCARD_BIZ.accent2;
    }
    function cambiarColorTarjeta(cual, hex) {
      if (!/^#[0-9a-fA-F]{6}$/.test(hex || '')) return;
      TPCARD_BIZ[cual] = hex;
      tpSyncColorInputs();
      tpDibujar(TPCARD.photoImg);
    }
    function restablecerColoresTarjeta() {
      TPCARD_BIZ.accent = TPCARD_DEFAULT_COLORS.accent;
      TPCARD_BIZ.accent2 = TPCARD_DEFAULT_COLORS.accent2;
      tpSyncColorInputs();
      tpDibujar(TPCARD.photoImg);
    }
    function tpRenderPreview() {
      var prev=document.getElementById('tp-preview'); if(!prev)return;
      var canvas=TPCARD.canvases[TPCARD.format];
      if(!canvas)return; prev.innerHTML='';prev.appendChild(canvas);prev.setAttribute('data-format',TPCARD.format);
    }
    function seleccionarFormatoTarjeta(format) {
      TPCARD.format = TP_FORMATS[format] ? format : 'square';
      Object.keys(TP_FORMATS).forEach(function (key) {
        var b = document.getElementById('tp-format-' + key);
        if (b) b.classList.toggle('is-active', TPCARD.format === key);
      });
      var info = TP_FORMATS[TPCARD.format];
      var btn=document.getElementById('tp-download'),note=document.getElementById('tp-size-note');
      if(btn)btn.lastChild.textContent=' Descargar';
      if(note)note.textContent=info.note;
      tpRenderPreview();
    }

    function tpDescargarCanvas(canvas, prefix, success) {
      if (!canvas) { mostrarToast('Aún se está generando la tarjeta', 'error'); return; }
      canvas.toBlob(function (blob) {
        if (!blob) { mostrarToast('No se pudo exportar la imagen', 'error'); return; }
        var href=URL.createObjectURL(blob),a=document.createElement('a');a.href=href;
        a.download=prefix+'-'+(TPCARD.row?TPCARD.row.getAttribute('data-edit-id'):'')+'.png';
        document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(href);},2000);
        mostrarToast(success, 'ok');
      },'image/png');
    }
    function descargarFormatoTarjeta() {
      tpDescargarCanvas(TPCARD.canvases[TPCARD.format], TPCARD.format, TP_FORMATS[TPCARD.format].label + ' descargada ✓');
    }
    function compartirTarjetaProducto() {
      var canvas=TPCARD.canvases[TPCARD.format];
      if(!canvas){mostrarToast('Aún se está generando la tarjeta','error');return;}
      canvas.toBlob(function(blob){
        if(!blob){mostrarToast('No se pudo preparar la imagen','error');return;}
        var file=new File([blob],TPCARD.format+'-'+(TPCARD.row?TPCARD.row.getAttribute('data-edit-id'):'')+'.png',{type:'image/png'});
        if(navigator.share&&navigator.canShare&&navigator.canShare({files:[file]})){
          navigator.share({files:[file],title:TPCARD.row.getAttribute('data-edit-name')||'Producto',text:'Mira este producto en '+TPCARD_BIZ.name,url:TPCARD.url}).catch(function(e){if(e&&e.name!=='AbortError')mostrarToast('No se pudo compartir','error');});
        }else{
          tpDescargarCanvas(canvas,TPCARD.format,'Imagen descargada para compartir');
        }
      },'image/png');
    }
    function copiarEnlaceProducto() {
      if (!TPCARD.url) return;
      var done = function () { mostrarToast('Enlace copiado ✓', 'ok'); };
      var fallback = function () {
        var ta = document.createElement('textarea');
        ta.value = TPCARD.url; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch (e) { mostrarToast('No se pudo copiar', 'error'); }
        ta.remove();
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(TPCARD.url).then(done, fallback);
      else fallback();
    }

    // ===== Compartir la publicidad: texto listo, canales y copiado de imagen =====
    function tpPromoTexto(row) {
      var t = row.getAttribute('data-edit-promo-type') || '';
      var v = row.getAttribute('data-edit-promo-value') || '';
      var g = row.getAttribute('data-edit-promo-gift') || '';
      if (t === 'regalo' && g) return 'Llévate de regalo: ' + g;
      if (t && v) return t.charAt(0).toUpperCase() + t.slice(1) + ' ' + v;
      return '';
    }
    function tpHashtags(row) {
      var tags = (row.getAttribute('data-edit-tags') || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 4);
      tags.push(TPCARD_BIZ.name);
      var seen = {};
      return tags.map(function (s) {
        return '#' + s.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-zA-Z0-9]+/g, '');
      }).filter(function (h) { if (h.length < 3 || seen[h.toLowerCase()]) return false; seen[h.toLowerCase()] = 1; return true; }).join(' ');
    }
    function tpGenerarCaption(tone) {
      var row = TPCARD.row; if (!row) return '';
      var name = row.getAttribute('data-edit-name') || 'Producto';
      var desc = (row.getAttribute('data-edit-desc') || '').trim();
      if (desc.length > 140) desc = desc.slice(0, 137).replace(/\s+\S*$/, '') + '…';
      var price = tpSym(tpEffectivePrice(row));
      var oldRaw = tpEffectiveOld(row);
      var old = oldRaw && Number(oldRaw) > Number(tpEffectivePrice(row)) ? tpSym(oldRaw) : '';
      var promo = tpPromoTexto(row);
      var inst = row.getAttribute('data-edit-installments') === '1'
        ? 'A solo ' + (row.getAttribute('data-edit-inst-count') || 6) + ' abonos de ' + tpSym(Math.ceil(Number(tpEffectivePrice(row)) / (Number(row.getAttribute('data-edit-inst-count')) || 6))) : '';
      var url = TPCARD.url || '';
      var biz = TPCARD_BIZ.name;
      var L = [];
      if (tone === 'corto') {
        L.push(name + ' · ' + price + (old ? ' (antes ' + old + ')' : ''));
        if (url) L.push(url);
        return L.join('\n');
      }
      if (tone === 'elegante') {
        L.push(name);
        if (desc) L.push('', desc);
        L.push('', price + (old ? '  ·  antes ' + old : ''));
        if (promo) L.push(promo);
        if (inst) L.push(inst);
        L.push('', 'Descúbrelo en ' + biz + (url ? ':' : '.'));
        if (url) L.push(url);
        var ht = tpHashtags(row); if (ht) L.push('', ht);
        return L.join('\n');
      }
      L.push('🔥 ' + name.toUpperCase());
      if (desc) L.push(desc);
      L.push('');
      L.push('💰 ' + (old ? 'Antes ' + old + ' → ' : '') + 'Hoy ' + price);
      if (promo) L.push('🎁 ' + promo);
      if (inst) L.push('💳 ' + inst);
      L.push('');
      L.push('📲 Pídelo aquí' + (url ? ':' : '.'));
      if (url) L.push(url);
      L.push('✨ ' + biz);
      var ht2 = tpHashtags(row); if (ht2) L.push('', ht2);
      return L.join('\n');
    }
    function tpTono(tone) {
      TPCARD.tone = tone; TPCARD.dirty = false;
      document.querySelectorAll('.tps-tones button').forEach(function (b) { b.classList.toggle('is-on', b.getAttribute('data-tone') === tone); });
      var ta = document.getElementById('tp-caption');
      if (ta) { ta.value = tpGenerarCaption(tone); tpContarCaption(); }
    }
    function tpContarCaption() {
      var ta = document.getElementById('tp-caption'), c = document.getElementById('tp-cap-count');
      if (ta && c) c.textContent = ta.value.length + ' caracteres';
    }
    function tpTexto() { var ta = document.getElementById('tp-caption'); return (ta && ta.value.trim()) || tpGenerarCaption('venta'); }
    function tpCopiar(text, okMsg) {
      var fallback = function () {
        var ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;opacity:0'; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); mostrarToast(okMsg, 'ok'); } catch (e) { mostrarToast('No se pudo copiar', 'error'); }
        ta.remove();
      };
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { mostrarToast(okMsg, 'ok'); }, fallback); else fallback();
    }
    function copiarTextoTarjeta() { tpCopiar(tpTexto(), 'Texto copiado ✓'); }
    function copiarImagenTarjeta() {
      var canvas = TPCARD.canvases[TPCARD.format];
      if (!canvas) { mostrarToast('Aún se está generando la tarjeta', 'error'); return; }
      if (!(window.ClipboardItem && navigator.clipboard && navigator.clipboard.write && window.isSecureContext)) {
        tpDescargarCanvas(canvas, TPCARD.format, 'Tu navegador no copia imágenes; la descargamos');
        return;
      }
      canvas.toBlob(function (blob) {
        if (!blob) { mostrarToast('No se pudo preparar la imagen', 'error'); return; }
        navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]).then(
          function () { mostrarToast('Imagen copiada — pégala en tu publicación ✓', 'ok'); },
          function () { tpDescargarCanvas(canvas, TPCARD.format, 'No se pudo copiar; la descargamos'); }
        );
      }, 'image/png');
    }
    function tpAbsImg() {
      var s = TPCARD.row ? (TPCARD.row.getAttribute('data-edit-image') || '') : '';
      if (!s) return '';
      return /^https?:/i.test(s) ? s : location.origin + (s.charAt(0) === '/' ? s : '/' + s);
    }
    // Canales: los que aceptan enlace+texto lo abren ya llenos; los que no (Instagram, TikTok, Estados)
    // reciben la pieza descargada y el texto copiado, con la indicación de qué hacer.
    function tpCanal(canal) {
      var text = tpTexto(), url = TPCARD.url || '', enc = encodeURIComponent;
      var nombre = TPCARD.row ? TPCARD.row.getAttribute('data-edit-name') : 'Producto';
      var abrir = function (u) { window.open(u, '_blank', 'noopener'); };
      var preparar = function (formato, msg) {
        var canvas = TPCARD.canvases[formato];
        tpCopiar(text, 'Texto copiado ✓');
        if (canvas) setTimeout(function () { tpDescargarCanvas(canvas, formato, msg); }, 350);
      };
      if (canal === 'whatsapp') return abrir('https://wa.me/?text=' + enc(text));
      if (canal === 'facebook') return abrir('https://www.facebook.com/sharer/sharer.php?u=' + enc(url) + '&quote=' + enc(text));
      if (canal === 'telegram') return abrir('https://t.me/share/url?url=' + enc(url) + '&text=' + enc(text.replace(url, '').trim()));
      if (canal === 'x') return abrir('https://twitter.com/intent/tweet?text=' + enc(text.replace(url, '').trim().slice(0, 240)) + '&url=' + enc(url));
      if (canal === 'pinterest') return abrir('https://www.pinterest.com/pin/create/button/?url=' + enc(url) + '&media=' + enc(tpAbsImg()) + '&description=' + enc(text.replace(url, '').trim().slice(0, 480)));
      if (canal === 'email') { location.href = 'mailto:?subject=' + enc(nombre + ' · ' + TPCARD_BIZ.name) + '&body=' + enc(text); return; }
      if (canal === 'instagram') return preparar('feed', 'Pieza 4:5 descargada — súbela en Instagram y pega el texto');
      if (canal === 'tiktok') return preparar('story', 'Pieza 9:16 descargada — súbela en TikTok y pega el texto');
      if (canal === 'estado') return preparar('story', 'Pieza 9:16 descargada — publícala como Estado de WhatsApp');
    }
    function descargarTodasTarjeta() {
      var keys = Object.keys(TP_FORMATS), i = 0;
      (function next() {
        if (i >= keys.length) return;
        var k = keys[i++];
        tpDescargarCanvas(TPCARD.canvases[k], k, TP_FORMATS[k].label + ' descargada ✓');
        setTimeout(next, 500);
      })();
    }
  </script>
</body>
</html>
