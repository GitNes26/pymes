<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= product.name %> · <%= biz.name %></title>
  <meta name="description" content="<%= (product.description || (biz.name + ': ' + product.name)).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <meta property="og:type" content="product" />
  <meta property="og:title" content="<%= product.name %> — <%= money(product.price) %>" />
  <meta property="og:description" content="<%= (product.description || 'Disponible en ' + biz.name).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:url" content="<%= ogUrl %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= product.name %> — <%= money(product.price) %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f8f6f2;
      --bg-card: #ffffff;
      --text: #1e1b1a;
      --text-sec: #6b6562;
      --accent: #1a3c5e;
      --accent-light: #4a7a9c;
      --accent-glow: #c9a86c;
      --border: rgba(26,60,94,.08);
      --shadow: 0 8px 32px rgba(0,0,0,.06);
      --radius: 18px;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; -webkit-font-smoothing:antialiased; }
    h1,h2,h3 { font-family:'Playfair Display',serif; font-weight:700; letter-spacing:-.01em; }
    a { color:inherit; text-decoration:none; }

    /* ===== HEADER ===== */
    .hdr { position:sticky; top:0; z-index:50; background:rgba(248,246,242,.92); backdrop-filter:blur(18px); border-bottom:1px solid var(--border); }
    .hdr-inner { display:flex; align-items:center; gap:12px; padding:12px 24px; max-width:1200px; margin:0 auto; }
    .hdr-back { width:36px; height:36px; border-radius:12px; background:var(--bg-card); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text); font-size:16px; transition:all .25s cubic-bezier(.22,1,.36,1); }
    .hdr-back:hover { border-color:var(--accent-light); color:var(--accent); transform:translateX(-2px); }
    .hdr-brand { flex:1; min-width:0; }
    .hdr-brand h1 { font-size:1.1rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hdr-brand span { font-size:11px; color:var(--text-sec); font-family:'Inter',sans-serif; font-weight:500; }
    .hdr-cart { position:relative; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:8px 14px; cursor:pointer; font-size:14px; display:flex; align-items:center; gap:6px; transition:all .3s cubic-bezier(.22,1,.36,1); color:var(--text); font-weight:600; }
    .hdr-cart:hover { border-color:var(--accent-light); box-shadow:var(--shadow); transform:translateY(-1px); }
    .hdr-cart-count { display:none; position:absolute; top:-5px; right:-5px; background:var(--accent); color:#fff; font-size:10px; font-weight:800; min-width:18px; height:18px; border-radius:99px; align-items:center; justify-content:center; }

    /* ===== LAYOUT ===== */
    .page { max-width:1200px; margin:0 auto; padding:24px 24px 120px; }
    .prod-layout { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1fr); gap:48px; align-items:start; padding:28px; }
    .prod-gallery { display:flex; gap:12px; align-items:flex-start; position:sticky; top:84px; }

    /* ===== PRODUCT CARD ===== */
    .prod-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); animation:fadeIn .5s cubic-bezier(.22,1,.36,1); }
    @keyframes fadeIn { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:none; } }
    .prod-main-img { width:100%; aspect-ratio:1; object-fit:cover; display:block; cursor:zoom-in; border-radius:14px; border:1px solid var(--border); background:#eef2f6; }
    .prod-thumbs { display:flex; flex-direction:column; gap:8px; width:84px; flex-shrink:0; scrollbar-width:none; }
    .prod-thumbs::-webkit-scrollbar { display:none; }
    .prod-thumb { width:84px; height:84px; border-radius:12px; object-fit:cover; cursor:pointer; border:2px solid var(--border); transition:all .25s cubic-bezier(.22,1,.36,1); flex-shrink:0; opacity:.85; }
    .prod-thumb:hover { opacity:1; transform:translateY(-2px); }
    .prod-thumb.active { border-color:var(--accent); opacity:1; }
    .prod-info { margin-left:4rem; padding:12px 16px 12px 8px; }
    .prod-cat { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--accent-light); }
    .prod-title { font-size:2rem; margin-top:6px; line-height:1.15; overflow-wrap:anywhere; text-wrap:balance; }
    .prod-prices { display:flex; align-items:baseline; flex-wrap:wrap; row-gap:6px; gap:10px; margin-top:12px; }
    .prod-price { font-family:'Playfair Display',serif; font-size:2.1rem; font-weight:700; color:var(--accent); }
    .prod-old { font-size:15px; color:var(--text-sec); text-decoration:line-through; opacity:.5; }
    .prod-off { background:#ef4444; color:#fff; font-size:11px; font-weight:800; padding:3px 10px; border-radius:6px; align-self:center; }
    .prod-desc { font-size:14px; color:var(--text-sec); margin-top:14px; line-height:1.75; white-space:pre-line; overflow-wrap:anywhere; }

    /* ===== SPECS ===== */
    .specs-wrap { margin-top:20px; border-top:1px solid var(--border); padding-top:16px; overflow-x:hidden; }
    .specs-title { font-size:14px; font-weight:700; margin-bottom:10px; display:flex; align-items:center; gap:6px; }
    .specs-title i { color:var(--accent); }
    .specs-row { display:flex; gap:12px; padding:9px 12px; border-bottom:1px solid var(--border); border-radius:10px; font-size:13px; transition:background .2s cubic-bezier(.22,1,.36,1); }
    .specs-row:hover { background:rgba(26,60,94,.03); }
    .specs-row:last-child { border-bottom:none; }
    .specs-key { width:120px; flex-shrink:0; color:var(--text-sec); }
    .specs-val { color:var(--text); font-weight:500; }

    /* ===== TAGS ===== */
    .tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
    .tag { padding:4px 12px; border-radius:99px; font-size:11px; font-weight:600; background:rgba(26,60,94,.06); color:var(--accent); border:1px solid var(--border); }

    /* ===== ACTIONS ===== */
    .actions { display:flex; gap:10px; margin-top:20px; }
    .btn-add { flex:1; display:flex; align-items:center; justify-content:center; gap:8px; padding:13px; background:var(--accent)!important; color:#fff!important; border:none!important; border-radius:14px!important; font-weight:700!important; font-size:14px; cursor:pointer; transition:all .3s cubic-bezier(.22,1,.36,1); }
    .btn-add:hover { background:var(--accent-light)!important; transform:translateY(-2px); box-shadow:0 6px 20px rgba(26,60,94,.2); }
    .btn-add:active { transform:scale(.97); transition-duration:.1s; }
    body .btn-add { background:var(--accent)!important; color:#fff!important; }
    .btn-wa { display:flex; align-items:center; gap:8px; padding:13px 20px; background:#25d366; color:#fff; border:none; border-radius:14px; font-weight:700; font-size:14px; cursor:pointer; transition:all .3s cubic-bezier(.22,1,.36,1); text-decoration:none; box-shadow:0 4px 16px rgba(37,211,102,.2); }
    .btn-wa:hover { transform:translateY(-2px) scale(1.02); box-shadow:0 8px 24px rgba(37,211,102,.3); }
    .btn-wa:active { transform:scale(.97); transition-duration:.1s; }
    .btn-icon { width:48px; height:48px; display:flex; align-items:center; justify-content:center; border:1px solid var(--border); border-radius:14px; background:var(--bg-card); color:var(--text-sec); font-size:18px; cursor:pointer; transition:all .25s cubic-bezier(.22,1,.36,1); }
    .btn-icon:hover { border-color:var(--accent-light); color:var(--accent); transform:translateY(-1px); }
    .back-link { display:block; text-align:center; font-size:13px; color:var(--text-sec); margin-top:16px; transition:color .25s cubic-bezier(.22,1,.36,1); }
    .back-link:hover { color:var(--accent); }

    /* ===== RELACIONADOS (abajo) ===== */
    .related-section { margin-top:6px; }
    .sidebar-title { font-size:17px; font-weight:700; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .sidebar-title i { color:var(--accent); font-size:18px; }
    .related-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(168px,1fr)); gap:14px; }
    .related-card { display:block; padding:12px; border-radius:14px; border:1px solid var(--border); background:var(--bg-card); transition:all .3s cubic-bezier(.22,1,.36,1); }
    .related-card:hover { transform:translateY(-3px); box-shadow:var(--shadow); border-color:rgba(26,60,94,.14); }
    .related-img { width:100%; aspect-ratio:1; border-radius:10px; object-fit:cover; display:block; margin-bottom:10px; background:#eef2f6; }
    .related-name { font-size:13px; font-weight:600; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .related-price { font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:700; color:var(--accent); margin-top:6px; }

    /* ===== STICKY BAR (mobile) ===== */
    .sticky-bar { display:none; position:fixed; bottom:0; left:0; right:0; z-index:50; background:rgba(248,246,242,.97); backdrop-filter:blur(18px); border-top:1px solid var(--border); padding:12px 20px calc(12px + env(safe-area-inset-bottom, 0px)); box-shadow:0 -4px 16px rgba(0,0,0,.06); }
    .sticky-bar-inner { display:flex; align-items:center; gap:12px; max-width:1200px; margin:0 auto; }
    .sticky-price { font-family:'Playfair Display',serif; font-size:1.4rem; font-weight:700; color:var(--accent); }

    /* ===== GALLERY OVERLAY ===== */
    .gal-overlay { display:flex; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,.88); backdrop-filter:blur(8px); flex-direction:column; align-items:center; justify-content:center; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .3s cubic-bezier(.22,1,.36,1), visibility .3s; }
    .gal-overlay.show { opacity:1; visibility:visible; pointer-events:auto; }
    .gal-overlay img { max-width:90vw; max-height:80vh; object-fit:contain; border-radius:12px; box-shadow:0 20px 80px rgba(0,0,0,.5); transform:scale(.92); opacity:0; transition:transform .35s cubic-bezier(.22,1,.36,1), opacity .35s cubic-bezier(.22,1,.36,1); }
    .gal-overlay.show img { transform:scale(1); opacity:1; }
    .gal-close { position:absolute; top:20px; right:24px; background:rgba(255,255,255,.15); border:none; color:#fff; width:40px; height:40px; border-radius:50%; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all .25s cubic-bezier(.22,1,.36,1); }
    .gal-close:hover { background:rgba(255,255,255,.3); transform:rotate(90deg); }

    /* ===== RESPONSIVE ===== */
    @media(max-width:900px) {
      .page { padding:16px 16px 120px; }
      .prod-layout { grid-template-columns:1fr; gap:16px; padding:12px; }
      .prod-info { padding:0; margin-left:0; }
      .prod-gallery { flex-direction:column-reverse; gap:10px; position:static; }
      .prod-main-img { aspect-ratio:4/3; }
      .prod-thumbs { flex-direction:row; width:auto; overflow-x:auto; padding-bottom:4px; }
      .prod-thumb { width:64px; height:64px; }
      .sticky-bar { display:block; }
      /* El botón flotante del carrito sube para no tapar la barra inferior */
      #chat-fab.cart-fab { bottom:92px !important; }
      #chat-panel { bottom:164px !important; }
    }
    @media(max-width:480px) {
      .prod-title { font-size:1.45rem; }
      .prod-price { font-size:1.7rem; }
    }

    /* ===== ACCESIBILIDAD: respetar "reducir movimiento" ===== */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      *, *::before, *::after {
        animation-duration:.001ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.001ms !important;
      }
    }
  </style>
  <script src="/js/img-retry.js"></script>
</head>
<body>

  <!-- HEADER -->
  <header class="hdr">
    <div class="hdr-inner">
      <a href="/<%= biz.slug %>" class="hdr-back"><i class="bi bi-arrow-left"></i></a>
      <div class="hdr-brand">
        <h1><%= biz.name %></h1>
        <span><%= product.category_name || 'Producto' %></span>
      </div>
      
    </div>
  </header>

  <!-- MAIN -->
  <main class="page">
    <div class="prod-card">
      <div class="prod-layout">
        <!-- Galería: miniaturas a la izquierda + imagen principal -->
        <div class="prod-gallery">
          <% if (product.imgs.length > 1) { %>
            <div class="prod-thumbs">
              <% product.imgs.forEach(function(u, i) { %>
                <img src="<%= u %>" class="prod-thumb <%= i === 0 ? 'active' : '' %>" onclick="switchImg(this, '<%= u %>')" alt="img <%= i+1 %>" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'" />
              <% }) %>
            </div>
          <% } %>
          <img src="<%= product.imgs[0] || '/img/sin-imagen.svg' %>" id="prod-main-img" class="prod-main-img" alt="<%= product.name %>" onclick="openGalImg(this.src)" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'" />
        </div>

        <!-- Textos / descripción a la derecha -->
        <div class="prod-info">
        <div class="prod-cat"><%= product.category_name || 'General' %></div>
        <h1 class="prod-title"><%= product.name %></h1>
        
        <div class="prod-prices">
          <span class="prod-price" id="prod-price-main"><%= money(product.price) %></span>
          <% if (product.old_price && product.old_price > product.price) { %>
            <span class="prod-old"><%= money(product.old_price) %></span>
            <span class="prod-off">-<%= Math.round((1-product.price/product.old_price)*100) %>%</span>
          <% } %>
        </div>
        <p id="prod-stock-note" style="font-size:13px;font-weight:700;margin:4px 0 0;"></p>
        <% if (product.promo_desc) { %>
          <div style="display:flex;align-items:flex-start;gap:10px;margin-top:14px;padding:12px 14px;border-radius:14px;font-size:13px;font-weight:600;color:#b91c1c;background:linear-gradient(135deg,#fef2f2,#fff7ed);border:1px solid rgba(239,68,68,.22);line-height:1.45;">
            <span style="flex-shrink:0;width:28px;height:28px;border-radius:9px;background:#ef4444;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;"><i class="bi bi-tag-fill"></i></span>
            <span style="padding-top:4px;"><b>Promoción:</b> <%= product.promo_desc %></span>
          </div>
        <% } %>

        <% if (product.allow_installments) { 
          var instCount = product.installment_count || 6;
          var instUnit = (product.price / instCount).toFixed(2);
          var freqLabel = {semanal:'semana', quincenal:'quincenas', mensual:'mes'}[product.installment_frequency] || 'semana';
        %>
          <div style="margin-top:16px;background:linear-gradient(135deg,rgba(16,185,129,.08),rgba(16,185,129,.03));border:1px solid rgba(16,185,129,.2);border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:12px;">
            <span style="flex-shrink:0;width:38px;height:38px;border-radius:12px;background:rgba(16,185,129,.15);display:flex;align-items:center;justify-content:center;color:#059669;font-size:18px;"><i class="bi bi-credit-card"></i></span>
            <div style="min-width:0;">
              <p style="font-size:11px;font-weight:800;color:#059669;text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px;">Opci&oacute;n de abonos</p>
              <p style="font-size:14px;color:var(--text);"><b style="font-size:16px;"><%= money(instUnit) %></b> / <%= freqLabel %> · <%= instCount %> abonos en total</p>
              <% if (product.installment_min_down > 0) { %>
                <p style="font-size:11px;color:var(--text-sec);margin-top:3px;">Enganche m&iacute;nimo: <%= money(product.installment_min_down) %></p>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if (product.description) { %>
          <p class="prod-desc"><%= product.description %></p>
        <% } %>

        <!-- Tags -->
        <% if (product.tags) { %>
          <div class="tags">
            <% product.tags.split(',').forEach(function(t) { t = t.trim(); if (t) { %>
              <span class="tag"><%= t %></span>
            <% } }) %>
          </div>
        <% } %>

        <!-- Specs -->
        <% var specsLines = (product.specs || '').split('\n').map(function(s){ return s.trim(); }).filter(function(s){ return s.indexOf(':') > -1; }); %>
        <% if (specsLines.length) { %>
          <div class="specs-wrap">
            <div class="specs-title"><i class="bi bi-list-check"></i> Características</div>
            <dl>
              <% specsLines.forEach(function(line) { var idx = line.indexOf(':'); var k = line.slice(0, idx).trim(); var v = line.slice(idx+1).trim(); %>
                <div class="specs-row">
                  <dt class="specs-key"><%= k %></dt>
                  <dd class="specs-val"><%= v %></dd>
                </div>
              <% }) %>
            </dl>
          </div>
        <% } %>

        <!-- Variants -->
        <div id="prod-variants" style="margin-top:16px;"></div>

        <!-- Actions -->
        <div class="actions">
          <button class="btn-add" style="flex:1;" onclick="addProductToCart()"><i class="bi bi-bag-plus"></i> Agregar al carrito</button>
        </div>

        <a href="/<%= biz.slug %>" class="back-link"><i class="bi bi-grid-3x3-gap"></i> Ver todo el catálogo</a>
        </div>
      </div>
    </div>

    <!-- Relacionados (abajo) -->
    <% if (related.length) { %>
      <section class="related-section">
        <div class="sidebar-title"><i class="bi bi-grid-3x2"></i> Relacionados</div>
        <div class="related-grid">
          <% related.forEach(function(r) { %>
            <a href="/<%= biz.slug %>/p/<%= r.id %>" class="related-card">
              <img src="<%= r.image || '/img/sin-imagen.svg' %>" class="related-img" alt="<%= r.name %>" loading="lazy" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'" />
              <div class="related-name"><%= r.name %></div>
              <div class="related-price"><%= money(r.price) %></div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <!-- Sticky bar mobile -->
  <div class="sticky-bar">
    <div class="sticky-bar-inner">
      <div style="min-width:0;">
        <% if (product.old_price && product.old_price > product.price) { %><p style="font-size:12px;color:var(--text-sec);text-decoration:line-through;white-space:nowrap;"><%= money(product.old_price) %> <span style="background:#ef4444;color:#fff;font-size:10px;font-weight:800;padding:1px 7px;border-radius:6px;margin-left:2px;text-decoration:none;display:inline-block;">-<%= Math.round((1-product.price/product.old_price)*100) %>%</span></p><% } %>
        <p class="sticky-price" id="sticky-price"><%= money(product.price) %></p>
      </div>
      <button class="btn-add" style="flex:1;" onclick="addProductToCart()"><i class="bi bi-bag-plus"></i> Agregar</button>
    </div>
  </div>

  <!-- Gallery overlay -->
  <div class="gal-overlay" id="galOverlay" onclick="closeGal()">
    <button class="gal-close" onclick="closeGal()"><i class="bi bi-x-lg"></i></button>
    <img id="galImg" src="" />
  </div>

  <script>
    function switchImg(thumb, src) {
      document.getElementById('prod-main-img').src = src;
      document.querySelectorAll('.prod-thumb').forEach(function(t){ t.classList.remove('active'); });
      thumb.classList.add('active');
    }
    function openGalImg(src) {
      document.getElementById('galImg').src = src;
      document.getElementById('galOverlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeGal() {
      document.getElementById('galOverlay').classList.remove('show');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeGal(); });
  </script>

  <%- include('partials/cart-js', { biz, products: [product], currencySymbol: typeof currencySymbol !== 'undefined' ? currencySymbol : '$' }) %>

  <script>
    (function () {
      var PROD_ID = <%- product.id %>;
      var PROD_STOCK = <%- (product.displayStock === null || product.displayStock === undefined) ? 'null' : product.displayStock %>;
      var vm = { attrs: [], images: {} };
      try { var d = JSON.parse(<%- JSON.stringify(product.variants || '') %>); if (d && d.attrs) vm = d; } catch (e) {}
      var sel = {};
      function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
      function colorFor(v) { var map={rojo:'#ef4444',azul:'#3b82f6',verde:'#22c55e',amarillo:'#eab308',negro:'#111827',blanco:'#f8fafc',gris:'#9ca3af',rosa:'#ec4899',morado:'#8b5cf6',naranja:'#f97316',cafe:'#8b5e3c'}; return map[String(v).toLowerCase().trim()] || '#94a3b8'; }
      function comboKey() { return vm.attrs.map(function(a){ return sel[a.name]||''; }).join('|'); }
      function render() {
        var box = document.getElementById('prod-variants');
        if (!box || !vm.attrs.length) {
          if (box) box.innerHTML = '';
          updatePrice(); updateImage(); updateStockNote();
          return;
        }
        box.innerHTML = '';
        vm.attrs.forEach(function(a) {
          var isColor = /color/i.test(a.name);
          var wrap = document.createElement('div');
          wrap.style.marginBottom = '14px';
          wrap.innerHTML = '<p style="font-size:12px;font-weight:700;color:var(--text-sec);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;">'+esc(a.name)+'</p>';
          var row = document.createElement('div');
          row.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;';
          a.values.forEach(function(v) {
            var b = document.createElement('button');
            b.type='button';
            if (isColor) {
              b.style.cssText = 'padding:2px;border-radius:50%;border:2px solid '+(sel[a.name]===v?'var(--accent)':'transparent')+';cursor:pointer;transition:border .2s;';
              b.innerHTML = '<span style="display:block;width:32px;height:32px;border-radius:50%;border:1px solid rgba(0,0,0,.1);background:'+colorFor(v)+'"></span>';
              b.title = v;
            } else {
              var active = sel[a.name]===v;
              b.style.cssText = 'padding:8px 16px;border-radius:99px;font-size:13px;font-weight:600;border:1px solid '+(active?'var(--accent)':'var(--border)')+';background:'+(active?'var(--accent)':'var(--bg-card)')+';color:'+(active?'#fff':'var(--text)')+';cursor:pointer;transition:all .2s;';
              b.textContent = v;
            }
            b.onclick = function(){ sel[a.name]=v; render(); };
            row.appendChild(b);
          });
          wrap.appendChild(row);
          box.appendChild(wrap);
        });
        updatePrice();
        updateImage();
        updateStockNote();
      }
      // Cuántas piezas quedan — del total del producto, o de la combinación
      // elegida si es "con variantes" (cada una tiene su propio stock).
      function updateStockNote() {
        var el = document.getElementById('prod-stock-note');
        if (!el) return;
        var stock;
        if (vm.attrs.length) {
          var key = comboKey();
          var complete = vm.attrs.every(function (a) { return sel[a.name]; });
          if (!complete) { el.textContent = ''; return; }
          var st = vm.stock && vm.stock[key];
          stock = (st === undefined || st === '') ? null : Number(st);
        } else {
          stock = PROD_STOCK;
        }
        if (stock === null || stock === undefined) { el.textContent = ''; return; }
        if (stock <= 0) { el.textContent = 'Agotado'; el.style.color = '#ef4444'; }
        else if (stock <= 5) { el.textContent = '🔥 ¡Quedan ' + stock + '!'; el.style.color = '#ea580c'; }
        else { el.textContent = stock + ' disponibles'; el.style.color = 'var(--text-sec)'; }
      }
      function fmtMoney(n) { return n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
      function updatePrice() {
        var key = comboKey();
        var price = (vm.prices && vm.prices[key] !== undefined && vm.prices[key] !== '') ? Number(vm.prices[key]) : <%- product.price %>;
        var pe = document.getElementById('sticky-price');
        if (pe) pe.textContent = '$' + fmtMoney(price);
        var pm = document.getElementById('prod-price-main');
        if (pm) pm.textContent = '$' + fmtMoney(price);
      }
      // Al elegir Talla/Color, si esa combinación tiene su propia foto, la
      // vista principal cambia a esa — antes se quedaba pegada en la foto
      // general del producto sin importar qué variante se eligiera.
      function updateImage() {
        var key = comboKey();
        var img = (vm.images && vm.images[key]) ? vm.images[key] : '';
        if (!img) return;
        var main = document.getElementById('prod-main-img');
        if (main) main.src = img;
        document.querySelectorAll('.prod-thumb').forEach(function (t) {
          t.classList.toggle('active', t.getAttribute('src') === img);
        });
      }
      window.addProductToCart = function() {
        var complete = !vm.attrs.length || vm.attrs.every(function(a){ return sel[a.name]; });
        if (!complete) { addToCart(PROD_ID); return; }
        var label = vm.attrs.map(function(a){ return sel[a.name]; }).filter(Boolean).join(' / ');
        var key = comboKey();
        var img = (vm.images && vm.images[key]) || null;
        var price = (vm.prices && vm.prices[key]) ? Number(vm.prices[key]) : <%- product.price %>;
        addToCart(PROD_ID, undefined, price, label || undefined, undefined, img || undefined);
      };
      render();
    })();
  </script>
</body>
</html>
