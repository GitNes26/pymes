<%
  var _T = (typeof catDesignTokens !== 'undefined' && catDesignTokens) ? catDesignTokens : { bg:'#f8f6f2', card:'#ffffff', text:'#1e1b1a', textSec:'#6b6562', accent:'#1a3c5e', accentLight:'#4a7a9c', accentGlow:'#c9a86c', border:'rgba(26,60,94,.08)', radius:18, shadow:'0 8px 32px rgba(0,0,0,.06)', font:{ heading:"'Playfair Display', serif", body:"'Inter', sans-serif", href:'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap' } };
  var _dsg = (typeof catDesign !== 'undefined' && catDesign) ? catDesign : 'catalogo';
  function _lum(hex) {
    var h = String(hex || '').replace('#', '');
    if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
    if (!/^[0-9a-f]{6}$/i.test(h)) return 0.2;
    var c = [0, 2, 4].map(function (i) { var v = parseInt(h.substr(i, 2), 16) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); });
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  }
  var _onAccent = _lum(_T.accent) > 0.42 ? '#161513' : '#ffffff';
  var _bgDark = _lum(_T.bg) < 0.18;
  var _waNum = biz.whatsapp ? (String(biz.whatsapp).replace(/\D/g, '').length === 10 ? '52' + String(biz.whatsapp).replace(/\D/g, '') : String(biz.whatsapp).replace(/\D/g, '')) : '';
  var _hasOld = product.old_price && product.old_price > product.price;
%><!DOCTYPE html>
<html lang="es" data-style="<%= _dsg %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="<%= _T.accent %>" />
  <title><%= product.name %> · <%= biz.name %></title>
  <meta name="description" content="<%= (product.description || (biz.name + ': ' + product.name)).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <meta property="og:type" content="product" />
  <meta property="og:title" content="<%= product.name %> — <%= money(product.price) %>" />
  <meta property="og:description" content="<%= (product.description || 'Disponible en ' + biz.name).slice(0, 160).replace(/"/g, '&quot;') %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:url" content="<%= ogUrl %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= product.name %> — <%= money(product.price) %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="<%= _T.font.href %>" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <style>
    /* Mismos tokens que el catálogo: la ficha del producto toma la apariencia de la tienda */
    :root {
      --bg: <%- _T.bg %>;
      --bg-card: <%- _T.card %>;
      --text: <%- _T.text %>;
      --text-sec: <%- _T.textSec %>;
      --text-secondary: <%- _T.textSec %>;
      --accent: <%- _T.accent %>;
      --accent-light: <%- _T.accentLight %>;
      --accent-glow: <%- _T.accentGlow %>;
      --border: <%- _T.border %>;
      --shadow: <%- _T.shadow %>;
      --radius: <%- _T.radius %>px;
      --font-heading: <%- _T.font.heading %>;
      --font-body: <%- _T.font.body %>;
      --on-accent: <%- _onAccent %>;
      --line: color-mix(in srgb, var(--text) 14%, transparent);
      --soft: color-mix(in srgb, var(--text) 5%, var(--bg-card));
      --offer: #b5461c;
      color-scheme: <%- _bgDark ? 'dark' : 'light' %>;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:var(--font-body); background:var(--bg); color:var(--text); min-height:100vh; -webkit-font-smoothing:antialiased; line-height:1.5; }
    h1,h2,h3 { font-family:var(--font-heading); font-weight:700; letter-spacing:-.01em; }
    a { color:inherit; text-decoration:none; }
    button { font-family:inherit; }
    :focus-visible { outline:2px solid var(--accent); outline-offset:2px; }

    /* ===== CABECERA ===== */
    .hdr { position:sticky; top:0; z-index:50; background:color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter:blur(16px); border-bottom:1px solid var(--border); }
    .hdr-inner { display:flex; align-items:center; gap:12px; padding:10px 24px; max-width:1200px; margin:0 auto; min-height:64px; }
    .hdr-back { width:44px; height:44px; flex:none; border-radius:calc(var(--radius) * .6); background:var(--bg-card); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--text); font-size:17px; transition:border-color .2s, transform .2s; }
    .hdr-back:hover { border-color:var(--accent); transform:translateX(-2px); }
    .hdr-logo { width:40px; height:40px; flex:none; border-radius:50%; object-fit:contain; background:var(--bg-card); border:1px solid var(--border); }
    .hdr-brand { flex:1; min-width:0; }
    .hdr-brand b { display:block; font-family:var(--font-heading); font-size:1.05rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hdr-brand span { display:block; font-size:12px; color:var(--text-sec); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hdr-shop { flex:none; display:inline-flex; align-items:center; gap:6px; min-height:44px; padding:0 16px; border-radius:calc(var(--radius) * .6); border:1px solid var(--line); background:var(--bg-card); font-size:13px; font-weight:600; transition:border-color .2s; }
    .hdr-shop:hover { border-color:var(--accent); }

    /* ===== LAYOUT ===== */
    .page { max-width:1200px; margin:0 auto; padding:20px 24px 120px; }
    .crumbs { display:flex; align-items:center; flex-wrap:wrap; gap:6px; font-size:12.5px; color:var(--text-sec); margin-bottom:18px; }
    .crumbs a:hover { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
    .crumbs i { font-size:10px; opacity:.6; }
    .crumbs .cur { color:var(--text); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:42ch; }
    .prod-layout { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(0,1fr); gap:clamp(28px,4.5vw,64px); align-items:start; }

    /* ===== GALERÍA ===== */
    .prod-gallery { position:sticky; top:88px; min-width:0; }
    .prod-stage { position:relative; border-radius:var(--radius); overflow:hidden; background:var(--soft); border:1px solid var(--border); }
    .prod-main-img { width:100%; aspect-ratio:1; object-fit:cover; display:block; cursor:zoom-in; }
    .prod-zoom { position:absolute; right:12px; bottom:12px; width:44px; height:44px; border-radius:50%; border:1px solid var(--line); background:color-mix(in srgb, var(--bg-card) 90%, transparent); color:var(--text); display:flex; align-items:center; justify-content:center; font-size:17px; cursor:pointer; }
    .prod-badge { position:absolute; left:12px; top:12px; background:var(--offer); color:#fff; font-size:12px; font-weight:800; padding:5px 12px; border-radius:99px; letter-spacing:.02em; }
    .prod-thumbs { display:flex; gap:10px; margin-top:12px; overflow-x:auto; scrollbar-width:none; padding-bottom:2px; }
    .prod-thumbs::-webkit-scrollbar { display:none; }
    .prod-thumb { width:72px; height:72px; flex:none; border-radius:calc(var(--radius) * .55); object-fit:cover; cursor:pointer; border:2px solid transparent; outline:1px solid var(--border); transition:border-color .2s, opacity .2s; opacity:.72; background:var(--soft); }
    .prod-thumb:hover { opacity:1; }
    .prod-thumb.active { border-color:var(--accent); opacity:1; }

    /* ===== INFORMACIÓN ===== */
    .prod-info { min-width:0; }
    .prod-cat { display:inline-block; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:var(--accent); }
    .prod-title { font-size:clamp(1.7rem,3.2vw,2.35rem); margin-top:8px; line-height:1.12; overflow-wrap:anywhere; text-wrap:balance; }
    .prod-prices { display:flex; align-items:baseline; flex-wrap:wrap; gap:6px 12px; margin-top:16px; padding-bottom:18px; border-bottom:1px solid var(--line); }
    .prod-price { font-family:var(--font-heading); font-size:clamp(1.9rem,3.4vw,2.4rem); font-weight:700; color:var(--accent); line-height:1; }
    .prod-old { font-size:16px; color:var(--text-sec); text-decoration:line-through; }
    .prod-off { background:var(--offer); color:#fff; font-size:11.5px; font-weight:800; padding:3px 10px; border-radius:99px; align-self:center; }
    .prod-stock { font-size:13px; font-weight:700; margin-top:12px; min-height:0; }
    .prod-stock:empty { display:none; }
    .prod-desc { font-size:15px; color:var(--text-sec); margin-top:16px; line-height:1.75; white-space:pre-line; overflow-wrap:anywhere; }

    .note { display:flex; align-items:flex-start; gap:12px; margin-top:16px; padding:13px 15px; border:1px solid var(--line); border-left:3px solid var(--accent); border-radius:calc(var(--radius) * .6); background:var(--soft); font-size:13.5px; line-height:1.5; }
    .note > i { flex:none; font-size:17px; color:var(--accent); margin-top:1px; }
    .note.offer { border-left-color:var(--offer); } .note.offer > i { color:var(--offer); }
    .note b { font-weight:700; }
    .note small { display:block; color:var(--text-sec); font-size:12px; margin-top:2px; }

    .opt-label { font-size:11.5px; font-weight:700; color:var(--text-sec); margin-bottom:8px; text-transform:uppercase; letter-spacing:.08em; }
    #prod-variants { margin-top:20px; }

    .tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:16px; }
    .tag { padding:4px 12px; border-radius:99px; font-size:12px; font-weight:600; background:var(--soft); color:var(--text-sec); border:1px solid var(--border); }

    /* ===== ACCIONES ===== */
    .actions { display:flex; flex-direction:column; gap:10px; margin-top:24px; }
    .btn-add { display:flex; align-items:center; justify-content:center; gap:9px; min-height:52px; padding:0 22px; background:var(--accent); color:var(--on-accent); border:1px solid var(--accent); border-radius:calc(var(--radius) * .6); font-weight:700; font-size:15px; cursor:pointer; transition:transform .2s, box-shadow .2s, background .2s; }
    .btn-add:hover { background:var(--accent-light); border-color:var(--accent-light); transform:translateY(-1px); }
    .btn-add:active { transform:scale(.98); }
    .btn-wa { display:flex; align-items:center; justify-content:center; gap:9px; min-height:48px; padding:0 20px; background:transparent; color:var(--text); border:1px solid var(--line); border-radius:calc(var(--radius) * .6); font-weight:600; font-size:14px; transition:border-color .2s, background .2s; }
    .btn-wa i { color:#1faa54; font-size:18px; }
    .btn-wa:hover { border-color:var(--accent); background:var(--soft); }
    .trust { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:18px; font-size:12.5px; color:var(--text-sec); }
    .trust span { display:inline-flex; align-items:center; gap:6px; }
    .trust i { color:var(--accent); font-size:15px; }

    /* ===== DETALLES ===== */
    .specs-wrap { margin-top:26px; border-top:1px solid var(--line); padding-top:18px; }
    .specs-title { font-family:var(--font-heading); font-size:1.05rem; font-weight:700; margin-bottom:8px; display:flex; align-items:center; gap:8px; }
    .specs-title i { color:var(--accent); }
    .specs-row { display:flex; gap:14px; padding:11px 0; border-bottom:1px solid var(--border); font-size:14px; }
    .specs-row:last-child { border-bottom:none; }
    .specs-key { width:38%; max-width:170px; flex:none; color:var(--text-sec); }
    .specs-val { color:var(--text); font-weight:500; overflow-wrap:anywhere; }

    /* ===== RELACIONADOS ===== */
    .related-section { margin-top:64px; }
    .sec-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--line); }
    .sec-head h2 { font-size:clamp(1.15rem,2vw,1.45rem); }
    .sec-head a { font-size:13px; font-weight:600; color:var(--accent); white-space:nowrap; }
    .sec-head a:hover { text-decoration:underline; text-underline-offset:3px; }
    .related-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:18px; }
    .related-card { display:flex; flex-direction:column; min-width:0; border-radius:var(--radius); border:1px solid var(--border); background:var(--bg-card); overflow:hidden; transition:transform .25s, box-shadow .25s, border-color .25s; }
    .related-card:hover { transform:translateY(-3px); box-shadow:var(--shadow); border-color:var(--line); }
    .related-img { width:100%; aspect-ratio:1; object-fit:cover; display:block; background:var(--soft); }
    .related-body { padding:12px 14px 14px; }
    .related-name { font-size:14px; font-weight:600; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:2.6em; }
    .related-price { font-family:var(--font-heading); font-size:1.1rem; font-weight:700; color:var(--accent); margin-top:6px; }

    .foot { max-width:1200px; margin:0 auto; padding:0 24px 40px; text-align:center; font-size:12.5px; color:var(--text-sec); }
    .foot a { color:var(--accent); font-weight:600; }

    /* ===== BARRA INFERIOR (móvil) ===== */
    .sticky-bar { display:none; position:fixed; bottom:0; left:0; right:0; z-index:50; background:color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter:blur(16px); border-top:1px solid var(--line); padding:10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); }
    .sticky-bar-inner { display:flex; align-items:center; gap:14px; max-width:1200px; margin:0 auto; }
    .sticky-price { font-family:var(--font-heading); font-size:1.4rem; font-weight:700; color:var(--accent); line-height:1.1; }
    .sticky-bar .btn-add { flex:1; }

    /* ===== VISOR DE IMAGEN ===== */
    .gal-overlay { display:flex; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,.9); backdrop-filter:blur(8px); align-items:center; justify-content:center; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .25s, visibility .25s; }
    .gal-overlay.show { opacity:1; visibility:visible; pointer-events:auto; }
    .gal-overlay img { max-width:92vw; max-height:84vh; object-fit:contain; border-radius:calc(var(--radius) * .5); transform:scale(.95); transition:transform .3s; }
    .gal-overlay.show img { transform:scale(1); }
    .gal-close { position:absolute; top:16px; right:16px; background:rgba(255,255,255,.16); border:none; color:#fff; width:44px; height:44px; border-radius:50%; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; }

    /* ===== RESPONSIVE ===== */
    @media(max-width:900px) {
      .hdr-inner { padding:8px 16px; min-height:60px; }
      .hdr-shop span { display:none; } .hdr-shop { padding:0; width:44px; justify-content:center; }
      .page { padding:14px 16px 120px; }
      .crumbs { margin-bottom:12px; }
      .prod-layout { grid-template-columns:1fr; gap:20px; }
      .prod-gallery { position:static; }
      .prod-main-img { aspect-ratio:1; }
      .prod-thumb { width:60px; height:60px; }
      .actions .btn-add { display:none; }
      .sticky-bar { display:block; }
      .related-section { margin-top:44px; }
      .related-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
      .foot { padding-bottom:110px; }
      /* El botón flotante del carrito sube para no tapar la barra inferior */
      #chat-fab.cart-fab { bottom:92px !important; }
      #chat-panel { bottom:164px !important; }
    }
    @media(max-width:480px) { .specs-key { width:42%; } }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      *, *::before, *::after { animation-duration:.001ms !important; transition-duration:.001ms !important; }
    }
  </style>
  <link rel="stylesheet" href="/css/catalog-motion.css?v=20260919a">
  <link rel="stylesheet" href="/css/catalog-media.css?v=20260920k">
  <script src="/js/img-retry.js"></script>
  <script src="/js/catalog-motion.js?v=20260920a" defer></script>
  <script src="/js/btn-fit.js?v=20260920a" defer></script>
</head>
<body>

  <header class="hdr">
    <div class="hdr-inner">
      <a href="/<%= biz.slug %>" class="hdr-back" aria-label="Volver al catálogo"><i class="bi bi-arrow-left"></i></a>
      <% if (biz.logo) { %><img src="<%= biz.logo %>" class="hdr-logo" alt="" data-hide-on-error><% } %>
      <div class="hdr-brand">
        <b><%= biz.name %></b>
        <span><%= product.category_name || 'Catálogo' %></span>
      </div>
      <a href="/<%= biz.slug %>" class="hdr-shop"><i class="bi bi-grid-3x3-gap"></i><span>Ver catálogo</span></a>
    </div>
  </header>

  <main class="page">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/<%= biz.slug %>">Catálogo</a><i class="bi bi-chevron-right"></i>
      <% if (product.category_name) { %><span><%= product.category_name %></span><i class="bi bi-chevron-right"></i><% } %>
      <span class="cur"><%= product.name %></span>
    </nav>

    <div class="prod-layout">
      <!-- Galería -->
      <div class="prod-gallery">
        <div class="prod-stage" id="prod-stage" style="--ph:url(<%- encodeURI(product.imgs[0] || '').replace(/[()']/g, function (c) { return '%' + c.charCodeAt(0).toString(16); }) %>)">
          <% if (_hasOld) { %><span class="prod-badge">-<%= Math.round((1-product.price/product.old_price)*100) %>%</span><% } %>
          <img src="<%= product.imgs[0] || '/img/sin-imagen.svg' %>" id="prod-main-img" class="prod-main-img" alt="<%= product.name %>" fetchpriority="high" onclick="openGalImg(this.src)" />
          <button type="button" class="prod-zoom" aria-label="Ampliar imagen" onclick="openGalImg(document.getElementById('prod-main-img').src)"><i class="bi bi-arrows-fullscreen"></i></button>
        </div>
        <% if (product.imgs.length > 1) { %>
          <div class="prod-thumbs">
            <% product.imgs.forEach(function(u, i) { %>
              <img src="<%= u %>" class="prod-thumb <%= i === 0 ? 'active' : '' %>" onclick="switchImg(this, '<%= u %>')" alt="Foto <%= i+1 %>" />
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Información -->
      <div class="prod-info">
        <span class="prod-cat"><%= product.category_name || 'General' %></span>
        <% var _gx = {}; try { _gx = JSON.parse(biz.extras || '{}') || {}; } catch (e) { _gx = {}; }
           var _own = Array.isArray(product.customTags) ? product.customTags : [], _seen = {}, _allTags = [];
           _own.concat(Array.isArray(_gx.globalTags) ? _gx.globalTags : []).forEach(function (t) { if (t && t.t) { var k = String(t.t).toLowerCase(); if (!_seen[k]) { _seen[k] = 1; _allTags.push(t); } } });
           product.customTags = _allTags.slice(0, 4); %>
        <% if (product.customTags && product.customTags.length) { %><div class="prod-tags"><% product.customTags.forEach(function (t) { var _h = String(t.c || '#2c2c2e').replace('#', ''); var _lum = (parseInt(_h.substr(0, 2), 16) * 0.299 + parseInt(_h.substr(2, 2), 16) * 0.587 + parseInt(_h.substr(4, 2), 16) * 0.114); %><span class="prod-tag-custom" style="background:<%= t.c %>;color:<%= _lum > 160 ? '#161513' : '#fff' %>"><%= t.t %></span><% }) %></div><% } %>
        <h1 class="prod-title"><%= product.name %></h1>

        <div class="prod-prices">
          <span class="prod-price" id="prod-price-main"><%= money(product.price) %></span><% if (product.unit && product.unit !== 'pieza') { %><span class="prod-unit" style="font-size:.95rem;color:var(--text-sec)"> / <%= product.unit %></span><% } %>
          <% if (_hasOld) { %>
            <span class="prod-old"><%= money(product.old_price) %></span>
            <span class="prod-off">Ahorras <%= money(product.old_price - product.price) %></span>
          <% } %>
        </div>
        <p class="prod-stock" id="prod-stock-note"></p>

        <% if (product.promo_desc) { %>
          <div class="note offer"><i class="bi bi-tag-fill"></i><span><b>Promoción:</b> <%= product.promo_desc %></span></div>
        <% } %>

        <% if (product.allow_installments) {
          var instCount = product.installment_count || 6;
          var instUnit = (product.price / instCount).toFixed(2);
          var freqLabel = {semanal:'semana', quincenal:'quincena', mensual:'mes'}[product.installment_frequency] || 'semana';
        %>
          <div class="note">
            <i class="bi bi-credit-card"></i>
            <span><b><%= money(instUnit) %></b> por <%= freqLabel %> · <%= instCount %> abonos
              <% if (product.installment_min_down > 0) { %><small>Enganche mínimo: <%= money(product.installment_min_down) %></small><% } %>
            </span>
          </div>
        <% } %>

        <% if (product.description) { %><p class="prod-desc"><%= product.description %></p><% } %>

        <% if (product.tags) { %>
          <div class="tags">
            <% product.tags.split(',').forEach(function(t) { t = t.trim(); if (t) { %><span class="tag"><%= t %></span><% } }) %>
          </div>
        <% } %>

        <!-- Variantes -->
        <div id="prod-variants"></div>

        <!-- Acciones -->
        <div class="actions">
          <button class="btn-add" onclick="addProductToCart()"><i class="bi bi-bag-plus"></i> Agregar al carrito</button>
          <% if (_waNum) { %>
            <a class="btn-wa" target="_blank" rel="noopener" href="https://wa.me/<%= _waNum %>?text=<%= encodeURIComponent('Hola, me interesa: ' + product.name + ' (' + ogUrl + ')') %>"><i class="bi bi-whatsapp"></i> Preguntar por WhatsApp</a>
          <% } %>
        </div>
        <div class="trust">
          <span><i class="bi bi-shield-check"></i> Compra directa con la tienda</span>
          <% if (biz.address) { %><span><i class="bi bi-geo-alt"></i> Recoge en tienda</span><% } %>
        </div>

        <!-- Características -->
        <% var specsLines = (product.specs || '').split('\n').map(function(s){ return s.trim(); }).filter(function(s){ return s.indexOf(':') > -1; }); %>
        <% if (specsLines.length) { %>
          <div class="specs-wrap">
            <div class="specs-title"><i class="bi bi-list-check"></i> Características</div>
            <dl>
              <% specsLines.forEach(function(line) { var idx = line.indexOf(':'); var k = line.slice(0, idx).trim(); var v = line.slice(idx+1).trim(); %>
                <div class="specs-row"><dt class="specs-key"><%= k %></dt><dd class="specs-val"><%= v %></dd></div>
              <% }) %>
            </dl>
          </div>
        <% } %>
      </div>
    </div>

    <% if (related.length) { %>
      <section class="related-section">
        <div class="sec-head"><h2>También te puede interesar</h2><a href="/<%= biz.slug %>">Ver todo →</a></div>
        <div class="related-grid">
          <% related.forEach(function(r) { %>
            <a href="/<%= biz.slug %>/p/<%= r.id %>" class="related-card">
              <img src="<%= r.image || '/img/sin-imagen.svg' %>" class="related-img" alt="<%= r.name %>" loading="lazy" decoding="async" />
              <div class="related-body">
                <div class="related-name"><%= r.name %></div>
                <div class="related-price"><%= money(r.price) %></div>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <div class="foot"><a href="/<%= biz.slug %>"><%= biz.name %></a> · Catálogo digital</div>

  <!-- Barra inferior móvil -->
  <div class="sticky-bar">
    <div class="sticky-bar-inner">
      <div style="min-width:0;">
        <% if (_hasOld) { %><p style="font-size:12px;color:var(--text-sec);text-decoration:line-through;white-space:nowrap;"><%= money(product.old_price) %></p><% } %>
        <p class="sticky-price" id="sticky-price"><%= money(product.price) %></p>
      </div>
      <button class="btn-add" onclick="addProductToCart()"><i class="bi bi-bag-plus"></i> Agregar</button>
    </div>
  </div>

  <!-- Visor -->
  <div class="gal-overlay" id="galOverlay" onclick="closeGal()">
    <button class="gal-close" aria-label="Cerrar" onclick="closeGal()"><i class="bi bi-x-lg"></i></button>
    <img id="galImg" src="" alt="" />
  </div>

  <script>
    // Deslizar la foto principal cambia a la anterior/siguiente (modelos, otros ángulos)
    (function () {
      var st = document.getElementById('prod-stage'), x0 = 0, y0 = 0;
      if (!st) return;
      st.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      st.addEventListener('touchend', function (e) {
        var t = e.changedTouches[0], dx = t.clientX - x0, dy = t.clientY - y0;
        if (Math.abs(dx) < 34 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
        var th = [].slice.call(document.querySelectorAll('.prod-thumb'));
        if (th.length < 2) return;
        var cur = th.findIndex(function (x) { return x.classList.contains('active'); });
        var nx = (cur + (dx < 0 ? 1 : -1) + th.length) % th.length;
        th[nx].click();
        th[nx].scrollIntoView({ block: 'nearest', inline: 'center' });
      }, { passive: true });
    })();
    function setStageBg(src) {
      var st = document.getElementById('prod-stage');
      if (st && src) st.style.setProperty('--ph', 'url(' + encodeURI(src).replace(/[()']/g, function (c) { return '%' + c.charCodeAt(0).toString(16); }) + ')');
    }
    function switchImg(thumb, src) {
      setStageBg(src);
      document.getElementById('prod-main-img').src = src;
      document.querySelectorAll('.prod-thumb').forEach(function(t){ t.classList.remove('active'); });
      thumb.classList.add('active');
    }
    function openGalImg(src) {
      document.getElementById('galImg').src = src;
      document.getElementById('galOverlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeGal() {
      document.getElementById('galOverlay').classList.remove('show');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeGal(); });
  </script>

  <%- include('partials/cart-js', { biz, products: [product], currencySymbol: typeof currencySymbol !== 'undefined' ? currencySymbol : '$' }) %>

  <script>
    (function () {
      var PROD_ID = <%- product.id %>;
      var PROD_HIDE_STOCK = <%= product.hideStock ? 'true' : 'false' %>;
      var PROD_UNIT = <%- JSON.stringify((product.unit && product.unit !== 'pieza') ? ' ' + product.unit : '') %>;
      var PROD_STOCK = <%- (product.displayStock === null || product.displayStock === undefined) ? 'null' : product.displayStock %>;
      var PROD_MADE_TO_ORDER = <%= product.made_to_order ? 'true' : 'false' %>;
      var CUR = <%- JSON.stringify(typeof currencySymbol !== 'undefined' ? currencySymbol : '$') %>;
      var vm = { attrs: [], images: {} };
      try { var d = JSON.parse(<%- JSON.stringify(product.variants || '') %>); if (d && d.attrs) vm = d; } catch (e) {}
      var sel = {};
      function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
      function colorFor(v) { var map={rojo:'#ef4444',azul:'#3b82f6',verde:'#22c55e',amarillo:'#eab308',negro:'#111827',blanco:'#f8fafc',gris:'#9ca3af',rosa:'#ec4899',morado:'#8b5cf6',naranja:'#f97316',cafe:'#8b5e3c'}; return map[String(v).toLowerCase().trim()] || '#94a3b8'; }
      function comboKey() { return vm.attrs.map(function(a){ return sel[a.name]||''; }).join('|'); }
      function render() {
        var box = document.getElementById('prod-variants');
        if (!box || !vm.attrs.length) {
          if (box) box.innerHTML = '';
          updatePrice(); updateImage(); updateStockNote();
          return;
        }
        box.innerHTML = '';
        vm.attrs.forEach(function(a) {
          var isColor = /color/i.test(a.name);
          var wrap = document.createElement('div');
          wrap.style.marginBottom = '14px';
          wrap.innerHTML = '<p class="opt-label">'+esc(a.name)+'</p>';
          var row = document.createElement('div');
          row.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;';
          a.values.forEach(function(v) {
            var b = document.createElement('button');
            b.type='button';
            if (isColor) {
              b.style.cssText = 'padding:2px;border-radius:50%;border:2px solid '+(sel[a.name]===v?'var(--accent)':'transparent')+';cursor:pointer;transition:border .2s;';
              b.innerHTML = '<span style="display:block;width:32px;height:32px;border-radius:50%;border:1px solid rgba(0,0,0,.1);background:'+colorFor(v)+'"></span>';
              b.title = v;
            } else {
              var active = sel[a.name]===v;
              b.style.cssText = 'min-height:44px;padding:0 18px;border-radius:99px;font-size:14px;font-weight:600;border:1px solid '+(active?'var(--accent)':'var(--line)')+';background:'+(active?'var(--accent)':'var(--bg-card)')+';color:'+(active?'var(--on-accent)':'var(--text)')+';cursor:pointer;transition:all .2s;';
              b.textContent = v;
            }
            b.onclick = function(){ sel[a.name]=v; render(); };
            row.appendChild(b);
          });
          wrap.appendChild(row);
          box.appendChild(wrap);
        });
        updatePrice();
        updateImage();
        updateStockNote();
      }
      // Cuántas piezas quedan — del total del producto, o de la combinación
      // elegida si es "con variantes" (cada una tiene su propio stock).
      function updateStockNote() {
        var el = document.getElementById('prod-stock-note');
        if (!el) return;
        if (PROD_MADE_TO_ORDER) { el.textContent = 'Disponible por pedido'; el.style.color = 'var(--text-sec)'; return; }
        var stock;
        if (vm.attrs.length) {
          var key = comboKey();
          var complete = vm.attrs.every(function (a) { return sel[a.name]; });
          if (!complete) { el.textContent = ''; return; }
          var st = vm.stock && vm.stock[key];
          stock = (st === undefined || st === '') ? null : Number(st);
        } else {
          stock = PROD_STOCK;
        }
        if (stock === null || stock === undefined) { el.textContent = ''; return; }
        if (stock <= 0) { el.textContent = 'Agotado'; el.style.color = '#ef4444'; }
        else if (PROD_HIDE_STOCK) { el.textContent = ''; }
        else if (stock <= 5) { el.textContent = '🔥 ¡Quedan ' + stock + PROD_UNIT + '!'; el.style.color = '#ea580c'; }
        else { el.textContent = stock + PROD_UNIT + ' disponibles'; el.style.color = 'var(--text-sec)'; }
      }
      function fmtMoney(n) { return n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
      function updatePrice() {
        var key = comboKey();
        var price = (vm.prices && vm.prices[key] !== undefined && vm.prices[key] !== '') ? Number(vm.prices[key]) : <%- product.price %>;
        var pe = document.getElementById('sticky-price');
        if (pe) pe.textContent = CUR + fmtMoney(price);
        var pm = document.getElementById('prod-price-main');
        if (pm) pm.textContent = CUR + fmtMoney(price);
      }
      // Al elegir Talla/Color, si esa combinación tiene su propia foto, la
      // vista principal cambia a esa — antes se quedaba pegada en la foto
      // general del producto sin importar qué variante se eligiera.
      function updateImage() {
        var key = comboKey();
        var img = (vm.images && vm.images[key]) ? vm.images[key] : '';
        if (!img) return;
        var main = document.getElementById('prod-main-img');
        if (main) main.src = img;
        if (typeof setStageBg === 'function') setStageBg(img);
        document.querySelectorAll('.prod-thumb').forEach(function (t) {
          t.classList.toggle('active', t.getAttribute('src') === img);
        });
      }
      window.addProductToCart = function() {
        var complete = !vm.attrs.length || vm.attrs.every(function(a){ return sel[a.name]; });
        if (!complete) { addToCart(PROD_ID); return; }
        var label = vm.attrs.map(function(a){ return sel[a.name]; }).filter(Boolean).join(' / ');
        var key = comboKey();
        var img = (vm.images && vm.images[key]) || null;
        var price = (vm.prices && vm.prices[key]) ? Number(vm.prices[key]) : <%- product.price %>;
        addToCart(PROD_ID, undefined, price, label || undefined, undefined, img || undefined);
      };
      render();
    })();
  </script>
</body>
</html>
