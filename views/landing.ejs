<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo Fácil · Tu tienda en línea que vende por WhatsApp</title>
  <meta name="description" content="Crea el catálogo de tu negocio en minutos. Tus clientes eligen, arman su pedido y te lo mandan por WhatsApp. Gratis para empezar.">
  <!-- ===== PWA: permite instalar el sitio de Catálogo Fácil ===== -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0E1211">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Catálogo Fácil">
  <meta property="og:title" content="Catálogo Fácil · Tu tienda en línea que vende por WhatsApp">
  <meta property="og:description" content="Crea el catálogo de tu negocio en minutos y recibe pedidos por WhatsApp.">
  <meta property="og:image" content="/icons/icon-512.png">
  <link rel="icon" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <script src="/pwa.js?v=20260919" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing-2026.css?v=20260928a">
</head>
<body class="lp">

  <a class="lp-skip" href="#contenido">Saltar al contenido</a>

  <!-- ===================== NAV ===================== -->
  <header class="lp-nav" data-nav>
    <div class="lp-wrap lp-nav-in">
      <a href="/" class="lp-brand" aria-label="Catálogo Fácil, inicio">
        <img src="/icons/icon-192.png" alt="" width="30" height="30">
        <span>Catálogo Fácil</span>
      </a>
      <nav class="lp-links" aria-label="Secciones">
        <a href="#como">Cómo funciona</a>
        <a href="#todo">Qué incluye</a>
        <a href="#tiendas">Tiendas</a>
      </nav>
      <div class="lp-nav-cta">
        <a href="/registrar" class="lp-btn lp-btn-light">Crear mi tienda</a>
      </div>
    </div>
  </header>

  <main id="contenido">
    <!-- ===================== HERO ===================== -->
    <section class="lp-hero">
      <div class="lp-hero-glow" aria-hidden="true"></div>
      <div class="lp-wrap lp-hero-in">
        <div class="lp-hero-copy">
          <p class="lp-eyebrow" data-rise><span class="lp-dot" aria-hidden="true"></span>Tu tienda abierta las 24 horas</p>
          <h1 data-rise>Tu negocio,<br>en el celular de<br><em>todos tus clientes.</em></h1>
          <p class="lp-lede" data-rise>Crea tu catálogo en minutos. Tus clientes ven tus productos, arman su pedido y te lo mandan <strong>directo a tu WhatsApp</strong>, listo para cobrar.</p>
          <div class="lp-hero-cta" data-rise>
            <a href="/registrar" class="lp-btn lp-btn-primary lp-btn-lg">
              Crear mi tienda gratis
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="#tiendas" class="lp-btn lp-btn-ghost lp-btn-lg">Ver tiendas reales</a>
          </div>
          <ul class="lp-hero-proof" data-rise>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Gratis para empezar</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Sin saber programar</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Listo en 5 minutos</li>
          </ul>
        </div>

        <!-- Teléfono animado: catálogo → carrito → WhatsApp -->
        <div class="lp-stage" aria-hidden="true">
          <div class="lp-orbit lp-orbit-1"></div>
          <div class="lp-orbit lp-orbit-2"></div>
          <div class="lp-phone">
            <div class="lp-phone-notch"></div>
            <div class="lp-screen">
              <div class="lp-sc-head">
                <span class="lp-sc-logo">EB</span>
                <div><b>El Buen Pan</b><small><i></i>Abierto ahora</small></div>
              </div>
              <div class="lp-sc-chips"><span class="on">Todo</span><span>Pan dulce</span><span>Pasteles</span></div>
              <div class="lp-sc-grid">
                <div class="lp-sc-card lp-sc-c1"><div class="lp-sc-img"></div><b>Concha de vainilla</b><span>$14</span><em class="lp-sc-add">+</em></div>
                <div class="lp-sc-card lp-sc-c2"><div class="lp-sc-img"></div><b>Pastel tres leches</b><span>$320</span><em class="lp-sc-add">+</em></div>
                <div class="lp-sc-card lp-sc-c3"><div class="lp-sc-img"></div><b>Cuernito</b><span>$16</span><em class="lp-sc-add">+</em></div>
                <div class="lp-sc-card lp-sc-c4"><div class="lp-sc-img"></div><b>Galletas avena</b><span>$45</span><em class="lp-sc-add">+</em></div>
              </div>
              <div class="lp-sc-cart"><span class="lp-sc-count">3</span>Enviar pedido por WhatsApp</div>
            </div>
          </div>
          <div class="lp-bubble">
            <div class="lp-bubble-head"><span class="lp-wa"><svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.5z"/></svg></span>Nuevo pedido</div>
            <p>¡Hola! Quiero:<br>2 × Concha de vainilla<br>1 × Pastel tres leches<br><b>Total: $348</b></p>
            <small>Ahora · WhatsApp</small>
          </div>
          <div class="lp-toast"><span>✓</span> Pedido recibido</div>
        </div>
      </div>

      <div class="lp-marquee" aria-hidden="true">
        <div class="lp-marquee-track">
          <% const giros = ['Panaderías','Ferreterías','Boutiques','Florerías','Taquerías','Joyerías','Farmacias','Papelerías','Cosméticos','Refaccionarias','Mueblerías','Veterinarias','Heladerías','Tiendas de regalos']; %>
          <% for (let r = 0; r < 2; r++) { giros.forEach(function (g) { %><span><%= g %></span><% }) } %>
        </div>
      </div>
    </section>

    <!-- ===================== PROBLEMA → SOLUCIÓN ===================== -->
    <section class="lp-section lp-contrast">
      <div class="lp-wrap lp-contrast-in">
        <div class="lp-before" data-reveal>
          <span class="lp-tag lp-tag-muted">Hoy</span>
          <h2>Mandas fotos una por una, contestas “¿precio?” todo el día y los pedidos se pierden en el chat.</h2>
        </div>
        <div class="lp-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
        <div class="lp-after" data-reveal>
          <span class="lp-tag">Con Catálogo Fácil</span>
          <h2>Compartes <em>un solo enlace</em>. Tus clientes ven todo, eligen y te llega el pedido completo, con total.</h2>
        </div>
      </div>
    </section>

    <!-- ===================== CÓMO FUNCIONA ===================== -->
    <section id="como" class="lp-section">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <span class="lp-kicker">Cómo funciona</span>
          <h2>De cero a vender, <em>en tres pasos.</em></h2>
        </div>
        <ol class="lp-steps">
          <li data-reveal>
            <span class="lp-step-n">01</span>
            <h3>Crea tu tienda</h3>
            <p>Escribe el nombre de tu negocio y tu WhatsApp. Elige un diseño hecho para tu giro.</p>
            <div class="lp-step-vis lp-vis-1"><span>cadi.nessik.net/<b>tu-tienda</b></span></div>
          </li>
          <li data-reveal>
            <span class="lp-step-n">02</span>
            <h3>Sube tus productos</h3>
            <p>Foto, precio y listo. O súbelos todos de golpe desde Excel. Variantes, tallas y colores incluidos.</p>
            <div class="lp-step-vis lp-vis-2"><i></i><i></i><i></i></div>
          </li>
          <li data-reveal>
            <span class="lp-step-n">03</span>
            <h3>Recibe pedidos</h3>
            <p>Comparte tu enlace en estados, Facebook o Instagram. Los pedidos llegan a tu WhatsApp, ordenados.</p>
            <div class="lp-step-vis lp-vis-3"><span class="lp-wa"><svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.5z"/></svg></span><b>Pedido #128</b><small>3 productos · $348</small></div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ===================== TODO LO QUE INCLUYE (bento) ===================== -->
    <section id="todo" class="lp-section lp-dark">
      <div class="lp-wrap">
        <div class="lp-head" data-reveal>
          <span class="lp-kicker">Qué incluye</span>
          <h2>Todo lo de una tienda en línea.<br><em>Sin lo complicado.</em></h2>
        </div>
        <div class="lp-bento">
          <article class="lp-tile lp-tile-wide" data-reveal>
            <div>
              <h3>Diseños que se ven de marca</h3>
              <p>Decenas de estilos pensados para cada giro: panadería, joyería, ferretería, boutique… Tu catálogo se ve profesional desde el primer día.</p>
            </div>
            <div class="lp-swatches" aria-hidden="true">
              <span style="--a:#1D5C5A;--b:#E3F1EC"></span><span style="--a:#141414;--b:#C9A45C"></span><span style="--a:#D9476B;--b:#FFF6EE"></span><span style="--a:#FFC400;--b:#15171A"></span><span style="--a:#0B3A57;--b:#1FB5B0"></span><span style="--a:#6B7B3A;--b:#F1E9DA"></span>
            </div>
          </article>
          <article class="lp-tile" data-reveal>
            <span class="lp-ico"><svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.5z"/></svg></span>
            <h3>Pedidos por WhatsApp</h3>
            <p>Con productos, cantidades y total. Sin errores, sin volver a preguntar.</p>
          </article>
          <article class="lp-tile" data-reveal>
            <span class="lp-ico"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 10h18M7 15h3"/></svg></span>
            <h3>Cobra como quieras</h3>
            <p>Transferencia, efectivo o pago con tarjeta en línea.</p>
          </article>
          <article class="lp-tile" data-reveal>
            <span class="lp-ico"><svg viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"/></svg></span>
            <h3>Inventario al día</h3>
            <p>Stock por variante, aviso de pocas piezas y productos por pedido.</p>
          </article>
          <article class="lp-tile" data-reveal>
            <span class="lp-ico"><svg viewBox="0 0 24 24"><path d="M4 20V12M9 20V6M14 20V10M19 20V4M3 20h18"/></svg></span>
            <h3>Reportes claros</h3>
            <p>Visitas, clics a WhatsApp, pedidos y cobros por día.</p>
          </article>
          <article class="lp-tile lp-tile-wide lp-tile-accent" data-reveal>
            <div>
              <h3>Tu panel, desde el celular</h3>
              <p>Instálalo como app. Cambia precios, marca pedidos como entregados y agrega empleados con su propio PIN y permisos.</p>
            </div>
            <div class="lp-mini-panel" aria-hidden="true">
              <div><small>Ventas de hoy</small><b>$4,280</b></div>
              <div><small>Pedidos</small><b>11</b></div>
              <div class="lp-mini-bars"><i style="--h:40%"></i><i style="--h:62%"></i><i style="--h:48%"></i><i style="--h:80%"></i><i style="--h:70%"></i><i style="--h:95%"></i></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================== TIENDAS REALES ===================== -->
    <section id="tiendas" class="lp-section">
      <div class="lp-wrap">
        <div class="lp-head lp-head-row" data-reveal>
          <div>
            <span class="lp-kicker">Tiendas reales</span>
            <h2>Negocios que ya <em>venden así.</em></h2>
          </div>
          <p>Los catálogos que más visitas están recibiendo. Entra y compra como lo haría un cliente.</p>
        </div>
        <% if (stores.length === 0) { %>
          <div class="lp-empty" data-reveal>
            <p>Aún no hay tiendas publicadas.</p>
            <a href="/registrar" class="lp-btn lp-btn-primary">Sé la primera</a>
          </div>
        <% } else { %>
          <div class="lp-stores">
            <% stores.forEach(function (s, index) { const tint = s.color_hex || '#1D5C5A'; %>
              <a href="/<%= s.slug %>" class="lp-store" data-reveal style="--tint: <%= tint %>" aria-label="Ver catálogo de <%= s.name %>">
                <div class="lp-store-cover">
                  <% if (s.cover_image) { %><img src="<%= s.cover_image %>" alt="" loading="lazy" decoding="async"><% } else { %><span class="lp-store-mono"><%= s.name.charAt(0) %></span><% } %>
                  <span class="lp-store-rank">#<%= index + 1 %></span>
                </div>
                <div class="lp-store-body">
                  <span class="lp-store-logo"><% if (s.logo) { %><img src="<%= s.logo %>" alt="" loading="lazy"><% } else { %><%= s.name.charAt(0) %><% } %></span>
                  <div>
                    <b><%= s.name %></b>
                    <small><%= s.featured_product ? s.featured_product : '/' + s.slug %></small>
                  </div>
                  <svg class="lp-store-go" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ===================== PREGUNTAS ===================== -->
    <section class="lp-section lp-faq-sec">
      <div class="lp-wrap lp-faq-in">
        <div class="lp-head" data-reveal>
          <span class="lp-kicker">Preguntas frecuentes</span>
          <h2>Lo que todos <em>preguntan.</em></h2>
        </div>
        <div class="lp-faq" data-reveal>
          <details open><summary>¿Cuánto cuesta?</summary><p>Puedes empezar gratis y publicar tu catálogo hoy mismo. Cuando tu negocio crezca, eliges un plan con más productos y funciones.</p></details>
          <details><summary>¿Necesito página web o saber programar?</summary><p>No. Tu catálogo ya es tu página: tiene su propio enlace para compartir y se ve perfecto en celular y computadora.</p></details>
          <details><summary>¿Cómo me llegan los pedidos?</summary><p>El cliente arma su carrito y, al terminar, se abre WhatsApp con el pedido completo: productos, cantidades, total y sus datos de entrega.</p></details>
          <details><summary>¿Puedo cobrar en línea?</summary><p>Sí. Puedes aceptar transferencia, efectivo al entregar o pago con tarjeta en línea, según lo que actives en tu configuración.</p></details>
          <details><summary>¿Mis empleados pueden usarlo?</summary><p>Sí. Cada empleado entra con su propio PIN y tú decides qué puede ver y hacer: productos, pedidos, reportes y más.</p></details>
        </div>
      </div>
    </section>

    <!-- ===================== CTA FINAL ===================== -->
    <section class="lp-final">
      <div class="lp-final-glow" aria-hidden="true"></div>
      <div class="lp-wrap lp-final-in" data-reveal>
        <h2>Tu próximo cliente<br><em>ya está en su celular.</em></h2>
        <p>Abre tu tienda hoy. En cinco minutos puedes compartir tu enlace.</p>
        <a href="/registrar" class="lp-btn lp-btn-primary lp-btn-lg">
          Crear mi tienda gratis
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </section>
  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="lp-footer">
    <div class="lp-wrap lp-footer-in">
      <a href="/" class="lp-brand"><img src="/icons/icon-192.png" alt="" width="26" height="26"><span>Catálogo Fácil</span></a>
      <nav aria-label="Enlaces legales y de cuenta">
        <a href="/registrar">Crear tienda</a>
        <a href="/terminos">Términos</a>
        <a href="/aviso-de-privacidad">Aviso de privacidad</a>
        <a href="/maestro">Equipo</a>
      </nav>
      <small>Hecho por Nessik · Torreón, Coahuila</small>
    </div>
  </footer>

  <script>
    (function () {
      // Barra superior: se vuelve sólida al bajar
      var nav = document.querySelector('[data-nav]');
      var onScroll = function () { nav.classList.toggle('is-solid', window.scrollY > 24); };
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

      // Aparición al hacer scroll (una sola vez)
      var els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (e) { e.classList.add('is-in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: .12 });
        els.forEach(function (e, i) { e.style.setProperty('--d', (i % 4) * 70 + 'ms'); io.observe(e); });
      }
      document.body.classList.add('lp-ready');
    })();
  </script>
</body>
</html>
