<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Clientes', biz }) %>
</head>
<body class="m-material min-h-screen" style="background:var(--ap-bg);color:var(--ap-text)">
  <%- include('admin/sidebar', { biz, active: 'clientes', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="px-4 md:px-8 py-4 md:py-6 pb-24 md:pb-6">

      <%- include('admin/page-header', {
        icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
        title: 'Clientes',
        subtitle: 'Tus clientes frecuentes, su historial y un botón directo a WhatsApp.'
      }) %>

      <% if (ok) { %>
        <div class="mb-3 bg-emerald-50 text-emerald-700 text-sm font-bold px-4 py-3 rounded-xl m-pop">Cliente guardado ✓</div>
      <% } %>

      <div class="cl-layout">
        <div class="cl-main">
        <!-- Lista -->
        <section class="m-card cl-list">
          <% var _frec = customers.filter(function (c) { return c.orderCount >= 2; }).length; var _tot = customers.reduce(function (s, c) { return s + (c.totalSpent || 0); }, 0); %>
          <div class="cl-top">
            <div>
              <h2 class="cl-h">Tus clientes</h2>
              <p class="cl-meta"><b><%= customers.length %></b> en total · <b><%= _frec %></b> frecuente<%= _frec === 1 ? '' : 's' %><% if (_tot > 0) { %> · <b><%= money(_tot) %></b> comprado<% } %></p>
            </div>
            <label class="cl-search">
              <i class="bi bi-search"></i>
              <input id="cliente-search" type="text" placeholder="Buscar por nombre o teléfono" autocomplete="off">
            </label>
          </div>

          <% if (customers.length === 0) { %>
            <div class="cl-empty">
              <span><i class="bi bi-people"></i></span>
              <p><b>Aún no tienes clientes</b></p>
              <p>Se guardan solos cuando alguien pide por WhatsApp con su nombre o teléfono. También puedes agregarlos a mano.</p>
            </div>
          <% } else { %>
            <div id="cliente-list" class="cl-rows">
              <% customers.forEach(c => { %>
                <div class="cl-row" data-search="<%= (c.name + ' ' + c.phone).toLowerCase() %>" data-cliente-id="<%= c.id %>" data-cliente-name="<%= (c.name || '').replace(/"/g, '&quot;') %>" data-cliente-phone="<%= c.phone || '' %>" data-cliente-ordercount="<%= c.orderCount %>">
                  <span class="cl-av"><%= (c.name || '?').trim().charAt(0).toUpperCase() %></span>
                  <div class="cl-info">
                    <p class="cl-name"><span><%= c.name %></span><% if (c.orderCount >= 2) { %><em class="cl-star"><i class="bi bi-star-fill"></i> Frecuente</em><% } %></p>
                    <p class="cl-sub">
                      <% if (c.phone) { %><span><i class="bi bi-telephone"></i> <%= c.phone %></span><% } %>
                      <span><%= c.orderCount %> pedido<%= c.orderCount === 1 ? '' : 's' %></span>
                      <span><% if (c.totalSpent > 0) { %><b><%= money(c.totalSpent) %></b><% } else { %>sin compras<% } %></span>
                      <% if (c.orders.length) { %><span>último: <%= fmtFecha(c.orders[0].created_at, 'fecha') %></span><% } %>
                    </p>
                    <% if (c.notes) { %><p class="cl-note"><i class="bi bi-sticky"></i> <%= c.notes %></p><% } %>
                  </div>
                  <div class="cl-actions">
                    <% if (c.phone) { %><a href="https://wa.me/<%= c.phone.startsWith('52') ? c.phone : '52' + c.phone %>" target="_blank" class="cl-wa" title="Enviar WhatsApp"><i class="bi bi-whatsapp"></i><span>WhatsApp</span></a><% } %>
                    <form method="POST" action="/<%= biz.slug %>/admin/cliente/<%= c.id %>/eliminar" data-confirm="¿Eliminar a <%= c.name %>?">
                      <button class="cl-del" title="Eliminar" aria-label="Eliminar a <%= c.name %>"><i class="bi bi-trash3"></i></button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
            <div id="cliente-pager"></div>
          <% } %>
        </section>
        </div>
        <aside class="cl-side">
      <!-- Nuevo cliente -->
      <section class="m-card p-4 mb-3">
        <h2 class="font-extrabold text-sm mb-3" style="color:var(--ap-text)">Nuevo cliente</h2>
        <form method="POST" action="/<%= biz.slug %>/admin/cliente" class="grid gap-3">
          <div class="m-field"><label>Nombre *</label><input name="name" required placeholder="Ej: María González"></div>
          <div class="m-field"><label>Teléfono</label><input name="phone" type="tel" inputmode="numeric" maxlength="12" pattern="[0-9]{3} [0-9]{3} [0-9]{4}" data-mask="phone" title="10 dígitos" placeholder="Ej: 871 234 5678"></div>
          <div class="m-field"><label>Notas</label><input name="notes" placeholder="Ej: prefiere WhatsApp"></div>
          <div><button class="pn-btn pn-btn-solid w-full">Guardar cliente</button></div>
        </form>
      </section>

      <!-- Enviar promo -->
      <section class="m-card p-4 mb-3">
        <h2 class="font-extrabold text-sm mb-1 flex items-center gap-1.5" style="color:var(--ap-text)">
          <i class="bi bi-megaphone" style="color:var(--ap-accent-text)"></i>
          Enviar promo
        </h2>
        <p class="text-xs mb-3" style="color:var(--ap-text-sec)">Escribe un mensaje y envíalo por WhatsApp a tus clientes. Usa <b>{nombre}</b> para personalizarlo con el nombre de cada quien.</p>
        <textarea id="promo-msg" rows="3" class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none" style="border-color:var(--ap-border);background:var(--ap-bg);color:var(--ap-text)">¡Hola {nombre}! Te aviso que tenemos promociones nuevas esta semana. ¿Te interesa? 😊</textarea>
        <div class="flex flex-wrap gap-2 mt-3">
          <button type="button" onclick="prepararPromo('todos')" class="pn-btn pn-btn-solid pn-btn-sm">Enviar a todos</button>
          <button type="button" onclick="prepararPromo('frecuentes')" class="pn-btn pn-btn-sm">Solo frecuentes (2+ pedidos)</button>
          <button type="button" onclick="copiarPromo()" class="pn-btn pn-btn-sm">Copiar mensaje</button>
        </div>
        <div id="promo-result" class="mt-3"></div>
      </section>
        </aside>
      </div>


    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <script>
    // El panel es SPA-lite: guardar/borrar un cliente reemplaza solo el
    // <main> (ver admin/panel-ajax.ejs), y este <script> vive AFUERA de
    // <main> — nunca se vuelve a ejecutar, así que un CLIENTES fijo desde
    // el primer render se quedaba desactualizado (un cliente nuevo no
    // aparecía en "Enviar promo" hasta recargar la página a mano). Se
    // reconstruye leyendo el DOM (que sí queda al día) en vez de depender
    // de un JSON congelado, y se re-arma solo tras cada swap.
    var CLIENTES = [];
    function rebuildClientes() {
      CLIENTES = Array.prototype.map.call(document.querySelectorAll('#cliente-list [data-cliente-id]'), function (el) {
        return {
          id: el.getAttribute('data-cliente-id'),
          name: el.getAttribute('data-cliente-name') || '',
          phone: el.getAttribute('data-cliente-phone') || '',
          orderCount: parseInt(el.getAttribute('data-cliente-ordercount'), 10) || 0
        };
      });
    }
    rebuildClientes();
    window.onPanelSwap = rebuildClientes;
    function escHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    var promoState = { filtro: 'todos', page: 1, list: [] };
    var PROMO_PAGE_SIZE = 8;
    function promoTexto(c) {
      var msg = (document.getElementById('promo-msg') || {}).value || '';
      var nombre = (c.name || '').trim().split(/\s+/)[0] || 'cliente';
      return msg.replace(/\{nombre\}/g, nombre);
    }
    function promoUrl(c) {
      var phone = (c.phone || '').replace(/[^0-9]/g, '');
      if (!phone) return '';
      return 'https://wa.me/' + (phone.indexOf('52') === 0 ? phone : '52' + phone) + '?text=' + encodeURIComponent(promoTexto(c));
    }
    function prepararPromo(filtro) {
      var msg = (document.getElementById('promo-msg') || {}).value || '';
      if (!msg.trim()) { mostrarToast('Escribe el mensaje primero', 'error'); return; }
      promoState.filtro = filtro;
      promoState.page = 1;
      promoState.list = CLIENTES.filter(function (c) { return filtro === 'todos' ? true : c.orderCount >= 2; });
      promoRender();
    }
    function promoRender() {
      var box = document.getElementById('promo-result');
      var list = promoState.list;
      if (!list.length) {
        box.innerHTML = '<p class="text-xs text-slate-400 mt-3">No hay clientes' + (promoState.filtro === 'frecuentes' ? ' frecuentes (2+ pedidos)' : '') + ' todavía.</p>';
        return;
      }
      var conTel = list.filter(function (c) { return promoUrl(c); });
      var pages = Math.max(1, Math.ceil(list.length / PROMO_PAGE_SIZE));
      if (promoState.page > pages) promoState.page = pages;
      var start = (promoState.page - 1) * PROMO_PAGE_SIZE;
      var slice = list.slice(start, start + PROMO_PAGE_SIZE);
      var h = '<p class="text-xs text-slate-500 mb-2">Se preparó el envío para <b>' + list.length + '</b> cliente(s)'
        + (conTel.length < list.length ? ' · <span class="text-amber-600 font-bold">' + (list.length - conTel.length) + ' sin teléfono</span>' : '')
        + '. Pica cada botón para abrir su chat:</p>';
      h += '<div class="divide-y divide-slate-50">';
      slice.forEach(function (c) {
        var url = promoUrl(c);
        h += '<div class="flex items-center justify-between gap-2 py-1.5">'
          + '<span class="text-xs font-semibold text-slate-700 truncate">' + escHtml(c.name) + ' <span class="text-slate-400 font-normal">(' + c.orderCount + ' ped.)</span></span>'
          + (url ? '<a href="' + url + '" target="_blank" class="m-btn m-btn-sm !min-h-0 !py-1 !bg-emerald-500 !text-white shrink-0">💬 Enviar</a>' : '<span class="text-[11px] text-slate-400 shrink-0">sin teléfono</span>')
          + '</div>';
      });
      h += '</div>';
      if (pages > 1) {
        h += '<div class="flex items-center justify-center gap-2 mt-3">'
          + '<button type="button" class="m-btn m-btn-outlined m-btn-sm" data-pg="prev">‹ Anterior</button>'
          + '<span class="text-xs font-bold text-slate-500 px-2">Página ' + promoState.page + ' de ' + pages + '</span>'
          + '<button type="button" class="m-btn m-btn-outlined m-btn-sm" data-pg="next">Siguiente ›</button>'
          + '</div>';
      }
      h += '<button type="button" id="promo-open-page" class="m-btn m-btn-tonal m-btn-sm mt-3">🚀 Abrir los ' + slice.length + ' chats de esta página</button>';
      box.innerHTML = h;
      var prev = box.querySelector('[data-pg="prev"]');
      var next = box.querySelector('[data-pg="next"]');
      if (prev) prev.onclick = function () { if (promoState.page > 1) { promoState.page--; promoRender(); } };
      if (next) next.onclick = function () { if (promoState.page < pages) { promoState.page++; promoRender(); } };
      box.querySelector('#promo-open-page').onclick = function () {
        var links = slice.map(promoUrl).filter(Boolean);
        if (!links.length) { mostrarToast('Ningún cliente de esta página tiene teléfono', 'error'); return; }
        links.forEach(function (u) { window.open(u, '_blank'); });
        mostrarToast('Se abrieron ' + links.length + ' chats. Si tu navegador bloqueó algunos, usa sus botones 💬.', 'ok');
      };
    }
    function copiarPromo() {
      var msg = (document.getElementById('promo-msg') || {}).value || '';
      if (navigator.clipboard) { navigator.clipboard.writeText(msg).then(function () { mostrarToast('Mensaje copiado ✓', 'ok'); }); }
      else mostrarToast('Copia el texto manualmente', 'info');
    }
    var s = document.getElementById('cliente-search');
    // ====== Filtro en vivo + paginación de clientes (mismo patrón que productos) ======
    var CLI_PAGE_SIZE = 20;
    var cliPage = 1;
    function cliAll() {
      return Array.prototype.slice.call(document.querySelectorAll('#cliente-list [data-search]'));
    }
    function cliShow() {
      var q = (s && s.value || '').toLowerCase().trim();
      var current = cliAll().filter(function (row) {
        return !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
      });
      var pages = Math.max(1, Math.ceil(current.length / CLI_PAGE_SIZE));
      if (cliPage > pages) cliPage = pages;
      var start = (cliPage - 1) * CLI_PAGE_SIZE;
      cliAll().forEach(function (row) { row.classList.add('hidden'); });
      current.slice(start, start + CLI_PAGE_SIZE).forEach(function (row) { row.classList.remove('hidden'); });
      cliRenderPager(pages, current.length);
    }
    function cliRenderPager(pages, total) {
      var box = document.getElementById('cliente-pager');
      if (!box) return;
      if (pages <= 1) { box.innerHTML = ''; return; }
      var h = '<div class="flex items-center justify-center gap-2 mt-4">';
      h += '<button type="button" class="m-btn m-btn-outlined m-btn-sm" data-pg="prev">‹ Anterior</button>';
      h += '<span class="text-xs font-bold text-slate-500 px-2">Página ' + cliPage + ' de ' + pages + ' · ' + total + ' cliente' + (total === 1 ? '' : 's') + '</span>';
      h += '<button type="button" class="m-btn m-btn-outlined m-btn-sm" data-pg="next">Siguiente ›</button>';
      h += '</div>';
      box.innerHTML = h;
      box.querySelector('[data-pg="prev"]').onclick = function () { if (cliPage > 1) { cliPage--; cliShow(); } };
      box.querySelector('[data-pg="next"]').onclick = function () { if (cliPage < pages) { cliPage++; cliShow(); } };
    }
    if (s) {
      s.oninput = function () { cliPage = 1; cliShow(); };
    }
    cliShow();
  </script>
</body>
</html>
