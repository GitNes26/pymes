<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf" content="<%= csrf %>" />
  <title><%= list ? 'Panel maestro · Catálogo Fácil' : 'Acceso maestro · Catálogo Fácil' %></title>
  <script src="/vendor/tailwind.js"></script>
  <script>
    // Modo claro fijo: las clases dark: no siguen al dispositivo
    tailwind.config = { darkMode: 'class' };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/material.css" />
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css" />
  <script src="/js/material.js"></script>
  <script src="/js/searchable-select.js?v=20260920"></script>
  <script src="/vendor/sweetalert2.all.min.js"></script>
  <script>
    (function () {
      function csrfValue() {
        var m = document.querySelector('meta[name="csrf"]');
        return m ? m.getAttribute('content') : '';
      }
      function injectAll() {
        var t = csrfValue();
        if (!t) return;
        document.querySelectorAll('form').forEach(function (f) {
          if (f.querySelector('input[name="_csrf"]')) return;
          var i = document.createElement('input');
          i.type = 'hidden'; i.name = '_csrf'; i.value = t;
          f.appendChild(i);
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', injectAll);
      else injectAll();
      window.__csrfValue = csrfValue;
    })();
  </script>
  <style>
    /* ============================================================
       PANEL MAESTRO — ESTILO MODERNO 2026
       ============================================================ */

    :root {
      /* Misma paleta "Nessik" que el resto del panel admin (ver DESIGN.md):
         gris neutro + grafito, un solo acento, sin luz ambiental ni gradientes
         decorativos — maestro sigue la misma disciplina minimalista. */
      --mp-bg: #f7f7f8;
      --mp-card: #ffffff;
      --mp-text: #15181d;
      --mp-text-sec: #61666e;
      --mp-accent: #2c2c2e;
      --mp-accent-light: #454548;
      --mp-accent-glow: rgba(44,44,46,.07);
      --mp-border: rgba(21,24,29,.09);
      --mp-shadow: 0 1px 2px rgba(20,24,31,.04);
      --mp-shadow-lg: 0 8px 24px rgba(20,24,31,.09);
      --mp-radius: 12px;
    }
    * { transition: border-color .2s, background .2s, box-shadow .2s; }
    body {
      font-family:'Inter',system-ui,sans-serif;
      /* !important porque la etiqueta <body> trae bg-slate-100 de Tailwind,
         de mayor especificidad que un selector de elemento plano. */
      background-color: var(--mp-bg) !important;
    }
    body.dark { background-color: #0d1117 !important; }

    /* Scrollbar moderno */
    ::-webkit-scrollbar { width:5px; height:5px; }
    ::-webkit-scrollbar-track { background:transparent; }
    ::-webkit-scrollbar-thumb { background:rgba(21,24,29,.18); border-radius:10px; }
    ::-webkit-scrollbar-thumb:hover { background:rgba(21,24,29,.32); }

    /* Header glass */
    .panel-header {
      background: rgba(255,255,255,.9)!important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--mp-border)!important;
    }

    /* Tarjeta de tienda */
    .store-card {
      background: var(--mp-card);
      border-radius: var(--mp-radius);
      border: 1px solid var(--mp-border);
      padding: 1.1rem 1.3rem;
      transition: border-color .2s, box-shadow .2s;
      box-shadow: var(--mp-shadow);
      position: relative;
      overflow: hidden;
    }
    .store-card:hover {
      box-shadow: var(--mp-shadow-lg);
      border-color: rgba(21,24,29,.16);
    }
    .store-card.expired {
      border-color: rgba(180,50,50,.22);
      background: #fffdfc;
    }
    .store-card.suspended {
      border-color: rgba(180,50,50,.14);
      background: #fafafa;
      opacity: .6;
    }

    /* Badges de estado */
    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.2rem 0.75rem;
      border-radius: 99px;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border: 1px solid transparent;
      transition: all .2s;
    }
    .badge-status.active {
      background: #ecfdf5;
      color: #065f46;
      border-color: #a7f3d0;
      box-shadow: 0 0 0 3px rgba(16,185,129,.06);
    }
    .badge-status.inactive {
      background: #f8fafc;
      color: #64748b;
      border-color: #e2e8f0;
    }
    .badge-status.suspended {
      background: #fef2f2;
      color: #991b1b;
      border-color: #fecaca;
    }
    .badge-status.pro {
      background: #eff6ff;
      color: #1e40af;
      border-color: #bfdbfe;
      box-shadow: 0 0 0 3px rgba(44,44,46,.06);
    }
    .badge-status.free {
      background: #f8fafc;
      color: #475569;
      border-color: #e2e8f0;
    }
    .badge-status.expired {
      background: #fef2f2;
      color: #991b1b;
      border-color: #fecaca;
    }
    .badge-status.ads {
      background: #fffbeb;
      color: #92400e;
      border-color: #fde68a;
    }
    .badge-status.no-ads {
      background: #f8fafc;
      color: #64748b;
      border-color: #e2e8f0;
    }

    /* Botones de accion */
    .action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.35rem 0.8rem;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 700;
      border: 1px solid var(--mp-border);
      background: var(--mp-card);
      color: var(--mp-text-sec);
      cursor: pointer;
      transition: all .2s cubic-bezier(.22,1,.36,1);
      min-height: 30px;
      line-height: 1;
    }
    .action-btn:hover {
      background: var(--mp-bg);
      border-color: rgba(21,24,29,.2);
      color: var(--mp-text);
    }
    .action-btn:active { transform:scale(.97); }
    .action-btn.primary {
      background: var(--mp-accent);
      border-color: var(--mp-accent);
      color: #fff;
      box-shadow: 0 2px 8px rgba(44,44,46,.2);
    }
    .action-btn.primary:hover {
      background: var(--mp-accent-light);
      border-color: var(--mp-accent-light);
      box-shadow: 0 4px 14px rgba(44,44,46,.3);
    }
    .action-btn.danger {
      color: #dc2626;
      border-color: rgba(220,38,38,.2);
    }
    .action-btn.danger:hover {
      background: #fef2f2;
      border-color: rgba(220,38,38,.3);
    }
    .action-btn.success {
      color: #059669;
      border-color: rgba(5,150,105,.2);
    }
    .action-btn.success:hover {
      background: #ecfdf5;
      border-color: rgba(5,150,105,.3);
    }
    .action-btn.warning {
      color: #d97706;
      border-color: rgba(217,119,6,.2);
    }
    .action-btn.warning:hover {
      background: #fffbeb;
      border-color: rgba(217,119,6,.3);
    }
    .action-btn.small {
      padding: 0.2rem 0.5rem;
      font-size: 0.65rem;
      min-height: 24px;
      border-radius: 8px;
    }

    /* Selector de plan */
    .plan-select {
      font-size: 0.75rem;
      padding: 0.3rem 0.7rem;
      border-radius: 10px;
      border: 1px solid var(--mp-border);
      background: var(--mp-card);
      color: var(--mp-text);
      font-weight: 600;
      cursor: pointer;
      outline: none;
      transition: all .2s;
    }
    .plan-select:focus {
      border-color: var(--mp-accent);
      box-shadow: 0 0 0 3px var(--mp-accent-glow);
    }

    /* Inputs compactos */
    .input-compact {
      font-size: 0.75rem;
      padding: 0.3rem 0.7rem;
      border-radius: 10px;
      border: 1px solid var(--mp-border);
      background: var(--mp-card);
      color: var(--mp-text);
      outline: none;
      transition: all .2s;
      width: auto;
      min-width: 60px;
    }
    .input-compact:focus {
      border-color: var(--mp-accent);
      box-shadow: 0 0 0 3px var(--mp-accent-glow);
    }

    /* Tarjetas de resumen (dashboard) */
    .mp-stat-card {
      background: var(--mp-card);
      border: 1px solid var(--mp-border);
      border-radius: var(--mp-radius);
      box-shadow: var(--mp-shadow);
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition: all .25s cubic-bezier(.22,1,.36,1);
      position: relative;
      overflow: hidden;
    }
    .mp-stat-card:hover { transform: translateY(-2px); box-shadow: var(--mp-shadow-lg); border-color: rgba(44,44,46,.15); }
    .mp-stat-card.active-filter { border-color: var(--mp-accent); box-shadow: 0 0 0 3px var(--mp-accent-glow); }
    .mp-stat-icon {
      width: 34px; height: 34px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; margin-bottom: 0.5rem;
      transition: transform .25s cubic-bezier(.22,1,.36,1);
    }
    .mp-stat-card:hover .mp-stat-icon { transform: scale(1.1) rotate(-4deg); }
    .mp-stat-icon.blue { background: rgba(44,44,46,.1); }
    .mp-stat-icon.green { background: rgba(5,150,105,.1); }
    .mp-stat-icon.amber { background: rgba(217,119,6,.1); }
    .mp-stat-icon.purple { background: rgba(147,51,234,.1); }
    .mp-stat-icon.pink { background: rgba(219,39,119,.1); }
    .mp-stat-icon.slate { background: rgba(100,116,139,.1); }
    .mp-stat-val { font-size: 1.3rem; font-weight: 900; color: var(--mp-text); line-height: 1.1; }
    .mp-stat-lbl { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--mp-text-sec); margin-top: 0.2rem; }
    body.dark .mp-stat-card:hover { border-color: rgba(138,180,248,.25); }

    /* Barra de adopción Pro vs Free */
    .mp-adopt-bar { height: 8px; border-radius: 99px; background: #e2e8f0; overflow: hidden; display: flex; }
    .mp-adopt-bar .fill { height: 100%; background: linear-gradient(90deg, var(--mp-accent), var(--mp-accent-light)); transition: width .8s cubic-bezier(.22,1,.36,1); }
    body.dark .mp-adopt-bar { background: rgba(255,255,255,.08); }

    /* Selector de orden */
    .sort-select { font-size: 0.75rem; padding: 0.4rem 0.8rem; border-radius: 10px; border: 1px solid var(--mp-border); background: var(--mp-card); color: var(--mp-text); font-weight: 600; cursor: pointer; outline: none; transition: all .2s; }
    .sort-select:focus { border-color: var(--mp-accent); box-shadow: 0 0 0 3px var(--mp-accent-glow); }
    body.dark .sort-select { background: #0d1117; border-color: rgba(255,255,255,.08); color: #e6edf3; }

    /* Badges clicables (funcionan como filtros rápidos) */
    .badge-status.clickable { cursor: pointer; user-select: none; }
    .badge-status.clickable:hover { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .badge-status.clickable:active { transform: scale(.96); }

    /* Tabs modernos */
    .mt-tab {
      flex: 1;
      padding: 0.6rem 0.8rem;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--mp-text-sec);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all .25s cubic-bezier(.22,1,.36,1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .mt-tab:hover { color: var(--mp-text); background: rgba(44,44,46,.04); }
    .mt-tab.active {
      background: var(--mp-card);
      color: var(--mp-text);
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
    }
    .mt-tab-count {
      font-size: 0.6rem;
      padding: 0.1rem 0.45rem;
      border-radius: 99px;
      background: #f1f5f9;
      color: #94a3b8;
      font-weight: 800;
    }
    .mt-tab.active .mt-tab-count { background: #dbeafe; color: var(--mp-accent); }
    .mt-tab-panel { display: none; }
    .mt-tab-panel.active { display: block; animation: mtFadeIn .3s cubic-bezier(.22,1,.36,1); }
    @keyframes mtFadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }

    /* Stagger animation */
    .stagger-item {
      animation: fadeSlideUp .4s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes fadeSlideUp {
      from { opacity:0; transform:translateY(16px); }
      to { opacity:1; transform:translateY(0); }
    }
    .stagger-item:nth-child(1) { animation-delay:.02s; }
    .stagger-item:nth-child(2) { animation-delay:.05s; }
    .stagger-item:nth-child(3) { animation-delay:.08s; }
    .stagger-item:nth-child(4) { animation-delay:.11s; }
    .stagger-item:nth-child(5) { animation-delay:.14s; }
    .stagger-item:nth-child(6) { animation-delay:.17s; }
    .stagger-item:nth-child(7) { animation-delay:.20s; }
    .stagger-item:nth-child(8) { animation-delay:.23s; }
    .stagger-item:nth-child(9) { animation-delay:.26s; }
    .stagger-item:nth-child(10) { animation-delay:.29s; }

    /* Animacion fade-in global */
    .fade-in { animation: fadeIn .3s cubic-bezier(.22,1,.36,1) both; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }

    /* Toast moderno */
    .toast-in { animation: toastIn .35s cubic-bezier(.22,1,.36,1) both; }
    @keyframes toastIn { from { opacity:0; transform:translateY(12px) scale(.95); } to { opacity:1; transform:none; } }

    /* ========== MODO OSCURO ========== */
    body.dark { --mp-bg: #0d1117; --mp-card: #161b22; --mp-text: #e6edf3; --mp-text-sec: #8b949e; --mp-border: rgba(255,255,255,.08); --mp-shadow: 0 1px 3px rgba(0,0,0,.3); --mp-shadow-lg: 0 10px 40px -8px rgba(0,0,0,.5); }
    body.dark .panel-header { background: rgba(13,17,23,.85)!important; border-bottom-color: rgba(255,255,255,.06)!important; }
    body.dark .store-card { border-color: rgba(255,255,255,.08); }
    body.dark .store-card:hover { border-color: rgba(138,180,248,.2); }
    body.dark .store-card.expired { border-color: rgba(248,113,113,.2); background: linear-gradient(135deg, #161b22 80%, rgba(248,113,113,.04)); }
    body.dark .badge-status.active { background: rgba(16,185,129,.12); color: #6ee7b7; border-color: rgba(16,185,129,.25); }
    body.dark .badge-status.inactive { background: rgba(255,255,255,.04); color: #8b949e; border-color: rgba(255,255,255,.08); }
    body.dark .badge-status.suspended { background: rgba(248,113,113,.1); color: #fca5a5; border-color: rgba(248,113,113,.2); }
    body.dark .badge-status.pro { background: rgba(138,180,248,.1); color: #93c5fd; border-color: rgba(138,180,248,.2); }
    body.dark .badge-status.free { background: rgba(255,255,255,.04); color: #8b949e; border-color: rgba(255,255,255,.08); }
    body.dark .badge-status.expired { background: rgba(248,113,113,.1); color: #fca5a5; border-color: rgba(248,113,113,.2); }
    body.dark .badge-status.ads { background: rgba(251,191,36,.1); color: #fcd34d; border-color: rgba(251,191,36,.2); }
    body.dark .badge-status.no-ads { background: rgba(255,255,255,.04); color: #8b949e; border-color: rgba(255,255,255,.08); }
    body.dark .action-btn { border-color: rgba(255,255,255,.08); color: #8b949e; background: transparent; }
    body.dark .action-btn:hover { background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.12); color: #e6edf3; }
    body.dark .action-btn.primary { background: #454548; border-color: #454548; color: #fff; }
    body.dark .action-btn.primary:hover { background: #4d4d50; border-color: #4d4d50; }
    body.dark .action-btn.danger { color: #fca5a5; border-color: rgba(248,113,113,.2); }
    body.dark .action-btn.danger:hover { background: rgba(248,113,113,.08); }
    body.dark .action-btn.success { color: #6ee7b7; border-color: rgba(16,185,129,.2); }
    body.dark .action-btn.success:hover { background: rgba(16,185,129,.08); }
    body.dark .action-btn.warning { color: #fcd34d; border-color: rgba(251,191,36,.2); }
    body.dark .action-btn.warning:hover { background: rgba(251,191,36,.08); }
    body.dark .plan-select { background: #0d1117; border-color: rgba(255,255,255,.08); color: #e6edf3; }
    body.dark .plan-select:focus { border-color: #d4d4d4; box-shadow: 0 0 0 3px rgba(138,180,248,.12); }
    body.dark .input-compact { background: #0d1117; border-color: rgba(255,255,255,.08); color: #e6edf3; }
    body.dark .input-compact:focus { border-color: #d4d4d4; box-shadow: 0 0 0 3px rgba(138,180,248,.12); }
    body.dark .mt-tab:hover { color: #e6edf3; background: rgba(255,255,255,.04); }
    body.dark .mt-tab.active { background: #161b22; color: #fff; }
    body.dark .mt-tab-count { background: rgba(255,255,255,.06); color: #8b949e; }
    body.dark .mt-tab.active .mt-tab-count { background: rgba(138,180,248,.15); color: #93c5fd; }
  </style>
  <link rel="stylesheet" href="/css/maestro-refine.css?v=20260918a" />
  <script src="/js/img-retry.js"></script>
</head>
<body class="m-material min-h-screen bg-slate-100 dark:bg-[#0d1117]">

  <% if (!list) { %>

    <!-- ============================================================
    LOGIN – Acceso maestro
    ============================================================ -->
    <div class="min-h-screen flex items-center justify-center p-4 bg-slate-50">
      <div class="w-full max-w-sm">
        <div class="bg-white rounded-3xl border border-slate-200 shadow-[0_12px_40px_rgba(15,23,42,0.08)] p-8 m-rise">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="w-16 h-16 rounded-2xl bg-slate-800 text-white flex items-center justify-center text-3xl shadow-sm mb-4">🔐</div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Panel maestro</h1>
            <p class="text-sm text-slate-400 mt-1">Control global de todas las tiendas</p>
          </div>

          <% if (error) { %>
            <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl p-3.5 mb-4 font-semibold flex items-center gap-2">
              <span>⚠️</span>
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="POST" action="/maestro">
            <label class="block text-[0.7rem] font-bold uppercase tracking-wide text-slate-400 mb-2" for="f-master">Código maestro</label>
            <input type="password" name="master" id="f-master" placeholder="••••" autofocus class="w-full border-2 border-slate-200 rounded-2xl px-4 py-3 text-lg font-semibold tracking-[0.4em] text-center text-slate-900 focus:outline-none focus:border-slate-500 focus:ring-4 focus:ring-slate-200" />
            <button class="m-btn m-btn-filled w-full !min-h-11 mt-4 !bg-slate-800 hover:!bg-slate-700">
              Entrar al panel
            </button>
          </form>

          <a href="/" class="block text-center text-sm text-slate-400 font-semibold hover:text-slate-600 transition mt-5">
            ← Volver al inicio
          </a>
        </div>
      </div>
    </div>

  <% } else { %>

    <!-- ============================================================
    PANEL – Listado de tiendas
    ============================================================ -->

    <!-- HEADER -->
    <header class="panel-header sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-4 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-xl text-white flex items-center justify-center text-lg" style="background:#2c2c2e"><i class="bi bi-shield-lock"></i></span>
          <div>
            <h1 class="font-extrabold text-slate-900 dark:text-white leading-tight text-lg">Panel maestro</h1>
            <p class="text-xs text-slate-400 dark:text-slate-500"><%= list.length %> tiendas registradas</p>
          </div>
        </div>
        <form method="POST" action="/maestro/cerrar">
          <button class="text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white bg-slate-100 dark:bg-[#21262d] hover:bg-slate-200 dark:hover:bg-[#30363d] px-4 py-2 rounded-xl transition">
            Cerrar sesión
          </button>
        </form>
      </div>
    </header>

    <!-- MAIN -->
    <main class="max-w-6xl mx-auto px-3 md:px-6 py-5">

      <!-- RESUMEN GLOBAL -->
      <%
        var mpActivas = list.filter(function(b){ return b.active; }).length;
        var mpProCount = list.filter(function(b){ return b.plan === 'pro'; }).length;
        var mpAds = list.filter(function(b){ return b.ads_enabled; }).length;
        var mpProductos = list.reduce(function(s,b){ return s + (b.products_count||0); }, 0);
        var mpPedidos = list.reduce(function(s,b){ return s + (b.orders_count||0); }, 0);
        var mpMrr = list.filter(function(b){ return b.active && !b.suspended; }).reduce(function(s,b){ return s + Number(b.plan_price||0); }, 0);
        var mpProPct = list.length ? Math.round((mpProCount / list.length) * 100) : 0;
      %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-3">
        <div class="mp-stat-card stagger-item" data-stat-filter="all" style="animation-delay:.0s" title="Ver todas las tiendas">
          <div class="mp-stat-icon blue"><i class="bi bi-shop"></i></div>
          <p class="mp-stat-val"><%= list.length %></p>
          <p class="mp-stat-lbl">Tiendas</p>
        </div>
        <div class="mp-stat-card stagger-item" data-stat-filter="active" style="animation-delay:.03s" title="Filtrar: solo activas">
          <div class="mp-stat-icon green"><i class="bi bi-check-circle"></i></div>
          <p class="mp-stat-val"><%= mpActivas %></p>
          <p class="mp-stat-lbl">Activas</p>
        </div>
        <div class="mp-stat-card stagger-item" data-stat-filter="pro" style="animation-delay:.06s" title="Filtrar: solo plan Pro">
          <div class="mp-stat-icon purple"><i class="bi bi-gem"></i></div>
          <p class="mp-stat-val"><%= mpProCount %></p>
          <p class="mp-stat-lbl">Plan Pro</p>
        </div>
        <div class="mp-stat-card stagger-item" data-stat-filter="ads" style="animation-delay:.09s" title="Filtrar: publicitadas">
          <div class="mp-stat-icon amber"><i class="bi bi-megaphone"></i></div>
          <p class="mp-stat-val"><%= mpAds %></p>
          <p class="mp-stat-lbl">Publicitadas</p>
        </div>
        <div class="mp-stat-card stagger-item" style="animation-delay:.12s" title="Productos registrados en toda la plataforma">
          <div class="mp-stat-icon pink"><i class="bi bi-box-seam"></i></div>
          <p class="mp-stat-val"><%= mpProductos %></p>
          <p class="mp-stat-lbl">Productos</p>
        </div>
        <div class="mp-stat-card stagger-item" style="animation-delay:.15s" title="Suma de precios de plan de tiendas activas">
          <div class="mp-stat-icon slate"><i class="bi bi-cash-stack"></i></div>
          <p class="mp-stat-val">$<%= mpMrr.toFixed(0) %></p>
          <p class="mp-stat-lbl">Ingreso/mes</p>
        </div>
      </div>
      <div class="flex items-center gap-3 mb-5 px-0.5">
        <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 shrink-0">Adopción Pro</span>
        <div class="mp-adopt-bar flex-1"><div class="fill" style="width:0%" data-adopt-pct="<%= mpProPct %>"></div></div>
        <span class="text-[11px] font-black text-slate-600 dark:text-slate-300 shrink-0"><%= mpProPct %>%</span>
      </div>

      <!-- TAB NAV -->
      <nav class="flex gap-1 bg-slate-100 dark:bg-[#161b22] rounded-2xl p-1 mb-5 border border-slate-200 dark:border-[#21262d]">
        <button onclick="switchTab('tiendas')" id="tab-btn-tiendas" class="mt-tab active"><i class="bi bi-shop"></i> Tiendas <span class="mt-tab-count"><%= list.length %></span></button>
      </nav>

      <!-- TAB: TIENDAS -->
      <div id="tab-tiendas" class="mt-tab-panel active">

      <!-- FILTROS DE TIENDAS -->
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <select id="giro-filtro" class="input-compact rounded-xl px-3 py-2 text-sm border border-slate-200 dark:bg-[#0d1117] dark:border-[#30363d] dark:text-white bg-white focus:outline-none focus:border-neutral-500">
          <option value="">Todos los giros</option>
          <% GIROS.forEach(g => { %>
            <option value="<%= g %>"><%= g.charAt(0).toUpperCase() + g.slice(1) %></option>
          <% }) %>
        </select>
        <input id="busca-tienda" type="search" placeholder="Buscar por nombre o slug…"
          class="input-compact flex-1 min-w-[180px] rounded-xl px-3 py-2 text-sm border border-slate-200 dark:bg-[#0d1117] dark:border-[#30363d] dark:text-white bg-white focus:outline-none focus:border-neutral-500">
        <select id="orden-tiendas" class="sort-select rounded-xl">
          <option value="recientes">↓ Más recientes</option>
          <option value="visitas">👁 Más visitas</option>
          <option value="productos">📦 Más productos</option>
          <option value="pedidos">🧾 Más pedidos</option>
          <option value="az">A–Z</option>
        </select>
        <span id="conteo-tiendas" class="text-[11px] font-bold text-slate-400 dark:text-slate-500 shrink-0"><%= list.length %> tienda<%= list.length === 1 ? '' : 's' %></span>
      </div>

      <!-- LISTADO DE TIENDAS -->
      <div class="grid gap-3" id="tiendas-grid">
        <% list.forEach((b, i) => { %>
          <div class="store-card <%= b.expired ? 'expired' : '' %> <%= b.suspended ? 'suspended' : '' %> stagger-item"
               data-giro="<%= b.giro || '' %>" data-busca="<%= (b.name + ' ' + b.slug).toLowerCase() %>"
               data-active="<%= b.active ? 1 : 0 %>" data-plan="<%= b.plan %>" data-ads="<%= b.ads_enabled ? 1 : 0 %>"
               data-visitas="<%= b.visits_count || 0 %>" data-productos="<%= b.products_count || 0 %>" data-pedidos="<%= b.orders_count || 0 %>"
               data-creado="<%= b.created_at %>" data-nombre="<%= (b.name || '').toLowerCase() %>"
               style="animation-delay: <%= (i * 0.03) %>s">
            <div class="mc">
              <div class="mc-head">
                <img src="<%= b.logo || '/img/sin-imagen.svg' %>" class="mc-logo" alt="" data-hide-on-error />
                <div class="mc-id">
                  <p class="mc-name"><span><%= b.name %></span><a href="/<%= b.slug %>" target="_blank">/<%= b.slug %> <i class="bi bi-box-arrow-up-right"></i></a></p>
                  <p class="mc-stats">
                    <span><i class="bi bi-box-seam"></i> <%= b.products_count || 0 %> producto<%= (b.products_count || 0) === 1 ? '' : 's' %></span>
                    <span><i class="bi bi-receipt"></i> <%= b.orders_count || 0 %> pedido<%= (b.orders_count || 0) === 1 ? '' : 's' %></span>
                    <span><i class="bi bi-eye"></i> <%= b.visits_count || 0 %> visita<%= (b.visits_count || 0) === 1 ? '' : 's' %></span>
                    <span><i class="bi bi-calendar3"></i> <%= fmtFecha(b.created_at) %></span>
                  </p>
                </div>
                <span class="badge-status <%= b.active ? 'active' : 'inactive' %>"><%= b.active ? 'Activa' : 'Inactiva' %></span>
              </div>

              <div class="mc-badges">
                <% if (b.giro) { %><span class="badge-status giro clickable" onclick="filtrarPorGiro('<%= b.giro %>')" title="Filtrar por este giro"><%= b.giro %></span><% } %>
                <span class="badge-status <%= b.plan === 'pro' ? 'pro' : 'free' %>"><%= b.plan_name.toUpperCase() %></span>
                <span class="badge-status neutral">$<%= Number(b.plan_price || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',') %></span>
                <% if (b.plan_ends_at) { %>
                  <span class="badge-status <%= b.expired ? 'expired' : 'warning' %>">Vence <%= fmtFecha(b.plan_ends_at, 'fecha') %><%= b.expired ? ' · VENCIDO' : '' %></span>
                <% } %>
                <% if (b.suspended) { %><span class="badge-status suspended">Suspendida</span><% } %>
              </div>

              <div class="mc-controls">
                <div class="mc-billing">
                  <span class="mc-lbl">Vencimiento</span>
                  <div class="mc-billing-row">
                    <form method="POST" action="/maestro/<%= b.id %>/vencimiento" class="mc-pay">
                      <input type="hidden" name="plan_price" value="<%= b.plan_price || 0 %>" />
                      <input name="plan_ends_at" type="date" value="<%= b.plan_ends_at || '' %>" title="Vence el" aria-label="Vence el" class="mc-date" />
                      <button class="mc-save" title="Guardar vencimiento">Guardar</button>
                    </form>
                  </div>
                </div>

                <div class="mc-actions">
                  <% if (b.suspended) { %>
                    <form method="POST" action="/maestro/<%= b.id %>/reactivar">
                      <button class="mc-act ok"><i class="bi bi-play-circle"></i><span>Reactivar</span></button>
                    </form>
                  <% } %>
                  <form method="POST" action="/maestro/<%= b.id %>/toggle">
                    <button class="mc-act <%= b.active ? '' : 'ok' %>"><i class="bi <%= b.active ? 'bi-toggle-on' : 'bi-toggle-off' %>"></i><span><%= b.active ? 'Desactivar' : 'Activar' %></span></button>
                  </form>
                  <form method="POST" action="/maestro/<%= b.id %>/reset-pin" onsubmit="var p=prompt('Nuevo PIN para <%= b.slug %> (min 6 digitos):','123456'); if(!p){event.preventDefault();return;} this.insertAdjacentHTML('beforeend','<input type=hidden name=new_pin value=\'' + p + '\'>');">
                    <button class="mc-act" title="Resetear PIN de acceso"><i class="bi bi-key"></i><span>PIN</span></button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      </div><!-- /tab-tiendas -->

      
    </main>
  <% } %>

  <!-- ============================================================
  SCRIPT DE CONFIRMACIÓN
  ============================================================ -->
  <script>
    function toastMaestro(msg, ok) {
      Swal.fire({ toast: true, position: 'bottom', timer: 2600, timerProgressBar: true, showConfirmButton: false,
        icon: ok ? 'success' : 'error', title: msg });
    }

    // Tab switching
    function switchTab(name) {
      document.querySelectorAll('.mt-tab').forEach(function(b){ b.classList.remove('active'); });
      document.querySelectorAll('.mt-tab-panel').forEach(function(p){ p.classList.remove('active'); });
      var btn = document.getElementById('tab-btn-' + name);
      var panel = document.getElementById('tab-' + name);
      if (btn) btn.classList.add('active');
      if (panel) panel.classList.add('active');
      history.replaceState(null, '', '?tab=' + name);
    }
    // Auto-switch from URL param
    (function(){
      var t = new URLSearchParams(window.location.search).get('tab');
      if (t && document.getElementById('tab-' + t)) switchTab(t);
    })();
    (function () {
      var ok = new URLSearchParams(window.location.search).get('ok');
      if (ok) toastMaestro(ok, true);
    })();
    document.addEventListener('submit', function (e) {
      var f = e.target;
      if (f && f.hasAttribute && f.hasAttribute('data-confirm')) {
        var msg = f.getAttribute('data-confirm');
        e.preventDefault();
        Swal.fire({
          title: msg, icon: 'warning', showCancelButton: true,
          confirmButtonText: 'Sí, continuar', cancelButtonText: 'Cancelar',
          confirmButtonColor: '#dc2626', cancelButtonColor: '#64748b'
        }).then(function (r) { if (r.isConfirmed) f.submit(); });
      }
    });

    // Filtro por giro + búsqueda + tarjeta de resumen + orden en el listado de tiendas
    var filtrarPorGiro;
    (function () {
      var sel = document.getElementById('giro-filtro');
      var inp = document.getElementById('busca-tienda');
      var ordenSel = document.getElementById('orden-tiendas');
      var grid = document.getElementById('tiendas-grid');
      var conteo = document.getElementById('conteo-tiendas');
      var statCards = Array.prototype.slice.call(document.querySelectorAll('.mp-stat-card[data-stat-filter]'));
      if (!sel || !inp || !grid) return;
      var cards = Array.prototype.slice.call(document.querySelectorAll('.store-card[data-giro]'));
      var statFilter = 'all';

      filtrarPorGiro = function (g) {
        sel.value = g;
        switchTab('tiendas');
        apply();
      };

      function apply() {
        var g = sel.value, q = inp.value.trim().toLowerCase();
        var visibles = 0;
        cards.forEach(function (c) {
          var okG = !g || c.getAttribute('data-giro').toLowerCase() === g;
          var okQ = !q || (c.getAttribute('data-busca') || '').indexOf(q) !== -1;
          var okStat = true;
          if (statFilter === 'active') okStat = c.getAttribute('data-active') === '1';
          else if (statFilter === 'pro') okStat = c.getAttribute('data-plan') === 'pro';
          else if (statFilter === 'ads') okStat = c.getAttribute('data-ads') === '1';
          var show = okG && okQ && okStat;
          c.style.display = show ? '' : 'none';
          if (show) visibles++;
        });
        if (conteo) conteo.textContent = visibles + ' tienda' + (visibles === 1 ? '' : 's') + (visibles !== cards.length ? ' de ' + cards.length : '');
      }

      sel.addEventListener('change', apply);
      inp.addEventListener('input', apply);

      // Tarjetas de resumen como filtros rápidos (clic para activar/desactivar)
      statCards.forEach(function (card) {
        card.addEventListener('click', function () {
          var f = card.getAttribute('data-stat-filter');
          statFilter = (statFilter === f) ? 'all' : f;
          statCards.forEach(function (c) { c.classList.toggle('active-filter', c.getAttribute('data-stat-filter') === statFilter && statFilter !== 'all'); });
          switchTab('tiendas');
          apply();
          grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });

      // Orden del listado (recientes, visitas, productos, pedidos, A-Z)
      if (ordenSel) {
        ordenSel.addEventListener('change', function () {
          var mode = ordenSel.value;
          var sorted = cards.slice().sort(function (a, b) {
            if (mode === 'visitas') return (+b.getAttribute('data-visitas')) - (+a.getAttribute('data-visitas'));
            if (mode === 'productos') return (+b.getAttribute('data-productos')) - (+a.getAttribute('data-productos'));
            if (mode === 'pedidos') return (+b.getAttribute('data-pedidos')) - (+a.getAttribute('data-pedidos'));
            if (mode === 'az') return a.getAttribute('data-nombre').localeCompare(b.getAttribute('data-nombre'));
            return new Date(b.getAttribute('data-creado')) - new Date(a.getAttribute('data-creado'));
          });
          sorted.forEach(function (c) { grid.appendChild(c); });
        });
      }
    })();

    // Animación de conteo para las tarjetas de resumen
    (function () {
      document.querySelectorAll('.mp-stat-val').forEach(function (el) {
        var text = el.textContent.trim();
        var m = /^(\$?)(\d+)$/.exec(text);
        if (!m) return;
        var prefix = m[1], target = parseInt(m[2], 10);
        if (!target) return;
        var dur = 700, start = null;
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + Math.round(target * eased);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
      var bar = document.querySelector('.mp-adopt-bar .fill');
      if (bar) requestAnimationFrame(function () { setTimeout(function () { bar.style.width = bar.getAttribute('data-adopt-pct') + '%'; }, 80); });
    })();
  </script>
</body>
</html>