<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Reportes', biz }) %>
  <style>
    .report-number { font-variant-numeric: tabular-nums; }
    .report-table { width: 100%; border-collapse: collapse; }
    .report-table th, .report-table td { padding: .7rem .85rem; text-align: left; border-bottom: 1px solid var(--ap-border); }
    .report-table th { font-size: 10px; font-weight: 700; color: var(--ap-text-sec); white-space: nowrap; }
    .report-table td { font-size: .8rem; color: var(--ap-text); }
    .report-table tr:last-child td { border-bottom: 0; }
    .report-table tbody tr:hover { background: var(--ap-bg); }
    .report-table .number { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .report-table .details { max-width: 22rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  </style>
</head>
<body class="m-material min-h-screen" style="background:var(--ap-bg);color:var(--ap-text)">
  <%- include('admin/sidebar', { biz, active: 'reportes', canDesign }) %>
  <main class="transition-all duration-300">
    <div class="px-4 md:px-8 py-4 md:py-6 pb-24 md:pb-6">
      <%- include('admin/page-header', {
        icon: 'M3 3v18h18M7 16l4-5 3 2 5-7',
        title: 'Reportes',
        subtitle: 'Revisa pedidos, cobros y actividad de tu catálogo por período.'
      }) %>

      <form action="/<%= biz.slug %>/admin/reportes" method="GET" class="m-card p-4 mb-4 flex flex-wrap items-end gap-3">
        <div class="m-field min-w-36"><label for="report-desde">Desde</label><input id="report-desde" name="desde" type="date" value="<%= period.from %>" required></div>
        <div class="m-field min-w-36"><label for="report-hasta">Hasta</label><input id="report-hasta" name="hasta" type="date" value="<%= period.to %>" required></div>
        <button type="submit" class="m-btn m-btn-filled">Aplicar fechas</button>
        <% if (!period.error) { %><a class="m-btn m-btn-outlined" href="/<%= biz.slug %>/admin/reportes.csv?desde=<%= period.from %>&amp;hasta=<%= period.to %>">Descargar CSV</a><% } %>
      </form>

      <% if (period.error) { %>
        <div role="alert" class="m-card p-4 mb-4 text-sm font-semibold"><%= period.error %></div>
      <% } else { %>
        <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 mb-4">
          <section class="m-card p-4"><p class="text-xs" style="color:var(--ap-text-sec)">Pedidos recibidos</p><p class="report-number text-2xl font-extrabold mt-1"><%= report.count %></p></section>
          <section class="m-card p-4"><p class="text-xs" style="color:var(--ap-text-sec)">Valor de pedidos vigentes</p><p class="report-number text-2xl font-extrabold mt-1"><%= money(report.sales) %></p></section>
          <section class="m-card p-4"><p class="text-xs" style="color:var(--ap-text-sec)">Ingresos cobrados</p><p class="report-number text-2xl font-extrabold mt-1"><%= money(report.revenue) %></p></section>
          <section class="m-card p-4"><p class="text-xs" style="color:var(--ap-text-sec)">Pedidos pendientes</p><p class="report-number text-2xl font-extrabold mt-1"><%= report.pending %></p></section>
        </div>

        <section class="m-card p-4 mb-4">
          <div class="flex items-baseline justify-between flex-wrap gap-2 mb-3"><h2 class="font-extrabold text-sm">Actividad del catálogo</h2><p class="text-xs" style="color:var(--ap-text-sec)">Visitas y clics para hacer pedidos por WhatsApp</p></div>
          <div class="flex flex-wrap gap-6"><p class="text-sm"><strong class="report-number text-lg"><%= report.visits %></strong> <span style="color:var(--ap-text-sec)">visitas</span></p><p class="text-sm"><strong class="report-number text-lg"><%= report.waClicks %></strong> <span style="color:var(--ap-text-sec)">clics a WhatsApp</span></p></div>
        </section>

        <div class="grid lg:grid-cols-2 gap-4">
          <section class="m-card overflow-hidden">
            <div class="p-4 pb-2"><h2 class="font-extrabold text-sm">Por día</h2><p class="text-xs mt-1" style="color:var(--ap-text-sec)">Los cobros se muestran en la fecha en que se registraron.</p></div>
            <% if (!report.byDay.length) { %><p class="p-4 text-sm" style="color:var(--ap-text-sec)">No hay actividad en este período.</p><% } else { %>
              <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Fecha</th><th class="number">Pedidos</th><th class="number">Cobrado</th><th class="number">Visitas</th></tr></thead><tbody>
              <% report.byDay.forEach(d => { %><tr><td><%= d.date %></td><td class="number"><%= d.orders %></td><td class="number"><%= money(d.revenue) %></td><td class="number"><%= d.visits %></td></tr><% }) %>
              </tbody></table></div>
            <% } %>
          </section>
          <section class="m-card overflow-hidden">
            <div class="p-4 pb-2"><h2 class="font-extrabold text-sm">Pedidos del período</h2><p class="text-xs mt-1" style="color:var(--ap-text-sec)">Incluye pedidos cancelados; el valor de pedidos vigentes los excluye.</p></div>
            <% if (!report.orders.length) { %><p class="p-4 text-sm" style="color:var(--ap-text-sec)">No hay pedidos en este período.</p><% } else { %>
              <div class="overflow-x-auto"><table class="report-table"><thead><tr><th>Fecha</th><th>Cliente</th><th>Productos</th><th>Estado</th><th class="number">Total</th></tr></thead><tbody>
              <% report.orders.slice(0, 100).forEach(o => { %><tr><td class="whitespace-nowrap"><%= String(o.created_at).slice(0, 10) %></td><td><%= o.customer_name || 'Sin nombre' %></td><td class="details" title="<%= o.items || '' %>"><%= o.items || '—' %></td><td><%= o.status %></td><td class="number"><%= money(o.total) %></td></tr><% }) %>
              </tbody></table></div>
              <% if (report.orders.length > 100) { %><p class="p-3 text-xs" style="color:var(--ap-text-sec)">Mostrando 100 de <%= report.orders.length %> pedidos. El CSV incluye todos.</p><% } %>
            <% } %>
          </section>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
