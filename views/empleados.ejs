<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Empleados', biz }) %>
</head>
<body class="m-material employees-admin-page min-h-screen">
  <!--
    THESIS: administrar accesos debe sentirse como organizar un equipo, no como llenar una matriz de permisos.
    OWN-WORLD: suelo perla, tinta azul-negra, petróleo para acción y luz cian/violeta contenida en el editor.
    STORY: el dueño reconoce a su equipo, entiende sus accesos y crea o edita sin perder el directorio.
    FIRST VIEWPORT: encabezado breve; directorio flexible a la izquierda y editor sticky de 370px a la derecha.
    FORM: workspace asimétrico operativo; seed employee-access-workbench.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
  -->
  <svg class="employee-icon-defs" aria-hidden="true">
    <symbol id="ee-person-add" viewBox="0 0 24 24"><path d="M15 19a6 6 0 0 0-12 0v2h12v-2ZM9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm10-5v6m-3-3h6"/></symbol>
    <symbol id="ee-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
    <symbol id="ee-alert" viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.3 3.8 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.8a2 2 0 0 0-3.4 0Z"/></symbol>
    <symbol id="ee-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
    <symbol id="ee-people" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
    <symbol id="ee-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-2 2 2 2m-5 1 2 2"/></symbol>
    <symbol id="ee-pencil" viewBox="0 0 24 24"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Zm10-13 3 3"/></symbol>
    <symbol id="ee-trash" viewBox="0 0 24 24"><path d="M4 7h16m-10 4v6m4-6v6M9 4h6l1 3H8l1-3Zm-3 3 1 14h10l1-14"/></symbol>
    <symbol id="ee-person-gear" viewBox="0 0 24 24"><circle cx="8" cy="8" r="4"/><path d="M2 21v-2a6 6 0 0 1 10-4.5M18 14v2m0 4v2m-4-4h2m4 0h2m-1.2-2.8-1.4 1.4m-2.8 2.8-1.4 1.4m0-5.6 1.4 1.4m2.8 2.8 1.4 1.4"/></symbol>
    <symbol id="ee-x" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
    <symbol id="ee-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></symbol>
    <symbol id="ee-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></symbol>
    <symbol id="ee-eye-off" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.2A11 11 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-2.1 2.8M6.2 6.2C3.5 8 2 12 2 12s3.5 6 10 6c1.6 0 3-.4 4.2-1M9.9 9.9a3 3 0 0 0 4.2 4.2"/></symbol>
    <symbol id="ee-shield" viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="ee-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/></symbol>
  </svg>
  <%- include('admin/sidebar', { biz, active: 'empleados', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="employees-shell">
      <header class="employee-hero">
        <div>
          <h1>Empleados</h1>
          <p>Asigna un PIN individual y decide exactamente qué puede gestionar cada persona.</p>
        </div>
        <a href="#employee-editor" class="m-btn m-btn-filled m-btn-sm employee-add-shortcut">
          <svg class="employee-icon" aria-hidden="true"><use href="#ee-person-add"/></svg>
          <span>Nuevo empleado</span>
        </a>
      </header>

      <% if (ok) { %>
        <div class="employee-alert employee-alert--success m-pop" role="status">
          <svg class="employee-icon" aria-hidden="true"><use href="#ee-check"/></svg><span>Empleado guardado correctamente.</span>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="employee-alert employee-alert--error m-pop" role="alert">
          <svg class="employee-icon" aria-hidden="true"><use href="#ee-alert"/></svg><span><%= error %></span>
        </div>
      <% } %>

      <div class="employee-workspace">
        <section class="employee-directory" aria-labelledby="employee-directory-title">
          <div class="employee-directory__toolbar">
            <div>
              <h2 id="employee-directory-title">Tu equipo <span class="m-badge m-badge-neutral"><%= employees.length %></span></h2>
              <p><%= employees.length === 1 ? '1 acceso configurado' : employees.length + ' accesos configurados' %></p>
            </div>
            <% if (employees.length > 0) { %>
              <label class="employee-search">
                <svg class="employee-icon" aria-hidden="true"><use href="#ee-search"/></svg>
                <span class="sr-only">Buscar empleado</span>
                <input id="employee-search" type="search" placeholder="Buscar empleado…" autocomplete="off">
              </label>
            <% } %>
          </div>

          <% if (employees.length === 0) { %>
            <div class="employee-empty">
              <span class="employee-empty__icon"><svg class="employee-icon" aria-hidden="true"><use href="#ee-people"/></svg></span>
              <h3>Tu equipo empieza aquí</h3>
              <p>Crea un acceso con PIN y activa sólo los permisos que esa persona necesita.</p>
              <a href="#employee-editor" class="m-btn m-btn-outlined m-btn-sm">Agregar el primero</a>
            </div>
          <% } else { %>
            <div class="employee-list" id="employee-list">
              <% employees.forEach(e => { %>
                <article class="employee-row" data-employee-search="<%= e.name.toLowerCase() %>">
                  <div class="employee-avatar" aria-hidden="true"><%= e.name.charAt(0).toUpperCase() %></div>
                  <div class="employee-row__content">
                    <div class="employee-row__heading">
                      <h3><%= e.name %></h3>
                      <span class="employee-pin-label"><svg class="employee-icon" aria-hidden="true"><use href="#ee-key"/></svg> PIN individual</span>
                    </div>
                    <div class="employee-permission-summary">
                      <% if (e.perms.length === 0) { %>
                        <span class="employee-no-perms">Sin permisos asignados</span>
                      <% } else { %>
                        <% const employeeModules = [...new Set(e.perms.map(pk => { const perm = EMPLOYEE_PERMS.find(x => x.key === pk); return perm && perm.module; }).filter(Boolean))]; %>
                        <% employeeModules.forEach(moduleName => { %><span class="m-badge m-badge-primary"><%= moduleName %></span><% }) %>
                        <span class="employee-permission-count"><%= e.perms.length %> <%= e.perms.length === 1 ? 'permiso' : 'permisos' %></span>
                      <% } %>
                    </div>
                  </div>
                  <div class="employee-row__actions">
                    <button type="button" onclick="editarEmpleado(<%= e.id %>)" class="m-btn m-btn-sm m-btn-outlined employee-edit-button">
                      <svg class="employee-icon" aria-hidden="true"><use href="#ee-pencil"/></svg><span>Editar</span>
                    </button>
                    <form method="POST" action="/<%= biz.slug %>/admin/empleado/<%= e.id %>/eliminar" data-confirm="¿Quitar a <%= e.name %>?">
                      <button class="m-btn-icon employee-delete-button" title="Eliminar a <%= e.name %>" aria-label="Eliminar a <%= e.name %>"><svg class="employee-icon" aria-hidden="true"><use href="#ee-trash"/></svg></button>
                    </form>
                  </div>
                </article>
              <% }) %>
            </div>
            <div id="employee-search-empty" class="employee-search-empty hidden" role="status">
              <svg class="employee-icon" aria-hidden="true"><use href="#ee-search"/></svg>
              <p>No encontramos empleados con ese nombre.</p>
            </div>
          <% } %>
        </section>

        <aside class="employee-editor" id="employee-editor" aria-labelledby="emp-form-title">
          <div class="employee-editor__heading">
            <div class="employee-editor__title">
              <span><svg class="employee-icon" aria-hidden="true"><use href="#ee-person-gear"/></svg></span>
              <div>
                <h2 id="emp-form-title">Agregar empleado</h2>
                <p>Acceso y permisos</p>
              </div>
            </div>
            <button type="button" id="emp-cancel" onclick="cancelarEdicionEmpleado()" class="employee-cancel hidden" aria-label="Cancelar edición">
              <svg class="employee-icon" aria-hidden="true"><use href="#ee-x"/></svg><span>Cancelar</span>
            </button>
          </div>

          <form method="POST" action="/<%= biz.slug %>/admin/empleado" id="emp-form">
            <input type="hidden" name="emp_id" id="emp-id" value="<%= formId || '' %>">
            <div class="employee-identity-fields">
              <div class="m-field">
                <label for="emp-name">Nombre *</label>
                <input name="name" id="emp-name" required value="<%= formName || '' %>" placeholder="Ej: Ana García" autocomplete="name">
              </div>
              <div class="m-field">
                <label for="emp-pin">PIN de acceso *</label>
                <div class="employee-pin-field">
                  <svg class="employee-icon" aria-hidden="true"><use href="#ee-lock"/></svg>
                  <input name="pin" id="emp-pin" required type="password" inputmode="numeric" minlength="4" maxlength="12" pattern="[0-9]{4,12}" placeholder="4 a 12 dígitos" aria-describedby="emp-pin-hint" autocomplete="new-password">
                  <button type="button" class="employee-pin-toggle" onclick="alternarPinEmpleado(this)" aria-label="Mostrar PIN"><svg class="employee-icon" aria-hidden="true"><use href="#ee-eye"/></svg></button>
                </div>
                <p class="employee-field-hint" id="emp-pin-hint">Al editar puedes dejarlo vacío para conservar el PIN actual.</p>
              </div>
            </div>

            <fieldset class="employee-permissions">
              <legend>Permisos</legend>
              <p class="employee-permissions__intro">Activa sólo las tareas que podrá realizar.</p>
              <% const modules = [...new Set(EMPLOYEE_PERMS.map(p => p.module))]; %>
              <div class="permission-groups">
                <% modules.forEach(m => { %>
                  <section class="permission-group" aria-labelledby="perm-module-<%= m.replace(/\s+/g, '-').toLowerCase() %>">
                    <div class="permission-group__label">
                      <svg class="employee-icon" aria-hidden="true"><use href="#ee-shield"/></svg>
                      <h3 id="perm-module-<%= m.replace(/\s+/g, '-').toLowerCase() %>"><%= m %></h3>
                    </div>
                    <div class="permission-options">
                      <% EMPLOYEE_PERMS.filter(p => p.module === m).forEach(p => { %>
                        <label class="permission-option">
                          <input type="checkbox" name="perms" value="<%= p.key %>" <%= (typeof formPerms !== 'undefined' && formPerms.includes(p.key)) ? 'checked' : '' %>>
                          <span class="permission-option__control" aria-hidden="true"></span>
                          <span><%= p.label %></span>
                        </label>
                      <% }) %>
                    </div>
                  </section>
                <% }) %>
              </div>
            </fieldset>

            <div class="employee-editor__footer">
              <p><svg class="employee-icon" aria-hidden="true"><use href="#ee-info"/></svg> Sin permisos, no verá ninguna sección.</p>
              <button id="emp-submit" class="m-btn m-btn-filled">
                <svg class="employee-icon" aria-hidden="true"><use href="#ee-person-add"/></svg><span>Agregar empleado</span>
              </button>
            </div>
          </form>
        </aside>
      </div>
    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <style>
    .employees-admin-page {
      --ee-ink:#17232d;
      --ee-muted:#52616c;
      --ee-petrol:#2c2c2e;
      --ee-petrol-soft:#454548;
      --ee-line:rgba(44,44,46,.11);
      --ee-card:rgba(255,255,255,.90);
      color:var(--ee-ink);
      background-color:#f7f7f8;
    }
    .employee-icon-defs { position:absolute; width:0; height:0; overflow:hidden; }
    .employee-icon { width:1em; height:1em; flex:none; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .employees-admin-page ::selection { background:rgba(44,44,46,.22); color:#10283d; }
    .employees-shell { max-width:1480px; margin:0 auto; padding:28px 30px 44px; }
    .employee-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; }
    .employee-hero h1 { margin:0; color:#151d23; font:900 22px/1.15 Inter,system-ui,sans-serif; letter-spacing:-.025em; }
    .employee-hero p { max-width:62ch; margin:6px 0 0; color:var(--ee-muted); font-size:13px; line-height:1.5; }
    .employee-add-shortcut { flex:none; }
    .employee-alert { display:flex; align-items:center; gap:9px; margin-bottom:16px; padding:11px 14px; border-radius:12px; font-size:13px; font-weight:700; }
    .employee-alert--success { color:#176044; background:#e9f8f0; }
    .employee-alert--error { color:#9d2f36; background:#fdeff0; }
    .employee-workspace { display:grid; grid-template-columns:minmax(0,1fr) 370px; gap:18px; align-items:start; }
    .employee-directory { min-width:0; }
    .employee-directory__toolbar { display:flex; align-items:center; justify-content:space-between; gap:14px; min-height:46px; padding:0 2px 12px; border-bottom:1px solid var(--ee-line); }
    .employee-directory__toolbar h2 { display:flex; align-items:center; gap:7px; margin:0; color:var(--ee-ink); font-size:15px; font-weight:850; letter-spacing:-.015em; }
    .employee-directory__toolbar p { margin:3px 0 0; color:#687781; font-size:11px; font-weight:600; }
    .employee-search { position:relative; display:block; width:min(240px,42vw); }
    .employee-search > .employee-icon { position:absolute; inset-inline-start:12px; top:50%; transform:translateY(-50%); color:#596a75; font-size:13px; pointer-events:none; }
    .employee-search input { width:100%; min-height:36px; padding:8px 12px 8px 34px; border:1px solid rgba(44,44,46,.12); border-radius:999px; outline:none; background:rgba(255,255,255,.78); color:var(--ee-ink); font:500 12px/1.4 Inter,system-ui,sans-serif; box-shadow:0 3px 10px rgba(20,24,31,.05); }
    .employee-search input:focus { border-color:rgba(44,44,46,.58); box-shadow:0 0 0 3px rgba(44,44,46,.10); }
    .employee-search input::placeholder { color:#65737c; opacity:1; }
    .employee-list { display:grid; gap:10px; margin-top:12px; }
    .employee-row { display:grid; grid-template-columns:44px minmax(0,1fr) auto; align-items:center; gap:12px; min-width:0; padding:13px 14px; border-radius:14px; background:var(--ee-card); box-shadow:0 7px 20px rgba(20,24,31,.08),0 2px 5px rgba(20,24,31,.04); transition:transform .22s cubic-bezier(.22,1,.36,1),box-shadow .22s ease; }
    .employee-row:hover { transform:translateY(-2px); box-shadow:0 13px 25px rgba(20,24,31,.12),0 3px 7px rgba(20,24,31,.05); }
    .employee-row.hidden { display:none; }
    .employee-avatar { display:grid; place-items:center; width:44px; height:44px; border-radius:12px; color:#fff; background:var(--ee-petrol); font-size:16px; font-weight:850; box-shadow:0 5px 12px rgba(44,44,46,.20); }
    .employee-row__content { min-width:0; }
    .employee-row__heading { display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
    .employee-row__heading h3 { margin:0; overflow:hidden; color:var(--ee-ink); font-size:13px; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
    .employee-pin-label { display:inline-flex; align-items:center; gap:4px; color:#687781; font-size:10px; font-weight:650; }
    .employee-permission-summary { display:flex; align-items:center; gap:5px; flex-wrap:wrap; margin-top:5px; }
    .employee-permission-summary .m-badge { min-height:20px; border-radius:6px; font-size:9px; }
    .employee-permission-count,.employee-no-perms { color:#74818a; font-size:10px; font-weight:650; }
    .employee-row__actions { display:flex; align-items:center; gap:5px; }
    .employee-edit-button { min-height:34px !important; }
    .employee-delete-button { width:34px !important; height:34px !important; color:#78848d; }
    .employee-delete-button:hover { color:#b43d45 !important; background:#fff0f1 !important; }
    .employee-empty,.employee-search-empty { min-height:290px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; margin-top:12px; padding:38px 22px; border:1px dashed rgba(44,44,46,.17); border-radius:14px; text-align:center; background:rgba(255,255,255,.55); }
    .employee-empty__icon { display:grid; place-items:center; width:54px; height:54px; margin-bottom:3px; border-radius:16px; color:var(--ee-petrol); background:rgba(44,44,46,.09); font-size:23px; }
    .employee-empty h3 { margin:0; color:#25323b; font-size:15px; font-weight:850; }
    .employee-empty p { max-width:42ch; margin:0 0 8px; color:#66757f; font-size:12px; line-height:1.55; }
    .employee-search-empty { min-height:190px; color:#687781; font-size:12px; }
    .employee-search-empty.hidden { display:none; }
    .employee-search-empty .employee-icon { color:var(--ee-petrol); font-size:22px; }
    .employee-editor { position:sticky; top:16px; max-height:calc(100vh - 32px); overflow:auto; border-radius:15px; background:#fff; border:1px solid rgba(44,44,46,.09); box-shadow:0 8px 24px rgba(20,24,31,.09); scrollbar-width:thin; scrollbar-color:rgba(44,44,46,.24) transparent; }
    .employee-editor__heading { position:sticky; top:0; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:15px 16px 12px; background:rgba(255,255,255,.92); backdrop-filter:blur(12px); border-bottom:1px solid rgba(44,44,46,.08); }
    .employee-editor__title { display:flex; align-items:center; gap:10px; min-width:0; }
    .employee-editor__title > span { display:grid; place-items:center; width:34px; height:34px; flex:none; border-radius:10px; color:#fff; background:var(--ee-petrol); box-shadow:0 5px 12px rgba(44,44,46,.20); }
    .employee-editor.is-editing .employee-editor__title > span { animation:employeeModeShift .42s cubic-bezier(.22,1,.36,1); }
    @keyframes employeeModeShift { 0% { transform:scale(.88); filter:blur(2px); } 100% { transform:none; filter:none; } }
    .employee-editor__title h2 { margin:0; color:var(--ee-ink); font-size:14px; font-weight:850; letter-spacing:-.015em; }
    .employee-editor__title p { margin:2px 0 0; color:#74818a; font-size:10px; font-weight:650; }
    .employee-cancel { display:inline-flex; align-items:center; gap:4px; min-height:30px; padding:6px 8px; border-radius:8px; color:#a13b43; font-size:10px; font-weight:750; }
    .employee-cancel:hover { background:rgba(180,61,69,.08); }
    .employee-cancel.hidden { display:none; }
    #emp-form { padding:15px 16px 16px; }
    .employee-identity-fields { display:grid; gap:12px; }
    /* El label flotante y los estados de foco de .m-field ahora viven en
       material.css (diseño compartido) — solo queda aquí lo que sí es
       propio de esta página (el campo compuesto del PIN). */
    .employee-pin-field { width:100%; min-height:39px; border:1px solid rgba(44,44,46,.16); border-radius:8px; background:rgba(255,255,255,.78); transition:border-color .18s ease,background .18s ease,box-shadow .18s ease; }
    .employee-pin-field:focus-within { outline:none; border-color:rgba(44,44,46,.58); background:#fff; box-shadow:0 0 0 3px rgba(44,44,46,.10); }
    .employee-pin-field { display:grid; grid-template-columns:30px minmax(0,1fr) 34px; align-items:center; padding:0 3px 0 7px; }
    .employee-pin-field > .employee-icon { color:#596a75; justify-self:center; }
    .employee-pin-field input { min-width:0; height:37px; padding:7px 5px; border:0; outline:0; background:transparent; color:var(--ee-ink); font:400 13.6px/1.5 Inter,system-ui,sans-serif; }
    .employee-pin-toggle { display:grid; place-items:center; width:30px; height:30px; border-radius:8px; color:#5f707c; }
    .employee-pin-toggle:hover { color:var(--ee-petrol); background:rgba(44,44,46,.08); }
    .employee-field-hint { margin:4px 1px 0; color:#586975; font-size:10px; line-height:1.45; }
    .employee-permissions { margin:16px 0 0; padding:0; border:0; }
    .employee-permissions legend { padding:0; color:#33434e; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.025em; }
    .employee-permissions__intro { margin:3px 0 7px; color:#6a7983; font-size:10px; }
    .permission-groups { border-top:1px solid rgba(44,44,46,.09); }
    .permission-group { display:grid; grid-template-columns:92px minmax(0,1fr); gap:9px; padding:10px 0; border-bottom:1px solid rgba(44,44,46,.09); }
    .permission-group__label { display:flex; align-items:flex-start; gap:6px; padding-top:6px; color:#51636f; }
    .permission-group__label .employee-icon { color:var(--ee-petrol-soft); font-size:12px; }
    .permission-group__label h3 { margin:0; font-size:10px; font-weight:800; line-height:1.4; }
    .permission-options { display:grid; gap:5px; }
    .permission-option { position:relative; display:grid; grid-template-columns:18px minmax(0,1fr); align-items:center; gap:7px; min-height:32px; padding:6px 8px; border-radius:8px; color:#465862; background:rgba(255,255,255,.55); font-size:10.5px; font-weight:600; line-height:1.35; cursor:pointer; transition:background .16s ease,color .16s ease; }
    .permission-option:hover { color:#213b50; background:rgba(255,255,255,.90); }
    .permission-option input { position:absolute; width:1px; height:1px; opacity:0; }
    .permission-option__control { display:grid; place-items:center; width:18px; height:18px; border:1px solid rgba(44,44,46,.24); border-radius:5px; color:transparent; background:#fff; transition:background .16s ease,border-color .16s ease; }
    .permission-option__control::after { content:''; width:7px; height:4px; border-left:2px solid currentColor; border-bottom:2px solid currentColor; transform:translateY(-1px) rotate(-45deg); }
    .permission-option input:checked + .permission-option__control { border-color:var(--ee-petrol-soft); color:#fff; background:var(--ee-petrol-soft); }
    .permission-option input:focus-visible + .permission-option__control { outline:3px solid rgba(44,44,46,.18); outline-offset:2px; }
    .employee-editor__footer { display:grid; gap:10px; margin-top:13px; }
    .employee-editor__footer p { display:flex; align-items:center; gap:5px; margin:0; color:#667781; font-size:10px; }
    .employee-editor__footer .m-btn { width:100%; min-height:42px; }
    @media (max-width:1179px) {
      .employee-workspace { grid-template-columns:1fr; }
      .employee-editor { position:relative; top:auto; max-height:none; overflow:visible; }
    }
    @media (max-width:767px) {
      .employees-shell { padding:20px 14px 92px; }
      .employee-hero { align-items:flex-start; margin-bottom:18px; }
      .employee-hero h1 { font-size:20px; }
      .employee-hero p { font-size:12px; }
      .employee-add-shortcut span,.employee-edit-button span,.employee-cancel span { display:none; }
      .employee-add-shortcut { width:38px; min-width:38px !important; padding:0 !important; }
      .employee-directory__toolbar { align-items:flex-start; flex-direction:column; }
      .employee-search { width:100%; }
      .employee-row { grid-template-columns:40px minmax(0,1fr) auto; gap:10px; padding:11px; }
      .employee-avatar { width:40px; height:40px; }
      .employee-row__actions { gap:3px; }
      .employee-edit-button { width:34px; min-width:34px !important; padding:0 !important; }
      .permission-group { grid-template-columns:1fr; gap:5px; }
      .permission-group__label { padding-top:0; }
      .employee-empty { min-height:240px; }
    }
    body.dark.employees-admin-page { --ee-ink:#e6edf3; --ee-muted:#9ba9b4; --ee-line:rgba(255,255,255,.1); --ee-card:#161b22; background-color:#0d1117; }
    body.dark .employee-hero h1,body.dark .employee-directory__toolbar h2,body.dark .employee-row__heading h3,body.dark .employee-empty h3,body.dark .employee-editor__title h2 { color:var(--ee-ink); }
    body.dark .employee-search input,body.dark .employee-empty,body.dark .employee-search-empty { color:#d5dee5; background:rgba(21,28,34,.84); }
    body.dark .employee-editor { background:#161b22; border-color:rgba(255,255,255,.08); }
    body.dark .employee-editor__heading { background:rgba(22,27,34,.92); }
    body.dark .employees-admin-page .m-field > input,body.dark .employee-pin-field,body.dark .permission-option { color:#e6edf3; background:rgba(19,25,31,.74); }
    body.dark .permission-option__control { background:#151c22; }
  </style>

  <script>
    var EMPLEADOS = <%- safeJson(employees.map(e => ({ id: e.id, name: e.name, perms: e.perms }))) %>;

    function editarEmpleado(id) {
      var employee = EMPLEADOS.find(function (item) { return item.id === id; });
      if (!employee) return;
      document.getElementById('emp-id').value = id;
      document.getElementById('emp-name').value = employee.name;
      document.getElementById('emp-pin').value = '';
      document.getElementById('emp-pin').removeAttribute('required');
      document.getElementById('emp-pin-hint').textContent = 'Déjalo vacío para conservar el PIN actual o escribe uno nuevo.';
      document.querySelectorAll('#emp-form [name="perms"]').forEach(function (checkbox) { checkbox.checked = employee.perms.indexOf(checkbox.value) !== -1; });
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado/' + id;
      document.getElementById('emp-form-title').textContent = 'Editar empleado';
      document.querySelector('#emp-submit span').textContent = 'Guardar cambios';
      document.querySelector('#emp-submit use').setAttribute('href', '#ee-check');
      document.getElementById('emp-cancel').classList.remove('hidden');
      document.getElementById('employee-editor').classList.add('is-editing');
      document.getElementById('employee-editor').scrollIntoView({ behavior:'smooth', block:'start' });
      setTimeout(function () { document.getElementById('emp-name').focus(); }, 280);
    }

    function cancelarEdicionEmpleado() {
      document.getElementById('emp-id').value = '';
      document.getElementById('emp-name').value = '';
      document.getElementById('emp-pin').value = '';
      document.getElementById('emp-pin').type = 'password';
      document.getElementById('emp-pin').setAttribute('required', '');
      document.getElementById('emp-pin-hint').textContent = 'Al editar puedes dejarlo vacío para conservar el PIN actual.';
      document.querySelectorAll('#emp-form [name="perms"]').forEach(function (checkbox) { checkbox.checked = false; });
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado';
      document.getElementById('emp-form-title').textContent = 'Agregar empleado';
      document.querySelector('#emp-submit span').textContent = 'Agregar empleado';
      document.querySelector('#emp-submit use').setAttribute('href', '#ee-person-add');
      document.getElementById('emp-cancel').classList.add('hidden');
      document.getElementById('employee-editor').classList.remove('is-editing');
    }

    function alternarPinEmpleado(button) {
      var input = document.getElementById('emp-pin');
      var showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      button.setAttribute('aria-label', showing ? 'Mostrar PIN' : 'Ocultar PIN');
      button.querySelector('use').setAttribute('href', showing ? '#ee-eye' : '#ee-eye-off');
      input.focus();
    }

    var employeeSearch = document.getElementById('employee-search');
    if (employeeSearch) employeeSearch.addEventListener('input', function () {
      var query = employeeSearch.value.trim().toLowerCase();
      var visible = 0;
      document.querySelectorAll('[data-employee-search]').forEach(function (row) {
        var matches = (row.getAttribute('data-employee-search') || '').indexOf(query) !== -1;
        row.classList.toggle('hidden', !matches);
        if (matches) visible++;
      });
      var empty = document.getElementById('employee-search-empty');
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    });

    var editId = <%- typeof formId !== 'undefined' && formId ? safeJson(formId) : 'null' %>;
    if (editId) {
      document.getElementById('emp-form').action = '/<%= biz.slug %>/admin/empleado/' + editId;
      document.getElementById('emp-form-title').textContent = 'Editar empleado';
      document.querySelector('#emp-submit span').textContent = 'Guardar cambios';
      document.querySelector('#emp-submit use').setAttribute('href', '#ee-check');
      document.getElementById('emp-cancel').classList.remove('hidden');
      document.getElementById('employee-editor').classList.add('is-editing');
      document.getElementById('emp-pin').removeAttribute('required');
      document.getElementById('emp-pin-hint').textContent = 'Déjalo vacío para conservar el PIN actual o escribe uno nuevo.';
    }
  </script>
</body>
</html>
