<script>
  tailwind.config = {
    // Dark mode por CLASE (body.dark), controlado por el switch del panel —
    // no por la preferencia del dispositivo ('media'), que pintaba páginas en negro con el modo claro activo.
    darkMode: 'class',
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'system-ui', 'sans-serif'],
          display: ['Playfair Display', 'serif']
        },
        boxShadow: {
          card: '0 1px 2px 0 rgb(0 0 0 / 0.04), 0 1px 3px 0 rgb(0 0 0 / 0.05)',
          float: '0 10px 30px -10px rgb(0 0 0 / 0.18)'
        }
      }
    }
  };
</script>
<style>
  /* ===== ADMIN PANEL — CORPORATE MINIMAL 2026 ===== */
  :root {
    /* Paleta "Nessik" (ver DESIGN.md): gris neutro + grafito, con un solo
       acento (petróleo) reservado para acción y selección. Sin luz ambiental
       ni degradados decorativos — la superficie hace el trabajo, no el color. */
    --ap-bg: #f7f7f8;
    --ap-card: #ffffff;
    --ap-text: #15181d;
    --ap-text-sec: #61666e;
    --ap-accent: #2c2c2e;
    --ap-accent-light: #454548;
    --ap-accent-text: #2c2c2e;
    --ap-accent-gold: #b08a4e;
    --ap-accent-green: #2d6a4f;
    --ap-border: rgba(21,24,29,.09);
    --ap-shadow: 0 1px 2px rgba(20,24,31,.04);
    --ap-shadow-md: 0 2px 8px rgba(20,24,31,.06);
    --ap-shadow-lg: 0 8px 24px rgba(20,24,31,.09);
    --ap-shadow-xl: 0 16px 40px rgba(20,24,31,.12);
    --ap-radius: 12px;
    --ap-radius-sm: 8px;
    --ap-gradient: var(--ap-accent);
    --ap-motion: .2s cubic-bezier(.22, 1, .36, 1);
    --ap-motion-fast: .14s cubic-bezier(.22, 1, .36, 1);
  }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--ap-bg);
    color: var(--ap-text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  /* ---- Selección de texto ---- */
  ::selection { background: rgba(44,44,46,0.1); color: var(--ap-text); }

  /* ---- Focus visible global ---- */
  :focus-visible {
    outline: 2px solid var(--ap-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ===== SCROLLBAR ===== */
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(21,24,29,0.15); border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(21,24,29,0.3); }
  .scrollbar-thin::-webkit-scrollbar { width: 5px; height: 5px; }
  .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(44,44,46,0.12); border-radius: 10px; }
  .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }

  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* ===== ANIMACIONES ===== */
  .fade-in {
    animation: fadeIn .5s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  .toast-in {
    animation: toastIn .5s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes toastIn {
    from { opacity: 0; transform: translateY(16px) scale(.95); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(44,44,46,0.15); }
    50% { box-shadow: 0 0 0 8px rgba(44,44,46,0); }
  }
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  .animate-slide-up {
    animation: slideUp .6s cubic-bezier(.22,1,.36,1) both;
  }

  /* ===== SIDEBAR ===== */
  .m-sidebar {
    transition: width var(--ap-motion);
  }
  .m-sidebar a, .m-sidebar button {
    transition: background var(--ap-motion), color var(--ap-motion), border-color var(--ap-motion);
    border-radius: var(--ap-radius-sm);
    border-left: 2.5px solid transparent;
  }
  .m-sidebar a:hover, .m-sidebar button:hover {
    background: rgba(21,24,29,0.05);
  }
  /* Activo: acento tenue + barra lateral + ícono/texto en el color de marca
     de la tienda — más sobrio que un bloque sólido, lee "seleccionado" sin
     gritar, y sigue usando el acento de cada tienda (no un color fijo). */
  .m-sidebar a.m-active-nav {
    background: color-mix(in srgb, var(--ap-accent) 10%, transparent) !important;
    border-left-color: var(--ap-accent);
    color: var(--ap-accent) !important;
    font-weight: 700;
  }
  .m-sidebar a.m-active-nav svg {
    color: var(--ap-accent) !important;
  }
  .m-sidebar-group-label {
    padding: 0 0.75rem;
    margin: 1.1rem 0 0.35rem;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ap-text-sec);
    opacity: .68;
  }
  .m-sidebar-group:first-child .m-sidebar-group-label { margin-top: 0; }

  /* ===== CARDS ===== */
  .m-card {
    background: var(--ap-card);
    border: 1px solid var(--ap-border);
    border-radius: var(--ap-radius);
    box-shadow: var(--ap-shadow);
    transition: border-color var(--ap-motion), box-shadow var(--ap-motion);
    position: relative;
    overflow: hidden;
  }
  .m-card:hover {
    box-shadow: var(--ap-shadow-md);
    border-color: rgba(21,24,29,0.14);
  }
  .m-card-highlight {
    position: relative;
    overflow: visible;
    border-color: rgba(44,44,46,0.25) !important;
  }

  /* ===== BOTONES ===== */
  .m-btn {
    border-radius: var(--ap-radius-sm) !important;
    font-weight: 600;
    transition: background var(--ap-motion), border-color var(--ap-motion), color var(--ap-motion);
    position: relative;
    overflow: hidden;
    letter-spacing: 0.01em;
  }
  .m-btn:active {
    transform: scale(.98);
    transition-duration: .1s;
  }
  .m-btn:focus-visible {
    outline: 2px solid var(--ap-accent);
    outline-offset: 2px;
  }
  .m-btn-filled {
    background: var(--ap-accent) !important;
    color: #fff !important;
  }
  .m-btn-filled:hover {
    background: var(--ap-accent-light) !important;
  }

  /* ===== GLASS HEADER ===== */
  .m-header {
    background: rgba(247,247,248,.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--ap-border);
  }

  /* ===== METRIC CARDS ===== */
  .metric-card {
    position: relative;
    overflow: hidden;
    background: var(--ap-card);
    border: 1px solid var(--ap-border);
    border-radius: var(--ap-radius);
    box-shadow: var(--ap-shadow);
    transition: border-color var(--ap-motion), box-shadow var(--ap-motion);
  }
  .metric-card:hover {
    box-shadow: var(--ap-shadow-md);
    border-color: rgba(21,24,29,0.14);
  }

  .metric-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--ap-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .metric-icon.blue { background: rgba(44,44,46,0.08); color: var(--ap-accent); }
  .metric-icon.green { background: rgba(45,106,79,0.08); color: #2d6a4f; }
  .metric-icon.gold { background: rgba(176,138,78,0.1); color: #8a6a38; }
  .metric-icon.purple { background: rgba(107,79,160,0.08); color: #6b4fa0; }

  /* ===== BARRAS DE PROGRESO ===== */
  .progress-bar {
    height: 6px;
    border-radius: 10px;
    background: rgba(21,24,29,0.06);
    overflow: hidden;
    position: relative;
  }
  .progress-bar-fill {
    height: 100%;
    border-radius: 10px;
    transition: width .6s cubic-bezier(.22,1,.36,1);
    position: relative;
  }
  .progress-bar-fill.blue { background: var(--ap-accent); }
  .progress-bar-fill.green { background: #2d6a4f; }
  .progress-bar-fill.gold { background: #b08a4e; }
  .progress-bar-fill.purple { background: #6b4fa0; }

  /* ===== BADGES ===== */
  .m-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 22px;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: all .2s ease;
  }
  .m-badge-success { background: rgba(45,106,79,0.08); color: #2d6a4f; }
  .m-badge-warn { background: rgba(201,168,108,0.12); color: #a07d3c; }
  .m-badge-error { background: rgba(180,50,50,0.08); color: #b43232; }
  .m-badge-neutral { background: rgba(0,0,0,.04); color: #6b6562; }
  .m-badge-primary { background: rgba(44,44,46,0.08); color: #2c2c2e; }

  /* ===== GRÁFICAS ===== */
  .chart-bar {
    border-radius: 6px 6px 2px 2px;
    transition: height .8s cubic-bezier(.22,1,.36,1), filter .2s;
    position: relative;
  }
  .chart-bar:hover {
    filter: brightness(1.15);
  }
  .chart-bar.blue { background: var(--ap-accent); }
  .chart-bar.green { background: #2d6a4f; }
  .chart-bar.gold { background: #b08a4e; }

  /* ===== PEDIDOS ===== */
  .order-row {
    transition: all var(--ap-motion);
    border-radius: var(--ap-radius-sm);
    border-left: 3px solid transparent;
  }
  .order-row:hover {
    background: rgba(44,44,46,0.02);
    border-left-color: var(--ap-accent);
  }

  /* ===== SHARE CARD ===== */
  .share-card {
    background: var(--ap-gradient);
    border: none;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  /* ===== LOW STOCK WARNING ===== */
  .warning-card {
    background: #fdf8f0;
    border: 1px solid rgba(176,138,78,0.25);
    border-radius: var(--ap-radius);
    position: relative;
    overflow: hidden;
  }

  /* ===== CHIPS ===== */
  .m-chip {
    border-radius: var(--ap-radius-sm);
    font-weight: 600;
    transition: background var(--ap-motion), border-color var(--ap-motion), color var(--ap-motion);
  }
  .m-chip:hover {
    background: rgba(21,24,29,0.04);
    border-color: var(--ap-accent-light);
  }
  .m-chip-selected {
    background: var(--ap-accent) !important;
    color: #fff !important;
    border-color: transparent !important;
  }
  .m-chip-selected::before { content: '✓ '; }

  /* ===== LIST ITEMS ===== */
  .m-list-item {
    border-radius: var(--ap-radius-sm);
    transition: background var(--ap-motion), border-color var(--ap-motion);
    border-left: 3px solid transparent;
  }
  .m-list-item:hover {
    background: rgba(21,24,29,0.03);
    border-left-color: var(--ap-accent);
  }

  /* ===== BOTTOM NAV ===== */
  .m-bottomnav {
    border-radius: 18px 18px 0 0;
    background: rgba(255,255,255,.97);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--ap-border);
  }

  /* ===== MODAL ===== */
  .modal-overlay {
    background: rgba(15,18,22,.35);
    backdrop-filter: blur(6px);
  }

  /* ===== DARK MODE ===== */
  /* El tema del panel lo decide el switch de la app (clase body.dark), no el
     SO — pero los controles nativos (inputs, checkboxes, selects, date
     pickers) pintan sus colores por defecto según color-scheme, y esa
     propiedad heredaba "light dark" del <meta> de arriba, es decir seguía
     al SO. Con el celular/PC en modo oscuro del sistema pero la app en modo
     claro, algunos inputs salían oscuros "de la nada" aunque el resto de la
     UI se viera clara. Se ata explícitamente al mismo interruptor.
     El <meta color-scheme> de la cabecera ya quedó fijo en "light"; aquí solo
     se activa "dark" cuando la propia app lo pide. */
  body.dark { color-scheme: dark; }
  body:not(.dark) { color-scheme: light; }
  body.dark {
    --ap-bg: #0d1117;
    --ap-card: #161b22;
    --ap-text: #e6edf3;
    --ap-text-sec: #8b949e;
    --ap-accent-text: #d4d4d4;
    --ap-border: rgba(255,255,255,.07);
    --ap-shadow: 0 1px 2px rgba(0,0,0,.25);
    --ap-shadow-md: 0 2px 10px rgba(0,0,0,.32);
    --ap-shadow-lg: 0 10px 30px rgba(0,0,0,.4);
    --ap-shadow-xl: 0 20px 50px rgba(0,0,0,.5);
  }
  body.dark ::selection { background: rgba(74,122,156,0.2); }
  body.dark .m-header {
    background: rgba(13,17,23,.9);
    border-bottom-color: rgba(255,255,255,.05);
  }
  body.dark .m-sidebar a:hover { background: rgba(255,255,255,0.06); }
  body.dark .m-sidebar a.m-active-nav { background: color-mix(in srgb, var(--ap-accent) 18%, transparent) !important; }
  body.dark .order-row:hover { background: rgba(255,255,255,0.03); }
  body.dark .warning-card { background: #1a1510; border-color: rgba(176,138,78,.2); }
  body.dark .m-bottomnav { background: rgba(22,27,34,.97); }
  body.dark .progress-bar { background: rgba(255,255,255,0.07); }
  body.dark :focus-visible { outline-color: #d4d4d4; }

  /* ===== SIDEBAR TOGGLE ===== */
  /* Con el sidebar abierto, va anclado a su borde derecho para no montarse
     sobre el logo del perfil; solo baja a la esquina de la página cuando
     el sidebar está colapsado (ver reglas de abajo). */
  .sidebar-toggle {
    position: fixed;
    top: 16px;
    left: calc(15rem - 52px);
    z-index: 46;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid var(--ap-border);
    background: var(--ap-card);
    color: var(--ap-text);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--ap-motion);
    box-shadow: var(--ap-shadow-md);
  }
  .sidebar-toggle:hover {
    background: var(--ap-accent);
    color: #fff;
    border-color: var(--ap-accent);
    transform: scale(1.05);
  }
  .sidebar-toggle:active { transform: scale(0.95); }
  .sidebar-toggle:focus-visible {
    outline: 2px solid var(--ap-accent);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .sidebar-toggle { display: flex; }
  }

  /* Sidebar: curva de easing más suave que la de Tailwind (mayor especificidad, no pisa transition-property) */
  aside.fixed,
  main.transition-all {
    transition-duration: .3s;
    transition-timing-function: cubic-bezier(.22, 1, .36, 1);
  }

  /* Sidebar colapsado */
  body.sidebar-closed aside {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
  }
  body.sidebar-closed main {
    padding-left: 0 !important;
  }
  body.sidebar-closed .sidebar-toggle {
    left: 16px;
  }
  /* Con el sidebar colapsado, el botón flota sobre la esquina superior izquierda
     del contenido — se reserva espacio arriba para que no tape encabezados. */
  @media (min-width: 768px) {
    body.sidebar-closed main > div:first-child {
      padding-top: 56px;
    }
  }

  /* Sidebar abierto */
  body:not(.sidebar-closed) aside {
    transform: translateX(0);
    opacity: 1;
  }
  body:not(.sidebar-closed) main {
    padding-left: 15rem;
  }
  @media (max-width: 767px) {
    body:not(.sidebar-closed) main,
    body.sidebar-closed main {
      padding-left: 0 !important;
    }
  }

  /* Overlay móvil para sidebar — se desvanece en vez de aparecer de golpe */
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.3);
    backdrop-filter: blur(4px);
    z-index: 39;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--ap-motion), visibility var(--ap-motion);
  }
  body.sidebar-open .sidebar-overlay {
    opacity: 1;
    visibility: visible;
  }
  body.sidebar-open aside {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== ACCESIBILIDAD: respetar "reducir movimiento" ===== */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .fade-in, .toast-in, .animate-slide-up, .m-card::before, .progress-bar-fill::after {
      animation: none !important;
    }
    *, *::before, *::after {
      transition-duration: .001ms !important;
      animation-duration: .001ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
