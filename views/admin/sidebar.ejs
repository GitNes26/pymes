      <img src="<%= avatar %>" class="w-8 h-8 rounded-lg object-cover shrink-0">
      <span class="font-extrabold text-sm truncate"><%= biz.name %></span>
    </a>
    <div class="admin-mobile-topbar__actions">
      <a href="/<%= biz.slug %>" target="_blank" class="admin-mobile-topbar__action" title="Ver catálogo" aria-label="Ver catálogo público">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
      </a>
