  <%- include('partials/img-editor', { upUrl: (esMaestro ? '/maestro/' + biz.id + '/upload' : '/' + biz.slug + '/admin/upload'), z: 9000 }) %>
<script>
    // Quitar logo o banner por separado (el servidor recibe logo_clear / banner_clear)
    function quitarImagenTienda(cual) {
      var url = document.getElementById(cual + '-url'), clr = document.getElementById(cual + '-clear'), prev = document.getElementById('prev-' + cual), btn = document.getElementById('quitar-' + cual);
      if (url) url.value = '';
      if (clr) clr.value = '1';
      if (prev) prev.src = '/img/sin-imagen.svg';
      if (btn) btn.classList.add('hidden');
      if (window.mostrarToast) mostrarToast((cual === 'logo' ? 'Logo' : 'Banner') + ' quitado: pulsa Guardar cambios para aplicarlo', 'info');
    }
    function subirConEditor(inputId, campoId, previewId, aspecto) {
      // Logo y banner: el servidor recorta franjas vacías pegadas a un borde de la foto
      window.__imgeTrim = (campoId === 'logo-url' || campoId === 'banner-url');
      var input = document.getElementById(inputId);
      if (!input || !input.files || !input.files[0]) return;
      var f = input.files[0];
      var rd = new FileReader();
      rd.onload = function () {
        abrirEditorImagen(rd.result, function (url) {
          var campo = document.getElementById(campoId);
          if (campo) { campo.value = url; campo.dispatchEvent(new Event('change')); }
          var fl = /-url$/.test(String(campoId)) ? document.getElementById(String(campoId).replace(/-url$/, '-clear')) : null; if (fl) fl.value = '';
          var qb = document.getElementById(String(campoId).replace('-url', '').replace(/^/, 'quitar-')); if (qb && /^(logo|banner)-url$/.test(campoId)) qb.classList.remove('hidden');
          var prev = document.getElementById(previewId);
          if (prev) prev.src = url;
          if (window.mostrarToast) mostrarToast('Imagen aplicada ✓', 'ok');
        }, null, aspecto);
      };
      rd.readAsDataURL(f);
      input.value = '';
    }

    // Geolocaliza al dueño y convierte las coordenadas a una dirección legible
    // (reverse geocoding con Nominatim/OpenStreetMap — gratis, sin API key).
    function detectarUbicacion() {
      var btn = document.getElementById('f-address-detect');
      var input = document.getElementById('f-address');
      if (!input || !btn) return;
      if (!navigator.geolocation) {
        if (window.mostrarToast) mostrarToast('Tu navegador no soporta detectar ubicación.', 'error');
        return;
      }
      var original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>Detectando…</span>';
      navigator.geolocation.getCurrentPosition(function (pos) {
        var lat = pos.coords.latitude, lon = pos.coords.longitude;
        fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon + '&zoom=18&addressdetails=1', {
          headers: { 'Accept-Language': 'es' }
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d && d.display_name) {
              input.value = d.display_name;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              if (window.mostrarToast) mostrarToast('Ubicación detectada ✓', 'ok');
            } else {
              input.value = lat.toFixed(6) + ', ' + lon.toFixed(6);
              if (window.mostrarToast) mostrarToast('Se detectaron las coordenadas, pero no una dirección exacta.', 'info');
            }
          })
          .catch(function () {
            input.value = lat.toFixed(6) + ', ' + lon.toFixed(6);
            if (window.mostrarToast) mostrarToast('Se detectaron las coordenadas; no se pudo traducir a dirección.', 'error');
          })
          .finally(function () { btn.disabled = false; btn.innerHTML = original; });
      }, function (err) {
        btn.disabled = false; btn.innerHTML = original;
        var msg = err && err.code === 1 ? 'Permiso de ubicación denegado.' : 'No se pudo obtener tu ubicación.';
        if (window.mostrarToast) mostrarToast(msg, 'error');
      }, { enableHighAccuracy: true, timeout: 10000 });
    }

  </script>

  <script>
    // WhatsApp de ventas: máximo 10 dígitos, solo números
    (function () {
      var wa = document.getElementById('config-whatsapp');
      if (!wa) return;
      wa.addEventListener('input', function () {
        var v = this.value.replace(/[^0-9]/g, '');
        if (v.length > 10) v = v.slice(0, 10);
        this.value = v;
      });
    })();
    // Redes sociales: marca la tarjeta como configurada cuando el campo tiene contenido
    document.querySelectorAll('.social-field input').forEach(function (inp) {
      inp.addEventListener('input', function () {
        this.closest('.social-field').setAttribute('data-filled', this.value.trim() ? '1' : '0');
      });
    });

    // Navegación local: mantiene visible la sección actual mientras se recorre la página.
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-config-nav]'));
      if (!links.length) return;
      var sections = links.map(function (link) { return document.querySelector(link.getAttribute('href')); }).filter(Boolean);
      function activate(id) {
        links.forEach(function (link) {
          var on = link.getAttribute('href') === '#' + id;
          link.classList.toggle('is-active', on);
          if (on) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          var visible = entries.filter(function (entry) { return entry.isIntersecting; })
            .sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio; });
          if (visible[0]) activate(visible[0].target.id);
        }, { rootMargin: '-18% 0px -58% 0px', threshold: [0, .15, .4] });
        sections.forEach(function (section) { observer.observe(section); });
      }
      links.forEach(function (link) {
        link.addEventListener('click', function () {
          activate((this.getAttribute('href') || '').slice(1));
        });
      });
    })();
  </script>
