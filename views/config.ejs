<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Configuración', biz }) %>
  <style>
    /* ============================================================
       MEJORAS ADICIONALES PARA EL PANEL DE CONFIGURACIÓN
       ============================================================ */

    /* Transiciones suaves para todo */
    .config-section {
      transition: box-shadow 0.25s ease, transform 0.25s ease;
    }
    .config-section:hover {
      box-shadow: var(--md-elevation-2);
    }

    /* Inputs con estilo más refinado */
    .config-input {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1.5px solid var(--md-outline-soft);
      border-radius: var(--md-radius-sm);
      font-size: 0.9rem;
      font-family: var(--md-font-family);
      background: var(--md-surface);
      color: var(--md-on-surface);
      transition: border-color var(--md-motion), box-shadow var(--md-motion), background var(--md-motion);
      outline: none;
    }
    .config-input:focus {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.12);
      background: var(--md-surface);
    }
    .config-input::placeholder {
      color: var(--md-on-surface-variant);
      opacity: 0.5;
    }

    /* Etiquetas de campo */
    .config-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--md-on-surface-variant);
      margin-bottom: 0.4rem;
    }

    /* Preview de colores */
    .color-preview {
      width: 100%;
      height: 40px;
      border-radius: 12px;
      border: 2px solid transparent;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .color-preview:hover {
      transform: scale(1.02);
    }
    .color-radio:checked + .color-preview {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);
    }

    /* Opciones de plantilla */
    .template-option {
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .template-option:hover {
      transform: translateY(-2px);
      box-shadow: var(--md-elevation-1);
    }
    .template-radio:checked + .template-option {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.15);
    }

    /* Selector de columnas */
    .cols-option {
      transition: all 0.2s ease;
      cursor: pointer;
      min-width: 60px;
    }
    .cols-option:hover {
      transform: translateY(-2px);
      box-shadow: var(--md-elevation-1);
    }
    .cols-radio:checked + .cols-option {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.15);
    }

    /* Indicador de selección (check) en plantillas, estilos, colores y columnas */
    .template-option, .cols-option, .color-preview {
      position: relative;
    }
    .template-radio:checked + .template-option,
    .cols-radio:checked + .cols-option {
      border-color: var(--md-primary) !important;
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.25);
      transform: translateY(-2px);
    }
    .template-radio:checked + .template-option::after,
    .cols-radio:checked + .cols-option::after,
    .color-radio:checked + .color-preview::after {
      content: '✓';
      position: absolute;
      top: 5px; right: 5px;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--md-primary);
      color: #fff;
      font-size: 12px;
      font-weight: 900;
      line-height: 20px;
      text-align: center;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
      z-index: 5;
    }
    body.dark .template-radio:checked + .template-option,
    body.dark .cols-radio:checked + .cols-option {
      border-color: #d4d4d4 !important;
      box-shadow: 0 0 0 3px rgba(138, 180, 248, 0.25);
    }
    body.dark .template-radio:checked + .template-option::after,
    body.dark .cols-radio:checked + .cols-option::after,
    body.dark .color-radio:checked + .color-preview::after {
      background: #d4d4d4;
      color: #062e6f;
    }

    /* Chips de giros */
    .giro-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.8rem;
      border-radius: 60px;
      background: var(--md-secondary-container);
      color: var(--md-on-secondary-container);
      font-size: 0.75rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .giro-chip .remove-giro {
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.2s ease;
      background: none;
      border: none;
      font-size: 0.8rem;
      padding: 0 0.2rem;
      color: inherit;
    }
    .giro-chip .remove-giro:hover {
      opacity: 1;
    }

    /* Dropdown de giros */
    .giro-dropdown-item {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--md-on-surface);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .giro-dropdown-item:hover {
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
    }

    /* Mensajes de éxito/error */
    .toast-message {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.8rem 1.2rem;
      border-radius: var(--md-radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      animation: mPop 0.3s cubic-bezier(0.2, 0, 0, 1) both;
    }
    .toast-success {
      background: var(--md-secondary-container);
      border: 1px solid #a7d7b5;
      color: var(--md-on-secondary-container);
    }
    .toast-error {
      background: var(--md-error-container);
      border: 1px solid #f5c6cb;
      color: #8c1d18;
    }

    /* Ajustes modo oscuro */
    body.dark .config-input {
      background: #0d1117;
      border-color: #30363d;
      color: #e6edf3;
    }
    body.dark .config-input:focus {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(138, 180, 248, 0.15);
    }
    body.dark .config-label {
      color: #9aa7b4;
    }
    body.dark .giro-chip {
      background: #20334d;
      color: #d6e3ff;
    }
    body.dark .giro-dropdown-item:hover {
      background: #264f9e;
      color: #d6e3ff;
    }
    body.dark .toast-success {
      background: #1a3a2a;
      border-color: #2d6a4f;
      color: #b7e4c7;
    }
    body.dark .toast-error {
      background: #4c1d24;
      border-color: #8b2d32;
      color: #f8a5a0;
    }

    /* ===== Tarjetas de redes sociales ===== */
    .social-field {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border: 1.5px solid var(--md-outline-soft);
      border-radius: 14px;
      background: var(--md-surface);
      transition: border-color .2s, box-shadow .2s, transform .15s;
      position: relative;
    }
    .social-field:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px -8px rgba(0,0,0,.12);
    }
    .social-field:focus-within {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, .1);
    }
    .social-chip {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 19px;
      flex-shrink: 0;
      box-shadow: 0 4px 10px -3px rgba(0,0,0,.25);
    }
    .social-chip-ig {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%) !important;
    }
    .social-body {
      flex: 1;
      min-width: 0;
    }
    .social-name {
      display: block;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--md-on-surface-variant);
      margin-bottom: 2px;
    }
    .social-field input {
      width: 100%;
      border: none;
      background: transparent;
      font-size: .85rem;
      color: var(--md-on-surface);
      outline: none;
      padding: 0;
      font-family: var(--md-font-family);
    }
    .social-field input::placeholder {
      color: var(--md-on-surface-variant);
      opacity: .5;
    }
    .social-done {
      position: absolute;
      top: -7px;
      right: -7px;
      font-size: 17px;
      color: #22c55e;
      background: var(--md-surface);
      border-radius: 50%;
      opacity: 0;
      transform: scale(.4);
      transition: opacity .25s, transform .25s cubic-bezier(.22,1,.36,1);
      pointer-events: none;
    }
    .social-field[data-filled="1"] .social-done {
      opacity: 1;
      transform: scale(1);
    }
    body.dark .social-field {
      background: #161b22;
      border-color: #30363d;
    }
    body.dark .social-field:focus-within {
      border-color: #d4d4d4;
      box-shadow: 0 0 0 4px rgba(138, 180, 248, .12);
    }
    body.dark .social-name {
      color: #9aa7b4;
    }
    body.dark .social-field input {
      color: #e6edf3;
    }
    body.dark .social-done {
      background: #161b22;
    }

    /* ============================================================
       CONFIG CENTER · admin pearl / petrol system
       ============================================================ */
    .config-admin-page {
      --cfg-ink: #17232d;
      --cfg-muted: #60717d;
      --cfg-line: rgba(44, 44, 46, .13);
      --cfg-petrol: #2c2c2e;
      --cfg-petrol-2: #454548;
      --cfg-cyan: #f0f0f1;
      --cfg-violet: #eaeaeb;
      background: #f7f7f8;
      color: var(--cfg-ink);
    }
    .config-admin-page main { width: 100%; min-width: 0; max-width: 100%; }
    .config-shell { width: 100%; max-width: 1440px; box-sizing: border-box; margin: 0 auto; padding: 24px clamp(16px, 2.4vw, 34px) 48px; }
    .config-hero {
      display: flex; align-items: flex-end; justify-content: space-between; gap: 18px;
      margin-bottom: 18px; padding: 22px 24px; border: 1px solid var(--cfg-line);
      border-radius: 18px; background: rgba(255,255,255,.78);
      width: 100%; max-width: 100%; box-sizing: border-box;
    }
    .config-hero > div { min-width: 0; }
    .config-title { margin-top: 4px; color: var(--cfg-ink); font-size: clamp(1.55rem, 2vw, 2rem); font-weight: 850; letter-spacing: -.035em; line-height: 1.05; }
    .config-lede { margin-top: 8px; max-width: 670px; color: var(--cfg-muted); font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; }
    .config-catalog-link { flex: 0 0 auto; border-color: rgba(44,44,46,.2) !important; background: #f0f0f1 !important; color: var(--cfg-petrol) !important; }
    .config-catalog-link:hover { background: #e2edf2 !important; }

    .config-workspace { display: grid; grid-template-columns: 216px minmax(0, 1fr); gap: 18px; align-items: start; }
    .config-rail {
      position: sticky; top: 18px; padding: 10px; border: 1px solid var(--cfg-line);
      border-radius: 16px; background: #fff;
    }
    .config-nav-link {
      display: flex; align-items: center; gap: 10px; min-height: 42px; padding: 9px 11px;
      border-radius: 11px; color: #52616c; font-size: 13px; font-weight: 720; transition: .18s ease;
    }
    .config-nav-link + .config-nav-link { margin-top: 3px; }
    .config-nav-link:hover { color: var(--cfg-petrol); background: #f0f0f1; }
    .config-nav-link.is-active { color: #fff; background: var(--cfg-petrol); box-shadow: 0 9px 20px -13px rgba(44,44,46,.85); }
    .config-nav-icon { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 9px; background: rgba(44,44,46,.08); }
    .config-nav-link.is-active .config-nav-icon { background: rgba(255,255,255,.14); }
    .config-nav-icon svg { width: 15px; height: 15px; }
    .config-content { min-width: 0; max-width: 100%; display: grid; gap: 18px; }
    .config-content > *, .config-section form, .config-section .grid { min-width: 0; max-width: 100%; }

    .config-admin-page .config-section {
      scroll-margin-top: 20px; padding: clamp(18px, 2vw, 26px) !important;
      border: 1px solid var(--cfg-line) !important; border-radius: 16px !important;
      width: 100%; max-width: 100%; box-sizing: border-box; background: #fff !important;
      box-shadow: none !important;
      overflow: visible;
    }
    .config-admin-page .config-section:hover { transform: none; box-shadow: none !important; }
    .config-section-head { display: flex; align-items: center; gap: 12px; margin-bottom: 22px !important; }
    .config-section-head > div:first-child {
      width: 40px; height: 40px; border-radius: 12px !important; color: var(--cfg-petrol) !important;
      background: linear-gradient(135deg, var(--cfg-cyan), var(--cfg-violet)) !important;
    }
    .config-section h2 { color: var(--cfg-ink) !important; font-size: 16px; letter-spacing: -.015em; }
    .config-section-head p { color: #71808a !important; margin-top: 2px; }
    .config-admin-page .config-input,
    .config-admin-page input[type="date"],
    .config-admin-page input[type="time"],
    .config-admin-page input[type="password"] {
      width: 100%; max-width: 100%; box-sizing: border-box;
      min-height: 42px; padding: 10px 12px; border: 1px solid rgba(44,44,46,.16);
      border-radius: 9px; background: rgba(255,255,255,.96); color: var(--cfg-ink);
      box-shadow: 0 1px 1px rgba(44,44,46,.03); font-size: 13px;
    }
    .config-admin-page textarea.config-input { min-height: 76px; resize: vertical; }
    .config-admin-page .config-input:focus,
    .config-admin-page input[type="date"]:focus,
    .config-admin-page input[type="time"]:focus,
    .config-admin-page input[type="password"]:focus {
      border-color: var(--cfg-petrol-2); box-shadow: 0 0 0 3px rgba(44,44,46,.12); outline: 0;
    }
    .config-admin-page .config-label { color: #40515d; font-size: 10.5px; letter-spacing: .075em; }
    .config-admin-page .social-field { min-height: 66px; padding: 10px 12px; border: 1px solid rgba(44,44,46,.13); border-radius: 12px; box-shadow: none; }
    .config-admin-page .social-field:hover { transform: none; border-color: rgba(44,44,46,.25); box-shadow: 0 8px 22px -20px rgba(44,44,46,.7); }
    .config-admin-page .social-field:focus-within { border-color: var(--cfg-petrol-2); box-shadow: 0 0 0 3px rgba(44,44,46,.1); }
    .config-admin-page .social-chip { width: 36px; height: 36px; border-radius: 10px; box-shadow: none; }
    .config-admin-page .m-btn-filled { background: var(--cfg-petrol) !important; color: #fff !important; }

    .config-admin-page #config-design .cat-design-card {
      display: block !important;
      border-width: 1px !important; border-color: rgba(44,44,46,.14) !important; border-radius: 13px !important;
      background: #fff; box-shadow: 0 8px 22px -22px rgba(44,44,46,.8); transition: border-color .18s, box-shadow .18s, transform .18s;
    }
    .config-admin-page #config-design .cat-design-card:hover { transform: translateY(-1px); border-color: rgba(44,44,46,.34) !important; box-shadow: 0 14px 28px -23px rgba(44,44,46,.7); }
    .config-admin-page #config-design .cat-design-card.border-neutral-800 { border-color: var(--cfg-petrol-2) !important; box-shadow: 0 0 0 3px rgba(44,44,46,.11) !important; }
    .config-admin-page #config-design .cat-design-preview { min-height: 64px; padding: 9px; }
    .config-admin-page #config-design .cat-design-card > .p-3 { padding: 10px 11px 11px !important; }
    .config-admin-page #config-design .cat-design-card p.text-xs { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 32px; }
    .catalog-design-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 18px 0 12px; }
    .catalog-design-count { display: inline-flex; align-items: center; gap: 7px; color: #52616c; font-size: 12px; font-weight: 700; }
    .catalog-design-count strong { display: grid; place-items: center; min-width: 27px; height: 27px; padding-inline: 7px; border-radius: 9px; background: #f0f0f1; color: var(--cfg-petrol); font-size: 12px; }

    .config-upload-row { display: grid !important; grid-template-columns: minmax(0,1fr) 160px; gap: 16px !important; align-items: center; padding: 14px; border: 1px dashed rgba(44,44,46,.22); border-radius: 13px; background: #f8fafb; }
    .config-upload-row img { justify-self: end; }
    .config-admin-page #config-security .security-reset { padding: 15px; border: 1px solid rgba(180,72,72,.17); border-radius: 12px; background: #fff8f7; }

    @media (min-width: 1180px) {
      .config-admin-page #config-design form > .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    @media (max-width: 860px) {
      .config-shell { padding-top: 16px; }
      .config-hero { align-items: flex-start; }
      .config-workspace { display: block; }
      .config-rail { position: sticky; top: 0; z-index: 38; display: flex; gap: 6px; margin-bottom: 14px; padding: 7px; overflow-x: auto; scrollbar-width: none; }
      .config-rail::-webkit-scrollbar { display: none; }
      .config-nav-link { flex: 0 0 auto; min-height: 38px; padding: 6px 10px; }
      .config-nav-link + .config-nav-link { margin-top: 0; }
      .config-nav-icon { width: 26px; height: 26px; }
    }
    @media (max-width: 560px) {
      .config-shell { padding-inline: 12px; }
      .config-hero { display: block; padding: 18px; }
      .config-catalog-link { width: 100%; margin-top: 14px; justify-content: center; }
      .config-admin-page .config-section { padding: 17px !important; }
      .config-upload-row { grid-template-columns: 1fr; }
      .config-upload-row img { justify-self: start; }
      .config-admin-page #config-design form > .grid { grid-template-columns: 1fr 1fr; gap: 9px; }
      .config-admin-page #config-design .cat-design-card p.text-xs { display: none; min-height: 0; }
    }
    body.dark.config-admin-page { background: #0d1117; }
    body.dark .config-hero, body.dark .config-rail, body.dark.config-admin-page .config-section { background: rgba(22,27,34,.92) !important; border-color: #28333d !important; }
    body.dark .config-title, body.dark.config-admin-page .config-section h2 { color: #edf4f8 !important; }
    body.dark .config-lede { color: #9aa7b4; }
    body.dark .config-nav-link { color: #a8b4bd; }
    body.dark .config-nav-link:hover { background: #1b2a36; color: #d8e9f3; }
    body.dark.config-admin-page .config-input, body.dark.config-admin-page input[type="date"], body.dark.config-admin-page input[type="time"], body.dark.config-admin-page input[type="password"] { background: #101820; border-color: #34414b; color: #e7eef3; }
    body.dark.config-admin-page #config-design .cat-design-card { background: #121a21; border-color: #303c46 !important; }
    body.dark .config-upload-row { background: #101820; border-color: #34414b; }
    body.dark.config-admin-page #config-security .security-reset { background: #251819; border-color: #513033; }
    .config-master-bar { background: #fff !important; color: var(--cfg-petrol) !important; border-color: var(--cfg-line) !important; }
    .config-master-bar > div { min-width: 0; }
    .config-master-bar a { color: var(--cfg-petrol) !important; }
    .config-master-bar span { color: #52616c !important; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .config-ui-icon { width: 15px; height: 15px; flex: 0 0 auto; }
    body.dark .config-master-bar { background: #121a21 !important; border-color: #28333d !important; }
    body.dark .config-master-bar a { color: #d8e9f3 !important; }
    body.dark .config-master-bar span { color: #9aa7b4 !important; }
  </style>
</head>
<body class="m-material config-admin-page bg-slate-100 min-h-screen dark:bg-[#0d1117]">
  <!--
    THESIS: Configuración funciona como centro de control, no como formulario interminable.
    OWN-WORLD: Reutiliza el mundo admin perlado/petróleo, su tipografía Inter y sus acentos cian-violeta contenidos.
    STORY: Primero orienta, luego permite saltar entre negocio, apariencia, imágenes y seguridad.
    FIRST VIEWPORT: Encabezado compacto + navegación local + comienzo inmediato de los datos esenciales.
    FORM: seed=config-center-rail-2026; los controles comparten altura, radio, borde, foco y densidad semántica.
    FINISH: Jerarquía clara, responsivo sin overflow horizontal y modo oscuro coherente.
  -->
  <% if (!esMaestro) { %>
    <%- include('admin/sidebar', { biz, active: 'config', canDesign }) %>
  <% } else { %>
    <nav class="config-master-bar sticky top-0 z-50 border-b">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/maestro/panel" class="flex items-center gap-2 text-sm font-bold hover:text-slate-300 transition">
          <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5m6-6l-6 6 6 6"/></svg> Panel maestro
        </a>
        <span class="text-xs font-black uppercase tracking-wider text-emerald-400">Diseño de <%= biz.name %></span>
      </div>
    </nav>
  <% } %>

  <main class="transition-all duration-300">
    <div class="config-shell">

      <!-- HEADER -->
      <div class="config-hero">
        <div>
          <h1 class="config-title">
            <%= esMaestro ? 'Diseño y datos de la tienda' : 'Configuración' %>
          </h1>
          <p class="config-lede">
            <%= esMaestro ? 'Controlas el diseño, las imágenes, los datos y el acceso de esta tienda.' : (canDesign ? 'Personaliza el diseño, los datos y el acceso de tu tienda.' : 'Cambia los datos y el acceso de tu tienda.') %>
          </p>
        </div>
        <a href="/<%= biz.slug %>" target="_blank" class="config-catalog-link m-btn m-btn-tonal m-btn-sm dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
          Ver catálogo
        </a>
      </div>

      <%
        const cfgAction = esMaestro ? '/maestro/' + biz.id + '/config' : '/' + biz.slug + '/admin/config';
        const prevSrc = esMaestro ? '/maestro/' + biz.id + '/preview' : '/' + biz.slug + '/admin/preview';
      %>

      <!-- MENSAJES (se muestran como toast de SweetAlert2) -->
      <% if (ok || error) { %>
        <div id="panel-msg" class="hidden" data-tipo="<%= ok ? 'ok' : 'error' %>"><%= ok || error %></div>
      <% } %>

      <div class="config-workspace">
        <nav class="config-rail" aria-label="Secciones de configuración">
          <a class="config-nav-link is-active" href="#config-business" data-config-nav>
            <span class="config-nav-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></span>Negocio
          </a>
          <% if (canDesign) { %>
          <a class="config-nav-link" href="#config-design" data-config-nav>
            <span class="config-nav-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18h1.5a1.5 1.5 0 000-3H12a1.5 1.5 0 010-3h2a7 7 0 000-12h-2z"/><path d="M7.5 10h.01M9 6.8h.01M14.5 6.5h.01"/></svg></span>Apariencia
          </a>
          <a class="config-nav-link" href="#config-images" data-config-nav>
            <span class="config-nav-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 19l5-5 3 3 2-2 6 4M5 5h14v14H5z"/><path d="M9 10a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg></span>Imágenes
          </a>
          <% } %>
          <% if (!esMaestro) { %>
          <a class="config-nav-link" href="#config-pagos" data-config-nav>
            <span class="config-nav-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 8h20M2 8v10a2 2 0 002 2h16a2 2 0 002-2V8M2 8l1.5-3.5A2 2 0 015.3 3h13.4a2 2 0 011.8 1.5L22 8M6 15h4"/></svg></span>Pagos
          </a>
          <a class="config-nav-link" href="#config-security" data-config-nav>
            <span class="config-nav-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0110 0v3M5 11h14v10H5z"/><path d="M12 15v2"/></svg></span>Seguridad
          </a>
          <% } %>
        </nav>
        <div class="config-content">

      <!-- ============================================================
      SECCIÓN 1: DATOS DEL NEGOCIO
      ============================================================ -->
      <section id="config-business" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="config-section-head flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Datos del negocio</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Nombre, contacto y giro</p>
          </div>
        </div>

        <form data-noajax method="POST" action="<%= cfgAction %>#config-business" class="space-y-4" id="form-datos">
          <input type="hidden" name="sections-current" value="<%= biz.sections || '{}' %>">
          <input type="hidden" name="sections" id="sections-json" value="">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="config-label">Nombre del negocio *</label>
              <input name="name" value="<%= biz.name %>" class="config-input" placeholder="Ej: Ferretería El Toro" required>
            </div>
            <div>
              <label class="config-label">WhatsApp (10 dígitos) *</label>
              <input id="config-whatsapp" name="whatsapp" value="<%= (function (w) { var d = String(w || '').replace(/\D/g, ''); if (d.length > 10 && d.indexOf('52') === 0) d = d.slice(-10); return d.length === 10 ? d.slice(0, 3) + ' ' + d.slice(3, 6) + ' ' + d.slice(6) : String(w || ''); })(biz.whatsapp) %>" type="tel" inputmode="numeric" maxlength="12" pattern="[0-9]{3} ?[0-9]{3} ?[0-9]{4}" data-mask="phone" title="10 dígitos" class="config-input" placeholder="871 234 5678" required>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Los pedidos llegarán a este número.</p>
            </div>
          </div>

          <% var _redes = {}; try { _redes = JSON.parse(biz.redes || '{}'); } catch(e) {} %>
          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Redes sociales</label>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Agrega los enlaces de tus redes para que aparezcan en tu catálogo.</p>
            <div class="grid md:grid-cols-3 gap-3">
              <div class="social-field" data-filled="<%= _redes.facebook ? '1' : '0' %>">
                <span class="social-chip" style="background:#1877f2;"><i class="bi bi-facebook"></i></span>
                <div class="social-body">
                  <label class="social-name">Facebook</label>
                  <input name="redes_facebook" value="<%= _redes.facebook || '' %>" placeholder="https://facebook.com/tu-pagina" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
              <div class="social-field" data-filled="<%= _redes.instagram ? '1' : '0' %>">
                <span class="social-chip social-chip-ig"><i class="bi bi-instagram"></i></span>
                <div class="social-body">
                  <label class="social-name">Instagram</label>
                  <input name="redes_instagram" value="<%= _redes.instagram || '' %>" placeholder="@tu-cuenta o enlace" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
              <div class="social-field" data-filled="<%= _redes.tiktok ? '1' : '0' %>">
                <span class="social-chip" style="background:#111111;"><i class="bi bi-tiktok"></i></span>
                <div class="social-body">
                  <label class="social-name">TikTok</label>
                  <input name="redes_tiktok" value="<%= _redes.tiktok || '' %>" placeholder="@tu-cuenta o enlace" autocomplete="off">
                </div>
                <i class="bi bi-check-circle-fill social-done" title="Configurada"></i>
              </div>
            </div>
          </div>

          <div>
            <label class="config-label">Descripción</label>
            <textarea name="description" rows="2" class="config-input" placeholder="¿Qué vende tu negocio?"><%= biz.description %></textarea>
          </div>

          <div>
            <label class="config-label">Mensaje personalizado de WhatsApp <span class="font-normal text-slate-400">(opcional)</span></label>
            <textarea name="wa_message" rows="4" class="config-input" placeholder="Déjalo vacío para usar el mensaje por defecto."><%= biz.wa_message || '' %></textarea>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Es el mensaje que recibe el cliente al pedir. Puedes usar <b>{tienda}</b>, <b>{productos}</b> y <b>{total}</b>.</p>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <input type="hidden" name="horario_set" value="1">
            <div class="flex items-center justify-between mb-1 flex-wrap gap-2">
              <label class="config-label !mb-0">Horario de atención</label>
              <button type="button" onclick="copiarHorarioATodos()" class="text-xs font-bold text-neutral-600 hover:text-neutral-800">Copiar Lunes → días abiertos</button>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Enciende los días que abres y marca su horario.</p>
            <% const diasSemana = [['1','Lunes'],['2','Martes'],['3','Miércoles'],['4','Jueves'],['5','Viernes'],['6','Sábado'],['7','Domingo']]; %>
            <div class="rounded-xl border border-slate-200 dark:border-[#30363d] overflow-hidden divide-y divide-slate-100 dark:divide-[#30363d]">
              <% diasSemana.forEach(d => { const diaData = horario[d[0]] || null; const isOpen = !!(diaData && diaData.o); %>
                <div class="dia-row flex items-center gap-2 sm:gap-3 px-3 py-2 bg-white dark:bg-slate-900/40" data-dia="<%= d[0] %>">
                  <label class="m-switch shrink-0" title="Abierto / cerrado">
                    <input type="checkbox" class="dia-open" data-dia="<%= d[0] %>" <%= isOpen ? 'checked' : '' %> onchange="toggleDia(this)">
                    <span class="track"><span class="thumb"></span></span>
                  </label>
                  <span class="w-20 shrink-0 text-xs font-bold <%= isOpen ? 'text-slate-700 dark:text-slate-200' : 'text-slate-400 dark:text-slate-500' %>"><%= d[1] %></span>
                  <input type="time" name="h_open_<%= d[0] %>" value="<%= diaData ? diaData.o : '' %>" <%= isOpen ? '' : 'disabled' %> class="flex-1 min-w-0 border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-neutral-400 disabled:opacity-40">
                  <span class="text-slate-400 text-xs shrink-0">a</span>
                  <input type="time" name="h_close_<%= d[0] %>" value="<%= diaData ? diaData.c : '' %>" <%= isOpen ? '' : 'disabled' %> class="flex-1 min-w-0 border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-neutral-400 disabled:opacity-40">
                </div>
              <% }) %>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-2">Los días apagados se mostrarán como "Cerrado" en tu tienda.</p>
          </div>

          <div>
            <label class="config-label">Mensaje cuando esté cerrado</label>
            <textarea name="horario_msg" rows="2" class="config-input" placeholder="Estamos cerrados. Recibimos tu pedido y te respondemos en cuanto abramos."><%= horarioMsg %></textarea>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Dirección / ubicación <span class="font-normal text-slate-400">(opcional)</span></label>
            <input id="f-address" name="address" value="<%= (typeof address !== 'undefined' && address) || '' %>" class="config-input" placeholder="Ej: Av. Juárez 120, Centro, Torreón, Coah.">
            <button type="button" id="f-address-detect" onclick="detectarUbicacion()" class="mt-2 inline-flex items-center gap-1.5 text-xs font-bold text-neutral-700 dark:text-slate-300 border border-slate-200 dark:border-[#30363d] rounded-lg px-3 py-1.5 hover:bg-neutral-100 dark:hover:bg-[#161b22] transition">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2a7 7 0 00-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 00-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <span>Detectar ubicación</span>
            </button>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Si escribes la dirección, tu catálogo mostrará un mapa con esa ubicación. Vacío = no se muestra mapa.</p>
          </div>

          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
            <label class="config-label">Preguntas frecuentes <span class="font-normal text-slate-400">(opcional)</span></label>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Aparecen como desplegables en tu catálogo. Agrega las que quieras; si no pones ninguna, no se muestra esa sección.</p>

            <!-- Ejemplos guía (no se guardan) -->
            <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/40 px-4 py-3 mb-4">
              <p class="text-[11px] font-black uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-1">Ejemplos — preguntas que suelen hacer los clientes</p>
              <div class="space-y-2">
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Hacen envíos?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Sí, hacemos envíos a toda la ciudad. El costo depende de tu zona.</p>
                </details>
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Cuál es su horario?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Atendemos de lunes a sábado de 8:00 am a 6:00 pm.</p>
                </details>
                <details class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-[#30363d] rounded-lg overflow-hidden">
                  <summary style="list-style:none;" class="px-3 py-2.5 text-sm font-bold text-slate-700 dark:text-slate-200 flex items-center justify-between cursor-pointer select-none">
                    <span>¿Aceptan tarjeta?</span><span class="text-slate-400 text-base leading-none">+</span>
                  </summary>
                  <p class="px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">Sí, aceptamos efectivo, tarjeta y transferencia.</p>
                </details>
              </div>
              <p class="text-[11px] text-amber-600 dark:text-amber-500 mt-1.5">Estos ejemplos son solo de guía y no se guardan. Usa el botón de abajo para cargarlos y edítalos a tu gusto, o escribe tus propias preguntas.</p>
            </div>

            <div id="faq-rows" class="space-y-3"></div>
            <input type="hidden" name="faq" id="faq-json" value=''>

            <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3">
              <label class="config-label">Banner de campaña <span class="font-normal text-slate-400">(publicidad en tu catálogo)</span></label>
              <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">Una franja arriba de tu catálogo para anunciar promociones. Ejemplos: "🔥 Buen Fin: -30% en toda la tienda", "🎉 2x1 en pinturas esta semana", "⚡ Envío gratis en pedidos +$500". Déjalo vacío para no mostrar nada.</p>
              <input name="campaign_text" value="<%= (biz.sections && biz.sections.indexOf('campaign') !== -1 && (JSON.parse(biz.sections||'{}').campaign||{}).text) || '' %>" maxlength="120" class="config-input" placeholder="🔥 Buen Fin: -30% en toda la tienda">
              <div class="flex items-center gap-2 mt-2">
                <label class="text-xs font-semibold text-slate-600 dark:text-slate-300 shrink-0">Termina el</label>
                <input name="campaign_ends" type="date" value="<%= (biz.sections && (JSON.parse(biz.sections||'{}').campaign||{}).ends) || '' %>" class="border border-slate-200 dark:border-[#30363d] rounded-lg px-2 py-1.5 text-sm bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-neutral-400">
                <span class="text-[11px] text-slate-400">(opcional — muestra cuenta regresiva)</span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mt-1">
              <button type="button" onclick="faqAgregarFila()" class="m-btn m-btn-outline m-btn-sm !text-neutral-700 dark:!text-[#d4d4d4] dark:!border-[#d4d4d4] dark:hover:!bg-neutral-500/10">
                <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Agregar pregunta
              </button>
              <button type="button" onclick="faqCargarEjemplos()" class="m-btn m-btn-outline m-btn-sm !text-amber-600 dark:!text-amber-400 dark:!border-amber-700 dark:hover:!bg-amber-500/10">
                <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 5h6M9 3h6v4H9zM6 5H4v16h16V5h-2M8 12h8M8 16h6"/></svg> Usar ejemplos
              </button>
            </div>
          </div>

          <%
            var _ex = {};
            try { _ex = JSON.parse(biz.extras || '{}') || {}; } catch (e) { _ex = {}; }
            var _exAbout = _ex.about || {};
            var _exPagos = Array.isArray(_ex.pagos) ? _ex.pagos : [];
            var _PAGOS_OPC = [['efectivo','Efectivo'],['transferencia','Transferencia'],['tarjeta','Tarjeta'],['contra_entrega','Contra entrega'],['abonos','Pagos en abonos'],['mercado_pago','Mercado Pago']];
          %>
          <div class="border-t border-slate-200 dark:border-[#30363d] pt-4 mt-3" id="extras-block">
            <label class="config-label">Secciones extra de tu catálogo <span class="font-normal text-slate-400">(opcional)</span></label>
            <p class="text-xs text-slate-400 dark:text-slate-500 mb-4">Llena lo que quieras: cada sección aparece sola cuando tiene contenido y, si la dejas vacía, no se muestra. Se ven con el estilo de tu apariencia.</p>

            <div class="space-y-4">
              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Conócenos</p>
                <input id="ex-about-title" class="config-input" maxlength="80" placeholder="Título (opcional, por defecto “Conócenos”)" value="<%= _exAbout.title || '' %>">
                <textarea id="ex-about-text" rows="4" maxlength="2000" class="config-input" placeholder="Cuenta tu historia: desde cuándo existe el negocio, qué te distingue, quién te atiende…"><%= _exAbout.text || '' %></textarea>
                <div class="config-upload-row flex items-center gap-3 pt-1">
                  <label class="cursor-pointer bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold px-4 py-2.5 rounded-xl transition text-slate-700 dark:text-slate-300">
                    <span class="inline-flex items-center gap-2"><svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h4l1.5-2h5L16 7h4v12H4z"/><circle cx="12" cy="13" r="3"/></svg>Subir foto</span>
                    <input id="foto-about" type="file" accept="image/*" class="hidden" onchange="subirConEditor('foto-about', 'ex-about-image', 'prev-about', '4:5')">
                  </label>
                  <img id="prev-about" src="<%= _exAbout.image || '/img/sin-imagen.svg' %>" class="w-14 h-[70px] rounded-lg object-cover border border-slate-200 dark:border-[#30363d]" alt="">
                  <button type="button" onclick="quitarFotoAbout()" class="text-xs font-bold text-red-600 hover:text-red-800">Quitar</button>
                </div>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">Foto opcional (tú, tu equipo o tu local). Se recorta con el editor de imágenes.</p>
                <input type="hidden" id="ex-about-image" value="<%= _exAbout.image || '' %>">
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Etiquetas para TODOS los productos <span class="font-normal">(hasta 3)</span></p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">Salen en cada producto de tu tienda, además de las que le pongas a uno por uno. Ej: “Mayoreo desde 10 pzas”, “Envío gratis”.</p>
                <div id="gt-rows" class="space-y-2"></div>
                <button type="button" id="gt-add" onclick="gtAdd()" class="m-btn m-btn-outline m-btn-sm !text-neutral-700 dark:!text-[#d4d4d4] dark:!border-[#d4d4d4]">
                  <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Agregar etiqueta
                </button>
                <div class="flex flex-wrap gap-1.5">
                  <button type="button" class="gt-sug" onclick="gtAdd('Mayoreo','#7c3aed')">Mayoreo</button>
                  <button type="button" class="gt-sug" onclick="gtAdd('Envío gratis','#0f766e')">Envío gratis</button>
                  <button type="button" class="gt-sug" onclick="gtAdd('Entrega inmediata','#1d4ed8')">Entrega inmediata</button>
                </div>
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Modelos <span class="font-normal">(fotos de personas usando tus productos, hasta 12)</span></p>
                <input id="ex-mod-title" class="config-input" maxlength="80" placeholder="Título (opcional, por defecto “Así lo lucen”)" value="<%= (_ex.modelos && _ex.modelos.title) || '' %>">
                <input id="ex-mod-text" class="config-input" maxlength="400" placeholder="Frase corta (opcional). Ej: Así luce nuestra colección puesta." value="<%= (_ex.modelos && _ex.modelos.text) || '' %>">
                <div id="modelos-rows" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
                <button type="button" onclick="modeloAgregarFila()" class="m-btn m-btn-outline m-btn-sm !text-neutral-700 dark:!text-[#d4d4d4] dark:!border-[#d4d4d4]">
                  <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Agregar foto de modelo
                </button>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">Se recortan en vertical (3:4) con el editor. La sección aparece sola en el catálogo cuando hay al menos una foto.</p>
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Envíos y formas de pago</p>
                <textarea id="ex-envios" rows="3" maxlength="1500" class="config-input" placeholder="Zonas de entrega, costo y tiempos. Ej: Entregamos en toda la ciudad. Envío gratis desde $500."><%= _ex.envios || '' %></textarea>
                <div class="flex flex-wrap gap-x-4 gap-y-2 pt-1">
                  <% _PAGOS_OPC.forEach(function (o) { %>
                    <label class="inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200 cursor-pointer">
                      <input type="checkbox" class="ex-pago" value="<%= o[0] %>" <%= _exPagos.indexOf(o[0]) !== -1 ? 'checked' : '' %>> <%= o[1] %>
                    </label>
                  <% }) %>
                </div>
                <input id="ex-pagos-nota" class="config-input" maxlength="300" placeholder="Nota sobre pagos (opcional). Ej: Aceptamos pago al recibir en la ciudad." value="<%= _ex.pagos_nota || '' %>">
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Testimonios de clientes <span class="font-normal">(hasta 8)</span></p>
                <div id="testi-rows" class="space-y-3"></div>
                <button type="button" onclick="testiAgregarFila()" class="m-btn m-btn-outline m-btn-sm !text-neutral-700 dark:!text-[#d4d4d4] dark:!border-[#d4d4d4]">
                  <svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg> Agregar testimonio
                </button>
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 space-y-2">
                <p class="text-xs font-black text-slate-500 dark:text-slate-400">Secciones automáticas</p>
                <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer"><input type="checkbox" id="ex-show-new" class="mt-1" <%= _ex.showNew ? 'checked' : '' %>> <span><b>Recién llegados</b> — tira con tus últimos productos <span class="text-slate-400">(desde 4 productos)</span></span></label>
                <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer"><input type="checkbox" id="ex-show-top" class="mt-1" <%= _ex.showTop ? 'checked' : '' %>> <span><b>Los más vendidos</b> — los que más se han vendido <span class="text-slate-400">(solo cuentan pedidos ya cobrados; aparece cuando haya ventas cobradas)</span></span></label>
                <label class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer"><input type="checkbox" id="ex-show-how" class="mt-1" <%= _ex.showHow ? 'checked' : '' %>> <span><b>Cómo pedir</b> — 3 pasos para quien nunca ha pedido por WhatsApp</span></label>
              </div>
            </div>
            <input type="hidden" name="extras" id="extras-json" value=''>
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#d4d4d4] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>

      <!-- ============================================================
      SECCIÓN: PAGOS EN LÍNEA (Mercado Pago — Checkout Pro)
      Queda pendiente por el momento — se decidió que para el tipo de
      negocio que usa esto, transferencia + comprobante por WhatsApp
      (ver la sección de abajo) tiene más sentido como primera opción.
      El código y la ruta de pago siguen intactos, solo se oculta del
      admin; basta con quitar este "false" para reactivarla.
      ============================================================ -->
      <% if (!esMaestro) { %>
      <section id="config-pagos" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="config-section-head flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-900/30 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 8h20M2 8v10a2 2 0 002 2h16a2 2 0 002-2V8M2 8l1.5-3.5A2 2 0 015.3 3h13.4a2 2 0 011.8 1.5L22 8M6 15h4"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Pagos en línea</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Deja que tus clientes paguen con tarjeta antes de recoger — con tu propia cuenta de Mercado Pago</p>
          </div>
        </div>

        <% if (typeof mpOAuth !== 'undefined' && mpOAuth) { %>
        <div class="rounded-xl border border-sky-200 dark:border-sky-900/50 bg-sky-50/60 dark:bg-sky-900/10 p-4 mb-5">
          <% if (biz.mp_connected) { %>
            <p class="text-sm font-bold text-slate-800 dark:text-slate-100">✅ Tu cuenta de Mercado Pago está conectada</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">El dinero de cada venta llega directo a tu cuenta de Mercado Pago.</p>
            <form method="POST" action="/<%= biz.slug %>/admin/mp/desconectar" data-noajax class="mt-3">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="m-btn !min-h-10 text-sm" onclick="return confirm('¿Desconectar Mercado Pago? Dejarás de cobrar en línea.')">Desconectar</button>
            </form>
          <% } else { %>
            <p class="text-sm font-bold text-slate-800 dark:text-slate-100">Cobra en línea con un solo clic</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Conecta tu cuenta de Mercado Pago (la creas gratis si no tienes). Sin copiar tokens.</p>
            <a href="/<%= biz.slug %>/admin/mp/conectar" class="m-btn m-btn-filled inline-flex items-center justify-center !min-h-11 mt-3 px-5 text-sm">Conectar mi cuenta de Mercado Pago</a>
          <% } %>
        </div>
        <% } %>

        <form data-noajax method="POST" action="<%= cfgAction %>#config-pagos" class="space-y-4" id="form-pagos">
          <input type="hidden" name="mp_form" value="1">
          <div>
            <label class="config-label">Access Token de Mercado Pago <span class="font-normal text-slate-400">(de producción)</span></label>
            <input name="mp_access_token" value="<%= biz.mp_access_token || '' %>" type="password" autocomplete="off" class="config-input" placeholder="APP_USR-...">
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">
              Sácalo de tu cuenta de Mercado Pago: <b>Tu negocio → Configuración → Credenciales → Credenciales de producción</b>. Nunca lo compartas — con él se cobra directo a tu cuenta, nadie más la toca.
            </p>
          </div>

          <div>
            <label class="config-label">Public Key de Mercado Pago <span class="font-normal text-slate-400">(para cobrar con tarjeta dentro de tu catálogo)</span></label>
            <input name="mp_public_key" value="<%= biz.mp_public_key || '' %>" type="text" autocomplete="off" class="config-input" placeholder="APP_USR-...">
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">
              Está en el mismo lugar: <b>Credenciales de producción → Public Key</b>. Esta sí es pública. Con ella y el Access Token, el cliente paga con tarjeta <b>sin salir de tu catálogo</b>; la tarjeta la procesa Mercado Pago y tu servidor nunca la ve. Si la dejas vacía, el botón lleva a la página de Mercado Pago.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-4 space-y-3">
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" name="mp_fee_on" value="1" <%= (biz.mp_fee_on === 0 || biz.mp_fee_on === '0') ? '' : 'checked' %> class="mt-0.5 accent-sky-500">
              <span class="text-sm font-bold text-slate-700 dark:text-slate-200">Incluir la comisión de Mercado Pago en el precio de mis productos
                <span class="block text-xs font-normal text-slate-500 mt-0.5">El cliente ve un solo precio final, sin cargos aparte, y a ti te llega el precio que tú pusiste. Tú sigues capturando el precio base; el catálogo muestra el precio ya ajustado.</span>
              </span>
            </label>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="config-label">Comisión %</label>
                <input name="mp_fee_pct" value="<%= biz.mp_fee_pct == null ? 3.49 : biz.mp_fee_pct %>" inputmode="decimal" class="config-input" placeholder="3.49">
              </div>
              <div>
                <label class="config-label">Cargo fijo $</label>
                <input name="mp_fee_fixed" value="<%= biz.mp_fee_fixed == null ? 4 : biz.mp_fee_fixed %>" inputmode="decimal" class="config-input" placeholder="4">
              </div>
              <div>
                <label class="config-label">IVA %</label>
                <input name="mp_fee_iva" value="<%= biz.mp_fee_iva == null ? 16 : biz.mp_fee_iva %>" inputmode="decimal" class="config-input" placeholder="16">
              </div>
            </div>
            <p class="text-xs text-slate-400">Ejemplo con estos valores: un producto que capturas en $180 se muestra a $193 (el cálculo exacto es $192.43) y a ti te llegan $180 limpios. Cada producto lleva incluido el cargo fijo por operación, así que en una compra de varios productos el cliente paga un poco de más. Revisa la tarifa vigente en tu cuenta de Mercado Pago y ajusta los números.</p>
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 text-xs text-slate-500 dark:text-slate-400">
            Es la única forma de pago del catálogo. Al conectar tu cuenta, tus clientes verán un botón <b>"Pagar con Mercado Pago"</b> junto al de WhatsApp. El pedido se marca como <b>pagado</b> automáticamente en tu panel apenas Mercado Pago confirma el cobro — no tienes que revisar nada a mano.
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#d4d4d4] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>
      <% } %>

      <!-- ============================================================
      SECCIÓN: TRANSFERENCIA BANCARIA
      ============================================================ -->
      <% if (!esMaestro) { %>
      <section id="config-transferencia" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="config-section-head flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 10h18M6 10v8M10 10v8M14 10v8M18 10v8M4 18h16M12 3l9 5H3l9-5z"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Transferencia bancaria</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Publica tu cuenta para que te transfieran — sin comisiones ni pasarela</p>
          </div>
        </div>

        <form data-noajax method="POST" action="<%= cfgAction %>#config-pagos" class="space-y-4" id="form-transferencia">
          <input type="hidden" name="transfer_form" value="1">
          <label class="flex items-center gap-2.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl px-4 py-3 cursor-pointer">
            <input type="checkbox" name="transfer_enabled" value="1" <%= biz.transfer_enabled ? 'checked' : '' %> class="w-4.5 h-4.5 accent-emerald-500">
            <span class="text-sm font-bold text-slate-700 dark:text-slate-200">Mostrar mi cuenta en el catálogo para recibir transferencias</span>
          </label>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="config-label">Banco</label>
              <input name="transfer_bank" value="<%= biz.transfer_bank || '' %>" maxlength="120" class="config-input" placeholder="Ej: BBVA">
            </div>
            <div>
              <label class="config-label">Cuenta / CLABE</label>
              <input name="transfer_account" value="<%= biz.transfer_account || '' %>" maxlength="20" inputmode="numeric" pattern="[0-9]{10,20}" title="Solo números, de 10 a 20 dígitos (la CLABE tiene 18)" class="config-input" placeholder="Ej: 012180001234567895">
            </div>
          </div>
          <div>
            <label class="config-label">A nombre de</label>
            <input name="transfer_holder" value="<%= biz.transfer_holder || '' %>" maxlength="120" class="config-input" placeholder="Ej: Juan Pérez Gómez">
          </div>

          <div class="rounded-xl border border-slate-200 dark:border-[#30363d] p-3 text-xs text-slate-500 dark:text-slate-400">
            Cuando está activo, tus clientes verán estos datos en el carrito con instrucciones de <b>transferir y mandar su comprobante por WhatsApp</b> junto con su pedido — tú confirmas el pago a mano, como ya lo haces hoy.
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#d4d4d4] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>
      <% } %>

      <!-- ============================================================
      SECCIÓN 2: DISEÑO DEL CATÁLOGO (maestro o dueño con plan que lo incluya)
      ============================================================ -->
      <% if (canDesign) { %>
      <%
        const hdrRaw = biz.header || diseno.header;
        const hdrColor = /^#[0-9a-fA-F]{6}$/.test(hdrRaw || '') ? hdrRaw : ((hdrRaw || '').match(/#[0-9a-fA-F]{6}/) || ['#334155'])[0];
        const accentVal = biz.accent || diseno.accent || '#2563eb';
        const accent2Val = biz.accent2 || diseno.accent2 || accentVal;
        const headerTextVal = biz.header_text || diseno.headerText || '#ffffff';
      %>
      <section id="config-design" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
          <div class="config-section-head flex items-center gap-4 flex-wrap">
            <div class="w-12 h-12 rounded-xl bg-fuchsia-50 dark:bg-fuchsia-900/30 text-fuchsia-600 dark:text-fuchsia-400 flex items-center justify-center shrink-0"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18h1.5a1.5 1.5 0 000-3H12a1.5 1.5 0 010-3h2a7 7 0 000-12h-2z"/><path d="M7.5 10h.01M9 6.8h.01M14.5 6.5h.01"/></svg></div>
            <div class="flex-1 min-w-[200px]">
              <h2 class="font-extrabold text-slate-900 dark:text-white">Diseño del catálogo</h2>
              <p class="text-xs text-slate-400 dark:text-slate-500">Escoge el estilo visual de tu catálogo — colores, tipografía y formas. Los mismos elementos, distinta personalidad.</p>
            </div>
          </div>

          <% var _fontHrefs = Array.from(new Set(CAT_DESIGNS.map(function(d){ return d.tokens.font.href; }))); %>
          <% _fontHrefs.forEach(function(h) { %><link rel="stylesheet" href="<%= h %>"><% }) %>

          <form data-noajax method="POST" action="<%= cfgAction %>#config-design" id="cat-design-form">
            <div class="catalog-design-toolbar">
              <p class="catalog-design-count"><strong><%= CAT_DESIGNS.length %></strong> diseños disponibles</p>
              <p class="text-xs text-slate-400 dark:text-slate-500">Selecciona uno y guarda el cambio</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <% CAT_DESIGNS.forEach(function(d) { %>
              <% var t = d.tokens; %>
              <label class="cat-design-card relative block cursor-pointer rounded-2xl border-2 transition overflow-hidden <%= catDesign.id === d.id ? 'border-neutral-800' : 'border-slate-200 dark:border-[#30363d] hover:border-slate-300 dark:hover:border-[#3d444d]' %>">
                <input type="radio" name="catalog_design" value="<%= d.id %>" class="sr-only" <%= catDesign.id === d.id ? 'checked' : '' %>>

                <!-- Preview: mini tarjeta de producto renderizada con la paleta y tipografía reales del estilo -->
                <div class="cat-design-preview" style="background:<%= t.bg %>;">
                  <div class="cdp-card" style="background:<%= t.card %>; border-radius:<%= Math.min(t.radius, 14) %>px; box-shadow:<%= t.shadow %>; border:1px solid <%= t.border %>;">
                    <div class="cdp-thumb" style="background:<%= t.accentGlow %>; border-radius:<%= Math.max(0, Math.min(t.radius, 14) - 4) %>px;"></div>
                    <div class="cdp-info">
                      <div class="cdp-heading" style="font-family:<%= t.font.heading %>; color:<%= t.text %>;">Producto</div>
                      <div class="cdp-body" style="font-family:<%= t.font.body %>; color:<%= t.textSec %>;">Desde $99</div>
                    </div>
                  </div>
                  <div class="cdp-btn" style="background:<%= t.accent %>; border-radius:<%= Math.min(t.radius, 10) %>px;"></div>
                </div>

                <div class="p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm"><%= d.emoji %></span>
                    <% if (catDesign.id === d.id) { %><span class="text-[10px] font-black uppercase tracking-wider text-neutral-700 bg-neutral-100 dark:bg-neutral-800 dark:text-neutral-300 px-2 py-0.5 rounded-full">En uso</span><% } %>
                  </div>
                  <p class="font-extrabold text-sm text-slate-900 dark:text-white mt-1"><%= d.name %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= d.desc %></p>
                </div>
              </label>
              <% }) %>
            </div>
            <input type="hidden" name="save_design_only" value="1">
            <button type="submit" class="m-btn m-btn-filled m-btn-sm mt-4">Guardar diseño</button>
          </form>
          <style>
            .cat-design-preview { display:flex; align-items:center; gap:8px; padding:12px; }
            .cdp-card { flex:1; min-width:0; display:flex; align-items:center; gap:8px; padding:8px; }
            .cdp-thumb { width:30px; height:30px; flex-shrink:0; }
            .cdp-info { min-width:0; flex:1; }
            .cdp-heading { font-size:12px; font-weight:700; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
            .cdp-body { font-size:11px; margin-top:2px; }
            .cdp-btn { width:26px; height:26px; flex-shrink:0; }
            .cat-design-card.border-neutral-800 { box-shadow:0 0 0 3px rgba(44,44,46,.15); }
          </style>
          <script>
            (function () {
              var form = document.getElementById('cat-design-form');
              if (!form) return;
              // Al cambiar de radio, marca la tarjeta activa y envía solo este formulario
              var radios = form.querySelectorAll('input[name="catalog_design"]');
              radios.forEach(function (r) {
                r.addEventListener('change', function () {
                  form.querySelectorAll('.cat-design-card').forEach(function (c) {
                    var on = c.querySelector('input').checked;
                    c.classList.toggle('border-neutral-800', on);
                    c.classList.toggle('bg-neutral-100/40', on);
                    c.classList.toggle('dark:bg-neutral-800/40', on);
                    c.classList.toggle('border-slate-200', !on);
                    c.classList.toggle('dark:border-[#30363d]', !on);
                  });
                });
              });
            })();
          </script>
        </section>

      <!-- ============================================================
      SECCIÓN 3: IMÁGENES
      ============================================================ -->
      <section id="config-images" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="config-section-head flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 20h16M6 8h.01M6 8a2 2 0 100-4 2 2 0 000 4z"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Imágenes</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Logo y banner de tu tienda</p>
          </div>
        </div>

        <form data-noajax method="POST" action="<%= cfgAction %>#config-images" class="space-y-4">
          <div>
            <label class="config-label">Logo</label>
            <div class="config-upload-row flex items-center gap-3 flex-wrap">
              <label class="cursor-pointer bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold px-4 py-2.5 rounded-xl transition text-slate-700 dark:text-slate-300">
                <span class="inline-flex items-center gap-2"><svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h4l1.5-2h5L16 7h4v12H4z"/><circle cx="12" cy="13" r="3"/></svg> Subir logo</span>
                <input id="foto-logo" type="file" accept="image/*" class="hidden" onchange="subirConEditor('foto-logo', 'logo-url', 'prev-logo')">
              </label>
              <span class="cfg-thumb cfg-thumb-logo"><img id="prev-logo" src="<%= biz.logo || '/img/sin-imagen.svg' %>" alt="Logo"></span>
              <button type="button" onclick="quitarImagenTienda('logo')" id="quitar-logo" class="text-xs font-bold text-red-600 hover:text-red-800 <%= biz.logo ? '' : 'hidden' %>">Quitar logo</button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Se ve completo, sin recortar. Las franjas blancas o negras pegadas al borde se quitan solas.</p>
            <input name="logo" id="logo-url" type="hidden" value="<%= biz.logo || '' %>">
            <input name="logo_clear" id="logo-clear" type="hidden" value="">
          </div>

          <div>
            <label class="config-label">Banner de portada <span class="text-slate-400 font-normal">(plantillas con portada)</span></label>
            <div class="config-upload-row flex items-center gap-3 flex-wrap">
              <label class="cursor-pointer bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold px-4 py-2.5 rounded-xl transition text-slate-700 dark:text-slate-300">
                <span class="inline-flex items-center gap-2"><svg class="config-ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h4l1.5-2h5L16 7h4v12H4z"/><circle cx="12" cy="13" r="3"/></svg> Subir banner</span>
                <input id="foto-banner" type="file" accept="image/*" class="hidden" onchange="subirConEditor('foto-banner', 'banner-url', 'prev-banner')">
              </label>
              <button type="button" onclick="quitarImagenTienda('banner')" id="quitar-banner" class="text-xs font-bold text-red-600 hover:text-red-800 <%= biz.banner ? '' : 'hidden' %>">Quitar banner</button>
            </div>
            <span class="cfg-thumb cfg-thumb-banner mt-2"><img id="prev-banner" src="<%= biz.banner || '/img/sin-imagen.svg' %>" alt="Banner"></span>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Ocupa todo el ancho de la portada; lo que sobre se recorta. Mejor una foto horizontal.</p>
            <input name="banner" id="banner-url" type="hidden" value="<%= biz.banner || '' %>">
            <input name="banner_clear" id="banner-clear" type="hidden" value="">
          </div>

          <div class="flex gap-3 pt-2">
            <button class="m-btn m-btn-filled flex-1 !min-h-11 dark:bg-[#d4d4d4] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>
      <% } %>

      <!-- ============================================================
      SECCIÓN 4: SEGURIDAD (solo visible para el dueño)
      ============================================================ -->
      <% if (!esMaestro) { %>
      <section id="config-security" class="m-card config-section p-5 md:p-6 dark:bg-[#161b22] dark:border-[#21262d]">
        <div class="config-section-head flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/30 text-red-500 dark:text-red-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white">Acceso seguro</h2>
            <p class="text-xs text-slate-400 dark:text-slate-500">Tu PIN para entrar al panel</p>
          </div>
        </div>

        <form data-noajax method="POST" action="/<%= biz.slug %>/admin/cambiar-pin#config-security" class="space-y-3 mb-6">
          <div class="grid md:grid-cols-3 gap-3">
            <label><span class="config-label">PIN actual</span><input name="pin_actual" type="password" inputmode="numeric" autocomplete="current-password" placeholder="Ingresa tu PIN" class="config-input" required></label>
            <label><span class="config-label">PIN nuevo</span><input name="pin_nuevo" type="password" inputmode="numeric" autocomplete="new-password" placeholder="6 a 12 dígitos" class="config-input" required></label>
            <label><span class="config-label">Confirmar PIN</span><input name="pin_repite" type="password" inputmode="numeric" autocomplete="new-password" placeholder="Repite el PIN nuevo" class="config-input" required></label>
          </div>
          <button class="m-btn m-btn-filled m-btn-sm dark:bg-[#d4d4d4] dark:text-[#062e6f] dark:hover:bg-[#a0c4ff]">
            Cambiar PIN
          </button>
        </form>

        <div class="security-reset border-t border-slate-200 dark:border-[#30363d] pt-4">
          <p class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">¿El dueño olvidó su PIN?</p>
          <form data-noajax method="POST" action="/<%= biz.slug %>/admin/resetear-pin#config-security" class="flex flex-wrap gap-2">
            <label class="flex-1 max-w-xs"><span class="config-label">Código maestro</span><input name="master" type="password" autocomplete="current-password" placeholder="Código maestro" class="config-input" required></label>
            <button class="m-btn m-btn-danger m-btn-sm dark:bg-[#8b2d32] dark:text-white dark:hover:bg-[#a03a3f]">
              Resetear a 1234
            </button>
          </form>
        </div>
      </section>
      <% } %>

        </div>
      </div>

    </div>
  </main>


  <style>
    .gt-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:8px; border:1px solid rgba(0,0,0,.1); border-radius:12px; }
    .gt-row .gt-text { flex:1 1 170px; min-width:0; }
    .gt-colors { display:flex; align-items:center; gap:5px; flex-wrap:wrap; }
    .gt-dot { width:22px; height:22px; border-radius:50%; border:2px solid transparent; cursor:pointer; box-shadow:0 0 0 1px rgba(0,0,0,.12); }
    .gt-dot.on { border-color:#fff; box-shadow:0 0 0 2px #15181d; }
    .gt-color { width:28px; height:28px; padding:0; border:0; background:none; cursor:pointer; }
    .gt-prev { display:inline-block; padding:3px 10px; border-radius:6px; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .gt-del { width:32px; height:32px; border-radius:8px; color:#dc2626; background:none; border:0; cursor:pointer; }
    .gt-del:hover { background:rgba(220,38,38,.08); }
    .gt-sug { min-height:30px; padding:0 11px; border:1px solid rgba(0,0,0,.14); border-radius:999px; background:#fff; font-size:11.5px; font-weight:700; cursor:pointer; }
    .gt-sug:hover { border-color:#15181d; }
  </style>
