    return JSON.stringify(PAGE_BG);
  }

  /* ===== NAVEGACIÓN ===== */
  function toggleNavPanel(){ document.getElementById('nav-panel').classList.toggle('open'); }
  function setNav(k, v){ NAV_STYLE[k] = v; _dirty = true; setSaveStatus('editing'); if (k === 'bgType') syncNavBgFields(); renderCanvas(); }
  function setPageLayout(k, v){ PAGE_LAYOUT[k] = v; _dirty = true; setSaveStatus('editing'); renderCanvas(); syncLayoutButtons(); }
  function togglePageLayout(which){
    var key = which === 'header' ? 'showHeader' : 'showFooter';
    PAGE_LAYOUT[key] = !PAGE_LAYOUT[key];
    _dirty = true; setSaveStatus('editing'); renderCanvas(); syncLayoutButtons();
  }
  function syncLayoutButtons(){
    var bh = document.getElementById('btn-toggle-header');
    var bf = document.getElementById('btn-toggle-footer');
    if (bh){
      bh.style.background = PAGE_LAYOUT.showHeader ? 'var(--wp-accent)' : 'var(--wp-bg)';
      bh.style.color = PAGE_LAYOUT.showHeader ? '#fff' : 'var(--wp-muted)';
      bh.style.borderColor = PAGE_LAYOUT.showHeader ? 'var(--wp-accent)' : 'var(--wp-line)';
    }
    if (bf){
      bf.style.background = PAGE_LAYOUT.showFooter ? 'var(--wp-accent)' : 'var(--wp-bg)';
      bf.style.color = PAGE_LAYOUT.showFooter ? '#fff' : 'var(--wp-muted)';
      bf.style.borderColor = PAGE_LAYOUT.showFooter ? 'var(--wp-accent)' : 'var(--wp-line)';
    }
  }
  function bindNavControls(){
    bindPageBgControls();
    var binds = [
      ['nav-estilo','estilo','str'], ['nav-align','align','str'], ['nav-direction','direction','str'], ['nav-posicion','posicion','str'],
      ['nav-bg-type','bgType','str'], ['nav-bg','bg','color'], ['nav-bg2','bg2','color'], ['nav-bg-angle','bgAngle','num'],
      ['nav-bg-image','bgImage','text'], ['nav-bg-pattern','bgPattern','str'], ['nav-bg-pattern-c','bgPatternC','color'],
      ['nav-text','text','color'], ['nav-active-bg','activeBg','color'], ['nav-active-text','activeText','color'],
      ['nav-radius','radius','str'], ['nav-shadow','shadow','str'], ['nav-gap','gap','num'], ['nav-pad','pad','num'], ['nav-size','size','num'],
      ['nav-uppercase','uppercase','str'], ['nav-border-w','borderW','num'], ['nav-border-c','borderC','color'], ['nav-opacity','opacity','num'],
      ['nav-sticky-on','stickyOn','str'], ['nav-sticky-pos','stickyPos','str'], ['nav-sticky-off','stickyOff','num'],
      ['nav-sticky-bg','stickyBg','color'], ['nav-sticky-shadow','stickyShadow','str'],
      ['nav-hov-bg','hovBg','color'], ['nav-hov-text','hovText','color'], ['nav-hov-under','hovUnder','str'], ['nav-hov-scale','hovScale','str'],
      ['nav-icons','icons','str'], ['nav-icon-pos','iconPos','str'], ['nav-mobile','mobile','str'], ['nav-breakpoint','breakpoint','num'],
      ['nav-act-border','actBorder','str'], ['nav-act-border-c','actBorderC','color'], ['nav-act-border-w','actBorderW','num'], ['nav-act-border-pos','actBorderPos','str']
    ];
    binds.forEach(function(b){
      var el = document.getElementById(b[0]);
      if (!el) return;
      var key = b[1], type = b[2];
      if (type === 'color') {
        var def = (key === 'activeBg' ? (NAV_STYLE.color || PAL.accent || '#2563eb') : (key === 'activeText' ? '#ffffff' : (key === 'stickyBg' ? '#ffffff' : (key === 'borderC' ? '#cccccc' : (key === 'actBorderC' ? '#2563eb' : (key === 'bg2' || key === 'bgPatternC' ? '#e2e8f0' : (key === 'hovBg' || key === 'hovText' ? '' : '#000000')))))));
        el.value = (NAV_STYLE[key] || def).replace(/^#?([0-9a-fA-F]{6})$/, '#$1');
        el.oninput = function(){ setNav(key, el.value); };
      } else if (type === 'num') {
        el.value = String(Number(NAV_STYLE[key]) || 0);
        el.onchange = function(){ setNav(key, Number(el.value) || 0); };
      } else if (type === 'text') {
        el.value = String(NAV_STYLE[key] || '');
        el.oninput = function(){ setNav(key, el.value); };
      } else {
        el.value = String(NAV_STYLE[key] == null ? '' : NAV_STYLE[key]);
        el.onchange = function(){ setNav(key, el.value); syncNavBgFields(); };
      }
    });
    syncNavBgFields();
    conectarSubirImgBtn(document.getElementById('nav-bg-image'), function(url){ setNav('bgImage', url); });
  }
  function syncNavBgFields(){
    var t = NAV_STYLE.bgType || 'solid';
    var ids = ['fld-nav-bg2','fld-nav-bgangle','fld-nav-bgimage','fld-nav-bgpattern','fld-nav-bgpattern-c'];
    var show = { 'fld-nav-bg2': (t==='linear'||t==='radial'||t==='conic'), 'fld-nav-bgangle': (t==='linear'), 'fld-nav-bgimage': (t==='image'), 'fld-nav-bgpattern': (t==='pattern'), 'fld-nav-bgpattern-c': (t==='pattern') };
    ids.forEach(function(id){ var el = document.getElementById(id); if (el) el.style.display = show[id] ? '' : 'none'; });
  }

  /* ===== RESIZE HANDLES PARA MÁSCARAS ===== */
  function bindMascaraResize(){
    document.addEventListener('mousedown', function(e){
      var handle = e.target.closest('.resize-handle');
      if (!handle) return;
      e.preventDefault(); e.stopPropagation();
      var child = handle.closest('.mascara-child');
      if (!child) return;
      var mascara = child.closest('.pv-mascara');
      if (!mascara) return;
      var inner = mascara.querySelector('.mascara-inner');
      if (!inner) return;
      var startX = e.clientX, startY = e.clientY;
      var rect = child.getBoundingClientRect();
      var innerRect = inner.getBoundingClientRect();
      var startW = rect.width, startH = rect.height;
      var startL = rect.left - innerRect.left, startT = rect.top - innerRect.top;
      var isBR = handle.classList.contains('br');
      var isTR = handle.classList.contains('tr');
      var isBL = handle.classList.contains('bl');
      var isTL = handle.classList.contains('tl');
      function onMove(ev){
        var dx = ev.clientX - startX;
        var dy = ev.clientY - startY;
        var newW = startW, newH = startH, newL = startL, newT = startT;
        if (isBR) { newW = Math.max(40, startW + dx); newH = Math.max(40, startH + dy); }
        else if (isTR) { newW = Math.max(40, startW + dx); newH = Math.max(40, startH - dy); newT = startT + dy; }
        else if (isBL) { newW = Math.max(40, startW - dx); newH = Math.max(40, startH + dy); newL = startL + dx; }
        else if (isTL) { newW = Math.max(40, startW - dx); newH = Math.max(40, startH - dy); newL = startL + dx; newT = startT + dy; }
        child.style.width = newW + 'px';
        child.style.height = newH + 'px';
        child.style.left = newL + 'px';
        child.style.top = newT + 'px';
        child.style.position = 'absolute';
        child.style.margin = '0';
      }
      function onUp(){
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        // persistir
        var childId = child.getAttribute('data-child-id');
        if (childId) {
          var b = buscarEn(PAGINAS, childId);
          if (b && b.b) {
            b.b.style = b.b.style || '';
            var styleObj = {};
            b.b.style.split(';').forEach(function(s){ var p=s.split(':'); if(p.length===2) styleObj[p[0].trim()]=p[1].trim(); });
            styleObj.width = child.style.width;
            styleObj.height = child.style.height;
            styleObj.left = child.style.left;
            styleObj.top = child.style.top;
            styleObj.position = 'absolute';
            styleObj.margin = '0';
            b.b.style = Object.entries(styleObj).map(function(kv){ return kv[0]+':'+kv[1]; }).join(';');
            pushUndo(); renderCanvas();
          }
        }
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  }
  document.documentElement.classList.add('ct-js');
  paginaActiva = PAGINAS.length ? PAGINAS[0].id : null;
  if (!PAGINAS.length) PAGINAS.push({ id:nuevoId('pg'), title:'Inicio', icon:'🏠', blocks:[] });
  var _metaIni = _tplMeta(TPL_SEL);
  if (_metaIni) aplicarTema(_metaIni, !!_savedPageBg);
  bindNavControls();
  bindMascaraResize();
  syncLayoutButtons();
  applyPalette();
  renderTabs();
  renderCanvas();
  if (!HAS_BLOCKS && !TPL_SEL && !(defaultStack && defaultStack.length)) abrirPlantillas();

  /* ===== UX: Unsaved changes warning ===== */
  window.addEventListener('beforeunload', function(e){
    if (_dirty){ e.preventDefault(); e.returnValue = ''; }
  });

  /* ===== UX: Shortcut panel ===== */
  function toggleShortcuts(force){
    var p = document.getElementById('shortcut-panel');
    if (!p) return;
    if (typeof force === 'boolean') p.classList.toggle('open', force);
    else p.classList.toggle('open');
  }

  /* ===== Overlay drag ===== */
  (function initOverlayDrag(){
    document.addEventListener('mousedown', function(e){
      var el = e.target.closest('.pv-overlay-drag');
      if (!el) return;
      e.preventDefault();
      el.classList.add('drag-active');
      var startLeft = parseFloat(el.style.left) || 50;
      var startTop = parseFloat(el.style.top) || 50;
      var box = el.parentElement;
      var bw = box ? box.offsetWidth : 800;
      var bh = box ? box.offsetHeight : 600;
      var onMove = function(ev){
        var rect = box.getBoundingClientRect();
        var mx = ev.clientX - rect.left;
        var my = ev.clientY - rect.top;
        var nx = Math.max(0, Math.min(100, (mx / bw) * 100));
        var ny = Math.max(0, Math.min(100, (my / bh) * 100));
        el.style.left = nx + '%';
        el.style.top = ny + '%';
        el.style.transform = 'translate(-50%,-50%)' + (el.style.transform.indexOf('rotate') > -1 ? el.style.transform.replace(/rotate\([^)]+\)/, '') : '');
        var bid = el.getAttribute('data-block-id');
        if (bid) {
          var blk = bloques.find(function(b){ return b.id === bid; });
          if (blk) { blk.posX = Math.round(nx); blk.posY = Math.round(ny); _dirty = true; }
        }
      };
      var onUp = function(){
        el.classList.remove('drag-active');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        render();
      };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  })();
</script>
