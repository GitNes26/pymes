  function subirArchivo(file, kind){
    var fd = new FormData();
    if (kind==='video') fd.append('video', file);
    else if (kind==='audio' || kind==='archivo') fd.append('archivo', file);
    else fd.append('foto', file);
    var tok = (window.__csrfValue && window.__csrfValue()) || '';
    if (tok) fd.append('_csrf', tok);
    var upUrl = '<%= esMaestro ? "/maestro/" + biz.id + "/upload" : "/" + biz.slug + "/admin/upload" %>';
    if (kind==='video') upUrl = '<%= esMaestro ? "/maestro/" + biz.id + "/uploadvideo" : "/" + biz.slug + "/admin/uploadvideo" %>';
    if (kind==='audio' || kind==='archivo') upUrl = '<%= esMaestro ? "/maestro/" + biz.id + "/uploadfile" : "/" + biz.slug + "/admin/uploadfile" %>';
    return fetch(upUrl, { method:'POST', body: fd, headers: tok ? { 'x-csrf-token': tok } : {}, credentials:'same-origin' })
      .then(function(r){ return r.json(); });
  }

  // Botón "⬆ Subir imagen" para los campos de imagen de fondo (página, menú y bloques).
  // Sube el archivo al servidor y mete la URL en el campo de enlace.
  function conectarSubirImgBtn(input, onUrl){
    if (!input || !input.nodeType) return;
    var row = document.createElement('div'); row.className='img-row'; row.style.marginTop='6px';
    var upBtn = document.createElement('button'); upBtn.type='button'; upBtn.textContent='⬆ Subir imagen';
    var file = document.createElement('input'); file.type='file'; file.accept='image/*'; file.style.display='none';
    upBtn.onclick = function(){ file.click(); };
    file.addEventListener('change', function(){
      var f = file.files[0]; file.value = ''; if (!f) return;
      subirArchivo(f, 'foto').then(function(d){
        if (d && d.url){
          input.value = d.url;
          input.dispatchEvent(new Event('input', {bubbles:true}));
          input.dispatchEvent(new Event('change', {bubbles:true}));
          if (onUrl) onUrl(d.url);
          mostrarToast('Imagen subida ✓');
        } else mostrarToast('No se pudo subir. Usa .jpg, .png o .webp y menos de 5MB.', 'error');
      }).catch(function(){ mostrarToast('Error al subir la imagen.', 'error'); });
    });
    row.appendChild(upBtn); row.appendChild(file);
    input.parentNode.insertBefore(row, input);
  }



  /* ===== GALERÍA ===== */
  var _galOnPick = null;
  var _galMulti = false;
  var _galSelected = [];
  var _galOnPickMulti = null;
  function galeriaImagenes(){
    var list = [];
    if (BIZ_LOGO) list.push(BIZ_LOGO);
    if (BIZ_BANNER) list.push(BIZ_BANNER);
    PRODUCTS.forEach(function(p){ if (p.image) list.push(p.image); });
    try { var saved = JSON.parse(localStorage.getItem('nessik_galeria')||'[]'); if (Array.isArray(saved)) saved.forEach(function(u){ list.push(u); }); } catch(e){}
    return list.filter(function(v,i,a){ return v && a.indexOf(v)===i; });
  }
  function abrirGaleria(onPick, multi){
    _galOnPick = onPick;
    _galMulti = !!multi;
    _galSelected = [];
    _galOnPickMulti = multi ? onPick : null;
    var grid = document.getElementById('galeria-grid');
    grid.innerHTML = '';
    var bar = document.getElementById('galeria-multi-bar');
    bar.classList.remove('show');
    var multiBtn = document.getElementById('gal-multi-btn');
    if (multiBtn) multiBtn.style.display = _galMulti ? 'none' : '';
    var imgs = galeriaImagenes();
    if (!imgs.length){ grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:#757575;font-size:13px;padding:20px;">No hay imágenes guardadas todavía. Sube una o agrega productos.</div>'; }
    imgs.forEach(function(url){
      var img = document.createElement('img'); img.src=url; img.dataset.url=url;
      img.onclick = function(){
        if (_galMulti){
          var idx = _galSelected.indexOf(url);
          if (idx > -1){ _galSelected.splice(idx, 1); img.classList.remove('selected'); }
          else { _galSelected.push(url); img.classList.add('selected'); }
          var cnt = document.getElementById('gal-multi-count');
          cnt.textContent = _galSelected.length + ' seleccionada' + (_galSelected.length !== 1 ? 's' : '');
          bar.classList.toggle('show', _galSelected.length > 0);
        } else {
          if (_galOnPick) _galOnPick(url); cerrarGaleria();
        }
      };
      grid.appendChild(img);
    });
    if (_galMulti && multiBtn) multiBtn.click();
    document.getElementById('galeria').classList.add('open');
  }
  function cerrarGaleria(){ document.getElementById('galeria').classList.remove('open'); _galOnPick=null; _galMulti=false; _galSelected=[]; document.getElementById('galeria-multi-bar').classList.remove('show'); }
  function galMultiCancel(){ _galSelected=[]; document.getElementById('galeria-multi-bar').classList.remove('show'); document.querySelectorAll('#galeria-grid img.selected').forEach(function(i){ i.classList.remove('selected'); }); }
  function galMultiConfirm(){
    if (!_galSelected.length || !_galOnPickMulti) return;
    _galOnPickMulti(_galSelected.slice());
    cerrarGaleria();
    mostrarToast(_galSelected.length + ' imagen(es) aplicada(s) ✓');
  }
  function guardarImagenLocal(url){
    try { var a = JSON.parse(localStorage.getItem('nessik_galeria')||'[]'); if (a.indexOf(url)===-1) a.unshift(url); localStorage.setItem('nessik_galeria', JSON.stringify(a.slice(0,30))); } catch(e){}
  }

  /* ===== PICKER ===== */
  function abrirPickerRaiz(){ _destino = null; abrirPicker(); }
  function abrirPicker(){
    document.getElementById('block-picker').classList.add('open');
    document.getElementById('picker-search').value='';
    filtrarPicker('');
  }
  function cerrarPicker(){ document.getElementById('block-picker').classList.remove('open'); }
  function setPickerMode(mode){
    if (!mode || (mode !== 'simple' && mode !== 'advanced')) mode = 'simple';
    PICKER_MODE = mode;
    var modal = document.getElementById('block-picker');
    if (modal) {
      modal.querySelectorAll('[data-picker-mode]').forEach(function(btn){
        btn.classList.toggle('active', btn.getAttribute('data-picker-mode') === mode);
      });
    }
    filtrarPicker(document.getElementById('picker-search') ? document.getElementById('picker-search').value : '');
  }
  function getVisiblePickerGroups(){
    return PICKER_GROUPS.filter(function(cat){ return !cat.mode || cat.mode.indexOf(PICKER_MODE) !== -1; });
  }
  function filtrarPicker(q){
    q=(q||'').toLowerCase().trim();
