          el.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', _dragId);
        });
        el.addEventListener('dragend', function(){ el.classList.remove('dragging'); _dragId = null; designPane.querySelectorAll('.drag-over-top,.drag-over-bottom,.drag-over-zone').forEach(function(x){ x.classList.remove('drag-over-top','drag-over-bottom','drag-over-zone'); }); });
      });
      designPane.addEventListener('dragover', function(e){
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        designPane.querySelectorAll('.drag-over-top,.drag-over-bottom,.drag-over-zone').forEach(function(x){ x.classList.remove('drag-over-top','drag-over-bottom','drag-over-zone'); });
        if (!_dragId) return;
        var colZone = e.target.closest('[data-drop-col]');
        var cardZone = e.target.closest('[data-drop-card]');
        var masZone = e.target.closest('[data-drop-mascara]');
        if (colZone){
          var draggedEl = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedEl && !colZone.contains(draggedEl)){ colZone.classList.add('drag-over-zone'); return; }
        }
        if (cardZone){
          var draggedEl2 = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedEl2 && !cardZone.contains(draggedEl2)){ cardZone.classList.add('drag-over-zone'); return; }
        }
        if (masZone){
          var draggedEl3 = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedEl3 && !masZone.contains(draggedEl3)){ masZone.classList.add('drag-over-zone'); return; }
        }
        var tgt = e.target.closest('.blk');
        if (!tgt || tgt.dataset.id === _dragId) return;
        var rect = tgt.getBoundingClientRect();
        var mid = rect.top + rect.height / 2;
        if (e.clientY < mid) tgt.classList.add('drag-over-top'); else tgt.classList.add('drag-over-bottom');
      });
      designPane.addEventListener('drop', function(e){
        e.preventDefault();
        designPane.querySelectorAll('.drag-over-top,.drag-over-bottom,.drag-over-zone').forEach(function(x){ x.classList.remove('drag-over-top','drag-over-bottom','drag-over-zone'); });
        if (!_dragId) return;
        var from = localizar(_dragId);
        if (!from) return;
        var colZone = e.target.closest('[data-drop-col]');
        var cardZone = e.target.closest('[data-drop-card]');
        var masZone = e.target.closest('[data-drop-mascara]');
        if (colZone){
          var draggedInCol = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedInCol && colZone.contains(draggedInCol)) return;
          var _dcIdx = colZone.dataset.dropCol.lastIndexOf('-');
          var rowId = colZone.dataset.dropCol.slice(0, _dcIdx); var colIdx = parseInt(colZone.dataset.dropCol.slice(_dcIdx+1),10);
          var fr = localizar(rowId);
          if (fr && fr.b.type==='row' && fr.b.columns[colIdx]){
            pushUndo();
            var item = from.arr.splice(from.i, 1)[0];
            fr.b.columns[colIdx].blocks.push(item);
            renderCanvas();
          }
          return;
        }
        if (cardZone){
          var draggedInCard = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedInCard && cardZone.contains(draggedInCard)) return;
          var _ccIdx = cardZone.dataset.dropCard.lastIndexOf('-');
          var cardId = cardZone.dataset.dropCard.slice(0, _ccIdx); var zone = cardZone.dataset.dropCard.slice(_ccIdx+1);
          var fc = localizar(cardId);
          if (fc && fc.b.type==='card' && (zone==='body'||zone==='footer')){
            pushUndo();
            var item2 = from.arr.splice(from.i, 1)[0];
            fc.b[zone].push(item2);
            renderCanvas();
          }
          return;
        }
        if (masZone){
          var draggedInMas = designPane.querySelector('.blk[data-id="'+_dragId+'"]');
          if (draggedInMas && masZone.contains(draggedInMas)) return;
          var masId = masZone.dataset.dropMascara;
          var fm = localizar(masId);
          if (fm && fm.b.type==='mascara'){
            pushUndo();
            var item3 = from.arr.splice(from.i, 1)[0];
            fm.b.children.push(item3);
            renderCanvas();
          }
          return;
        }
        var tgt = e.target.closest('.blk');
        if (!tgt || tgt.dataset.id === _dragId) return;
        var to = localizar(tgt.dataset.id);
        if (!to) return;
        var rect = tgt.getBoundingClientRect();
        var mid = rect.top + rect.height / 2;
        var fromIdx = from.i;
        if (from.arr === to.arr){
          var toIdx = to.i + (e.clientY >= mid ? 1 : 0);
          pushUndo();
          var item4 = from.arr.splice(fromIdx, 1)[0];
          if (fromIdx < toIdx) toIdx--;
          to.arr.splice(toIdx, 0, item4);
        } else {
          pushUndo();
          var item5 = from.arr.splice(fromIdx, 1)[0];
          var toIdx2 = to.i + (e.clientY >= mid ? 1 : 0);
          to.arr.splice(toIdx2, 0, item5);
        }
        renderCanvas();
      });
    }
  }

  function bindReveals(scope){
    var host = scope || document;
    var els = host.querySelectorAll('.ct-anim-fade,.ct-anim-up,.ct-anim-down,.ct-anim-left,.ct-anim-right,.ct-anim-zoom');
    if (!els.length) return;
    function reveal(el){
      if (window.requestAnimationFrame){
        window.requestAnimationFrame(function(){
          window.requestAnimationFrame(function(){ el.classList.add('ct-anim-on'); });
        });
      } else el.classList.add('ct-anim-on');
    }
    if (!('IntersectionObserver' in window)) {
      els.forEach(reveal);
      return;
    }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting){
          obs.unobserve(en.target);
          reveal(en.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
    els.forEach(function(el){ obs.observe(el); });
    setTimeout(function(){
      els.forEach(function(el){
