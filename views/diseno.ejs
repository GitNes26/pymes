    var h1 = /^#[0-9a-fA-F]{6}$/.test(c.bg || '') ? c.bg : '';
    var h2 = /^#[0-9a-fA-F]{6}$/.test(c.bg2 || '') ? c.bg2 : '';
    var ang = Number(c.bgAngle) || 135;
    if (c.type === 'linear') return (c.bg || c.bg2) ? 'linear-gradient(' + ang + 'deg,' + (h1 || '#ffffff') + ',' + (h2 || '#e2e8f0') + ')' : 'transparent';
    if (c.type === 'radial') return (c.bg || c.bg2) ? 'radial-gradient(circle at 50% 40%,' + (h1 || '#ffffff') + ',' + (h2 || '#e2e8f0') + ')' : 'transparent';
    if (c.type === 'conic') return (c.bg || c.bg2) ? 'conic-gradient(from 0deg at 50% 50%,' + (h1 || '#ffffff') + ',' + (h2 || '#e2e8f0') + ')' : 'transparent';
