        btn.addEventListener('click', function(e){ e.stopPropagation(); if (btn.dataset.mascara){ _destino = { kind:'mascara', mascaraId: btn.dataset.mascara }; } else { _destino = { kind:'card', cardId: btn.dataset.card, zone: btn.dataset.zone }; } abrirPicker(); });
      });
      designPane.querySelectorAll('.pv-nav').forEach(function(navEl){
        navEl.addEventListener('click', function(e){
