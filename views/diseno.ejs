<script>
  /* ===== DATOS INYECTADOS ===== */
  var RAW_BLOCKS = <%- safeJson((blocksList && blocksList.length ? blocksList : (defaultStack || []))) %>;
  var HAS_BLOCKS = <%- safeJson(!!(blocksList && blocksList.length)) %>;
  var CATS = <%- safeJson(cats || []) %>;
  var PRODUCTS = <%- safeJson(previewProducts || []) %>;
  var CUR = <%- safeJson(currencySymbol || '$') %>;
  var BIZ_LOGO = <%- safeJson(biz.logo || '') %>;
  var BIZ_BANNER = <%- safeJson(biz.banner || '') %>;
  var BIZ_NAME = <%- safeJson(biz.name || '') %>;
  var BIZ_SLUG = <%- safeJson(biz.slug || '') %>;
  var BIZ_DESC = <%- safeJson(biz.description || '') %>;
  var BIZ_WHATSAPP = <%- safeJson(biz.whatsapp || '') %>;
  var BIZ_HORARIO = <%- safeJson(biz.horario || '') %>;
  var BIZ_HORARIO_MSG = <%- safeJson(biz.horario_msg || '') %>;
  var PAL = <%- safeJson({ accent: pal.accent, accent2: pal.accent2, bg: diseno.bg, card: diseno.card, text: diseno.text, muted: diseno.muted, border: diseno.border, radius: diseno.radius }) %>;
  var _savedPageBg = <%- safeJson(biz.page_bg || '') %>;
  var PAGE_BG = _savedPageBg;
  function parsePageBg(v){
    if (v && typeof v === 'string') { try { var o = JSON.parse(v); if (o && typeof o === 'object') return o; } catch(e){} }
    if (/^#[0-9a-fA-F]{6}$/.test(v || '')) return { type: 'solid', bg: v };
    return null;
  }
  PAGE_BG = parsePageBg(PAGE_BG) || { type: 'solid', bg: PAL.bg || '#ffffff' };
  var CFG_ACTION = '<%= esMaestro ? "/maestro/" + biz.id + "/config" : "/" + biz.slug + "/admin/config" %>';
  var TPL_META = <%- safeJson(TPL_META || []) %>;
  var TPL_CASOS = <%- safeJson((typeof locals !== 'undefined' && locals.TPL_CASOS) || []) %>;
  var _CASE_ICONS = { local:'🏘️', tienda:'🛒', servicio:'💼', restaurante:'🍽️', portafolio:'🎨' };
  var TPL_SEL = <%- safeJson(template || '') %>;
  var SECTIONS_RAW = <%- safeJson(biz.sections || '{}') %>;
  var _sectionsObj = {};
  try { _sectionsObj = JSON.parse(SECTIONS_RAW || '{}'); } catch(e){}
  var _navCfg = (_sectionsObj.nav && typeof _sectionsObj.nav === 'object') ? _sectionsObj.nav : {};
  var NAV_STYLE = {
    estilo: _navCfg.estilo || 'pildoras',
    align: _navCfg.align || 'left',
    direction: _navCfg.direction || 'horizontal',
    color: _navCfg.color || '',
    activeBg: _navCfg.activeBg || '',
    activeText: _navCfg.activeText || '',
    bg: _navCfg.bg || '#ffffff',
    bgType: _navCfg.bgType || 'solid',
    bg2: _navCfg.bg2 || '#e2e8f0',
    bgAngle: Number(_navCfg.bgAngle) || 135,
    bgImage: _navCfg.bgImage || '',
    bgPattern: _navCfg.bgPattern || 'rayas',
    bgPatternC: _navCfg.bgPatternC || '#e2e8f0',
    text: _navCfg.text || '#0f172a',
    posicion: _navCfg.posicion || 'arriba',
    radius: _navCfg.radius || 'pill',
    shadow: _navCfg.shadow || 'soft',
    gap: Number(_navCfg.gap) || 8,
    pad: Number(_navCfg.pad) || 10,
    size: Number(_navCfg.size) || 14,
    uppercase: _navCfg.uppercase || 'no',
    borderW: Number(_navCfg.borderW) || 0,
    borderC: _navCfg.borderC || '#cccccc',
    opacity: Number(_navCfg.opacity) || 100,
    stickyOn: _navCfg.stickyOn || ((_navCfg.sticky === 'si') ? 'si' : 'no'),
    stickyPos: _navCfg.stickyPos || 'top',
    stickyOff: Number(_navCfg.stickyOff) || 0,
    stickyBg: _navCfg.stickyBg || '#ffffff',
    stickyShadow: _navCfg.stickyShadow || 'medium',
    hovBg: _navCfg.hovBg || '',
    hovText: _navCfg.hovText || '',
    hovUnder: _navCfg.hovUnder || 'no',
    hovScale: _navCfg.hovScale || '1',
    icons: _navCfg.icons || 'si',
    iconPos: _navCfg.iconPos || 'left',
    mobile: _navCfg.mobile || 'si',
    breakpoint: Number(_navCfg.breakpoint) || 768,
    actBorder: _navCfg.actBorder || 'no',
    actBorderC: _navCfg.actBorderC || '#2563eb',
    actBorderW: Number(_navCfg.actBorderW) || 2,
    actBorderPos: _navCfg.actBorderPos || 'bottom'
  };

  var PAGE_LAYOUT = {
    showHeader: _sectionsObj.showHeader !== false,
    showFooter: _sectionsObj.showFooter !== false
  };

  function fmtMoney(n){ return CUR + Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

  /* ===== ESTADO ===== */
  function nuevoId(prefijo){
    var base = prefijo || 'c';
    var stamp = Date.now().toString(36);
    var seq = (++__ctorSeq).toString(36);
    var salt = Math.random().toString(36).slice(2, 8);
    return base + stamp + '-' + seq + '-' + salt;
  }
  function normalizePages(raw){
    raw = Array.isArray(raw) ? raw : [];
    if (raw.length && raw[0] && typeof raw[0].type === 'undefined' && Array.isArray(raw[0].blocks)){
      return raw.map(function(pg){ return { id: pg.id||nuevoId('pg'), title: pg.title||'Página', icon: pg.icon||'📄', blocks: (Array.isArray(pg.blocks)?pg.blocks:[]) }; });
    }
    return [{ id:'pg-inicio', title:'Inicio', icon:'🏠', blocks: raw }];
  }
  function buildDemo(){
    var cats = CATS && CATS.length ? CATS.map(function(c){ return { id: c.id, nombre: c.name }; }) : SAMPLE_CATS;
    var prods = PRODUCTS && PRODUCTS.length ? PRODUCTS.map(function(p){ return { id:p.id, nombre:p.name, precio:fmtMoney(p.price), img:p.image||'', old:p.old_price, featured:p.featured, cat:p.category_name||'', catId:p.category_id||0 }; }) : SAMPLE_PRODUCTS;
    return { categorias: cats, productos: prods };
  }
  var SAMPLE_CATS = [{id:1,nombre:'Tacos'},{id:2,nombre:'Quesadillas'},{id:3,nombre:'Bebidas'},{id:4,nombre:'Postres'}];
  var SAMPLE_PRODUCTS = [
