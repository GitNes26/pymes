    var abC = /^#[0-9a-fA-F]{6}$/.test(NS.actBorderC || '') ? NS.actBorderC : accent;
    if (NS.actBorder === 'si') {
      var abp = NS.actBorderPos || 'bottom';
      actB = (abp === 'all') ? 'border:'+abW+'px solid '+abC+' !important;' : 'border-'+abp+':'+abW+'px solid '+abC+' !important;';
    }
    var hovBg = /^#[0-9a-fA-F]{6}$/.test(NS.hovBg || '') ? NS.hovBg : '';
    var hovText = /^#[0-9a-fA-F]{6}$/.test(NS.hovText || '') ? NS.hovText : '';
    var hovScale = Number(NS.hovScale) || 1;
    var hovUnder = NS.hovUnder === 'si';
    var btns = PAGINAS.map(function(pg, pi){
      var isAct = pi === 0;
      var st;
      if (NS.estilo==='tabs') st = 'background:transparent;border:1px solid rgba(15,23,42,.12);border-radius:8px 8px 0 0;padding:'+pad+'px '+(pad+4)+'px;font-size:'+fsize+'px;font-weight:700;color:'+navText+';cursor:pointer;'+upper;
      else if (NS.estilo==='subrayado') st = 'background:transparent;border:none;border-bottom:2px solid transparent;padding:'+pad+'px '+(pad+2)+'px;font-size:'+fsize+'px;font-weight:700;color:'+navText+';cursor:pointer;'+upper;
      else st = 'background:var(--card, #fff);border:1px solid rgba(15,23,42,.12);border-radius:'+radius+';padding:'+pad+'px '+(pad+6)+'px;font-size:'+fsize+'px;font-weight:700;color:'+navText+';cursor:pointer;'+upper;
      if (bw > 0) st += 'border:'+bw+'px solid '+bc+';';
      if (isAct){
        if (NS.estilo==='subrayado') st += 'color:'+activeText+';border-bottom-color:'+activeBg+';';
        else st += 'background:'+activeBg+';color:'+activeText+';border-color:'+activeBg+';';
        if (actB) st += actB;
      }
      var icon = showIcons && (pg.icon||'') ? (iconPos ? esc(pg.title)+' '+(pg.icon||'') : (pg.icon||'')+' '+esc(pg.title)) : esc(pg.title);
      return '<button type="button" data-prev-tab="'+pg.id+'" style="'+st+'">'+icon+'</button>';
    }).join('');
    var hoverCss = '';
    if (hovBg || hovText || hovScale !== 1 || hovUnder) {
      hoverCss = '<style>.pv-nav [data-prev-tab]:hover{';
      if (hovBg) hoverCss += 'background:'+hovBg+'!important;';
      if (hovText) hoverCss += 'color:'+hovText+'!important;';
      if (hovUnder) hoverCss += 'text-decoration:underline;';
      if (hovScale && hovScale !== 1) hoverCss += 'transform:scale('+hovScale+');';
      hoverCss += '}</style>';
    }
    var mobile = NS.mobile !== 'no';
    var bp = Number(NS.breakpoint) || 768;
    var extraCss = '';
    if (mobile) {
      extraCss += '<style>.pv-nav[data-nav-mobile="1"] .nav-burger{display:none;background:transparent;border:1px solid rgba(15,23,42,.15);border-radius:8px;padding:8px 12px;font-size:18px;cursor:pointer;line-height:1;}@media (max-width:'+bp+'px){.pv-nav[data-nav-mobile="1"] .nav-burger{display:inline-flex!important;}.pv-nav[data-nav-mobile="1"] [data-prev-tab]{display:none;}.pv-nav[data-nav-mobile="1"].nav-open [data-prev-tab]{display:inline-block;}.pv-nav[data-nav-mobile="1"]{flex-direction:column;align-items:flex-start;}}</style>';
    }
    var burger = mobile ? '<button type="button" class="nav-burger">☰</button>' : '';
    return '<div class="pv-nav" data-nav-root="true" data-nav-mobile="'+(mobile?1:0)+'" style="display:flex;flex-direction:'+direction+';flex-wrap:'+(direction==='row'?'wrap':'nowrap')+';gap:'+gap+'px;padding:14px 20px;border:1px solid rgba(15,23,42,.08);'+bgFinal+'border-radius:'+radius+';box-shadow:'+navShadow+';'+stickyCss+align+'cursor:pointer;pointer-events:auto;opacity:'+op+';'+(direction==='column'?'align-items:flex-start;':'')+'">'+burger+btns+'</div>'+extraCss+hoverCss;
  }

  function renderCanvas(){
    var host = document.getElementById('canvas-content');
    if (!host) return;
    var blocks = getActiva().blocks;
    var nav = renderNavHTML();
    var body = blocks.length
      ? blocks.map(function(b,i){ return insertLine(i) + renderBlockHTML(b); }).join('') + insertLine(blocks.length)
      : '<div class="empty-canvas">Esta página está vacía.<br><button onclick="abrirPickerRaiz()">➕ Agregar el primer bloque</button></div>';
