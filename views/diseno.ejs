    var designPane = host.querySelector('.design-pane');
    if (designPane) {
      if (designPane.querySelector('[data-nav-root]')) {
        designPane.querySelector('[data-nav-root]').addEventListener('click', function(e){
          if (e.target && e.target.closest && e.target.closest('button[data-prev-tab]')) return;
