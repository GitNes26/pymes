  function _boxSty(b){var s='';if(b.bg)s+='background:'+b.bg+';';if(b.color)s+='color:'+b.color+';';if(b.padding&&b.padding!=='none')s+='padding:'+({suave:'10px 14px',normal:'18px 22px',amplio:'28px 32px'}[b.padding]||'')+';';if(b.border&&b.border!=='none')s+='border:'+b.border+'px solid var(--border,#e2e8f0);';if(b.radius&&b.radius!=='0')s+='border-radius:'+b.radius+'px;';if(b.shadow&&b.shadow!=='none')s+='box-shadow:'+({suave:'0 2px 8px rgba(0,0,0,.08)',media:'0 6px 18px rgba(0,0,0,.14)',fuerte:'0 12px 32px rgba(0,0,0,.22)'}[b.shadow]||'')+';';return s;}
  function vacio(msg){ return '<div style="grid-column:1/-1;padding:20px;text-align:center;color:#94a3b8;font-size:12px;">'+msg+'</div>'; }
  function placeholder(){ return '/img/sin-imagen.svg'; }
  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function countBlocks(arr){
    var c = 0;
    if (!Array.isArray(arr)) return 0;
    for (var i=0;i<arr.length;i++){
      var b = arr[i]; if (!b) continue; c++;
      if (b.type==='row'){ for (var j=0;j<(b.columns||[]).length;j++) c += countBlocks(b.columns[j].blocks); }
      else if (b.type==='card'){ c += countBlocks(b.body) + countBlocks(b.footer); }
      else if (b.type==='mascara'){ c += countBlocks(b.children); }
    }
    return c;
  }
  var _DIAS = {1:'Lunes',2:'Martes',3:'Miércoles',4:'Jueves',5:'Viernes',6:'Sábado',7:'Domingo'};
  function _to12(h){
    if (!h) return '';
    var parts = String(h).split(':');
    var hr = parseInt(parts[0], 10);
    var mn = parseInt(parts[1], 10) || 0;
    if (isNaN(hr)) return h;
    var ampm = hr >= 12 ? 'pm' : 'am';
    var h12 = hr % 12 || 12;
    return h12 + ':' + String(mn).padStart(2, '0') + ' ' + ampm;
  }
  function horarioDbToText(raw){
    try {
      var arr = JSON.parse(raw || '[]');
      if (!Array.isArray(arr) || !arr.length) return '';
      return arr.filter(function(x){ return x && x.d && x.o && x.c; }).map(function(x){
        return (_DIAS[x.d]||('Día '+x.d))+' | '+_to12(x.o)+' - '+_to12(x.c);
      }).join('\n');
    } catch(e){ return ''; }
  }
  function _lines(s){ return String(s==null?'':s).split('\n').map(function(x){return x.trim();}).filter(Boolean); }
  function _parts(line){ var p = String(line||'').split('|'); return { a:(p[0]||'').trim(), b:(p[1]||'').trim(), c:(p[2]||'').trim(), d:(p[3]||'').trim() }; }
  function _pvTitle(b){ return b.title ? '<div class="pv-section-title">'+esc(b.title)+'</div>' : ''; }
  function _pvWrap(inner){ return '<div style="padding:4px 28px 16px;">'+inner+'</div>'; }
  function _row(a,b){ return '<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:9px 0;border-bottom:1px solid rgba(0,0,0,.06);"><span style="font-weight:700;">'+esc(a)+'</span>'+(b?'<span style="color:var(--muted,#64748b);text-align:right;">'+esc(b)+'</span>':'')+'</div>'; }
  function _btn(text,color){ return '<span style="display:inline-block;background:'+(color||'var(--accent,#2563eb)')+';color:#fff;padding:10px 20px;border-radius:999px;font-weight:700;font-size:13px;margin-top:10px;">'+esc(text)+'</span>'; }

  function renderTodo(opts){
    _dirty = true;
    setSaveStatus('editing');
    renderCanvas();
    if (opts && opts.keepDrawer && _seleccionado) return;
  }

  /* ===== DRAWER ===== */
  function abrirDrawer(id){
    var f = localizar(id); if (!f) return;
    var b = f.b;
    _seleccionado = id;
    document.getElementById('drawer-title').textContent = (COMP_ICONS[b.type]||'')+' '+(COMP_LABELS[b.type]||b.type);
    var body = document.getElementById('drawer-body');
    body.innerHTML = '';

    if (b.type==='row'){
      body.appendChild(campoTexto('Etiqueta interna', b.title, function(v){ b.title=v; marcarCambio(); }));
      var colOpts = [[1,'1 (12/12)'],[2,'2 (6/12)'],[3,'3 (4/12)'],[4,'4 (3/12)'],[6,'6 (2/12)'],[12,'12 (1/12)']];
      body.appendChild(campoSelect('Número de columnas', String(b.columns.length), colOpts, function(v){
        var n = parseInt(v,10);
        var span = 12 / n;
        if (n < b.columns.length){
          var moved = [];
          b.columns.slice(n).forEach(function(col){ moved = moved.concat(Array.isArray(col.blocks) ? col.blocks : []); });
          if (moved.length && !window.confirm('Estas columnas tienen contenido. Se moverá a la última columna conservada. ¿Continuar?')) return;
          if (moved.length){
            b.columns[n - 1].blocks = (b.columns[n - 1].blocks || []).concat(moved);
          }
        }
        while (b.columns.length<n) b.columns.push({span:span,blocks:[]});
        while (b.columns.length>n) b.columns.pop();
        b.columns.forEach(function(c){ c.span = span; });
        renderTodo(); abrirDrawer(id);
      }));
      body.appendChild(campoSelect('Separación', String(b.gap), [['0','Sin espacio'],['8','8px'],['14','14px'],['24','24px']], function(v){ b.gap=parseInt(v,10); renderTodo(); }));
      var spanOpts = [];
      for (var s=1;s<=12;s++) spanOpts.push([String(s), s+'/12']);
      b.columns.forEach(function(col,ci){
        body.appendChild(campoSelect('Ancho columna '+(ci+1)+' (grilla 12)', String(col.span), spanOpts, function(v){ col.span=parseInt(v,10); renderTodo(); }));
      });
    } else {
      var lastGroup = '';
      var hasBg = (COMP_FIELDS[b.type]||[]).some(function(f){ return f[0]==='bg'; });
      if (b.type==='testimonios') body.appendChild(campoTestimonios(b));
      if (b.type==='horario'){
        var hrDiv = document.createElement('div');
        hrDiv.className = 'field';
        hrDiv.innerHTML = '<label>Horarios de tu negocio</label><div id="horario-readonly"></div>';
        body.appendChild(hrDiv);
        setTimeout(function(){
          var box = document.getElementById('horario-readonly');
          if (!box) return;
          var dias = {1:'Lunes',2:'Martes',3:'Miércoles',4:'Jueves',5:'Viernes',6:'Sábado',7:'Domingo'};
          var arr = [];
          try { arr = JSON.parse(BIZ_HORARIO || '[]'); } catch(e){}
          if (!arr.length){
            box.innerHTML = '<div style="padding:10px 12px;background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;font-size:12px;color:#92400e;">Sin horarios configurados. <a href="'+CFG_ACTION+'" target="_blank" style="font-weight:700;color:#b45309;">Ir a Configuración</a></div>';
          } else {
            var html = '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px 12px;">';
            arr.forEach(function(x){
              if (x && x.d && x.o && x.c) html += '<div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #eee;font-size:12px;"><span style="font-weight:700;">'+(dias[x.d]||('Día '+x.d))+'</span><span style="color:#64748b;">'+_to12(x.o)+' - '+_to12(x.c)+'</span></div>';
            });
            html += '</div><div style="font-size:11px;color:#94a3b8;margin-top:6px;">Se edita en <a href="'+CFG_ACTION+'" target="_blank" style="color:var(--wp-accent);font-weight:700;">Configuración → Horario</a></div>';
            box.innerHTML = html;
          }
        }, 0);
      }
      (COMP_FIELDS[b.type]||[]).forEach(function(f){
        var key=f[0], label=f[1], kind=f[2], opts=f[3];
        if (b.type==='testimonios' && key==='items') return;
        if (b.type==='boton' && key==='link' && b.descarga==='si') return;
        if (b.type==='boton' && key==='url' && b.descarga!=='si') return;
        if (b.type==='boton' && key==='link' && b.descarga==='si') return;
        if (b.type==='boton' && key==='url' && b.descarga!=='si') return;
        if ((key==='bg'||key==='bg2') && hasBg) return;
        var group = grupoCampo(key);
        if (group !== lastGroup){ body.appendChild(campoGrupo(group)); lastGroup = group; }
        if (kind==='textarea') body.appendChild(/foto|url|imagen/i.test(label) ? campoTextareaFoto(label, b[key], function(v){ compSet(b,key,v); }) : campoTextarea(label, b[key], function(v){ compSet(b,key,v); }));
        else if (kind==='number') body.appendChild(campoNumero(label, b[key], function(v){ compSet(b,key,v); }));
        else if (kind==='select') body.appendChild(campoSelect(label, String(b[key]==null?'':b[key]), opts, function(v){ compSet(b,key,v); }));
        else if (kind==='image') body.appendChild(campoImagen(label, b[key], function(v){ compSet(b,key,v); }));
        else if (kind==='video') body.appendChild(campoVideo(label, b[key], function(v){ compSet(b,key,v); }));
        else if (kind==='audio') body.appendChild(campoAudio(label, b[key], function(v){ compSet(b,key,v); }));
