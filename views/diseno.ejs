      if (pat === 'horizontales') return (c.bg || 'transparent') + ' repeating-linear-gradient(0deg,' + pc + ' 0 6px,transparent 6px 14px)';
      return (c.bg || 'transparent') + ' repeating-linear-gradient(45deg,' + pc + ' 0 8px,transparent 8px 18px)';
    }
    return c.bg || 'transparent';
  }
