    var shadow = shadowMap[NS.shadow] || shadowMap.soft;
    var gap = Number(NS.gap) || 8;
    var pad = Number(NS.pad) || 10;
    var fsize = Number(NS.size) || 14;
    var upper = NS.uppercase === 'si' ? 'text-transform:uppercase;letter-spacing:.05em;' : '';
    var bw = Number(NS.borderW) || 0;
    var bc = /^#[0-9a-fA-F]{6}$/.test(NS.borderC || '') ? NS.borderC : '#cccccc';
    var bst = bw > 0 ? 'border:'+bw+'px solid '+bc+';' : '';
    var op = (Number(NS.opacity) || 100) / 100;
    var alignMap = { left: 'flex-start', center: 'center', right: 'flex-end', justify: 'space-between' };
    var align = 'justify-content:' + (alignMap[NS.align] || 'flex-start') + ';';
    var direction = NS.direction === 'vertical' ? 'column' : 'row';
    var stickyCss = '';
    if (NS.stickyOn === 'si') {
      var off = Number(NS.stickyOff) || 0;
      var edge = NS.stickyPos || 'top';
      stickyCss = 'position:sticky;'+edge+':'+off+'px;z-index:25;';
    }
    var bgFinal = navBgCss(NS);
    var navShadow = shadow;
    if (NS.stickyOn === 'si') {
      var c1 = /^#[0-9a-fA-F]{6}$/.test(NS.bg || '') ? NS.bg : '#ffffff';
      bgFinal = 'background:' + (/^#[0-9a-fA-F]{6}$/.test(NS.stickyBg || '') ? NS.stickyBg : c1) + ';';
