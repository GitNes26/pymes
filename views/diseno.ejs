  /* ===== LOCALIZACIÓN (recursiva) ===== */
  function buscarEn(arr, id){
    if (!Array.isArray(arr)) return null;
    for (var i=0;i<arr.length;i++){
      var b = arr[i];
      if (!b) continue;
      if (b.id===id) return { b:b, i:i, arr:arr };
      var r = null;
      if (b.type==='row'){ for (var j=0;j<(b.columns||[]).length;j++){ r = buscarEn(b.columns[j].blocks, id); if (r) return r; } }
      else if (b.type==='card'){ r = buscarEn(b.body,id) || buscarEn(b.footer,id); if (r) return r; }
      else if (b.type==='mascara'){ r = buscarEn(b.children,id); if (r) return r; }
    }
    return null;
  }
  function localizar(id){ for (var k=0;k<PAGINAS.length;k++){ var r = buscarEn(PAGINAS[k].blocks, id); if (r) return r; } return null; }

  function getActiva(){
    for (var i=0;i<PAGINAS.length;i++) if (PAGINAS[i].id===paginaActiva) return PAGINAS[i];
    return PAGINAS[0] || (PAGINAS[0] = { id:nuevoId('pg'), title:'Inicio', icon:'🏠', blocks:[] });
  }

  /* ===== ACCIONES ===== */
  function compAdd(type){
    if (!type) return;
    pushUndo();
    var nb = nuevoBloque(type);
    if (_destino && _destino.kind==='col'){
      var fr = localizar(_destino.rowId);
      if (fr && fr.b.type==='row' && fr.b.columns[_destino.colIndex]){
        var col = fr.b.columns[_destino.colIndex];
        var cpos = (typeof _destino.pos==='number') ? _destino.pos : col.blocks.length;
        if (cpos < 0 || cpos > col.blocks.length) cpos = col.blocks.length;
        col.blocks.splice(cpos, 0, nb);
      }
    } else if (_destino && _destino.kind==='card'){
      var fc = localizar(_destino.cardId);
      if (fc && fc.b.type==='card') fc.b[_destino.zone].push(nb);
    } else if (_destino && _destino.kind==='mascara'){
      var fm = localizar(_destino.mascaraId);
      if (fm && fm.b.type==='mascara') fm.b.children.push(nb);
    } else {
      var arr = getActiva().blocks;
      var pos = (_destino && _destino.kind==='root' && typeof _destino.pos==='number') ? _destino.pos : arr.length;
      if (pos < 0 || pos > arr.length) pos = arr.length;
      arr.splice(pos, 0, nb);
    }
    _destino = null;
    renderTodo();
    abrirDrawer(nb.id);
  }
  function compRemove(id){ pushUndo(); var f = localizar(id); if (!f) return; f.arr.splice(f.i,1); cerrarDrawer(); renderTodo(); }
  function compMoveSilent(id,dir){ pushUndo(); var f = localizar(id); if (!f) return; var j=f.i+dir; if (j<0||j>=f.arr.length) return; var t=f.arr[f.i]; f.arr[f.i]=f.arr[j]; f.arr[j]=t; renderTodo(); }
  function compMove(id,dir){ compMoveSilent(id,dir); abrirDrawer(id); }
  function renumberBlock(b){
    if (!b || typeof b !== 'object') return;
    b.id = nuevoId();
    if (b.type === 'row' && Array.isArray(b.columns)){
      b.columns.forEach(function(col){
        if (col && Array.isArray(col.blocks)) col.blocks.forEach(renumberBlock);
      });
    } else if (b.type === 'card'){
      if (Array.isArray(b.body)) b.body.forEach(renumberBlock);
      if (Array.isArray(b.footer)) b.footer.forEach(renumberBlock);
    } else if (b.type === 'mascara' && Array.isArray(b.children)){
      b.children.forEach(renumberBlock);
    }
  }
  function compDup(id){ pushUndo(); var f = localizar(id); if (!f) return; var cp = JSON.parse(JSON.stringify(f.b)); renumberBlock(cp); f.arr.splice(f.i+1,0,cp); renderTodo(); }
  function compSet(b,key,val){ pushUndo(); b[key]=val; renderTodo({keepDrawer:true}); }

  /* ===== RENDER: pestañas ===== */
  function renderTabs(){
    var box = document.getElementById('page-tabs');
    if (!box) return;
    box.innerHTML = '';
    PAGINAS.forEach(function(pg){
      var btn = document.createElement('button');
      btn.className = 'page-tab' + (pg.id===paginaActiva?' active':'');
      btn.innerHTML = (pg.icon||'📄') + ' ' + esc(pg.title);
      btn.onclick = function(){ paginaActiva = pg.id; renderTabs(); renderCanvas(); };
      var edit = document.createElement('button');
      edit.className='edit-title'; edit.textContent='✎'; edit.title='Renombrar página';
      edit.onclick = function(e){ e.stopPropagation(); var t = prompt('Nombre de la página', pg.title); if (t){ pg.title=t; marcarCambio(); renderTabs(); } };
      btn.appendChild(edit);
      box.appendChild(btn);
    });
    var add = document.createElement('button');
    add.className='page-tab add-page'; add.textContent='➕'; add.title='Crear página';
    add.onclick = function(){
      var t = prompt('Nombre de la nueva página','Nueva página');
      if (!t) return;
      var pg = { id:nuevoId('pg'), title:t, icon:'📄', blocks:[] };
      PAGINAS.push(pg); paginaActiva = pg.id;
      marcarCambio();
      renderTabs(); renderCanvas();
    };
    box.appendChild(add);
  }

  /* ===== RENDER: canvas ===== */
  function navBgCss(n){
    var c1 = /^#[0-9a-fA-F]{6}$/.test(n.bg||'') ? n.bg : '#ffffff';
    var c2 = /^#[0-9a-fA-F]{6}$/.test(n.bg2||'') ? n.bg2 : '#e2e8f0';
    var ang = Number(n.bgAngle) || 135;
    if (n.bgType === 'linear') return 'background:linear-gradient('+ang+'deg,'+c1+','+c2+');';
    if (n.bgType === 'radial') return 'background:radial-gradient(circle at 50% 40%,'+c1+','+c2+');';
    if (n.bgType === 'conic') return 'background:conic-gradient(from 0deg at 50% 50%,'+c1+','+c2+');';
    if (n.bgType === 'image') return n.bgImage ? 'background-image:url(\''+n.bgImage+'\');background-size:cover;background-position:center;' : 'background:'+c1+';';
    if (n.bgType === 'pattern') {
      var pat = n.bgPattern || 'rayas';
      var pc = /^#[0-9a-fA-F]{6}$/.test(n.bgPatternC || '') ? n.bgPatternC : c2;
      if (pat === 'puntos') return 'background-color:'+c1+';background-image:radial-gradient('+pc+' 5px,transparent 6px);background-size:26px 26px;';
      if (pat === 'cuadros') return 'background-color:'+c1+';background-image:repeating-conic-gradient('+pc+' 0% 25%,transparent 0% 50%);background-size:32px 32px;';
      if (pat === 'horizontales') return 'background-color:'+c1+';background-image:repeating-linear-gradient(0deg,'+pc+' 0 6px,transparent 6px 14px);';
      return 'background-color:'+c1+';background-image:repeating-linear-gradient(45deg,'+pc+' 0 8px,transparent 8px 18px);';
    }
    return 'background:'+c1+';';
  }
  function renderNavHTML(){
    if (!PAGINAS.length || PAGINAS.length < 2) return '';
    var NS = NAV_STYLE;
    var accent = NS.color || PAL.accent || '#2563eb';
    var activeBg = NS.activeBg || accent;
    var activeText = NS.activeText || '#ffffff';
    var navBg = NS.bg || '#ffffff';
    var navText = NS.text || '#0f172a';
    var radiusMap = { none: '0px', sm: '8px', md: '12px', lg: '20px', pill: '999px' };
    var radius = radiusMap[NS.radius] || '999px';
