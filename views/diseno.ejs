    wrap.appendChild(thumbs);
    function refreshThumbs(){
      thumbs.innerHTML='';
      var urls=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
      urls.forEach(function(url,idx){
        var el=document.createElement('div'); el.className='img-thumb';
        var img=document.createElement('img'); img.src=url; img.loading='lazy';
        img.onerror=function(){ this.onerror=null; this.src='/img/sin-imagen.svg'; };
        var rm=document.createElement('button'); rm.type='button'; rm.className='thumb-rm'; rm.textContent='✕';
        rm.title='Eliminar imagen';
        rm.addEventListener('click',function(e){
          e.stopPropagation();
          var cur=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
          cur.splice(idx,1);
          ta.value=cur.join('\n');
          onInput(ta.value);
          refreshThumbs();
        });
        var ed=document.createElement('button'); ed.type='button'; ed.className='thumb-edit'; ed.textContent='✎'; ed.title='Editar imagen (recortar, girar, zoom)';
        ed.style.cssText='position:absolute;bottom:4px;left:4px;width:22px;height:22px;border:none;border-radius:50%;background:rgba(15,23,42,.75);color:#fff;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;';
        ed.addEventListener('click',function(e){
          e.stopPropagation();
          abrirEditorImagen(url,function(nu){
            if(!nu) return;
            var cur=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
            cur[idx]=nu;
            ta.value=cur.join('\n');
            onInput(ta.value);
            refreshThumbs();
          });
        });
        el.style.position='relative';
        el.appendChild(img); el.appendChild(rm); el.appendChild(ed);
        thumbs.appendChild(el);
      });
    }
    refreshThumbs();
    var row=document.createElement('div'); row.className='img-row'; row.style.marginTop='8px';
    var upBtn=document.createElement('button'); upBtn.type='button'; upBtn.textContent='⬆ Subir varias imágenes';
    var file=document.createElement('input'); file.type='file'; file.accept='image/*'; file.multiple=true; file.style.display='none';
    upBtn.onclick=function(){ file.click(); };
    file.addEventListener('change',function(){
      var files=Array.prototype.slice.call(file.files||[]);
      if (!files.length) return;
      var urls=[];
      var queue=files.slice();
      function next(){
        var f=queue.shift();
        if (!f){
          file.value='';
          if (urls.length){
            var cur=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
            ta.value=cur.concat(urls).join('\n');
            onInput(ta.value);
            refreshThumbs();
            mostrarToast(urls.length+' imagen(es) aplicada(s) ✓');
          } else mostrarToast('No se aplicó ninguna imagen');
          return;
        }
        var rd=new FileReader();
        rd.onload=function(){
          abrirEditorImagen(rd.result, function(url){ urls.push(url); next(); }, next);
        };
        rd.readAsDataURL(f);
      }
      next();
    });
    row.appendChild(upBtn); row.appendChild(file);
    var galBtn=document.createElement('button'); galBtn.type='button'; galBtn.textContent='🖼 Galería';
    galBtn.onclick=function(){ abrirGaleria(function(urls){
      if (Array.isArray(urls)){
        var cur=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
        urls.forEach(function(u){ if (cur.indexOf(u)===-1) cur.push(u); });
        ta.value=cur.join('\n');
      } else {
        var cur=(ta.value||'').split('\n').map(function(s){return s.trim();}).filter(Boolean);
        if (cur.indexOf(urls)===-1) cur.push(urls);
        ta.value=cur.join('\n');
      }
      onInput(ta.value);
      refreshThumbs();
    }, true); };
    row.appendChild(galBtn);
    wrap.appendChild(row);
    return wrap;
  }

