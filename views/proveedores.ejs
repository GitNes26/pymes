<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('admin/head', { title: 'Proveedores', biz }) %>
  <style>
    .suppliers-admin-page {
      --sp-ink:#17232d; --sp-muted:#52616c; --sp-petrol:#2c2c2e; --sp-petrol-2:#454548;
      --sp-line:rgba(44,44,46,.13); --sp-soft:#f0f0f1; --sp-cyan:#f0f0f1; --sp-violet:#eaeaeb;
      background:#f7f7f8;
      color:var(--sp-ink); overflow-x:hidden;
    }
    .suppliers-admin-page main{min-width:0;max-width:100%;}
    .suppliers-shell{width:100%;max-width:1480px;margin:0 auto;padding:24px clamp(16px,2.5vw,34px) 48px;box-sizing:border-box;}
    .suppliers-header{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:18px;}
    .suppliers-title{font-size:clamp(1.55rem,2.2vw,2rem);font-weight:850;letter-spacing:-.035em;line-height:1.05;color:var(--sp-ink);}
    .suppliers-subtitle{max-width:650px;margin-top:7px;color:var(--sp-muted);font-size:13px;line-height:1.55;}
    .supplier-flow{display:flex;align-items:center;gap:8px;flex:0 0 auto;color:#657680;font-size:11px;font-weight:750;}
    .supplier-flow span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
    .supplier-flow svg{width:15px;height:15px;color:var(--sp-petrol);}
    .supplier-flow .flow-arrow{color:#9aabb5;}
    .suppliers-workspace{display:grid;grid-template-columns:minmax(260px,330px) minmax(0,1fr);gap:18px;align-items:start;}
    .supplier-panel{border:1px solid var(--sp-line);border-radius:15px;background:#fff;box-shadow:0 12px 30px -28px rgba(44,44,46,.65);min-width:0;}
    .supplier-panel-pad{padding:20px;}
    .supplier-directory{position:sticky;top:18px;}
    .panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;}
    .panel-title-wrap{display:flex;align-items:center;gap:11px;min-width:0;}
    .panel-icon{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--sp-cyan),var(--sp-violet));color:var(--sp-petrol);display:grid;place-items:center;flex:0 0 auto;}
    .panel-icon svg{width:18px;height:18px;}
    .panel-title{font-size:15px;font-weight:820;letter-spacing:-.015em;color:var(--sp-ink);}
    .panel-copy{margin-top:2px;color:#7a8992;font-size:11px;line-height:1.4;}
    .supplier-count{min-width:28px;height:28px;padding:0 8px;border-radius:8px;background:var(--sp-soft);color:var(--sp-petrol);font-size:11px;font-weight:850;display:grid;place-items:center;}
    .supplier-form{display:grid;gap:11px;}
    .suppliers-admin-page .m-field{min-width:0;}
    /* El label flotante y los estados de foco de .m-field ahora viven en
       material.css (diseño compartido); aquí solo queda lo que no es
       .m-field: el textarea suelto y las filas de la tabla de compra. */
    .suppliers-admin-page textarea,
    .suppliers-admin-page .po-row input{width:100%;max-width:100%;min-height:41px;box-sizing:border-box;border:1px solid rgba(44,44,46,.16);border-radius:9px;background:#fff;color:var(--sp-ink);font:500 13px/1.3 Inter,system-ui,sans-serif;outline:0;}
    .suppliers-admin-page textarea:focus,
    .suppliers-admin-page .po-row input:focus{border-color:var(--sp-petrol-2);box-shadow:0 0 0 3px rgba(44,44,46,.11);}
    .supplier-submit{width:100%;margin-top:2px;background:var(--sp-petrol)!important;color:#fff!important;}
    .supplier-list{display:grid;gap:8px;margin-top:16px;padding-top:15px;border-top:1px solid var(--sp-line);}
    .supplier-item{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:11px;border-radius:11px;background:#f7f9fa;border:1px solid rgba(44,44,46,.08);}
    .supplier-item-name{font-size:12px;font-weight:800;color:var(--sp-ink);}
    .supplier-meta{display:flex;flex-wrap:wrap;gap:5px 9px;margin-top:4px;color:#71808a;font-size:10px;line-height:1.35;}
    .supplier-meta span{display:inline-flex;align-items:center;gap:4px;min-width:0;overflow-wrap:anywhere;}
    .supplier-meta svg{width:12px;height:12px;flex:0 0 auto;}
    .supplier-delete{width:28px;height:28px;border-radius:8px;color:#a14747;display:grid;place-items:center;flex:0 0 auto;transition:.18s ease;}
    .supplier-delete:hover{background:#fff0ef;color:#7f2828;}
    .supplier-delete svg{width:14px;height:14px;}
    .supplier-empty{padding:14px 8px 4px;text-align:center;color:#82909a;font-size:11px;line-height:1.5;}
    .supplier-empty svg{display:block;width:24px;height:24px;margin:0 auto 7px;color:#91a4af;}
    .purchase-card{min-width:0;overflow:visible;}
    .purchase-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:end;margin-bottom:15px;}
    .purchase-help{display:flex;align-items:center;gap:7px;color:#73838d;font-size:10px;font-weight:650;text-align:right;}
    .purchase-help svg{width:15px;height:15px;color:var(--sp-petrol);flex:0 0 auto;}
    .purchase-table-label{margin:15px 0 7px;color:#40515d;font-size:10px;font-weight:780;letter-spacing:.055em;text-transform:uppercase;}
    .purchase-table-copy{font-weight:500;color:#81909a;text-transform:none;letter-spacing:0;}
    #po-grid{border-color:var(--sp-line)!important;border-radius:12px!important;background:#fbfcfd;}
    #po-grid table{border-collapse:separate;border-spacing:0;}
    #po-grid thead tr{background:#edf3f6!important;color:#5f707b!important;border-color:var(--sp-line)!important;}
    #po-grid th{height:38px;vertical-align:middle;}
    .po-row td{background:#fff;border-color:rgba(44,44,46,.08)!important;}
    .po-row input{min-height:36px!important;padding:7px 9px!important;}
    .po-invalid{border-color:#dc2626!important;box-shadow:0 0 0 3px rgba(220,38,38,.13)!important;}
    .po-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:11px 0 16px;}
    .ui-icon{width:15px;height:15px;flex:0 0 auto;}
    .paste-summary{display:inline-flex;align-items:center;gap:6px;color:var(--sp-petrol);font-size:11px;font-weight:750;cursor:pointer;}
    .paste-panel{margin-top:8px;padding:10px;border-radius:11px;background:#f6f9fa;border:1px solid var(--sp-line);}
    .purchase-total{display:flex;align-items:center;justify-content:space-between;padding:15px 16px;margin-bottom:13px;border-radius:12px;background:#f0f0f1;}
    .purchase-total span:first-child{color:#536670;font-size:11px;font-weight:750;}
    .purchase-total strong{color:var(--sp-ink);font-size:21px;font-weight:880;letter-spacing:-.025em;font-variant-numeric:tabular-nums;}
    .purchase-submit{width:100%;min-height:44px!important;background:var(--sp-petrol)!important;color:#fff!important;}
    .po-ac{max-width:calc(100vw - 16px)!important;box-sizing:border-box;border-color:rgba(44,44,46,.16)!important;border-radius:11px!important;box-shadow:0 16px 34px rgba(20,24,31,.18),0 3px 8px rgba(20,24,31,.08)!important;}
    .po-ac-it{white-space:normal;overflow-wrap:anywhere;}
    .purchase-history{margin-top:18px;}
    .history-list{display:grid;gap:10px;}
    .history-item{padding:14px;border:1px solid var(--sp-line);border-radius:12px;background:#fff;}
    .history-item.is-received{background:#f4faf7;border-color:#cfe4d8;}
    .history-main{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
    .history-name{font-size:13px;font-weight:800;color:var(--sp-ink);}
    .history-total{font-weight:850;color:var(--sp-ink);font-variant-numeric:tabular-nums;}
    .history-lines{margin-top:8px;color:#60717d;font-size:11px;line-height:1.5;}
    .history-lines > div{display:flex;justify-content:space-between;gap:12px;padding:3px 0;border-bottom:1px solid rgba(44,44,46,.06);}
    .history-actions{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin-top:11px;}
    .history-actions .m-btn{display:inline-flex;align-items:center;gap:6px;min-height:34px!important;padding:7px 10px!important;font-size:11px!important;font-weight:750;}
    .history-actions .history-wa{background:#25d366!important;color:#0d3520!important;border-color:#25d366!important;}
    .history-actions .history-wa:hover{background:#20bd5b!important;}
    .history-date{margin-top:7px;color:#8a98a1;font-size:10px;}
    .success-note{margin-bottom:14px;padding:11px 14px;border:1px solid #cde4d7;border-radius:11px;background:#f1faf5;color:#275f43;font-size:12px;font-weight:750;}
    .error-note{margin-bottom:14px;padding:11px 14px;border:1px solid #eec9c9;border-radius:11px;background:#fdf1f1;color:#8c2f2f;font-size:12px;font-weight:750;}
    @media(max-width:980px){.suppliers-workspace{grid-template-columns:1fr}.supplier-directory{position:static}.supplier-form{grid-template-columns:repeat(2,minmax(0,1fr))}.supplier-form .supplier-notes,.supplier-form .supplier-submit-wrap{grid-column:1/-1}.supplier-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:640px){.suppliers-shell{padding:16px 12px 36px}.suppliers-header{display:block}.supplier-flow{margin-top:13px;overflow-x:auto;padding-bottom:2px}.supplier-panel-pad{padding:16px}.supplier-form,.supplier-list{grid-template-columns:1fr}.purchase-top{grid-template-columns:1fr}.purchase-help{text-align:left}.purchase-table-copy{display:block;margin-top:3px}.history-lines>div{align-items:flex-start}.suppliers-admin-page .m-btn{max-width:100%}
      /* Pedido de compra en móvil: cada línea como tarjeta-lista (igual que Productos/Clientes) en vez de tabla con scroll horizontal */
      #po-grid{overflow-x:visible!important;border:0!important;background:transparent!important;}
      #po-grid table{display:block;width:100%;min-width:0!important;}
      #po-grid thead{display:none;}
      #po-grid tbody{display:block;}
      #po-grid tr.po-row{position:relative;display:block;width:100%;background:#fff;border:1px solid var(--sp-line)!important;border-radius:12px;padding:10px 44px 10px 10px;margin-bottom:8px;}
      #po-grid tr.po-row td{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%!important;min-width:0;padding:6px 0!important;border:0!important;text-align:left;}
      #po-grid tr.po-row td[data-label]::before{content:attr(data-label);flex:0 0 auto;color:#7a8992;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;}
      #po-grid tr.po-row td[data-label] input,#po-grid tr.po-row td[data-label] .po-sub{width:auto!important;min-width:0;flex:1 1 auto;text-align:right;}
      #po-grid tr.po-row td:last-child{position:absolute;top:8px;right:8px;padding:0!important;width:auto!important;}
      #po-grid tr.po-row td:nth-child(2){align-items:flex-start;}
      body.dark #po-grid tr.po-row{background:#151c23;}
    }
    body.dark.suppliers-admin-page{background:#0d1117;color:#e7eef3;}
    body.dark .suppliers-title,body.dark .panel-title,body.dark .supplier-item-name,body.dark .history-name,body.dark .history-total{color:#edf4f8;}
    body.dark .supplier-panel,body.dark .history-item,body.dark .po-row td{background:#151c23;border-color:#2b3741;}
    body.dark .supplier-item,body.dark #po-grid,body.dark .paste-panel{background:#101820;border-color:#303d47;}
    body.dark.suppliers-admin-page .m-field input,body.dark.suppliers-admin-page .m-field select,body.dark.suppliers-admin-page textarea,body.dark.suppliers-admin-page .po-row input{background:#0f171e;border-color:#34414b;color:#e7eef3;}
    body.dark #po-grid thead tr{background:#1b2730!important;color:#a8b5bd!important;}
    body.dark .purchase-total{background:#1c2128;}
    body.dark .purchase-total strong{color:#edf4f8;}
    body.dark .success-note{background:#12271c;border-color:#2b4a37;color:#8fd4ae;}
    body.dark .error-note{background:#2a1416;border-color:#543033;color:#e39a9a;}
  </style>
</head>
<body class="m-material suppliers-admin-page bg-slate-100 min-h-screen">
  <!--
    THESIS: Proveedores es una mesa de abastecimiento: directorio a mano, pedido al centro e historial como cierre.
    OWN-WORLD: Administración perla, tinta azul-negra y petróleo para acción y foco.
    STORY: Identificar proveedor, capturar productos, confirmar total y dar seguimiento a la recepción.
    FIRST VIEWPORT: Directorio compacto junto al constructor de pedido, con el total visible antes de registrar.
    FORM: seed=supply-desk-2026; controles compactos, labels estáticas y tabla de captura con ritmo uniforme.
    FINISH: Autocomplete contenido, tabla desplazable y composición móvil sin desbordamiento de página.
  -->
  <%- include('admin/sidebar', { biz, active: 'proveedores', canDesign }) %>

  <main class="transition-all duration-300">
    <div class="suppliers-shell">
      <header class="suppliers-header">
        <div>
          <h1 class="suppliers-title">Proveedores y compras</h1>
          <p class="suppliers-subtitle">Organiza tus contactos, prepara órdenes de compra y actualiza el inventario cuando recibas mercancía.</p>
        </div>
        <div class="supplier-flow" aria-label="Flujo de abastecimiento">
          <span><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM19 8v6m-3-3h6"/></svg>Proveedor</span>
          <span class="flow-arrow">→</span>
          <span><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M6 2h9l3 3v17H6zM14 2v5h5M9 12h6M9 16h6"/></svg>Pedido</span>
          <span class="flow-arrow">→</span>
          <span><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16M9 13h6"/></svg>Recepción</span>
        </div>
      </header>

      <% if (ok) { %>
        <div class="success-note m-pop"><%= msg || 'Cambios guardados correctamente' %></div>
      <% } %>
      <% if (error) { %>
        <div class="error-note m-pop"><%= error %></div>
      <% } %>

      <div class="suppliers-workspace">
      <section class="supplier-panel supplier-panel-pad supplier-directory">
        <div class="panel-heading">
          <div class="panel-title-wrap"><span class="panel-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM19 8v6m-3-3h6"/></svg></span><div><h2 class="panel-title">Directorio</h2><p class="panel-copy">Contactos para tus compras</p></div></div>
          <span class="supplier-count"><%= suppliers.length %></span>
        </div>
        <form method="POST" action="/<%= biz.slug %>/admin/proveedor" class="supplier-form">
          <div class="m-field"><label>Nombre *</label><input name="name" required placeholder="Ej: Distribuidora Torres" value="<%= old.name %>"></div>
          <div class="m-field"><label>WhatsApp</label><input name="phone" type="tel" inputmode="numeric" maxlength="12" pattern="[0-9]{3} [0-9]{3} [0-9]{4}" data-mask="phone" title="10 dígitos" placeholder="Ej: 871 234 5678" value="<%= old.phone %>"></div>
          <div class="m-field"><label>Email</label><input name="email" type="email" placeholder="ventas@torres.mx" value="<%= old.email %>"></div>
          <div class="m-field supplier-notes"><label>Notas</label><input name="notes" placeholder="Ej: entrega los martes" value="<%= old.notes %>"></div>
          <div class="supplier-submit-wrap"><button class="supplier-submit m-btn m-btn-filled !min-h-11">Guardar proveedor</button></div>
        </form>
        <div class="supplier-list">
          <% suppliers.forEach(s => { %>
            <article class="supplier-item">
              <div><p class="supplier-item-name"><%= s.name %></p><div class="supplier-meta">
                <% if (s.phone) { %><span><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a15 15 0 006 6l2-3 5 2v4a2 2 0 01-2 2C9.6 22 2 14.4 2 5a2 2 0 012-2z"/></svg><%= s.phone %></span><% } %>
                <% if (s.email) { %><span><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg><%= s.email %></span><% } %>
              </div></div>
              <form method="POST" action="/<%= biz.slug %>/admin/proveedor/<%= s.id %>/eliminar" data-confirm="¿Eliminar a <%= s.name %>?" class="inline">
                <button class="supplier-delete" title="Eliminar" aria-label="Eliminar a <%= s.name %>"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg></button>
              </form>
            </article>
          <% }) %>
          <% if (!suppliers.length) { %><div class="supplier-empty"><svg fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM19 8v6m-3-3h6"/></svg>Agrega tu primer proveedor para comenzar un pedido.</div><% } %>
        </div>
      </section>

      <section class="supplier-panel supplier-panel-pad purchase-card">
        <div class="purchase-top"><div class="panel-title-wrap"><span class="panel-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M6 2h9l3 3v17H6zM14 2v5h5M9 12h6M9 16h6"/></svg></span><div><h2 class="panel-title">Nuevo pedido de compra</h2><p class="panel-copy">Captura productos, costos y precio de venta</p></div></div><p class="purchase-help"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h.01M12 9h.01M16 9h.01M8 13h8M8 16h5"/></svg>Enter avanza · Ctrl+V pega desde Excel</p></div>
        <form method="POST" action="/<%= biz.slug %>/admin/compra" id="po-form">
          <div class="m-field mb-3">
            <label>Proveedor *</label>
            <select name="supplier_id" id="po-supplier" required>
              <option value="">Selecciona…</option>
              <% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
            </select>
          </div>

          <p class="purchase-table-label">Productos del pedido <span class="purchase-table-copy">Elige uno existente o escribe uno nuevo; se creará al recibir.</span></p>
          <div class="overflow-x-auto mb-2 rounded-xl border border-slate-200" id="po-grid">
            <table class="w-full text-sm min-w-[680px]">
              <thead>
                <tr class="text-left text-[10px] uppercase tracking-wide text-slate-400 border-b border-slate-100 bg-slate-50">
                  <th class="px-3 py-2 font-black">Producto</th>
                  <th class="px-2 py-2 w-36 font-black">Variante</th>
                  <th class="px-2 py-2 w-20 font-black">Cant.</th>
                  <th class="px-2 py-2 w-24 font-black">Costo</th>
                  <th class="px-2 py-2 w-24 font-black">Precio venta</th>
                  <th class="px-2 py-2 w-24 font-black text-right">Subtotal</th>
                  <th class="px-2 py-2 w-10"></th>
                </tr>
              </thead>
              <tbody id="po-items"></tbody>
            </table>
          </div>
          <div class="po-actions">
            <button type="button" onclick="poAddRow({focus:true})" class="m-btn m-btn-tonal m-btn-sm"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Agregar línea</button>
            <details class="inline-block">
              <summary class="paste-summary"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 5h6M9 3h6v4H9zM6 5H4v16h16V5h-2M8 12h8M8 16h6"/></svg>Pegar lista (Excel/CSV)</summary>
              <div class="paste-panel">
                <textarea id="po-paste" rows="4" placeholder="producto, cantidad, costo, precio venta&#10;Tornillos 8mm, 10, 3.50, 6.00" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-400"></textarea>
                <button type="button" onclick="poPasteBox()" class="m-btn m-btn-tonal m-btn-sm mt-1">Cargar lista</button>
              </div>
            </details>
          </div>

          <div class="purchase-total">
            <span>Total estimado del pedido</span>
            <strong id="po-total">$0.00</strong>
          </div>

          <input type="hidden" name="items" id="po-items-json">
          <button type="submit" class="purchase-submit m-btn m-btn-filled">Registrar pedido</button>
        </form>
      </section>
      </div>

      <section class="supplier-panel supplier-panel-pad purchase-history">
        <div class="panel-heading"><div class="panel-title-wrap"><span class="panel-icon"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16M8 13h8M8 16h5"/></svg></span><div><h2 class="panel-title">Pedidos de compra</h2><p class="panel-copy">Seguimiento y recepción de inventario</p></div></div><span class="supplier-count"><%= pos.length %></span></div>
        <% if (pos.length === 0) { %>
          <div class="supplier-empty"><svg fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path d="M6 2h9l3 3v17H6zM14 2v5h5M9 12h6M9 16h6"/></svg>Los pedidos que registres aparecerán aquí para darles seguimiento.</div>
        <% } else { %>
          <div class="history-list">
            <% pos.forEach(po => { %>
              <article class="history-item <%= po.received ? 'is-received' : '' %>">
                <div class="history-main">
                  <div class="flex items-center gap-2">
                    <p class="history-name"><%= po.supplier_name || 'Sin proveedor' %></p>
                    <% if (po.received) { %><span class="m-badge m-badge-success !h-5 !text-[10px]">RECIBIDO</span><% } else { %><span class="m-badge m-badge-warn !h-5 !text-[10px]">PENDIENTE</span><% } %>
                  </div>
                  <span class="history-total"><%= money(po.total) %></span>
                </div>
                <div class="history-lines">
                  <% po.items.forEach(it => { %>
                    <div><span><%= it.qty %> × <%= it.name %><% if (it.variant) { %> <span class="text-slate-400">(<%= it.variant %>)</span><% } %></span><span><%= money(it.cost * it.qty) %></span></div>
                  <% }) %>
                </div>
                <p class="history-date"><%= fmtFecha(po.created_at) %></p>
                <div class="history-actions">
                  <% if (po.supplier_phone) { %>
                    <a href="https://wa.me/<%= po.supplier_phone.startsWith('52') ? po.supplier_phone : '52' + po.supplier_phone %>?text=<%= po.msg %>" target="_blank" class="history-wa m-btn m-btn-sm m-btn-tonal !min-h-0 !py-1.5"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a15 15 0 006 6l2-3 5 2v4a2 2 0 01-2 2C9.6 22 2 14.4 2 5a2 2 0 012-2z"/></svg>Pedir por WhatsApp</a>
                  <% } %>
                  <% if (po.supplier_email) { %>
                    <a href="mailto:<%= po.supplier_email %>?subject=<%= po.esubject %>&body=<%= po.ebody %>" class="m-btn m-btn-sm m-btn-tonal !min-h-0 !py-1.5"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg>Pedir por email</a>
                  <% } %>
                  <button type="button" onclick="copiarPedido('<%= po.msg %>')" class="m-btn m-btn-sm m-btn-outlined !min-h-0 !py-1.5"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M8 7h11v14H8zM5 17H3V3h11v2"/></svg>Copiar texto</button>
                  <% if (!po.received) { %>
                    <form method="POST" action="/<%= biz.slug %>/admin/compra/<%= po.id %>/recibido" data-confirm="¿Marcar como RECIBIDO y sumar el stock a tus productos?" class="inline">
                      <button class="m-btn m-btn-sm m-btn-filled !min-h-0 !py-1.5 !bg-emerald-700"><svg class="ui-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12l4 4L19 6"/></svg>Recibido (suma stock)</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/<%= biz.slug %>/admin/compra/<%= po.id %>/eliminar" data-confirm="¿Eliminar este pedido?" class="inline">
                    <button class="supplier-delete" title="Eliminar pedido" aria-label="Eliminar pedido"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg></button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

    </div>
  </main>

  <%- include('admin/panel-ajax') %>
  <%- include('admin/toast') %>

  <script>
    var PRODS = <%- safeJson(products.map(p => ({ id: p.id, name: p.name, sku: p.sku, price: p.price, variantOpts: p.variantOpts || [] }))) %>;
    var UI_ICONS = {
      sliders: '<svg aria-hidden="true" class="inline-block w-3 h-3 mr-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M6 14v6"/></svg>',
      plus: '<svg aria-hidden="true" class="inline-block w-3 h-3 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>',
      trash: '<svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg>'
    };
    var prodNameToId = {};
    PRODS.forEach(p => prodNameToId[norm(p.name)] = p.id);
    var prodById = {};
    PRODS.forEach(p => prodById[p.id] = p);

    function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function fmtMoney(n){ return Number(n||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function norm(s){ return String(s==null?'':s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }

    var childOf = new WeakMap(); // fila maestra -> [filas hijas (combinaciones extra)]
    var NAV = ['.po-name', '.po-vname', '.po-qty', '.po-cost', '.po-price'];

    function poCells(row) {
      return NAV.map(s => row.querySelector(s)).filter(function(c){ return c && !c.classList.contains('hidden'); });
    }
    function poFocusCell(row, cell) {
      if (!cell) return;
      cell.focus();
      if (cell.select) cell.select();
    }
    function poNextCell(row, cell) {
      var cells = poCells(row);
      var i = cells.indexOf(cell);
      if (i >= 0 && i < cells.length - 1) { poFocusCell(row, cells[i + 1]); return true; }
      return false;
    }
    function poRowByCell(cell) {
      var el = cell; while (el && !(el.classList && el.classList.contains('po-row'))) el = el.parentElement;
      return el;
    }
    function poGoRow(row, cellSel, dir) {
      if (!row) return false;
      var rows = poRows();
      var i = rows.indexOf(row) + dir;
      if (i < 0 || i >= rows.length) return false;
      var c = rows[i].querySelector(cellSel);
      if (c && !c.classList.contains('hidden') && !c.readOnly) { poFocusCell(rows[i], c); return true; }
      return poGoRow(rows[i], cellSel, dir);
    }

    function poNameStyle(row) {
      var inp = row.querySelector('.po-name');
      var unlinked = !row.dataset.pid && inp.value.trim() && !inp.readOnly;
      inp.classList.toggle('border-dashed', unlinked);
      inp.classList.toggle('border-neutral-500', unlinked);
      inp.classList.toggle('bg-neutral-100/50', unlinked);
    }

    // ===== Lista de variantes por fila: mismo truco que el autocomplete =====
    // #po-grid tiene overflow-x-auto (necesario para la tabla en móvil), pero
    // eso obliga al navegador a tratar overflow-y como auto también (regla
    // del CSS: si un eje no es "visible", el otro deja de serlo aunque no se
    // haya pedido) — cualquier hijo position:absolute quedaba recortado o
    // generaba su propio scroll DENTRO de la tabla en vez de flotar encima.
    // Se ancla a <body> igual que el autocomplete de productos.
    function placeVList(vsum, vlist) {
      var r = vsum.getBoundingClientRect();
      var vv = window.visualViewport;
      var offX = (vv && vv.offsetLeft) || 0;
      var offY = (vv && vv.offsetTop) || 0;
      var vw = (vv && vv.width) || window.innerWidth;
      var vh = (vv && vv.height) || window.innerHeight;
      var w = Math.min(256, vw - 16);
      var H = Math.min(vlist.scrollHeight || 208, vh - 16);
      var left = Math.max(8, Math.min(r.left - offX, vw - w - 8));
      var below = (r.bottom - offY) + 4;
      var top = (below + H <= vh - 8) ? below : Math.max(8, (r.top - offY) - H - 4);
      vlist.style.left = left + 'px';
      vlist.style.top = top + 'px';
      vlist.style.width = w + 'px';
    }
    var openVDet = null, openVList = null, openVSum = null;
    function vdetReposition() { if (openVDet && openVDet.open) placeVList(openVSum, openVList); }
    window.addEventListener('scroll', vdetReposition, true);
    window.addEventListener('resize', vdetReposition);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', vdetReposition);
      window.visualViewport.addEventListener('scroll', vdetReposition);
    }
    document.addEventListener('click', function (e) {
      if (!openVDet || !openVDet.open) return;
      if (openVSum.contains(e.target) || openVList.contains(e.target)) return;
      openVDet.open = false;
    });

    // ===== Autocomplete de productos (estilo Excel) =====
    // Un solo dropdown anclado al <body>: ningún transform/overflow del panel lo desplaza o recorta
    var poAc = document.createElement('div');
    poAc.className = 'po-ac hidden fixed z-[70] min-w-[280px] max-h-56 overflow-auto bg-white border border-slate-200 rounded-xl shadow-xl';
    document.body.appendChild(poAc);

    function acBox() { return poAc; }
    function acHide() { poAc.classList.add('hidden'); poAc.innerHTML = ''; poAc._idx = -1; poAc._row = null; }
    function acPlace(row) {
      var inp = row.querySelector('.po-name');
      var r = inp.getBoundingClientRect();
      var vv = window.visualViewport;
      // offsetLeft/offsetTop: en móvil (sobre todo iOS Safari), el teclado
      // desplaza el visual viewport sin mover el layout viewport, así que
      // getBoundingClientRect() y nuestro dropdown position:fixed quedan
      // desalineados si no se compensa esa diferencia — era la causa de que
      // el autocomplete "se moviera" de su input al abrirse el teclado.
      var offX = (vv && vv.offsetLeft) || 0;
      var offY = (vv && vv.offsetTop) || 0;
      var vw = (vv && vv.width) || window.innerWidth;
      var vh = (vv && vv.height) || window.innerHeight;
      var H = 224; // max-h-56
      var w = Math.min(Math.max(r.width, 280), Math.max(240, vw - 16));
      var left = Math.max(8, Math.min(r.left - offX, vw - w - 8));
      var below = (r.bottom - offY) + 6;
      var top;
      if (below + H <= vh - 8) top = below;
      else if ((r.top - offY) - H - 6 >= 8) top = (r.top - offY) - H - 6;
      else top = Math.max(8, vh - H - 8);
      poAc.style.left = left + 'px';
      poAc.style.top = top + 'px';
      poAc.style.width = w + 'px';
    }
    function acUpdate(row) {
      var inp = row.querySelector('.po-name');
      if (row.classList.contains('po-child') || inp.readOnly) { acHide(); return; }
      var q = norm(inp.value);
      // Sin texto: muestra todo el catálogo para elegir sin escribir (como el select de antes)
      var list = q ? PRODS.filter(function(p){
        return norm(p.name).indexOf(q) >= 0 || (p.sku ? norm(p.sku).indexOf(q) >= 0 : false);
      }) : PRODS;
      var matches = list.slice(0, q ? 8 : 50);
      var html = matches.map(function(p, i){
        return '<button type="button" data-pid="' + p.id + '" class="po-ac-it w-full text-left px-3 py-2 text-sm hover:bg-neutral-100 ' + (i === 0 ? 'bg-neutral-100/60' : '') + ' border-b border-slate-50">' +
          '<b class="text-slate-800">' + esc(p.name) + '</b>' +
          (p.sku ? ' <span class="text-slate-400 text-xs">(' + esc(p.sku) + ')</span>' : '') +
          (p.variantOpts && p.variantOpts.length ? ' <span class="text-amber-700 text-xs">' + UI_ICONS.sliders + p.variantOpts.length + '</span>' : '') +
          (p.price ? ' <span class="text-slate-400 text-xs">$' + fmtMoney(p.price) + '</span>' : '') +
        '</button>';
      }).join('');
      if (q) html += '<button type="button" class="po-ac-new w-full text-left px-3 py-2 text-xs font-bold text-neutral-700 hover:bg-neutral-100">' + UI_ICONS.plus + 'Usar "' + esc(inp.value.trim()) + '" como producto nuevo</button>';
      poAc.innerHTML = html;
      poAc._row = row;
      poAc.classList.remove('hidden');
      acPlace(row);
      poAc._idx = 0;
      poAc.querySelectorAll('.po-ac-it').forEach(function(btn, i){
        btn.addEventListener('mousedown', function(e){ e.preventDefault(); acPick(row, parseInt(btn.dataset.pid)); });
      });
      var nb = poAc.querySelector('.po-ac-new');
      if (nb) nb.addEventListener('mousedown', function(e){
        e.preventDefault(); acHide(); poFocusCell(row, row.querySelector('.po-qty'));
      });
    }
    function acMove(row, dir) {
      var items = poAc.querySelectorAll('.po-ac-it');
      if (poAc.classList.contains('hidden') || !items.length) return false;
      poAc._idx = (poAc._idx + dir + items.length) % items.length;
      items.forEach(function(it, i){ it.classList.toggle('bg-neutral-100', i === poAc._idx); });
      items[poAc._idx].scrollIntoView({ block: 'nearest' });
      return true;
    }
    function acPick(row, id) {
      var p = prodById[id];
      if (!p) return;
      var hadChildren = (childOf.get(row) || []).length > 0;
      if (row.dataset.pid && row.dataset.pid !== String(id) && hadChildren) {
        (childOf.get(row) || []).forEach(function(ch){ dropRowVList(ch); ch.remove(); });
        childOf.set(row, []);
        row.dataset.var = '';
      }
      row.dataset.pid = String(id);
      row.querySelector('.po-name').value = p.name;
      // Preprecio: llena el precio de venta con el actual del producto si la celda está vacía
      var cost = row.querySelector('.po-cost'), price = row.querySelector('.po-price');
      if (!price.value && p.price) price.value = Number(p.price).toFixed(2);
      acHide();
      poNameStyle(row);
      refreshVariant(row);
      var vdet = row.querySelector('.po-vdet');
      if (!vdet.classList.contains('hidden')) vdet.open = true; // variantes listas para marcar
      poFocusCell(row, row.querySelector('.po-qty'));
      poRecalc();
    }

    // ===== Filas =====
    function poAddRow(opts) {
      opts = opts || {};
      var row = document.createElement('tr');
      row.className = 'po-row border-b border-slate-100 last:border-0';
      row.dataset.pid = opts.product_id ? String(opts.product_id) : '';
      row.dataset.prevPid = row.dataset.pid;
      row.dataset.var = opts.variant || '';
      row.innerHTML =
        '<td class="px-3 py-1.5 align-middle relative" data-label="Producto">' +
          '<input type="text" class="po-name w-full min-w-[170px] border border-slate-200 rounded-lg px-2 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-neutral-400" placeholder="Producto (escribe para buscar)" autocomplete="off">' +
        '</td>' +
        '<td class="px-2 py-1.5 align-middle" data-label="Variante">' +
          '<span class="po-vstatic hidden bg-amber-100 text-amber-800 rounded-lg px-2 py-1.5 text-xs font-bold whitespace-nowrap"></span>' +
          '<details class="po-vdet hidden relative text-xs">' +
            '<summary tabindex="-1" class="po-vsum bg-amber-50 border border-amber-300 text-amber-800 rounded-lg px-2 py-1.5 font-bold cursor-pointer select-none whitespace-nowrap overflow-hidden">' + UI_ICONS.sliders + '<span class="po-vlabel overflow-hidden text-ellipsis">Variantes</span><span class="po-vcount text-amber-600"></span></summary>' +
            '<div class="po-vlist hidden fixed z-[70] max-h-52 overflow-auto bg-white border border-slate-200 rounded-xl shadow-xl p-2 space-y-1"></div>' +
          '</details>' +
          '<input type="text" tabindex="-1" class="po-vname w-full border border-amber-300 bg-amber-50 rounded-lg px-2 py-1.5 text-sm hidden" placeholder="Atributo (ej: XS / Azul)">' +
        '</td>' +
        '<td class="px-2 py-1.5 align-middle" data-label="Cant."><input type="number" min="1" class="po-qty w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0"></td>' +
        '<td class="px-2 py-1.5 align-middle" data-label="Costo"><input type="number" min="0" step="0.01" class="po-cost w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0.00"></td>' +
        '<td class="px-2 py-1.5 align-middle" data-label="Precio venta"><input type="number" min="0" step="0.01" class="po-price w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm" placeholder="0.00"></td>' +
        '<td class="px-2 py-1.5 align-middle text-right" data-label="Subtotal"><span class="po-sub text-xs font-black text-slate-700">$0.00</span></td>' +
        '<td class="px-2 py-1.5 align-middle text-center"><button type="button" aria-label="Eliminar línea" title="Eliminar línea" class="po-del w-7 h-7 rounded-lg bg-slate-100 text-red-600 hover:bg-red-50 hover:text-red-800 grid place-items-center">' + UI_ICONS.trash + '</button></td>';

      var inp = row.querySelector('.po-name');
      var vname = row.querySelector('.po-vname');
      var qty = row.querySelector('.po-qty');
      var cost = row.querySelector('.po-cost');
      var price = row.querySelector('.po-price');

      var vdet = row.querySelector('.po-vdet');
      var vsum = row.querySelector('.po-vsum');
      var vlist = row.querySelector('.po-vlist');
      document.body.appendChild(vlist);
      row._vlist = vlist; // ya no es descendiente de row (ver arriba) — se guarda la referencia porque row.querySelector('.po-vlist') dejaría de encontrarlo
      vdet.addEventListener('toggle', function () {
        if (vdet.open) {
          if (openVDet && openVDet !== vdet) openVDet.open = false;
          openVDet = vdet; openVList = vlist; openVSum = vsum;
          vlist.classList.remove('hidden');
          placeVList(vsum, vlist);
        } else {
          vlist.classList.add('hidden');
          if (openVDet === vdet) { openVDet = null; openVList = null; openVSum = null; }
        }
      });

      // Navegación tipo Excel en las celdas numéricas
      [qty, cost, price].forEach(function(cell){
        cell.addEventListener('focus', function(){ cell.select(); });
        cell.addEventListener('input', poRecalc);
        cell.addEventListener('keydown', function(e){
          if (e.key === 'Enter') {
            e.preventDefault();
            if (!poNextCell(row, cell)) poEnterNextRow(row);
          } else if (e.key === 'ArrowDown') { e.preventDefault(); poGoRow(row, '.' + cell.classList[0], 1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); poGoRow(row, '.' + cell.classList[0], -1); }
        });
      });

      // Autocomplete + navegación en la celda de producto
      inp.addEventListener('input', function(){ row.dataset.pid = ''; refreshVariant(row); poNameStyle(row); acUpdate(row); });
      inp.addEventListener('focus', function(){
        if (inp.readOnly) return;
        // Si ya tiene un producto vinculado, selecciona el texto para reemplazarlo fácil
        if (row.dataset.pid) requestAnimationFrame(function(){ inp.select(); });
        acUpdate(row);
      });
      inp.addEventListener('blur', function(){
        setTimeout(function(){
          acHide(row);
          // Si escribió el nombre exacto de un producto, lo vincula solo
          if (!row.dataset.pid && !inp.readOnly) {
            var id = prodNameToId[norm(inp.value)];
            if (id) { row.dataset.pid = String(id); refreshVariant(row); }
            poNameStyle(row);
          }
        }, 120);
      });
      inp.addEventListener('keydown', function(e){
        if (e.key === 'ArrowDown') { e.preventDefault(); if (!acMove(row, 1)) acUpdate(row); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); acMove(row, -1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          var b = acBox(row);
          var items = b.querySelectorAll('.po-ac-it');
          if (!b.classList.contains('hidden') && b._idx >= 0 && items[b._idx]) { acPick(row, parseInt(items[b._idx].dataset.pid)); return; }
          acHide(row);
          if (!poNextCell(row, inp)) poEnterNextRow(row);
        }
        else if (e.key === 'Escape') { acHide(row); }
      });

      vname.addEventListener('input', poRecalc);
      row.querySelector('.po-del').onclick = function(){ removeRow(row); };

      if (opts.product_id) { inp.value = prodById[opts.product_id] ? prodById[opts.product_id].name : ''; }
      else if (opts.name) inp.value = opts.name;
      if (opts.qty) qty.value = opts.qty;
      if (opts.cost) cost.value = opts.cost;
      if (opts.price) price.value = opts.price;

      if (opts._childOf) {
        row.classList.add('po-child');
        inp.readOnly = true;
        inp.classList.add('bg-slate-50', 'text-slate-500');
      }
      refreshVariant(row);
      poNameStyle(row);
      document.getElementById('po-items').appendChild(row);
      if (opts._childOf) {
        var kids = childOf.get(opts._childOf) || [];
        kids.push(row);
        childOf.set(opts._childOf, kids);
      }
      poRecalc();
      if (opts.focus) poFocusCell(row, inp);
      return row;
    }

    function poEnterNextRow(row) {
      var rows = poRows();
      if (rows.indexOf(row) === rows.length - 1) poAddRow({ focus: true });
      else poFocusCell(rows[rows.indexOf(row) + 1], rows[rows.indexOf(row) + 1].querySelector('.po-name'));
    }

    // El po-vlist de la fila vive aparte en <body> (ver poAddRow) — al
    // borrar la fila hay que quitarlo también o se queda huérfano ahí.
    function dropRowVList(r) {
      var vl = r._vlist;
      if (vl && vl.parentNode) vl.parentNode.removeChild(vl);
      var vd = r.querySelector('.po-vdet');
      if (openVDet === vd) { openVDet = null; openVList = null; openVSum = null; }
    }
    function removeRow(row) {
      (childOf.get(row) || []).forEach(function(ch){ dropRowVList(ch); ch.remove(); });
      childOf.delete(row);
      dropRowVList(row);
      row.remove();
      poRecalc();
    }

    // El botón decía siempre "Variantes (n)" sin importar cuál se hubiera
    // marcado — con 1 sola marcada mostraba lo mismo que con ninguna, y
    // había que abrir el desplegable para saber cuál era. Ahora muestra el
    // nombre real cuando hay una sola, o "nombre +N" cuando hay varias.
    function updateVSummary(row) {
      var label = row.querySelector('.po-vlabel');
      var count = row.querySelector('.po-vcount');
      if (!label || !count || !row._vlist) return;
      var checked = Array.prototype.slice.call(row._vlist.querySelectorAll('.po-vchk:checked')).map(function (cb) { return cb.value; });
      if (checked.length === 0) { label.textContent = 'Variantes'; count.textContent = ''; }
      else if (checked.length === 1) { label.textContent = checked[0]; count.textContent = ''; }
      else { label.textContent = checked[0]; count.textContent = ' +' + (checked.length - 1); }
    }

    function buildVList(row) {
      var vlist = row._vlist;
      var p = row.dataset.pid ? prodById[parseInt(row.dataset.pid)] : null;
      var combos = (p && p.variantOpts && p.variantOpts.length) ? p.variantOpts : [];
      vlist.innerHTML = combos.map(function(c){
        return '<label class="flex items-center gap-1.5 py-0.5 cursor-pointer"><input type="checkbox" class="po-vchk accent-amber-500" value="' + esc(c) + '"> <span class="text-slate-700">' + esc(c) + '</span></label>';
      }).join('');
      var kids = childOf.get(row) || [];
      vlist.querySelectorAll('.po-vchk').forEach(function(cb){
        cb.checked = cb.value === row.dataset.var || kids.some(function(ch){ return ch.dataset.var === cb.value; });
        cb.addEventListener('change', function(){ poVChanged(row); });
      });
    }

    function refreshVariant(row) {
      var isChild = row.classList.contains('po-child');
      var pid = row.dataset.pid ? parseInt(row.dataset.pid) : null;
      var p = pid ? prodById[pid] : null;
      var hasVar = p && p.variantOpts && p.variantOpts.length;
      var inp = row.querySelector('.po-name');
      var vname = row.querySelector('.po-vname');
      var vdet = row.querySelector('.po-vdet');
      var vstatic = row.querySelector('.po-vstatic');

      // Si la fila maestra cambia de producto, se limpian los hijos y la variante elegida
      if (!isChild && row.dataset.prevPid && row.dataset.prevPid !== row.dataset.pid) {
        (childOf.get(row) || []).forEach(function(ch){ dropRowVList(ch); ch.remove(); });
        childOf.set(row, []);
        row.dataset.var = '';
      }
      row.dataset.prevPid = row.dataset.pid;

      if (isChild) {
        vstatic.textContent = row.dataset.var;
        vstatic.classList.remove('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.add('hidden');
      } else if (hasVar) {
        vstatic.classList.add('hidden');
        vname.classList.add('hidden');
        vdet.classList.remove('hidden');
        buildVList(row);
        updateVSummary(row);
      } else if (pid) {
        vstatic.classList.add('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.add('hidden');
      } else {
        vstatic.classList.add('hidden');
        vdet.classList.add('hidden'); vdet.open = false;
        vname.classList.remove('hidden');
      }
      poRecalc();
    }

    // La fila maestra guarda la 1ª combinación; el resto se agregan solas como filas hijas.
    function poVChanged(master) {
      (childOf.get(master) || []).forEach(function(ch){ dropRowVList(ch); ch.remove(); });
      childOf.set(master, []);
      var checked = Array.prototype.slice.call(master._vlist.querySelectorAll('.po-vchk:checked')).map(function(cb){ return cb.value; });
      master.dataset.var = checked[0] || '';
      updateVSummary(master);
      var baseQty = parseInt(master.querySelector('.po-qty').value) || 1;
      var mCost = master.querySelector('.po-cost').value;
      var mPrice = master.querySelector('.po-price').value;
      checked.slice(1).forEach(function(v){
        poAddRow({ product_id: master.dataset.pid, variant: v, qty: baseQty, cost: mCost, price: mPrice, _childOf: master });
      });
      poRecalc();
    }

    function poRows() { return Array.prototype.slice.call(document.querySelectorAll('.po-row')); }

    function poRecalc() {
      var total = 0;
      poRows().forEach(function(r){
        var qty = parseInt(r.querySelector('.po-qty').value) || 0;
        var cost = parseFloat(r.querySelector('.po-cost').value) || 0;
        var sub = qty * cost;
        total += sub;
        r.querySelector('.po-sub').textContent = '$' + fmtMoney(sub);
      });
      document.getElementById('po-total').textContent = '$' + fmtMoney(total);
      document.getElementById('po-items-json').value = JSON.stringify(poSerialize());
    }

    function poSerialize() {
      return poRows().map(function(r){
        var pid = r.dataset.pid ? parseInt(r.dataset.pid) : null;
        var prodName = pid ? prodById[pid].name : r.querySelector('.po-name').value.trim();
        var variant = r.dataset.var || r.querySelector('.po-vname').value.trim() || '';
        return { product_id: pid, name: prodName, variant: variant, qty: parseInt(r.querySelector('.po-qty').value) || 0, cost: parseFloat(r.querySelector('.po-cost').value) || 0, price: parseFloat(r.querySelector('.po-price').value) || 0 };
      }).filter(function(x){ return x.name && x.qty > 0; });
    }

    // ===== Pegar desde Excel directamente en la tabla (Ctrl+V sobre la cuadrícula) =====
    function poFillRow(row, o) {
      var inp = row.querySelector('.po-name');
      if (o.product_id) { row.dataset.pid = String(o.product_id); inp.value = prodById[o.product_id].name; }
      else { row.dataset.pid = ''; inp.value = o.name || ''; }
      if (o.qty) row.querySelector('.po-qty').value = o.qty;
      if (o.cost) row.querySelector('.po-cost').value = o.cost;
      if (o.price) row.querySelector('.po-price').value = o.price;
      refreshVariant(row);
      poNameStyle(row);
    }

    function poPasteText(txt, startRow) {
      var lines = txt.split(/\r?\n/).map(function(l){ return l.trim(); }).filter(Boolean);
      if (!lines.length) return 0;
      var rows = poRows();
      var si = startRow ? rows.indexOf(startRow) : -1;
      var count = 0;
      lines.forEach(function(line, i){
        var parts = line.split(/[\t,;]/).map(function(p){ return p.trim(); });
        var name = parts[0] || '';
        var qty = parseInt(parts[1]) || 0;
        var cost = parseFloat(parts[2]) || 0;
        var price = parseFloat(parts[3]) || 0;
        var m1 = name.match(/^(\d+)\s*[x*]\s*(.+)$/); // formato "10 x Tornillos"
        if (m1) { qty = parseInt(m1[1]); name = m1[2].trim(); }
        if (!name) return;
        var o = { qty: qty || 1, cost: cost, price: price };
        var id = prodNameToId[norm(name)];
        if (id) o.product_id = id; else o.name = name;
        if (i === 0 && si >= 0) { poFillRow(rows[si], o); }
        else { poAddRow(o); }
        count++;
      });
      poRecalc();
      return count;
    }

    function poPasteBox() { poPasteText(document.getElementById('po-paste').value, null); document.getElementById('po-paste').value = ''; }

    document.getElementById('po-grid').addEventListener('paste', function(e){
      var txt = (e.clipboardData || window.clipboardData).getData('text');
      if (!txt || (txt.indexOf('\n') < 0 && txt.indexOf('\t') < 0)) return; // valor simple → pegado normal
      e.preventDefault();
      var row = e.target && e.target.closest ? e.target.closest('.po-row') : null;
      poPasteText(txt, row);
    });

    // El autocomplete sigue anclado a su celda al hacer scroll (antes se cerraba y por eso "no salía")
    function acReposAll(){
      poRows().forEach(function(r){ var b = acBox(r); if (b && !b.classList.contains('hidden')) acPlace(r); });
    }
    window.addEventListener('scroll', acReposAll, { passive: true });
    window.addEventListener('resize', acReposAll, { passive: true });
    document.getElementById('po-grid').addEventListener('scroll', acReposAll, { passive: true });
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', acReposAll);
      window.visualViewport.addEventListener('scroll', acReposAll);
    }

    function copiarPedido(msg) {
      var text = decodeURIComponent(msg);
      try { navigator.clipboard.writeText(text); mostrarToast('Texto copiado ✓', 'ok'); } catch(e) { mostrarToast('No se pudo copiar', 'error'); }
    }

    document.getElementById('po-form').addEventListener('submit', function(e){
      // Validación de la tabla: una fila iniciada debe estar completa (producto + cantidad)
      var bad = null;
      poRows().forEach(function(r, i){
        if (bad) return;
        var name = (r.dataset.pid ? (prodById[r.dataset.pid] || {}).name : r.querySelector('.po-name').value.trim()) || '';
        var qty = parseInt(r.querySelector('.po-qty').value) || 0;
        var variant = r.dataset.var || r.querySelector('.po-vname').value.trim() || '';
        var cost = parseFloat(r.querySelector('.po-cost').value) || 0;
        var price = parseFloat(r.querySelector('.po-price').value) || 0;
        var started = name || variant || qty > 0 || cost > 0 || price > 0 || r.dataset.pid;
        if (started && (!name || qty < 1)) bad = { row: r, num: i + 1, missingName: !name, missingQty: qty < 1 };
      });
      if (bad) {
        e.preventDefault();
        var markName = bad.row.querySelector('.po-name'), markQty = bad.row.querySelector('.po-qty');
        if (bad.missingName) markName.classList.add('po-invalid');
        if (bad.missingQty) markQty.classList.add('po-invalid');
        setTimeout(function(){ markName.classList.remove('po-invalid'); markQty.classList.remove('po-invalid'); }, 2500);
        mostrarToast(bad.missingName ? ('Fila ' + bad.num + ': escribe el producto') : ('Fila ' + bad.num + ': falta la cantidad'), 'error');
        (bad.missingName ? markName : markQty).focus();
        return;
      }
      var items = poSerialize();
      if (!items.length) { e.preventDefault(); mostrarToast('Agrega al menos un producto', 'error'); return; }
      if (!document.getElementById('po-supplier').value) { e.preventDefault(); mostrarToast('Selecciona un proveedor', 'error'); return; }
      document.getElementById('po-items-json').value = JSON.stringify(items);
    });

    // La fila inicial queda lista sin robar foco ni abrir el autocomplete al cargar.
    poAddRow();
  </script>
</body>
</html>
