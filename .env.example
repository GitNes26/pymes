# ============================================
# CataManager (Nessik) — Variables de entorno
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real a git.

# --- Base de datos (MySQL 8 / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=catamanager
DB_PASS=cambia-esta-password
DB_NAME=catamanager

# --- Clave maestra ---
# Código para registrar tiendas desde /registrar y entrar al panel maestro /maestro
MASTER_KEY=mk-genera-una-clave-larga-y-unica

# --- URL pública ---
# Se usa para los enlaces de compartir. En local déjalo vacío;
# en producción: https://tudominio.com
BASE_URL=

# --- Archivos persistentes ---
# Cada despliegue que comparta /app/public/uploads debe usar un nombre único.
# Solo acepta letras, números, punto, guion y guion bajo.
UPLOADS_PROJECT_NAME=catamanager
# En Docker ya vale /app/public/uploads. Fuera de Docker puede omitirse.
UPLOADS_ROOT=
