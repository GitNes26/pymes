# ================= Dependencias =================
node_modules/

# ================= Secretos / entorno =================
# Cualquier variante de .env queda fuera (.env, .env.local, .env.production,
# .env.docker, etc.) — solo se permite explícitamente la plantilla de ejemplo.
.env*
!.env.example

# Credenciales, llaves y certificados sueltos (por si algún día aparecen)
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
*.pgp
credentials.json
secrets.json
docker-compose.override.yml
docker-compose.*.local.yml

# ================= Base de datos =================
# Ya no se usa SQLite, pero si regresa no debe versionarse:
*.db
*.db-shm
*.db-wal
*.db.bak
*.sqlite
*.sqlite3
# Respaldos (locales y de servidor)
backups/
*.sql.gz
# Los dumps .sql de datos completos NO van al repo (catamanager-con-datos.sql);
# el esquema limpio (catamanager-full.sql) sí se versiona a propósito.
catamanager-con-datos.sql

# ================= Archivos subidos por usuarios =================
# Logos, banners, fotos de productos y archivos del constructor
public/uploads/
uploads/

# ================= Logs =================
*.log
*.log.err
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ================= Sesiones de Freebuff (previews, run-doc, logs) =================
.freebuff/

# ================= Sesiones de Impeccable (config local, capturas de review) =================
.impeccable/

# ================= Archivos de trabajo temporales / basura =================
cookies*.txt
err.txt
*_REVIEW.txt
*.tmp
*.bak
fix-*.js
tools/test-*.js
tools/check-*.js
tools/debug-*.js

# ================= Sistema operativo / editores =================
