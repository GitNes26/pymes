# ─────────────────────────────────────────────────────────────
# CataManager — Variables de entorno para Dokploy (servicio app)
# Pega estas claves en: Dokploy → tu aplicación → Environment
# ─────────────────────────────────────────────────────────────

# ── Base de datos MySQL (servicio creado en Dokploy) ────────
# Crea un servicio MySQL 8 en Dokploy. Su host interno suele ser
# algo como "<nombre>-db-xxxx" (lo ves en el panel del servicio BD).
DB_HOST=tu-servicio-mysql-db-xxxx
DB_PORT=3306
DB_USER=catamanager
DB_PASS=cambia-esta-clave
DB_NAME=catamanager

# ── App ──────────────────────────────────────────────────────
# Clave maestra del panel /maestro (cámbiala por una larga y aleatoria:
# openssl rand -hex 24)
MASTER_KEY=cambia-esta-clave-maestra

# URL pública de la app — debe empezar con https:// (si no la pones así,
# los enlaces de compartir/QR/vista previa salen en http y fallan, y la
# app no fuerza el redirect a https). Se usa para compartir catálogos,
# SEO, y en server.js para el redirect http->https y las cookies Secure.
# IMPORTANTE: además de poner esto, en Dokploy → tu app → Domains agrega
# el dominio y activa "HTTPS" (ahí es donde Dokploy realmente emite el
# certificado; esta variable sola no genera el certificado).
BASE_URL=https://cadi.nessik.net

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# ── Archivos compartidos entre proyectos ────────────────────
# Monta el mismo directorio del host en todos los proyectos:
#   /var/www/imagenes_cadi:/app/public/uploads
# y asigna un nombre DIFERENTE a cada despliegue. Los nuevos archivos quedarán
# físicamente en /var/www/imagenes_cadi/<este-nombre>/, aunque sus URLs públicas
# seguirán siendo /uploads/archivo.ext.
UPLOADS_HOST_PATH=/var/www/imagenes_cadi
UPLOADS_ROOT=/app/public/uploads
UPLOADS_PROJECT_NAME=catamanager

# ─────────────────────────────────────────────────────────────
# PASOS UNA SOLA VEZ tras crear la BD en Dokploy:
#   1) El esquema se carga ejecutando el archivo `catamanager-full.sql`
#      contra esa BD (consola SQL del servicio o `mysql < catamanager-full.sql`).
#      Alternativa: en Dokploy monta `catamanager-full.sql` en
#      /docker-entrypoint-initdb.d/ del servicio MySQL.
#   2) La app siembra sola la tienda demo en su primer arranque si la
#      tabla `businesses` está vacía (no hace falta cargar datos).
# ─────────────────────────────────────────────────────────────
